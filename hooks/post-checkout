#!/usr/bin/env bash
# agent-board-toolkit post-checkout hook.
# On a BRANCH checkout (git checkout -b / git switch -c / switching branches), move the
# correlated card to "In Progress" so "work begun" is recorded without a manual step — but
# ONLY in a repo that has OPTED IN:
#
#     git config kanban.automove-on-checkout true     # in the repo you want moved
#
# UNSET MEANS OFF, and that default is the fix, not a preference (card#9845). The hook used to
# call the mover on EVERY branch checkout, and a checkout is not a work-start signal: reading a
# colleague's branch, bisecting, or hopping back to `main` silently moved that branch's card to
# In Progress. card#9845's measurement: three such moves inside five seconds, 2026-09-19.
# Nothing downstream could tell those apart from a real start — the mover is invoked with NO
# arguments, exactly as a deliberate hand-run invokes it, so the discriminating signal does not
# exist anywhere below this line. This hook is the layer that can mint it, and it mints it by
# NOT CALLING rather than by passing a flag: there is no second code path to keep correct.
#
# Scope is git's own config cascade, so the ordinary spelling above is repo-local (that is what
# `git config` writes inside a repo) and `--global` is available to a seat that deliberately
# wants every repo armed. It sits beside `kanban.board-id`, which the mover already reads.
#
# Fail-soft: this hook NEVER blocks or fails a checkout, and prints nothing on any path.
#
# Install with: bin/install-board-hooks <repo>   (symlinks this file into .git/hooks)
#
# Args from git: $1 = prev HEAD, $2 = new HEAD, $3 = 1 if a branch checkout.
[ "${3:-0}" = "1" ] || exit 0
# `--bool` leaves the SPELLING to git (true/yes/on/1 arm it; false/off/0/empty do not) instead of
# this hook deciding what counts as true. Every other answer is OFF: unset exits 1 with no output,
# and a value git cannot read as a boolean is a fatal on stderr — discarded here — with stdout
# empty. The value is captured, never echoed, so an armed or a broken config is equally silent.
kb_automove="$(git config --bool --get kanban.automove-on-checkout 2>/dev/null)"
[ "$kb_automove" = "true" ] || exit 0
if command -v board-card-start >/dev/null 2>&1; then
    board-card-start >/dev/null 2>&1 || true
fi
exit 0
