# agent-board-toolkit — per-board config (source of board/stage/type/custom-field IDs)
# ---------------------------------------------------------------------------
# Copy this to a real file and fill in YOUR board's numeric IDs:
#     cp examples/kanban-board.env.example ~/.kanban-myproject-board.env
#     chmod 600 ~/.kanban-myproject-board.env
#
# `kbcard` sources this file; the `--board <name>` flag selects which env file
# (it looks for ~/.kanban-<name>-board.env). See docs/INSTALL.md §3.
#
# HOW TO FIND THE IDs (replace YOUR-KANBAN-HOST + <board-id>):
#   stages : GET https://YOUR-KANBAN-HOST/api/v3/boards/<board-id>/workflows.json   -> .data[].workflow_stages[] {id,name}
#   types  : GET https://YOUR-KANBAN-HOST/api/v3/boards/<board-id>/card_types.json   -> .data[] {id,name}
#   fields : GET https://YOUR-KANBAN-HOST/api/v3/boards/<board-id>/custom_fields.json -> .data[] {id,key,type}
#            (`type` is not decoration — see the DECLARED TYPES box under 'Custom field IDs' below)
#   lanes  : GET https://YOUR-KANBAN-HOST/api/v3/boards/<board-id>.json               -> .data.swimlanes[] {id,name}
# Map each returned id to the matching key below. Names here are illustrative —
# use whatever columns/types/fields YOUR board actually has. The `kbcard` column
# and card-type ALIASES (e.g. `bug`, `in_progress`, `wont_do`) are a fixed set in
# the script; a board with a different taxonomy maps its ids onto the closest
# aliases, or extends the `case` blocks locally and drift-checks against upstream
# (per the vendor model — never a silent contract fork). `--board <name>` +
# `KANBAN_SNAPSHOT_BOARDS` (board-snapshot) + `KB_DL_CHECKOUT_GLOBS` (next-dl) make
# the roster/checkouts config-driven for a PM-project adopter.

export KB_BOARD_ID=000            # the board's numeric id
export KB_WORKFLOW_ID=000         # the board's workflow id

# --- Workflow stage IDs (your columns) ---
export KB_STAGE_BACKLOG=000
export KB_STAGE_PRIORITIZED=000
export KB_STAGE_IN_PROGRESS=000
export KB_STAGE_IN_REVIEW=000
export KB_STAGE_SHIPPED_TO_DEV=000
export KB_STAGE_RELEASED_TO_MAIN=000

# --- Card type IDs ---
export KB_TYPE_DL=000
export KB_TYPE_RELEASE=000
export KB_TYPE_REQUEST=000
export KB_TYPE_IDEA=000
export KB_TYPE_BUG=000

# --- Swimlane names (OPTIONAL; id-keyed — the INVERSE of the stage/type keys) ---
# Swimlane names are freeform labels (often the impl agent per lane), so they can't
# be env-var suffixes the way the controlled stage/type vocabularies can — the id is
# the suffix and the NAME is the value. Setting these lets `kbcard list` resolve each
# card's `swimlane` name and accept `--swimlane <name>` (read filter), and lets
# `kbcard patch --swimlane <name>` assign a card to a lane by name; without them the
# `swimlane` column is null and `--swimlane` only takes a numeric id. Add one per lane your
# board has (none by default — boards without swimlanes just leave this section out):
# export KB_SWIMLANE_1=device
# export KB_SWIMLANE_2=backend

# --- Custom field IDs ---
#
# ⛔ DECLARED TYPES — A PREREQUISITE, NOT A PREFERENCE. These ids are only half of
# what a board needs; the other half is the TYPE each field was DECLARED with, which
# lives on the board and not in this file. kanban validates every payload value
# against its field's declared type per board, so a key declared with a type that
# does not accept what these tools WRITE rejects every write to it, forever:
#
#   dl_number   MUST be `string`.  Every writer of it — `kbcard --dl`, `next-dl`,
#               `adopt-to-dl`, `dl-a1-register-field` — stamps the canonical
#               `DL-NNNN` STRING through one renderer. Declared `number`, the board
#               answers EVERY one of those writes
#               `422 {"message":"Must be a number.","errors":{"payload.dl_number":…}}`
#               — so the board is broken at first use, and nothing said so at setup.
#               ⚠ The by-ref correlation index does NOT catch this: it canonicalizes
#               by stripping non-digits and therefore works from either type. The
#               index looking healthy is why the wrong declaration survives, not
#               evidence that it is right.
#   pr_number / issue_number   MUST be `number` — the mirror-image constraint, and the
#               reason "just declare everything string" is not the safe default:
#               `kbcard` coerces a numeric value to a JSON number before the write, and
#               a `string`-typed field rejects that with `Must be a string.`
#
# ALREADY DECLARED IT WRONG? The type is fixed IN PLACE — there is no delete-and-recreate.
# Per `kbcard field retype`'s contract the server converts the definition AND every stored
# value in one transaction, issuing no delete. For the dl_number case that is
#     kbcard --board <name> field retype --field dl_number --to string --restamp-dl
# (`--restamp-dl` is what rewrites the converted values to the canonical `DL-NNNN` form;
# without it a card holding `305` converts to the string `"305"`, which a custom-field DSL
# filter spelled `DL-0305` does not match). `dl-a1-register-field` declares dl_number
# correctly on a fresh board and REFUSES, printing that command, on a board that already
# declares it wrong.
#
# NOTE (BR-3.2): `kbcard` writes payload by its CONTRACT-FIXED keys — `dl_number`,
# `pr_number`, `version_target`, `origin` (the canonical external-reference keys
# kanban maps; do not rename them). It does NOT read most KB_CF_* ids — they're
# informational here (and consumed by other tooling). The one that IS read is
# KB_CF_VERSION_TARGET: `kbcard --version` writes `version_target` ONLY when it's
# set (non-`000`), so a board WITHOUT a version_target field can leave it `000`
# and `--version` is skipped (with a warning) instead of 422-ing. Boards that
# lack a field simply leave its id `000`.
export KB_CF_DL_NUMBER=000
export KB_CF_PR_NUMBER=000
export KB_CF_VERSION_TARGET=000   # leave 000 if your board has no version_target field → --version is skipped
export KB_CF_ORIGIN=000

# --- Optional overrides (defaults shown) ---
# NOTE: KBCARD_API is board-independent — set it ONCE in ~/.kanban-host.env, NOT
# here. As of v0.14.0 a board env that sets it is REFUSED, naming this file, rather
# than silently guessing which host you meant: kbcard / dl-a0-backfill-triaged /
# dl-a1-register-field / adopt-to-dl exit 2, while next-dl warns, skips the board
# check and still mints offline (fail-soft). board-snapshot and board-card-start
# never read it from here at all. (See docs/INSTALL.md §3.)
# Token file (a file containing ONLY the bearer token; chmod 600; never committed).
# Honored from this board env (resolved AFTER sourcing).
#
# ⛔ REQUIRED unless some other tier names one — this toolkit bakes in NO token path of
# its own. Declaring it HERE is what pins this board to a credential of its own rather
# than to a shared one. docs/INSTALL.md §3b owns the full tier precedence (including the
# one hook that reads this file conditionally) and what happens to a board no tier names
# a token file for; read it there rather than here — the copy of that list which used to
# live in this comment is exactly what went stale when a tier was added below the ones
# it named.
# ~/.kanban-dev-token was a baked default until card#7245: every board that had not set
# its own resolved to the same file, so one overwrite of it took all of them out at
# once, and a `--board myproject` call was silently using another board's credential.
export KBCARD_TOKEN_FILE="$HOME/.kanban-myproject-token"
