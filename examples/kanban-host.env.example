# agent-board-toolkit — host/API config (board-INDEPENDENT)
# ---------------------------------------------------------------------------
# Copy to ~/.kanban-host.env (chmod 600). Sourced by kbcard + board-snapshot so
# no install's host is baked into the shared tool. One file per host, shared by
# all boards on that host. Override the path with $KANBAN_HOST_ENV if needed.
#
#     cp examples/kanban-host.env.example ~/.kanban-host.env
#     chmod 600 ~/.kanban-host.env
#     # then edit KBCARD_API below to your kanban host

export KBCARD_API="https://YOUR-KANBAN-HOST/api/v3"

# REQUIRED — the expected api host (the host part of KBCARD_API, no scheme/path).
# No baked default, and with it unset NO host is recognised. Two guards read it:
#   1. every tool preflights the api base it resolved from this file; a host that is
#      not this one (or a subdomain of it) is a REFUSAL at setup, not a fallback —
#      so an endpoint that was never reachable fails here instead of as a 401 twenty
#      minutes later (card#7245). The predicate is the HOST alone, so an
#      http://127.0.0.1:8000/api/v3 install just declares KANBAN_EXPECTED_HOST=127.0.0.1
#      — for THIS guard. Guard 2 below also requires https://, and board-card-start runs
#      it on the base it resolves here, so on a plaintext board that hook moves no card
#      (everything else works normally). See docs/INSTALL.md §3.
#   2. the anti-exfiltration guard refuses to send the writeback token unless the api
#      base the tool resolved is https:// on this host — unset ⇒ the local card-movement
#      hook (board-card-start) fail-softs (no card move). The committed .release-pr.json
#      api_base is normally a scrubbed placeholder, so the base actually used comes from
#      OUTSIDE the repo (KBCARD_API above for board-card-start, $KANBAN_API_BASE for
#      promote-released-cards) — and is guarded identically either way.
# CI jobs set this in their own env instead.
export KANBAN_EXPECTED_HOST="YOUR-KANBAN-HOST"

# A host-wide default token file, used by any board whose own env does not name one
# (a file containing ONLY the bearer token; chmod 600). This is one tier of several and
# it is NOT the lowest: docs/INSTALL.md §3b owns the full precedence, and says what
# actually happens to a board no tier names a token file for. Read it there rather than
# here — the copy of that list which used to live in this comment is exactly what went
# stale when a tier was added below the ones it named.
# export KBCARD_TOKEN_FILE="$HOME/.kanban-shared-token"
