#!/usr/bin/env bash
# release-artifacts-check — assert that every artifact a repo DECLARES as part of its
# release set actually moved in a release PR.
#
# `.release-pr.json`'s `artifacts` array is the explicit must-move-together release set.
# Until this tool existed its only consumer was `release-pr-body`, which PRINTS it as a
# `- [ ]` checklist — a printer is not an asserter, so a member left behind shipped in
# silence. A guard that reads a proper SUBSET of a must-move-together file set cannot fail
# on the member it never reads; this one reads the whole declared set and fails on any
# member that did not move, no longer exists, or does not carry the version being shipped.
#
# Usage:
#   release-artifacts-check --base <ref> --head <ref> [--config PATH]
#
#   --base   the PR's base commit/ref (e.g. github.event.pull_request.base.sha)
#   --head   the PR's head commit/ref (e.g. github.event.pull_request.head.sha)
#   --config per-repo release config (default `.release-pr.json`)
#
# THE RANGE IS `merge-base(base, head)..head` — the PR's OWN changes — never base's tip.
# Both are resolved against the MERGE BASE, and that is a correctness requirement, not a
# refinement: base-branch drift after the fork point corrupts both halves otherwise.
#   * the MOVED leg: a hotfix landing on base after the fork makes that file differ between
#     base's tip and head, so it appears in a two-dot diff and spuriously satisfies "moved"
#     for a member THIS PR never touched;
#   * the CLASSIFICATION: a version bump landing on base after the fork makes base's tip
#     read the same version as head, so a real release PR is classified "version unchanged"
#     and the entire gate silently does not run.
#
# Release-PR classification is BY VERSION VALUE, not by "the version file appears in the
# diff": a repo may point `version_file` at a whole config file (kanban's is
# `config/app.php`), where a file-moved test would misfire on any unrelated edit to it.
# Merge-base version == head version ⇒ not a release PR ⇒ nothing to assert, exit 0.
#
# Exit status: 0 = nothing to assert, or every declared member passed. 1 = at least one
# member failed (every failure is reported, not just the first). 2 = usage/config error,
# an unresolvable merge base, or a version that could not be read at either end — none of
# these is EVER classified as "not a release PR", because that misclassification is a
# silent non-run of the whole gate rather than a pass.
set -euo pipefail
# Pinned so version extraction and the fixed-string matching below mean the same thing on
# every runner: a bracket range is a COLLATION range, and en_US.UTF-8 widens `[0-9]` to
# non-ASCII digits (card#5409). Exported so the `grep`s inherit it, not just this shell.
export LC_ALL=C

die() { echo "release-artifacts-check: $*" >&2; exit 2; }
command -v jq  >/dev/null || die "jq is required"
command -v git >/dev/null || die "git is required"

# require_value <flag> <value>: die unless a value-taking option was given a non-empty
# value. An option that consumes "$2" and is then dispatched with `[ -n "$var" ]` reads an
# explicitly-EMPTY value as an ABSENT flag, so `--flag ""` silently selects the default path
# instead of doing what was asked — here `--config ""` would fall back to `.release-pr.json`,
# reading a DIFFERENT repo's declared set than the caller named. Also converts a trailing
# flag with no argument from a bare `set -u` unbound-variable error into one naming the flag.
# Mirrors kb_require_value in _kb-board-lib.sh — like the two release siblings, this script
# is self-contained and does not source that lib, so the guard is duplicated; keep them in sync.
require_value() { [ -n "${2:-}" ] || die "$1 requires a non-empty value"; }

CONFIG=".release-pr.json"; BASE=""; HEAD_REF=""
while [ $# -gt 0 ]; do
  case "$1" in
    --base)   require_value "$1" "${2:-}"; BASE="$2"; shift 2;;
    --head)   require_value "$1" "${2:-}"; HEAD_REF="$2"; shift 2;;
    --config) require_value "$1" "${2:-}"; CONFIG="$2"; shift 2;;
    # Contiguous leading comment block, not a fixed range — a fixed `sed -n '2,20p'` is
    # silently wrong in both directions as the header grows or shrinks (card#5145).
    -h|--help) awk 'NR>1 { if (substr($0,1,1) == "#") print; else exit }' "$0"; exit 0;;
    *) die "unknown arg '$1'";;
  esac
done

[ -n "$BASE" ]     || die "--base <ref> is required"
[ -n "$HEAD_REF" ] || die "--head <ref> is required"
[ -f "$CONFIG" ]   || die "no $CONFIG in this repo (per-project config — see examples/release-pr.json.example for the shape)"

cfg_opt() { jq -r "$1 // empty" "$CONFIG" 2>/dev/null; }

# The config's SHAPE is validated once, here, before any `.key` read. Two separate verdicts,
# because they have different fixes — and both must be rc 2, this script's config-error code.
#
# The top-level OBJECT check is not pedantry: `.artifacts` (and every other read below) is a
# jq runtime ERROR on an array/string/number top level — `Cannot index array with "artifacts"`,
# jq rc 5 — which `set -e` would propagate as the script's own exit status, so a config typo
# surfaced as an undocumented rc and a raw jq traceback instead of the documented rc 2. One
# guard at the boundary covers every read below; adding `|| die` per call-site would be the
# same fix written N times. `jq .` (not `jq -e .`) does the parse leg, because `-e` also fails
# on a valid config whose content is literally `null` — which is a SHAPE error, and is
# reported as one by the second check rather than mis-diagnosed as a syntax error.
jq . "$CONFIG" >/dev/null 2>&1 \
  || die "$CONFIG is not valid JSON (a trailing comma?)"
jq -e 'type == "object"' "$CONFIG" >/dev/null 2>&1 \
  || die "$CONFIG parses but is not a JSON object at the top level (it is $(jq -r 'type' "$CONFIG")) — it must be an object of config keys; see examples/release-pr.json.example"

# OPT-OUT and MALFORMED are different verdicts and must not share a branch. An absent/null or
# EMPTY `artifacts` is a repo that never opted in — nothing to assert, exit 0, reported rather
# than silent so a repo that MEANT to declare a set can see that it did not. Any OTHER type
# (object, string, number, boolean) is a malformed declaration: printing "no artifacts
# declared" there would be a false statement about the config, and would silently disable the
# gate for a repo that plainly intended to enable it. Checked before the version legs, because
# a fail-closed version read would otherwise refuse a repo that never opted in.
ARTIFACTS_TYPE="$(jq -r '.artifacts | type' "$CONFIG")"
case "$ARTIFACTS_TYPE" in
  null)  echo "release-artifacts-check: no artifacts declared — nothing to assert"; exit 0;;
  array)
    if [ "$(jq -r '.artifacts | length' "$CONFIG")" -eq 0 ]; then
      echo "release-artifacts-check: no artifacts declared (empty array) — nothing to assert"
      exit 0
    fi;;
  *) die "$CONFIG has .artifacts of type '$ARTIFACTS_TYPE' — it must be an array of strings (omit the key entirely to opt out)";;
esac

VERSION_FILE="$(cfg_opt '.version_file')"
VERSION_REGEX="$(cfg_opt '.version_regex')"
[ -n "$VERSION_FILE" ]  || die "$CONFIG declares artifacts but no version_file — the release-PR classification cannot run"
[ -n "$VERSION_REGEX" ] || die "$CONFIG declares artifacts but no version_regex — the release-PR classification cannot run"

# _extract_version <ref> <label> — sets EXTRACTED_VERSION from <ref>:<version_file>. <label>
# names which END of the range <ref> is, because <ref> is often a resolved merge-base SHA that
# appears in none of the caller's inputs — an error naming only that SHA is not actionable.
#
# Sets a global instead of printing, deliberately: `die` inside a command substitution exits
# only the SUBSHELL, so `V="$(_extract_version …)"` would depend on `set -e` noticing the
# assignment's status to abort — an implicit path that a later `|| true` or an `if` context
# would silently defeat. Here `die` runs in the script's own shell and the exit is explicit.
#
# The two-stage extraction is the same one `release-pr-body` uses (project regex first, then
# a 2-4-segment numeric pull, so a .NET Major.Minor.Build.Revision is not truncated to three).
# `|| true` on the pipeline is required, not defensive: `head -1` closes the pipe on the
# first line, and under `pipefail` the upstream grep's SIGPIPE would surface as rc 141 on a
# perfectly good extraction. Emptiness is what is tested, immediately below.
EXTRACTED_VERSION=""
_extract_version() {
  local ref="$1" label="$2" content
  content="$(git show "$ref:$VERSION_FILE" 2>/dev/null)" \
    || die "cannot read '$VERSION_FILE' at $label ($ref) (ref or path missing from this clone) — the caller must check out with fetch-depth: 0 so both ends of the range are present; refusing rather than classifying this as 'not a release PR'"
  EXTRACTED_VERSION="$(printf '%s\n' "$content" \
    | grep -oiE "$VERSION_REGEX" | head -1 \
    | grep -oE '[0-9]+(\.[0-9]+){1,3}' | head -1 || true)"
  [ -n "$EXTRACTED_VERSION" ] \
    || die "no version matched version_regex in '$VERSION_FILE' at $label ($ref) — refusing rather than classifying this as 'not a release PR'"
}

# The fork point, resolved once and used for BOTH the version read and the diff (see the
# header). Fail-closed: an unresolvable merge base means the two refs share no history this
# clone can see, which is a refusal — never a "not a release PR" pass.
BASEREF="$(git merge-base "$BASE" "$HEAD_REF" 2>/dev/null)" \
  || die "cannot resolve the merge base of '$BASE' and '$HEAD_REF' (no common ancestor in this clone) — the caller must check out with fetch-depth: 0 so the fork point is present; refusing rather than classifying this as 'not a release PR'"

_extract_version "$BASEREF"  "the fork point of '$BASE' and '$HEAD_REF'"; BASE_VERSION="$EXTRACTED_VERSION"
_extract_version "$HEAD_REF" "head '$HEAD_REF'";                        HEAD_VERSION="$EXTRACTED_VERSION"

if [ "$BASE_VERSION" = "$HEAD_VERSION" ]; then
  echo "release-artifacts-check: OK — version unchanged ($HEAD_VERSION) between the fork point and $HEAD_REF — not a release PR; nothing to assert"
  exit 0
fi
V="$HEAD_VERSION"

# Captured ONCE, into a variable. Never `git diff … | grep -q`: `grep -q` exits on the first
# match and SIGPIPEs the writer, which under `pipefail` surfaces as rc 141 — i.e. a MATCH
# reading as a failure. Every membership test below is a shell `case`, so no subprocess and
# no pipeline is involved in answering "did this path move".
#
# `core.quotePath=false` is load-bearing, not tidiness: by default git C-quotes any path
# containing a non-ASCII byte (`"docs/caf\303\251.md"`), which matches no declared member, so
# a member that DID move is reported "not moved" — a false failure carrying a wrong diagnosis.
# The `git show`/`cat-file` reads below take the path verbatim and are unaffected.
CHANGED="$(git -c core.quotePath=false diff --name-only "$BASEREF" "$HEAD_REF")" \
  || die "cannot diff '$BASE'...'$HEAD_REF' — the caller must check out with fetch-depth: 0"

# _expand_braces <spec> — one path per line, expanding a single-level `{a,b,c}` comma set.
# Deliberately NOT a glob: the members of a release set are DECLARED, so a path that does not
# yet exist must still be asserted (that is the whole point) — a glob would silently expand
# to nothing and take the check green on the missing member.
#
# It never calls `die`, and that is structural rather than stylistic: the caller consumes it
# through a process substitution, whose `exit` unwinds only the SUBSHELL — the message would
# print and the script would carry on with the member silently dropped. The emptiness verdict
# is therefore the CALLER's, taken in the main shell (see the `paths` array below).
#
# SINGLE-LEVEL, FIRST-BRACE-ONLY, and every pathological input FAILS LOUD rather than
# expanding oddly in silence — which is why neither is defended against beyond this note:
#   * `post` is everything after the FIRST `}`, so `a{b,c}d}e` yields `abd}e` / `acd}e` and a
#     second brace set is not expanded. Such a path will not exist at head and is reported as
#     a missing member, naming the path it actually looked for.
#   * `read -a` keeps a LEADING empty field but DROPS a trailing one (measured: `,x` ⇒ 2
#     alternatives, `x,` ⇒ 1), so `v{,a}.json` expands to two members and `v{a,}.json` to one.
#     The asymmetry is bash's, not this function's; a member lost to it is a member never
#     asserted, so the count on the summary line is the place it shows.
#   * a literal `{}` yields zero alternatives, which the caller turns into a rc-2 refusal.
_expand_braces() {
  local s="$1" pre post alts_str a
  local -a alts
  case "$s" in
    *'{'*'}'*)
      pre="${s%%\{*}"
      alts_str="${s#*\{}"; alts_str="${alts_str%%\}*}"
      post="${s#*\}}"
      IFS=, read -r -a alts <<<"$alts_str"
      for a in "${alts[@]}"; do printf '%s%s%s\n' "$pre" "$a" "$post"; done
      ;;
    *) printf '%s\n' "$s" ;;
  esac
}

FAILED=0
MEMBERS=0

while IFS= read -r raw; do
  [ -n "$raw" ] || continue
  expanded="${raw//\{\{version\}\}/$V}"
  # The path spec is the LEADING whitespace-delimited token; everything after it is prose
  # describing what the member must carry (`→ {{version}}`, `§ Recent releases row`).
  spec="${expanded%%[[:space:]]*}"
  # A leading-whitespace entry yields an empty spec, which would assert nothing and be
  # counted as nothing — the declared member would vanish with no signal.
  [ -n "$spec" ] || die "artifact entry has no leading path token: '$raw'"

  # Materialized in the MAIN shell before any assertion runs, so an entry that expands to no
  # path at all (a literal `{}`) is a loud config error rather than a member silently dropped
  # from both the assertions and the count — this tool's own defect class one layer up.
  # Boundary validation, not defensive coding: the input is a hand-edited config file.
  paths=()
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    paths+=("$p")
  done < <(_expand_braces "$spec")
  [ "${#paths[@]}" -gt 0 ] || die "artifact path '$spec' expands to no member (an empty brace set?) — declared as: $raw"

  for p in "${paths[@]}"; do
    MEMBERS=$((MEMBERS + 1))
    member_failed=0

    # (a) MOVED — an exact line of the captured diff.
    case $'\n'"$CHANGED"$'\n' in
      *$'\n'"$p"$'\n'*) ;;
      *) echo "::error::release artifact not moved: '$p' is absent from this PR's own changes ($BASE...$HEAD_REF) (declared as: $raw)"
         member_failed=1;;
    esac

    # (b) EXISTS at HEAD — a DELETION also appears in the diff, so (a) alone would pass it.
    if git cat-file -e "$HEAD_REF:$p" 2>/dev/null; then
      # (c) AGREES — read from the commit, never the working tree: the working tree is not
      # necessarily the head commit (a runner may have a dirty or differently-checked-out tree).
      content="$(git show "$HEAD_REF:$p" 2>/dev/null || true)"
      # WHICH ARM was taken is reported on the OK line, and that is a correctness feature, not
      # cosmetics. The strong arm is selected by a magic substring in FREE PROSE, so a prose
      # edit ('… entry', '… heading') silently DOWNGRADES the member to the weak
      # content-mention arm — and before the arm was named, a downgraded pass was
      # byte-identical to a strong one, so the loss of assertion strength was invisible in the
      # CI log. Naming the arm is what makes a downgrade legible without guessing at synonyms.
      #
      # The selector is matched case-INSENSITIVELY (`${raw,,}`, ASCII-only under LC_ALL=C).
      # Synonyms are deliberately NOT accepted: every extra spelling widens what silently
      # TRIGGERS the strong arm, and the legibility above is the general fix — a reader who
      # wrote 'entry' sees `via content mention` on the OK line and corrects the prose.
      raw_lc="${raw,,}"
      case "$raw_lc" in
        *'[{{version}}] section'*)
          # A LINE beginning `## [<version>]`. Matched as a FIXED STRING against a
          # newline-prefixed copy rather than as `^## \[$V\]`: the dots in a version are regex
          # metacharacters, so an unescaped `0.1.2` would also match `0x1x2`. The leading
          # $'\n' is the left anchor — without it an inline mid-line mention ('see ## [0.1.2]
          # below') would satisfy a check that claims to be about a heading LINE.
          arm="via '## [$V]' heading line"
          case $'\n'"$content" in
            *$'\n'"## [$V]"*) ;;
            *) echo "::error::release artifact does not agree: '$p' at $HEAD_REF has no line beginning '## [$V]' (declared as: $raw)"
               member_failed=1;;
          esac;;
        *)
          case "$p" in
            *"$V"*) arm="via version-bearing path" ;;  # e.g. sboms/vX.Y.Z.json
            *) arm="via content mention"
               # DISCLOSED WEAKNESS: an UNANCHORED substring test. With V=0.25.0 a file
               # containing only `10.25.0` (or `0.25.01`) satisfies this arm. It is the
               # catch-all for members whose agreement has no structure to key on (a table
               # row, a prose line), where there is nothing to anchor to — so the arm is
               # deliberately weak rather than accidentally so, and `docs/INSTALL.md` §4
               # states the same limit to the person writing the declaration. A member that
               # needs a real assertion should declare the `[{{version}}] section` shape.
               case "$content" in
                 *"$V"*) ;;
                 *) echo "::error::release artifact does not agree: '$p' at $HEAD_REF does not contain the version being shipped ($V) (declared as: $raw)"
                    member_failed=1;;
               esac;;
          esac;;
      esac
    else
      echo "::error::release artifact missing at head: '$p' does not exist at $HEAD_REF (deleted or renamed?) (declared as: $raw)"
      member_failed=1
    fi

    if [ "$member_failed" -eq 0 ]; then
      echo "release-artifacts-check: OK — $p moved, exists at $HEAD_REF, agrees with $V $arm"
    else
      FAILED=$((FAILED + 1))
    fi
  done
done < <(jq -r '.artifacts[]' "$CONFIG")

if [ "$FAILED" -gt 0 ]; then
  echo "release-artifacts-check: $FAILED of $MEMBERS artifact member(s) failed" >&2
  exit 1
fi
echo "release-artifacts-check: all $MEMBERS declared artifact member(s) moved and agree with $V"
exit 0
