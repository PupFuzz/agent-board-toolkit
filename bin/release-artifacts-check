#!/usr/bin/env bash
# release-artifacts-check — assert that every artifact a repo DECLARES as part of its
# release set actually moved in a release PR, against the set DECLARED AT THE FORK POINT.
#
# `.release-pr.json`'s `artifacts` array is the explicit must-move-together release set.
# Until this tool existed its only consumer was `release-pr-body`, which PRINTS it as a
# `- [ ]` checklist — a printer is not an asserter, so a member left behind shipped in
# silence. A guard that reads a proper SUBSET of a must-move-together file set cannot fail
# on the member it never reads; this one reads the whole declared set and fails on any
# member that did not move, no longer exists, or does not carry the version being shipped.
#
# A PR UNDER REVIEW MUST NOT BE ABLE TO WEAKEN THE VERDICT IT IS JUDGED BY. The declared
# set and the release-PR classification keys are both editable in the same PR the gate is
# judging, so a head-only read lets a PR narrow — or switch off — its own gate:
#   * delete an `artifacts` entry and the member it named is never asserted again, and from
#     the next release the fork point no longer carries it either: a permanent, silent
#     narrowing that leaves no trace in any CI log;
#   * retarget `version_file`/`version_regex` at a constant and every release PR classifies
#     as "version unchanged" — a silent non-run of the whole gate.
# So the VERDICT SURFACE IS READ FROM THE FORK POINT, which the PR cannot edit:
#   * `version_file` / `version_regex` come from the fork-point config. Head's retarget is
#     IGNORED rather than refused, so this leg has no false-positive surface at all.
#   * `artifacts` is read at BOTH ends. Head may only WIDEN the set. A member declared at
#     the fork point and absent from head is `LOST` and fails IN ITS OWN RIGHT — whether or
#     not that member's own legs would have passed, and on EVERY PR class, release or not
#     (a classification-gated severity would be bought back by poisoning the version file).
#   * the one narrowing channel is explicit: list the member in an optional
#     `retired_artifacts` array — PR-declared, read at head, and printed as a `RETIRED:`
#     line in the CI log. A member in BOTH arrays is a config error (rc 2), so a tombstone
#     cannot be pre-planted against a member that is still declared.
# The CORRELATION keys are head-read too, but they are no longer unguarded (card#8538): a
# config that declares a `.promote` block must declare `promote.source`, `ref_token_regex` and
# `card_token_regex`, or name the missing one in a `unset_correlation_keys` array. Absent, they
# fail SILENTLY downstream — `release-pr-body` emits a 0-id `shipped-cards` manifest at rc 0
# under the line "All shipped refs have a tracking card" — and a silent zero is the one shape a
# release gate must not have. Head-read and NOT fork-point-read, for the reason stated at the
# leg. Everything else in the config (`promote.board_id`, `api_base`, branch names) still
# stays head-read and unguarded: none of it decides a verdict here.
#
# ⛔ `version_extract_cmd` IS NOT READ HERE, AND MUST NOT BE. `release-pr-body` grew that key
# (card#7599) because a version declared INSIDE a code file has to be matched with its
# surrounding context, so the match is not the value; the key names a script in the repo and
# takes its stdout. Two independent reasons it stops at that tool's door:
#   * IT CANNOT ANSWER THIS QUESTION. The classification compares the version value AT TWO REFS,
#     read with `git show <ref>:<file>` and never from the working tree. A command can only
#     report on the checkout it runs in, so it would return one value for BOTH ends — and every
#     release PR would then classify as "version unchanged" and assert no member.
#   * IT WOULD HAND THE PR THE VERDICT. This runs on `pull_request` over an untrusted head, and
#     the fork-point design above exists precisely so the PR being judged cannot steer its own
#     gate. Executing a config-named script out of that head is arbitrary code execution by the
#     PR author inside the judging job — a strictly larger hole than the retarget just refused.
# The two keys answer two different questions, and version_regex is right for THIS one: a regex
# that matches its context still classifies correctly, because all this tool asks of it is
# equal-vs-changed. It is only as a DISPLAY value that the same match is unusable.
#
# COMPARISON IS ON EXPANDED, VERSION-AGNOSTIC MEMBERS, not on entry strings: `{{version}}`
# is replaced by a sentinel (never by a concrete version — otherwise every templated member
# would read as removed at every release, since the two ends carry different versions), the
# leading path token is taken, and a `{a,b}` brace set expands to one unit per alternative.
# Adding an alternative is therefore a widening (rc 0), dropping one names that alternative,
# and reordering a brace set is a no-op.
#
# THE CONFIG IS READ FROM COMMITS, NEVER FROM THE WORKING TREE — `git show <ref>:<path>` at
# the resolved fork-point and head SHAs. On a `pull_request` event the checkout is the MERGE
# ref, so a tree read would answer about a merge no one wrote. A config that exists only in
# the checkout and is not committed at head is refused (rc 2); a config committed at head
# but absent from the checkout is fine.
#
# Usage:
#   release-artifacts-check --base <ref> --head <ref> [--config PATH] [--classify-only]
#
#   --base   the PR's base commit/ref (e.g. github.event.pull_request.base.sha)
#   --head   the PR's head commit/ref (e.g. github.event.pull_request.head.sha)
#   --config per-repo release config (default `.release-pr.json`), inside this repository
#   --classify-only  answer ONLY "is this range a release?" and assert no artifact member.
#                    version_file/version_regex are REQUIRED in this mode even by a repo that
#                    declares no artifacts: they are what the answer is computed from, and the
#                    empty-`artifacts` opt-out below is an opt-out of the artifact LEGS, not of
#                    the classification. A config lacking them is rc 2 here, never "not-release".
#
# `--classify-only` EXISTS SO THE RULE HAS ONE IMPLEMENTATION, NOT TWO (card#6579). The
# release-VALUE test below — the fork-point version against head's, INCLUDING the arm that
# re-decides an EQUAL classifying value (card#6488) — is the repo's definition of
# "this range is a release", and a second consumer needed it: `release-tag-check` asserts
# post-merge that the release's tag actually exists, and must not assert on a non-release push.
# Re-deriving "is this a release" there would have been a second rule free to drift from this
# one, so the existing rule is EXPOSED instead. The mode prints one machine-readable line —
# `release <version>` or `not-release <version>` — and exits 0 for both, because "not a
# release" is an ANSWER, not a failure. Every refusal path (rc 2) is unchanged and still
# fail-closed: a range this tool cannot classify must never read as "not a release". The mode
# answers from the SAME variable the artifact legs are judged by, decided before either is
# answered, so the two consumers cannot disagree about what a release is.
#
# The mode deliberately SKIPS the artifact legs rather than running and ignoring them. They
# carry their own verdicts (a LOST member exits 1 on every PR class), so a classifier that ran
# them would report an artifact failure as a classification failure to a caller asking a
# different question entirely.
#
# THE RANGE IS `merge-base(base, head)..head` — the PR's OWN changes — never base's tip.
# Both are resolved against the MERGE BASE, and that is a correctness requirement, not a
# refinement: base-branch drift after the fork point corrupts both halves otherwise.
#   * the MOVED leg: a hotfix landing on base after the fork makes that file differ between
#     base's tip and head, so it appears in a two-dot diff and spuriously satisfies "moved"
#     for a member THIS PR never touched;
#   * the CLASSIFICATION: a version bump landing on base after the fork makes base's tip
#     read the same version as head, so a real release PR is classified "version unchanged"
#     and the entire gate silently does not run.
#
# Release-PR classification is BY VERSION VALUE, not by "the version file appears in the
# diff": a repo may point `version_file` at a whole config file (kanban's is
# `config/app.php`), where a file-moved test would misfire on any unrelated edit to it.
# Merge-base version == head version ⇒ not a release PR ⇒ no member is asserted — but a
# narrowed declaration is still refused, because that check never reads the classification.
#
# AND THE CLASSIFYING VALUE IS THE FIRST REGEX MATCH OVER CONTENT HEAD OWNS, so "equal" is not
# on its own an answer (card#6488). A version-shaped line above the version line makes both
# ends extract the same value and a real release PR read as "version unchanged": one prepended
# comment, no config edit, and every member leg silently does not run. The unsteerable half is
# the fork point's SET of matched values, and a real release must introduce a value there that
# head carries and the fork point does not. So on an equal classifying value the two sets are
# compared: exactly one value new at head NAMES the version being shipped and the PR is a
# release after all (`::warning::`, then every member asserted against that value); more than
# one is rc 2, because which version is being shipped is then genuinely unknown; none is the
# ordinary unchanged verdict. A value the fork point carries and head drops is a deletion, not
# a release, and does not enter the test.
#
# NO FORK-POINT CONFIG (the adoption PR that CREATES it, a config renamed since, an
# unparseable or key-less one) is a WARN, never a refusal: those keys can only enter the
# fork point through a merged release, so refusing would deadlock a repo that cannot then
# release. The run says so on a `::warning::` line, falls back to head's classification
# keys, and compares against an empty baseline — i.e. exactly today's head-only behaviour.
# The same rule holds PER ENTRY: a malformed entry read from the fork point (no leading path
# token, an empty brace set, a reserved sentinel) is warned about and dropped from the
# baseline, while the same entry at head is rc 2. Otherwise the PR that REPAIRS such an entry
# — by deleting it — is redded by the entry it is deleting, and the repair can never land.
#
# A DECLARED MEMBER MUST BE A REGULAR FILE. The member's type at head is read from one
# `git ls-tree` mode, because the content reads are answerable — wrongly — for three other
# object types: `git show <ref>:<symlink>` yields the TARGET PATH string, `<ref>:<dir>` a
# tree listing, and `<ref>:<gitlink>` a commit log when that commit happens to be in this
# store. Each of those can satisfy a content assertion while asserting nothing about a
# release artifact, so each is named and refused rather than read.
#
# Exit status: 0 = nothing to assert, every declared member passed, or (under
# `--classify-only`) the range was classified either way. 1 = at least one
# member failed, or a declared member was removed without acknowledgement (every failure is
# reported, not just the first). 2 = usage/config error, an unresolvable merge base, a
# config not committed at head, a member declared in both `artifacts` and
# `retired_artifacts`, a `.promote`-declaring config missing (or mis-typing) a correlation key
# it did not acknowledge in `unset_correlation_keys`, a version that could not be read at
# either end, or a version file whose
# classifying match is unchanged while it carries SEVERAL values head introduced (the version
# being shipped is then unknown) — none of these is EVER classified as "not a release PR",
# because that misclassification is a silent non-run of the whole gate rather than a pass.
set -euo pipefail
# Pinned so version extraction and the fixed-string matching below mean the same thing on
# every runner: a bracket range is a COLLATION range, and en_US.UTF-8 widens `[0-9]` to
# non-ASCII digits (card#5409). Exported so the `grep`s inherit it, not just this shell.
export LC_ALL=C

die() { echo "release-artifacts-check: $*" >&2; exit 2; }
command -v jq  >/dev/null || die "jq is required"
command -v git >/dev/null || die "git is required"

# require_value <flag> <value>: die unless a value-taking option was given a non-empty
# value. An option that consumes "$2" and is then dispatched with `[ -n "$var" ]` reads an
# explicitly-EMPTY value as an ABSENT flag, so `--flag ""` silently selects the default path
# instead of doing what was asked — here `--config ""` would fall back to `.release-pr.json`,
# reading a DIFFERENT repo's declared set than the caller named. Also converts a trailing
# flag with no argument from a bare `set -u` unbound-variable error into one naming the flag.
# Mirrors kb_require_value in _kb-board-lib.sh — like the two release siblings, this script
# is self-contained and does not source that lib, so the guard is duplicated; keep them in sync.
require_value() { [ -n "${2:-}" ] || die "$1 requires a non-empty value"; }

CONFIG=".release-pr.json"; BASE=""; HEAD_REF=""; CLASSIFY_ONLY=0
while [ $# -gt 0 ]; do
  case "$1" in
    --base)   require_value "$1" "${2:-}"; BASE="$2"; shift 2;;
    --head)   require_value "$1" "${2:-}"; HEAD_REF="$2"; shift 2;;
    --config) require_value "$1" "${2:-}"; CONFIG="$2"; shift 2;;
    --classify-only) CLASSIFY_ONLY=1; shift;;
    # Contiguous leading comment block, not a fixed range — a fixed `sed -n '2,20p'` is
    # silently wrong in both directions as the header grows or shrinks (card#5145).
    -h|--help) awk 'NR>1 { if (substr($0,1,1) == "#") print; else exit }' "$0"; exit 0;;
    *) die "unknown arg '$1'";;
  esac
done

[ -n "$BASE" ]     || die "--base <ref> is required"
[ -n "$HEAD_REF" ] || die "--head <ref> is required"

# --config is CWD-relative (that is what `-f` answers). A `git show "$REF:$path"` is
# ROOT-relative UNLESS the path begins `./` or `../`, which git resolves against the CWD — so
# from a subdirectory a bare `--config cfg.json` and its blob read name DIFFERENT files, while
# a `../cfg.json` spelling happens to agree. The path is therefore normalized to root-relative
# ONCE, here, and only that spelling is used for every blob read below; relying on the
# agreeing spelling would be relying on the caller's punctuation.
#
# The rc of `rev-parse` is captured, and that is load-bearing rather than tidy: on a
# directory outside any repository it exits 128 with EMPTY stdout, so an unguarded `$( )`
# would compose `"" + "$(basename …)"` and silently read THIS repo's own root config as the
# baseline for a config the caller pointed somewhere else entirely.
#
# AND AN rc IS NOT ENOUGH, because the same silent re-rooting happens one step out: a
# directory inside a DIFFERENT repository answers at rc 0, with a prefix that is root-relative
# to THAT repository — which every read below then applies to THIS repository's refs. So
# `--config ../other-clone/.release-pr.json` would be answered by this repo's own root config:
# not a refusal and not the caller's file, but a confident verdict about the wrong one. The
# two toplevels are therefore compared, and a mismatch is refused by name.
#
# `--show-toplevel` is the call whose rc is captured, not `--show-prefix`, because it is the
# one that discriminates: in a BARE repository `--show-prefix` succeeds (rc 0, empty) while
# `--show-toplevel` exits 128 — so guarding the prefix alone would let a config inside a bare
# repo's directory through to be re-rooted here. Once a toplevel is in hand the work tree is
# established, which is what makes the prefix read below safe without its own guard.
#
# STATED BOUND: this resolves the config's DIRECTORY in the checkout, so a `--config` whose
# directory exists at head but not in the checkout is refused here rather than rescued by the
# not-in-the-checkout fallback below. Rescuing it would need a second normalization path
# (that fallback consumes this function's output), so the refusal names the directory.
CONFIG_DIR="$(dirname "$CONFIG")"
CONFIG_TOPLEVEL="$(git -C "$CONFIG_DIR" rev-parse --show-toplevel 2>/dev/null)" \
  || die "--config '$CONFIG': its directory '$CONFIG_DIR' does not resolve inside a git repository's working tree — the config must live in the repository whose refs are being compared, and its directory must exist in the checkout"
REPO_TOPLEVEL="$(git rev-parse --show-toplevel 2>/dev/null)" \
  || die "this must run inside the working tree of the repository whose refs are being compared, and '$PWD' is not in one"
[ "$CONFIG_TOPLEVEL" = "$REPO_TOPLEVEL" ] \
  || die "--config '$CONFIG' resolves inside a DIFFERENT repository ('$CONFIG_TOPLEVEL') from the one whose refs are being compared ('$REPO_TOPLEVEL') — every config read here is a blob read against THIS repository's refs, so a foreign path would be re-rooted and the run would answer about this repository's own config instead of the one named"
CONFIG_ROOTREL="$(git -C "$CONFIG_DIR" rev-parse --show-prefix)$(basename "$CONFIG")"

# The config may legitimately be absent from the CHECKOUT while present at head: every read
# below is a blob read, and the checkout is not necessarily head (on a `pull_request` event
# it is the merge ref). Refusing on the tree alone diagnosed such a repo as having "no config
# in this repo", which is false. The tree is checked first only because it is the cheap arm.
if [ ! -f "$CONFIG" ] && ! git cat-file -e "$HEAD_REF:$CONFIG_ROOTREL" 2>/dev/null; then
  die "no $CONFIG in this repo — not in the working tree, and not committed at head '$HEAD_REF' (per-project config — see examples/release-pr.json.example for the shape)"
fi

# The fork point, resolved once and used for the config reads, the version read and the diff
# (see the header). Fail-closed: an unresolvable merge base means the two refs share no
# history this clone can see, which is a refusal — never a "not a release PR" pass. It is
# resolved BEFORE the opt-out test, because the opt-out itself is now a question about the
# fork point's declared set as well as head's.
BASEREF="$(git merge-base "$BASE" "$HEAD_REF" 2>/dev/null)" \
  || die "cannot resolve the merge base of '$BASE' and '$HEAD_REF' (no common ancestor in this clone) — the caller must check out with fetch-depth: 0 so the fork point is present; refusing rather than classifying this as 'not a release PR'"

# Emptiness is tested through the same call, not beside it: `jq .` exits 0 on EMPTY input and
# prints nothing, so a status-only test reads an empty committed config as valid JSON and the
# object check then reports its type as the empty string — a refusal that names nothing.
# A config whose content is literally `null` still prints `null` here, so it stays a SHAPE
# error diagnosed by the object check rather than mis-named a syntax error.
#
# BOTH the status AND the output are tested, and the conjunction is what makes these correct.
# An output-only test is wrong on a PARSE-THEN-ERROR blob (`{…} trailing junk`): jq PRINTS the
# leading value and THEN dies rc 5, so the output is non-empty and the type reads `object`,
# both guards pass — and the first `_cfg` read afterwards dies on the same input, surfacing as
# the script's own rc 5 with a raw jq traceback where the header promises rc 2. On the FORK
# side that is worse still: an rc no PR can fix, since the fork point is a merged commit.
# A status-only test is wrong on EMPTY input for the reason above; the conjunction is neither.
_json_parses() {
  local out
  out="$(printf '%s\n' "$1" | jq -c . 2>/dev/null)" || return 1
  [ -n "$out" ]
}
_json_type() {
  local out
  out="$(printf '%s\n' "$1" | jq -r 'type' 2>/dev/null)" || return 1
  printf '%s\n' "$out"
}
# _cfg <filter> <config-content> — a read from an ALREADY-VALIDATED top-level object. The
# object check at the boundary is what makes every `.key` read below safe: `.artifacts` on an
# array/string/number top level is a jq RUNTIME error (rc 5) that `set -e` would surface as
# the script's own exit status — an undocumented rc plus a raw traceback where the header
# promises rc 2. One guard at the boundary beats `|| die` written at N call-sites.
_cfg() { printf '%s\n' "$2" | jq -r "$1"; }

# --- head config: the asserted set, the retirements, and the shape validation -------------
HEAD_CFG="$(git show "$HEAD_REF:$CONFIG_ROOTREL" 2>/dev/null)" \
  || die "$CONFIG_ROOTREL is not committed at head '$HEAD_REF' — this check reads the config from the COMMIT, not the working tree, so a copy that exists only in the checkout is not the one the PR proposes; commit it on the PR branch"

# `jq .` (not `jq -e .`) does the parse leg, because `-e` also fails on a valid config whose
# content is literally `null` — which is a SHAPE error, and is reported as one by the object
# check rather than mis-diagnosed as a syntax error.
_json_parses "$HEAD_CFG" \
  || die "$CONFIG_ROOTREL at $HEAD_REF is not valid JSON (a trailing comma, or an empty file?)"
[ "$(_json_type "$HEAD_CFG")" = "object" ] \
  || die "$CONFIG_ROOTREL at $HEAD_REF parses but is not a JSON object at the top level (it is $(_json_type "$HEAD_CFG")) — it must be an object of config keys; see examples/release-pr.json.example"

# OPT-OUT and MALFORMED are different verdicts and must not share a branch. An absent/null or
# EMPTY `artifacts` is a repo that never opted in — nothing to assert, reported rather than
# silent so a repo that MEANT to declare a set can see that it did not. Any OTHER type
# (object, string, number, boolean) is a malformed declaration: printing "no artifacts
# declared" there would be a false statement about the config, and would silently disable the
# gate for a repo that plainly intended to enable it. The opt-out VERDICT is taken further
# down, on the union of both ends — head alone would let a wholesale deletion opt itself out.
HEAD_ARTIFACTS_TYPE="$(_cfg '.artifacts | type' "$HEAD_CFG")"
case "$HEAD_ARTIFACTS_TYPE" in
  null|array) ;;
  *) die "$CONFIG_ROOTREL at $HEAD_REF has .artifacts of type '$HEAD_ARTIFACTS_TYPE' — it must be an array of strings (omit the key entirely to opt out)";;
esac
# Same guard on the retirement channel, and for a sharper reason: an unguarded `.[]` over a
# string is a jq runtime error swallowed by the `while read` that consumes it, so the whole
# retirement/tombstone comparison would run against an EMPTY set — the guard silently off,
# with a raw traceback as the only sign.
HEAD_RETIRED_TYPE="$(_cfg '.retired_artifacts | type' "$HEAD_CFG")"
case "$HEAD_RETIRED_TYPE" in
  null|array) ;;
  *) die "$CONFIG_ROOTREL at $HEAD_REF has .retired_artifacts of type '$HEAD_RETIRED_TYPE' — it must be an array of strings (omit the key entirely if nothing has been retired)";;
esac

# --- correlation keys: the DECLARE half of the promote seam (card#8538) --------------------
# WHY THIS LEG EXISTS. The three keys below are what makes a release PR's card manifest, and
# the post-merge promote run, correlate to anything at all — and until this leg they were
# exactly what this file's header (above) still called "head-read and unguarded: none of it
# decides a verdict". That was true of THIS tool and false of the release: a config that omits
# `card_token_regex` makes `release-pr-body` emit a 0-id `shipped-cards` manifest AT RC 0 and
# print "All shipped refs have a tracking card" — a clean line asserting coverage that was
# never measured (measured on two consumer repos: card#8423 / card#8538). A silent zero is the
# one failure shape a release gate must not have.
#
# THE TRIGGER IS `.promote`, NOT `artifacts`. A repo that declares a `promote` block has
# declared that its releases move board cards; the correlation keys are what that promotion
# reads, so their absence is a gap IN THAT REPO'S DECLARATION. A config with no `promote`
# block has not made that claim — it correlates nothing on purpose, no manifest is expected of
# it, and requiring the keys there would be ceremony for a repo the class cannot reach. The
# trigger is therefore the claim, never the artifact set: this leg runs BEFORE the artifacts
# opt-out below, because `artifacts` and `promote` are independent declarations and a repo that
# opted out of the artifact legs still promotes.
#
# HEAD ONLY, unlike the artifact set. The fork-point read upstream exists because `artifacts`
# is a set the PR could NARROW to weaken its own verdict; there is no narrowing to catch here —
# deleting a correlation key is what this leg REDS on, and reading the fork point would instead
# red every consumer's next PR for a key their already-merged config never had. The one
# acknowledged-absence channel is explicit and PR-declared, exactly like `retired_artifacts`.
#
# ⛔ THE `promote.source` ACCEPT SET IS NOT RE-IMPLEMENTED HERE, and that is a decision, not an
# omission. `bin/promote-released-cards` owns that predicate (a shape `case` plus
# `src_charset_ok`), `kb_is_repo_slug` in `bin/_kb-board-lib.sh` is its one declared duplicate,
# and the two DIVERGED in service on the `.GIT` casing — measured, card#8421 — which is why
# `tests/promote-source-qualify-selftest.sh` § 3c now drives one corpus through both. A THIRD
# copy here would buy a shift-left on a failure that is already LOUD (promote refuses rc 2 and
# names the fix) at the price of a false red on every PR the day the copies disagree. What this
# leg asserts is the half that is SILENT: the key is there, it is a non-empty string, and — for
# the two regexes, which are fed to `grep -oiE` under a `|| true` that swallows a compile
# error into an empty manifest — that it COMPILES. A well-shaped but WRONG slug is caught where
# it can actually be measured: `promote-released-cards` compares the resolved source against
# $GITHUB_REPOSITORY (card#8538, the CHECK half of this same seam).
if [ "$CLASSIFY_ONLY" -eq 0 ]; then
  HEAD_UNSET_TYPE="$(_cfg '.unset_correlation_keys | type' "$HEAD_CFG")"
  case "$HEAD_UNSET_TYPE" in
    null|array) ;;
    *) die "$CONFIG_ROOTREL at $HEAD_REF has .unset_correlation_keys of type '$HEAD_UNSET_TYPE' — it must be an array of key names (omit the key entirely if every correlation key is declared)";;
  esac
  # A non-string member would reach the membership `case` below rendered by jq (a number as
  # its digits, an object as JSON) and be refused there with a message about a key name that
  # is not what the operator wrote. Typed at the boundary instead, once.
  NONSTR="$(_cfg '[.unset_correlation_keys // [] | .[] | select(type != "string")] | length' "$HEAD_CFG")"
  [ "$NONSTR" = 0 ] \
    || die "$CONFIG_ROOTREL at $HEAD_REF has $NONSTR non-string entr(y/ies) in .unset_correlation_keys — every member must be one of the key NAMES: promote.source, ref_token_regex, card_token_regex"
  declare -A UNSET_KEY=()
  while IFS= read -r _k; do
    case "$_k" in
      promote.source|ref_token_regex|card_token_regex) UNSET_KEY["$_k"]=1;;
      "") die "$CONFIG_ROOTREL at $HEAD_REF has an EMPTY entry in .unset_correlation_keys — name the key being declared absent: promote.source, ref_token_regex or card_token_regex";;
      *) die "$CONFIG_ROOTREL at $HEAD_REF lists '$_k' in .unset_correlation_keys, which is not a correlation key — the three are promote.source, ref_token_regex and card_token_regex. A misspelling here acknowledges NOTHING: the key it was meant to name is still required, and this array is the only place the acknowledgement is read";;
    esac
  done < <(printf '%s\n' "$HEAD_CFG" | jq -r '(.unset_correlation_keys // []) | .[]')

  HEAD_PROMOTE_TYPE="$(_cfg '.promote | type' "$HEAD_CFG")"
  case "$HEAD_PROMOTE_TYPE" in
    null|object) ;;
    *) die "$CONFIG_ROOTREL at $HEAD_REF has .promote of type '$HEAD_PROMOTE_TYPE' — it must be an object (board_id, released_stage_id, api_base, source); omit the key entirely if this repo promotes no cards";;
  esac
  if [ "$HEAD_PROMOTE_TYPE" = object ]; then
    # <jq path> <reader> <what it buys> <what its ABSENCE does> — one row per key, and the
    # READER is named in every message because "add card_token_regex" is not actionable without
    # knowing which tool went quiet. The rows are the population this leg covers; there is no
    # second list of them.
    #
    # THE FOURTH FIELD IS NOT DECORATION. The two token keys go silent when absent; `promote.source`
    # does the opposite — `promote-released-cards` REFUSES at rc 2, because that key has been
    # required with no default since card#8421. One shared sentence would therefore be FALSE of one
    # of the three, and it is the UNSET line where that matters most: an operator acknowledging
    # `promote.source` absent has to be told that the acknowledgement silences THIS check and not
    # that refusal, or they will read a green gate as "promotion is configured".
    while IFS='|' read -r _key _reader _buys _absent; do
      _type="$(_cfg ".${_key} | type" "$HEAD_CFG")"
      if [ "$_type" = null ]; then
        [ -z "${UNSET_KEY[$_key]:-}" ] \
          || { echo "release-artifacts-check: UNSET: $_key — declared absent in .unset_correlation_keys at head. $_reader reads it to $_buys. $_absent"; continue; }
        die "$CONFIG_ROOTREL at $HEAD_REF declares a .promote block but no $_key. $_reader reads it to $_buys. $_absent Declare the key, or acknowledge the gap by name: add \"$_key\" to a top-level \"unset_correlation_keys\": [] array in this PR, which is logged as an UNSET: line instead of failing"
      fi
      [ -z "${UNSET_KEY[$_key]:-}" ] \
        || die "$CONFIG_ROOTREL at $HEAD_REF declares $_key AND lists it in .unset_correlation_keys — a key cannot be both declared and acknowledged absent; remove it from one of the two (the acknowledgement is a tombstone, and a tombstone standing over a live key acknowledges the NEXT deletion of it in advance, with nothing reporting the narrowing)"
      [ "$_type" = string ] \
        || die "$CONFIG_ROOTREL at $HEAD_REF has $_key of type '$_type' — it must be a string ($_reader reads it to $_buys)"
      _val="$(_cfg ".${_key}" "$HEAD_CFG")"
      [ -n "${_val//[[:space:]]/}" ] \
        || die "$CONFIG_ROOTREL at $HEAD_REF has $_key set to '$_val', which is empty or whitespace only — byte-identical to omitting it. $_reader reads it to $_buys, and an empty value does none of that. Give it a value, or acknowledge the gap by name in .unset_correlation_keys"
      # The two token keys are handed STRAIGHT to `grep -oiE` by their readers, under a
      # `|| true` that turns a compile failure into an empty match set — i.e. into the same
      # silent 0-id manifest this leg exists to catch, from a key that is present and looks
      # set. Compiled here with the readers' own flags. `printf ''` feeds no input, so this
      # asks the one question it means to: rc >1 is a bad regex, rc 1 is "compiled, matched
      # nothing", and rc 1 is a pass.
      case "$_key" in
        *_token_regex)
          _rc=0; printf '' | grep -oiE "$_val" >/dev/null 2>&1 || _rc=$?
          [ "$_rc" -le 1 ] \
            || die "$CONFIG_ROOTREL at $HEAD_REF has $_key = '$_val', which grep -E cannot compile — $_reader pipes it straight into \`grep -oiE\` behind a \`|| true\`, so an uncompilable regex does not fail: it matches nothing and yields an EMPTY manifest at rc 0"
          ;;
      esac
    done <<'ROWS'
promote.source|bin/promote-released-cards|qualify a matched card against the repo this release ships (dl_number/pr_number are REPO-SCOPED counters, so an unqualified match promotes another repo's cards into a terminal stage)|Absent, that tool REFUSES AT RC 2 rather than going quiet — the key is required there with no default — so acknowledging it here silences THIS check and not that refusal: your post-merge promote job still reds.
ref_token_regex|bin/release-pr-body (and bin/promote-released-cards)|build the shipped-refs manifest and the ## Card coverage section, correlated against a card's payload.dl_number|Absent, none of that happens SILENTLY, at rc 0: the manifest footer is simply omitted, which reads exactly like a range that legitimately had nothing to say.
card_token_regex|bin/release-pr-body|build the shipped-cards manifest and the ## Card coverage section, correlated against the card's own id|Absent, none of that happens SILENTLY, at rc 0: the body emits a 0-id manifest under the line "All shipped refs have a tracking card", asserting coverage nothing measured.
ROWS
  fi
fi

# --- fork-point config: the baseline the PR may not edit ----------------------------------
# NOTHING READ FROM THE FORK POINT EVER PRODUCES rc 2. The fork point is a MERGED commit: a
# refusal there is an rc no PR can fix, because the only way to change it is to merge a release
# the gate would be redding. The disposition is warn-and-exclude at both granularities, and
# they are different exclusions rather than one rule stated twice:
#   * the CONFIG is unusable (absent, unparseable, not an object, `.artifacts` not an array) ⇒
#     one warning, an EMPTY baseline, and head's classification keys — below;
#   * a single ENTRY is unusable (no leading path token, an empty brace set, a reserved
#     sentinel) ⇒ one warning naming that entry, which is dropped from the baseline while its
#     siblings still compare — in `_paths_of_entry`, whose disposition this file passes as
#     `warn` for the fork-point read and `refuse` for both head reads.
FORK_CFG=""; FORK_USABLE=0; FORK_UNUSABLE_WHY=""
if FORK_CFG="$(git show "$BASEREF:$CONFIG_ROOTREL" 2>/dev/null)"; then
  if ! _json_parses "$FORK_CFG"; then
    FORK_UNUSABLE_WHY="it is not valid JSON there"
  elif [ "$(_json_type "$FORK_CFG")" != "object" ]; then
    FORK_UNUSABLE_WHY="it is not a JSON object at the top level there (it is $(_json_type "$FORK_CFG"))"
  else
    FORK_ARTIFACTS_TYPE="$(_cfg '.artifacts | type' "$FORK_CFG")"
    case "$FORK_ARTIFACTS_TYPE" in
      null|array) FORK_USABLE=1;;
      *) FORK_UNUSABLE_WHY="its .artifacts is of type '$FORK_ARTIFACTS_TYPE' there, not an array";;
    esac
  fi
else
  FORK_UNUSABLE_WHY="it does not exist there"
fi
if [ "$FORK_USABLE" -eq 0 ]; then
  echo "::warning::release-artifacts-check: no usable $CONFIG_ROOTREL at the fork point ($BASEREF) — $FORK_UNUSABLE_WHY. Falling back to head's version_file/version_regex for the release-PR classification, and comparing the declared set against an EMPTY baseline — so nothing can be reported as removed on this run."
fi

# --- comparison units ---------------------------------------------------------------------
# The sentinel stands in for `{{version}}` on BOTH sides of every comparison, so a templated
# member is stable across a release (substituting the concrete version would make every one of
# them read as removed, since the two ends carry different versions). It must be brace-free —
# `_expand_braces` splits on the first `{`, which `{{version}}`'s own brace would hit — and
# whitespace-free, since the path token is taken after substitution.
SENTINEL='@@ABTK_VERSION@@'

# _expand_braces <spec> — one path per line, expanding a single-level `{a,b,c}` comma set.
# Deliberately NOT a glob: the members of a release set are DECLARED, so a path that does not
# yet exist must still be asserted (that is the whole point) — a glob would silently expand
# to nothing and take the check green on the missing member.
#
# It never calls `die`, and that is structural rather than stylistic: the caller consumes it
# through a process substitution, whose `exit` unwinds only the SUBSHELL — the message would
# print and the script would carry on with the member silently dropped. The emptiness verdict
# is therefore the CALLER's, taken in the main shell (see `_paths_of_entry`).
#
# SINGLE-LEVEL, FIRST-BRACE-ONLY, and every pathological input FAILS LOUD rather than
# expanding oddly in silence — which is why neither is defended against beyond this note:
#   * `post` is everything after the FIRST `}`, so `a{b,c}d}e` yields `abd}e` / `acd}e` and a
#     second brace set is not expanded. Such a path will not exist at head and is reported as
#     a missing member, naming the path it actually looked for.
#   * `read -a` keeps a LEADING empty field but DROPS a trailing one (measured: `,x` ⇒ 2
#     alternatives, `x,` ⇒ 1), so `v{,a}.json` expands to two members and `v{a,}.json` to one.
#     The asymmetry is bash's, not this function's; a member lost to it is a member never
#     asserted, so the count on the summary line is the place it shows.
#   * a literal `{}` yields zero alternatives, which the caller turns into a rc-2 refusal.
_expand_braces() {
  local s="$1" pre post alts_str a
  local -a alts
  case "$s" in
    *'{'*'}'*)
      pre="${s%%\{*}"
      alts_str="${s#*\{}"; alts_str="${alts_str%%\}*}"
      post="${s#*\}}"
      IFS=, read -r -a alts <<<"$alts_str"
      for a in "${alts[@]}"; do printf '%s%s%s\n' "$pre" "$a" "$post"; done
      ;;
    *) printf '%s\n' "$s" ;;
  esac
}

# _paths_of_entry <entry> <substitution> <disposition: refuse|warn> <source> — fills PATHS_OUT
# with one path per expanded member, and returns non-zero when the entry is unusable.
# ONE function serves both consumers, because they must agree exactly: the comparison pass
# calls it with the SENTINEL (version-agnostic units) and the assertion pass with the concrete
# version. Both substitutions are brace- and whitespace-free, so the two produce the same
# member COUNT and the same brace structure from the same entry — which is what lets the
# assertion pass rely on the boundary refusals having already fired at comparison time.
#
# Materialized in the MAIN shell before any assertion runs, so an entry that expands to no
# path at all (a literal `{}`) is a loud config error rather than a member silently dropped
# from both the assertions and the count — this tool's own defect class one layer up.
# Boundary validation, not defensive coding: the input is a hand-edited config file.
#
# THE DISPOSITION IS A FUNCTION OF THE SOURCE, not of the shape. An unusable entry at HEAD is
# rc 2, as it has always been: the PR that wrote it can fix it. The same entry read from the
# FORK POINT is a merged commit no PR under review can edit, so refusing there is an rc no PR
# can clear — repairing the entry means DELETING it, and the run that would carry the repair
# is the run that reds, blaming the very entry the PR removes. A fork-point entry is therefore
# a per-entry `::warning::` and is EXCLUDED from the baseline: it cannot be compared, so it
# cannot be reported as removed, while every other fork-point entry still is. That is the same
# rule the unusable-config path already follows one level up, applied per entry.
PATHS_OUT=()
_paths_of_entry() {
  local raw="$1" sub="$2" disp="$3" src="$4" expanded spec p why=""
  PATHS_OUT=()
  # A literal sentinel in a declared entry would compare equal to a templated member on the
  # other side, i.e. it would be silently mistaken for `{{version}}`. `{{version}}` is the
  # only templating token the format defines, so this is a malformed declaration, refused.
  case "$raw" in
    *"$SENTINEL"*) why="artifact entry contains the reserved comparison token '$SENTINEL': '$raw' — write '{{version}}' for the version being shipped; that token is the only templating the format defines";;
    *)
      expanded="${raw//\{\{version\}\}/$sub}"
      # The path spec is the LEADING whitespace-delimited token; everything after it is prose
      # describing what the member must carry (`→ {{version}}`, `§ Recent releases row`).
      spec="${expanded%%[[:space:]]*}"
      # An EMPTY or leading-whitespace entry yields an empty spec, which would assert nothing
      # and be counted as nothing — the declared member would vanish with no signal. The two
      # spellings are one class and take one disposition: an empty entry used to be dropped by
      # a `[ -n "$raw" ]` guard at each caller while a whitespace-only one died here, which is
      # two answers to one question.
      if [ -z "$spec" ]; then
        why="artifact entry has no leading path token: '$raw'"
      else
        while IFS= read -r p; do
          [ -n "$p" ] || continue
          PATHS_OUT+=("$p")
        done < <(_expand_braces "$spec")
        [ "${#PATHS_OUT[@]}" -gt 0 ] \
          || why="artifact path '$spec' expands to no member (an empty brace set?) — declared as: $raw"
      fi;;
  esac
  [ -n "$why" ] || return 0
  PATHS_OUT=()
  case "$disp" in
    refuse) die "$why";;
    *) echo "::warning::release-artifacts-check: $why. That entry is declared at $src, which no PR under review can edit, so it is EXCLUDED from the baseline rather than refused — it is not compared, and cannot be reported as removed. Fix it in the PR that removes it."
       return 1;;
  esac
}

# _pasteable <unit> — a unit rendered back into the spelling a human writes in the config, so
# the remedy a failure prints can be pasted verbatim into `retired_artifacts` (a diagnosis
# naming an internal sentinel would have to be translated by hand, which is how a tombstone
# ends up spelled wrong and the next run reds again on a different line).
_pasteable() { local tok='{{version}}'; printf '%s' "${1//"$SENTINEL"/$tok}"; }

# Units, in declaration order and deduped. Order matters only for the report; the comparisons
# are set operations.
B_UNITS=(); declare -A B_HAS=() B_RAW=()
H_UNITS=(); declare -A H_HAS=()
R_UNITS=(); declare -A R_HAS=()

_collect() { # <config-content> <key> <destination set: B|H|R> <disposition> <source>
  local content="$1" key="$2" dst="$3" disp="$4" src="$5" raw p
  while IFS= read -r raw; do
    # No emptiness guard: an EMPTY entry is an unusable declaration, not a blank line to skip.
    # Dropping it here answered the same question two ways — silence for `""`, rc 2 for `" "`.
    _paths_of_entry "$raw" "$SENTINEL" "$disp" "$src" || continue
    for p in "${PATHS_OUT[@]}"; do
      case "$dst" in
        B) if [ -z "${B_HAS[$p]:-}" ]; then B_HAS["$p"]=1; B_RAW["$p"]="$raw"; B_UNITS+=("$p"); fi;;
        H) if [ -z "${H_HAS[$p]:-}" ]; then H_HAS["$p"]=1;                     H_UNITS+=("$p"); fi;;
        R) if [ -z "${R_HAS[$p]:-}" ]; then R_HAS["$p"]=1;                     R_UNITS+=("$p"); fi;;
      esac
    done
  done < <(printf '%s\n' "$content" | jq -r --arg k "$key" '(.[$k] // []) | .[]')
}

# THE ARTIFACT LEGS ARE SKIPPED WHOLESALE UNDER --classify-only, not run and ignored. Each
# carries its own verdict independent of the release classification (a LOST member exits 1 on
# EVERY PR class, by design), so running them for a caller that only asked "is this a release?"
# would surface an artifact failure as a classification failure. LOST is pre-set because the
# classification arm below reads it.
LOST=0
if [ "$CLASSIFY_ONLY" -eq 0 ]; then
  if [ "$FORK_USABLE" -eq 1 ]; then _collect "$FORK_CFG" artifacts B warn "the fork point ($BASEREF)"; fi
  _collect "$HEAD_CFG" artifacts         H refuse "head ($HEAD_REF)"
  _collect "$HEAD_CFG" retired_artifacts R refuse "head ($HEAD_REF)"

  # A member cannot be simultaneously asserted and retired. Refusing this is what stops a
  # tombstone being PRE-PLANTED against a still-declared member (the entry is deleted in a later
  # PR and the retirement is already acknowledged, so nothing ever reports the narrowing), and
  # it is equally what catches a retire-then-re-add that left its tombstone behind.
  if [ "${#H_UNITS[@]}" -gt 0 ]; then
    for u in "${H_UNITS[@]}"; do
      [ -z "${R_HAS[$u]:-}" ] \
        || die "'$(_pasteable "$u")' is declared in BOTH .artifacts and .retired_artifacts at $HEAD_REF — a member cannot be asserted and retired at the same time; remove it from one of the two"
    done
  fi

  # LOST — declared at the fork point, absent from head, unacknowledged. This is a SET
  # DIFFERENCE with its own verdict, evaluated regardless of whether the removed member's own
  # legs would have passed: a PR that deletes an entry while still updating the file it named
  # passes every leg, exits 0, and from the next release the fork point no longer carries the
  # entry either. It is also evaluated BEFORE, and independently of, the release-PR
  # classification — a severity that depended on classification would be bought back by
  # poisoning the version file's content, which costs no config edit at all.
  if [ "${#B_UNITS[@]}" -gt 0 ]; then
    for u in "${B_UNITS[@]}"; do
      [ -z "${H_HAS[$u]:-}" ] || continue
      if [ -n "${R_HAS[$u]:-}" ]; then
        echo "release-artifacts-check: RETIRED: $(_pasteable "$u") — declared at the fork point, absent from .artifacts at head, acknowledged in .retired_artifacts; not asserted"
      else
        echo "::error::release artifact declaration NARROWED: '$(_pasteable "$u")' is declared at the fork point ($BASEREF) but absent from .artifacts at $HEAD_REF (declared there as: ${B_RAW[$u]}) — restore the entry, or acknowledge the retirement by adding \"$(_pasteable "$u")\" to .retired_artifacts in this PR"
        LOST=$((LOST + 1))
      fi
    done
  fi

  # The opt-out tests the UNION: head alone would let a wholesale deletion of `artifacts` opt
  # the repo out of its own gate, and the fork point alone would refuse a repo adopting the key
  # for the first time. Checked after LOST (which cannot fire when the union is empty) and
  # before the version legs, because a fail-closed version read would otherwise refuse a repo
  # that never opted in.
  if [ "${#B_UNITS[@]}" -eq 0 ] && [ "${#H_UNITS[@]}" -eq 0 ]; then
    case "$HEAD_ARTIFACTS_TYPE" in
      array) echo "release-artifacts-check: no artifacts declared (empty array) — nothing to assert";;
      *)     echo "release-artifacts-check: no artifacts declared — nothing to assert";;
    esac
    exit 0
  fi
fi

# --- classification keys: fork point, else head ------------------------------------------
VERSION_FILE=""; VERSION_REGEX=""; KEY_SRC="the fork point ($BASEREF)"
if [ "$FORK_USABLE" -eq 1 ]; then
  VERSION_FILE="$(_cfg '.version_file // empty' "$FORK_CFG")"
  VERSION_REGEX="$(_cfg '.version_regex // empty' "$FORK_CFG")"
fi
if [ -z "$VERSION_FILE" ] || [ -z "$VERSION_REGEX" ]; then
  # Both keys move together: a fork point that declares only one of them cannot classify, and
  # mixing one end's file with the other end's regex would be a third, unwritten config.
  [ "$FORK_USABLE" -eq 0 ] || echo "::warning::release-artifacts-check: $CONFIG_ROOTREL at the fork point ($BASEREF) declares no version_file/version_regex — falling back to head's ($HEAD_REF) for the release-PR classification."
  VERSION_FILE="$(_cfg '.version_file // empty' "$HEAD_CFG")"
  VERSION_REGEX="$(_cfg '.version_regex // empty' "$HEAD_CFG")"
  KEY_SRC="head ($HEAD_REF)"
fi
# THE PREMISE IS CONDITIONAL BECAUSE THE REACHABILITY IS. In the normal mode these lines are
# reachable only with a non-empty declared set — the opt-out above exits 0 on an empty union —
# so "declares artifacts but no version_file" is a true account of how the run got here.
# `--classify-only` SKIPS that opt-out, because the question it answers has nothing to do with
# artifacts, so a config carrying `"artifacts": []` reaches these lines and the same sentence
# states something FALSE about it. That sentence is not cosmetic for an adopter: it is the
# entire diagnosis they get when their promote job reds rc 2 on a key they never set.
_need_class_key() {
  [ "$CLASSIFY_ONLY" -eq 0 ] \
    || die "$CONFIG_ROOTREL at $KEY_SRC declares no $1. --classify-only answers 'is this range a release', which is decided from version_file/version_regex ALONE, so both keys are required in this mode even when no artifact is declared — an empty or absent 'artifacts' array does not opt a repo out of the CLASSIFICATION. Declare them, or drop the caller's release-tag-check step: refusing rather than answering 'not a release', which would silently skip whatever the caller gates on this"
  die "$CONFIG_ROOTREL at $KEY_SRC declares artifacts but no $1 — the release-PR classification cannot run"
}
[ -n "$VERSION_FILE" ]  || _need_class_key version_file
[ -n "$VERSION_REGEX" ] || _need_class_key version_regex

# _extract_version <ref> <label> — sets EXTRACTED_VERSION and EXTRACTED_VALUES from
# <ref>:<version_file>. <label>
# names which END of the range <ref> is, because <ref> is often a resolved merge-base SHA that
# appears in none of the caller's inputs — an error naming only that SHA is not actionable.
#
# Sets a global instead of printing, deliberately: `die` inside a command substitution exits
# only the SUBSHELL, so `V="$(_extract_version …)"` would depend on `set -e` noticing the
# assignment's status to abort — an implicit path that a later `|| true` or an `if` context
# would silently defeat. Here `die` runs in the script's own shell and the exit is explicit.
#
# The extraction is the same one `release-pr-body` uses, and it is ONE stage: the version
# SHAPE is declared once, by `.release-pr.json`'s version_regex, and a match of it IS the
# value. ⛔ DO NOT RE-ADD THE SECOND `[0-9]+(\.[0-9]+){1,3}` NUMERIC PULL that stood here
# until card#7208 — running after the config regex, it could only narrow that regex's own
# match, never widen it, so the 4-segment support it read as was never reachable through a
# 3-segment version_regex; what it reached was a legal 1-segment config (refused outright)
# and a legal 5-segment one (cut to four).
# `|| true` on the pipeline is required, not defensive: `head -1` closes the pipe on the
# first line, and under `pipefail` the upstream grep's SIGPIPE would surface as the PIPELINE's
# status on a perfectly good extraction. Emptiness is what is tested, immediately below.
#
# ⛔ DO NOT PIN THAT STATUS TO A NUMBER — it is disposition-dependent, and this line said `141`
# until card#7175. The dead writer's status is **non-zero — 141 at SIGPIPE's default, 1 on the
# EPIPE path an inherited `SIG_IGN` produces — and `pipefail` promotes either**. The GitHub
# Actions runner is the second case (its step shell is started by the runner's Node process,
# which sets `SIG_IGN`, and that survives `execve` into every child), so an assertion written
# against `141` here passes locally and REDS IN CI. `tests/pipeline-free-match-selftest.sh`
# owns the measurement; the only property this `|| true` needs is that the status is non-zero.
#
# EXTRACTED_VALUES is EVERY value the regex matches at that ref — deduped, in first-appearance
# order — and it exists because the CLASSIFYING value above is the FIRST match over content
# HEAD OWNS (card#6488). Its first element is always EXTRACTED_VERSION: one grep, one pattern,
# one content, and an empty first match has already died. The two therefore cannot disagree
# about which value classifies; the list only adds the ones the `head -1` discards.
EXTRACTED_VERSION=""
EXTRACTED_VALUES=()
_extract_version() {
  local ref="$1" label="$2" content m
  local -A seen=()
  # The remediation names WHERE THE PATH CAME FROM, not just the path: `version_file` is read
  # from the config at $KEY_SRC, so the commonest real cause is that head RELOCATED the file
  # while the fork point still names the old path — a shallow-clone message alone would be
  # wrong-but-specific, which is worse than a generic one.
  content="$(git show "$ref:$VERSION_FILE" 2>/dev/null)" \
    || die "cannot read '$VERSION_FILE' at $label ($ref) — that path is the version_file declared by $CONFIG_ROOTREL at $KEY_SRC, so this fails when head relocated the file the fork point still names, or when the path or ref is missing from this clone: the caller must check out with fetch-depth: 0 so both ends of the range are present; refusing rather than classifying this as 'not a release PR'"
  EXTRACTED_VERSION="$(printf '%s\n' "$content" \
    | grep -oiE "$VERSION_REGEX" | head -1 || true)"
  [ -n "$EXTRACTED_VERSION" ] \
    || die "no version matched version_regex in '$VERSION_FILE' at $label ($ref) — refusing rather than classifying this as 'not a release PR'"
  # The same extraction, every match rather than the first one. The loop body is a dedupe and
  # nothing else — and THE KEY IS THE WHOLE MATCH `$m`, not a numeric run pulled back out of
  # it, because with the second stage gone a match IS a value and every other identity this
  # could dedupe on would re-declare the version shape that no file under bin/ now states.
  #
  # ⛔ THAT KEY DECIDES A VERDICT, not just the contents of a list: `${#NEW_AT_HEAD[@]}` below
  # is release / ::warning:: / rc-2 refusal, so a `version_regex` admitting two spellings of one
  # version (`v2.0.0` and `2.0.0` under `v?[0-9]+\.[0-9]+\.[0-9]+`) yields TWO values here
  # where the pre-card#7208 numeric key folded them to one and classified. ⛔ DO NOT NARROW THE
  # KEY BACK TO MAKE THAT CASE PASS: the same fold ran in the other direction too — two
  # genuinely DIFFERENT five-segment versions (`2.0.0.0.5`, `2.0.0.0.9`) both keyed to the
  # truncated `2.0.0.0`, so the gate silently dropped one and asserted every artifact member
  # against a version string that appeared nowhere in the file (measured, both directions, on
  # the pre-change bin). The refusal is this file's rule everywhere else: a version it cannot
  # determine is rc 2, never a pass and never a silent non-run.
  #
  # No emptiness guard on $m: `grep -o` emits no line for a zero-length match, so an empty one
  # cannot arrive here (measured, GNU grep 3.11, against a `[0-9]*` pattern over a digit-free
  # line) — and the empty EXTRACTED_VERSION case already died two lines up.
  EXTRACTED_VALUES=()
  while IFS= read -r m; do
    [ -z "${seen[$m]:-}" ] || continue
    seen["$m"]=1; EXTRACTED_VALUES+=("$m")
  done < <(printf '%s\n' "$content" | grep -oiE "$VERSION_REGEX")
}

_extract_version "$BASEREF"  "the fork point of '$BASE' and '$HEAD_REF'"; BASE_VERSION="$EXTRACTED_VERSION"; BASE_VALUES=("${EXTRACTED_VALUES[@]}")
_extract_version "$HEAD_REF" "head '$HEAD_REF'";                        HEAD_VERSION="$EXTRACTED_VERSION"; HEAD_VALUES=("${EXTRACTED_VALUES[@]}")

# The classification below has TWO consumers — this file's own artifact legs and
# `--classify-only`'s caller — and it runs BEFORE either is answered, deliberately. A mode that
# answered from `BASE_VERSION = HEAD_VERSION` alone would be a SECOND rule, blind to the arm
# below, and would report `not-release` for exactly the ranges this file goes on to assert
# every member against (card#6488 steered by content head owns + card#6579 exposing the rule).
IS_RELEASE=1
V="$HEAD_VERSION"
if [ "$BASE_VERSION" = "$HEAD_VERSION" ]; then
  # EQUAL IS NOT YET AN ANSWER (card#6488; the header states the rule, this states why it is
  # shaped the way it is). The unsteerable half is the FORK POINT's set of matched values — a merged commit no PR
  # under review can edit. A release SHIPS a version, and the version file must carry it to be
  # tagged and to satisfy its own artifact leg, so a real release ALWAYS introduces a value at
  # head that the fork point does not carry. That is the test, and it needs no diff and no
  # match positions: a value at head absent from the fork point, while the classifying match
  # is unchanged, is a release the first-match selector was steered away from.
  #
  # ONE such value NAMES the version being shipped, so the gate runs — this classifies as a
  # release PR and asserts every member against it, which is the verdict the poisoning existed
  # to avoid. SEVERAL and the version being shipped is genuinely ambiguous: rc 2, never a pass,
  # on the rule this file already holds everywhere else — a version that cannot be determined
  # is a refusal, because reading it as "not a release PR" is a silent non-run of the gate.
  #
  # A value the fork point carries and head does NOT is not a release signal (a deletion or a
  # reorder), so it does not enter the test: the pre-existing "unchanged" verdict stands, and
  # a repo that removes a stray version-shaped line is not redded for it.
  # Neither list can be empty here — both extractions refused above unless they produced a
  # value — so no emptiness guard is written around either loop.
  NEW_AT_HEAD=()
  for v in "${HEAD_VALUES[@]}"; do
    found=0
    for b in "${BASE_VALUES[@]}"; do [ "$b" != "$v" ] || { found=1; break; }; done
    [ "$found" -eq 1 ] || NEW_AT_HEAD+=("$v")
  done
  case "${#NEW_AT_HEAD[@]}" in
    0) IS_RELEASE=0;;
    1)
      V="${NEW_AT_HEAD[0]}"
      # A `::warning::`, not a silent switch: the classifying match says one thing and the file
      # says another, and WHICH value the members are judged against is the first thing a
      # maintainer needs when this fires on an honest PR that merely added a version-shaped
      # string. The remedy is the regex, and it is named — `version_regex` is read from the
      # fork point, so tightening it takes effect from the PR that MERGES the tightening, not
      # from this one.
      echo "::warning::release-artifacts-check: '$VERSION_FILE' carries $V at $HEAD_REF and not at the fork point ($BASEREF), while the FIRST version_regex match is unchanged ($HEAD_VERSION) at both ends — classifying this as a release PR of $V rather than as 'version unchanged', which would silently assert no member. If this is not a release, the version_regex declared by $CONFIG_ROOTREL at $KEY_SRC matches more than the version declaration; tighten it (in its own PR — it is read from the fork point) or drop the extra version-shaped text.";;
    *)
      die "cannot determine the version being shipped: '$VERSION_FILE' carries ${#NEW_AT_HEAD[@]} values at $HEAD_REF that the fork point ($BASEREF) does not (${NEW_AT_HEAD[*]}), while the FIRST version_regex match is unchanged ($HEAD_VERSION) at both ends — refusing rather than classifying this as 'not a release PR', which would silently assert no member. Tighten the version_regex declared by $CONFIG_ROOTREL at $KEY_SRC so it matches only the version declaration (in its own PR — it is read from the fork point), or drop the extra version-shaped text.";;
  esac
fi

if [ "$CLASSIFY_ONLY" -eq 1 ]; then
  # One machine-readable line, and rc 0 for BOTH answers: "not a release" is an answer, not a
  # failure, and a caller that had to tell them apart by exit code could not distinguish either
  # from the rc-2 refusals above — which is precisely the silent-non-run this mode must not mint.
  # The verdict is printed LAST, after the arm above may have emitted its `::warning::`, so a
  # caller reading the final line of a combined stdout+stderr capture reads the verdict.
  if [ "$IS_RELEASE" -eq 1 ]; then
    echo "release $V"
  else
    echo "not-release $V"
  fi
  exit 0
fi

if [ "$IS_RELEASE" -eq 0 ]; then
  if [ "$LOST" -gt 0 ]; then
    echo "release-artifacts-check: version unchanged ($HEAD_VERSION) between the fork point and $HEAD_REF — not a release PR, so no member was asserted — but $LOST declared artifact(s) were removed without acknowledgement, which is refused on every PR class" >&2
    exit 1
  fi
  echo "release-artifacts-check: OK — version unchanged ($HEAD_VERSION) between the fork point and $HEAD_REF — not a release PR; nothing to assert"
  exit 0
fi

# Captured ONCE, into a variable. Never `git diff … | grep -q`: `grep -q` exits on the first
# match and SIGPIPEs the writer, whose status `pipefail` then promotes to the pipeline's — i.e.
# a MATCH reading as a failure. That status is non-zero but NOT a fixed number: 141 at SIGPIPE's
# default, 1 on the EPIPE path an inherited `SIG_IGN` produces, and `pipefail` promotes either
# (card#7175 — see the note at `_extract_version`). Every membership test below is a shell
# `case`, so no subprocess and no pipeline is involved in answering "did this path move".
#
# `core.quotePath=false` is load-bearing, not tidiness: by default git C-quotes any path
# containing a non-ASCII byte (`"docs/caf\303\251.md"`), which matches no declared member, so
# a member that DID move is reported "not moved" — a false failure carrying a wrong diagnosis.
# The `git show`/`ls-tree` reads below take the path verbatim and are unaffected.
CHANGED="$(git -c core.quotePath=false diff --name-only "$BASEREF" "$HEAD_REF")" \
  || die "cannot diff '$BASE'...'$HEAD_REF' — the caller must check out with fetch-depth: 0"

FAILED=0
MEMBERS=0

while IFS= read -r raw; do
  # The boundary refusals inside this call (reserved token, no leading path token — which an
  # EMPTY entry also takes, hence no emptiness guard here either — an empty brace set) already
  # fired during the comparison pass over the same entries, so they cannot be reached here:
  # the substitution differs, the structure does not, and this pass reads HEAD's set, whose
  # disposition is `refuse`. The `|| continue` is the one call shape both passes use.
  _paths_of_entry "$raw" "$V" refuse "head ($HEAD_REF)" || continue

  for p in "${PATHS_OUT[@]}"; do
    MEMBERS=$((MEMBERS + 1))
    member_failed=0

    # (a) MOVED — an exact line of the captured diff.
    case $'\n'"$CHANGED"$'\n' in
      *$'\n'"$p"$'\n'*) ;;
      *) echo "::error::release artifact not moved: '$p' is absent from this PR's own changes ($BASE...$HEAD_REF) (declared as: $raw)"
         member_failed=1;;
    esac

    # (b) WHAT IS AT HEAD — one `ls-tree` mode read, which answers existence AND type in the
    # same row. `--full-tree` is mandatory: a plain `ls-tree` pathspec is CWD-relative, so
    # from a subdirectory it returns EMPTY AT RC 0 and every member reads as absent. No `-r`,
    # because a directory member must return its own `040000` row rather than vanish into its
    # children. The rc is captured because an unguarded `$( )` under `set -euo pipefail` would
    # surface a git failure as a bare rc 128 with no diagnosis.
    if ! row="$(git ls-tree --full-tree "$HEAD_REF" -- "$p")"; then
      die "cannot read '$p' at $HEAD_REF — git refused that member path as a pathspec, which is what a declared path escaping the repository root ('../…') or carrying pathspec magic (a leading ':') does; fix that entry in $CONFIG_ROOTREL (declared as: $raw). Failing that, '$HEAD_REF' itself is unreadable in this clone and the caller must check out with fetch-depth: 0 — the less likely half, since the version file was already read from that ref on this run"
    fi
    mode="${row%% *}"
    case "$mode" in
      "")
        echo "::error::release artifact missing at head: '$p' does not exist at $HEAD_REF (deleted or renamed?) (declared as: $raw)"
        member_failed=1;;
      100644|100755)
        # (c) AGREES — read from the commit, never the working tree: the working tree is not
        # necessarily the head commit (a runner may have a dirty or differently-checked-out tree).
        content="$(git show "$HEAD_REF:$p" 2>/dev/null || true)"
        # WHICH ARM was taken is reported on the OK line, and that is a correctness feature, not
        # cosmetics. The strong arm is selected by a magic substring in FREE PROSE, so a prose
        # edit ('… entry', '… heading') silently DOWNGRADES the member to the weak
        # content-mention arm — and before the arm was named, a downgraded pass was
        # byte-identical to a strong one, so the loss of assertion strength was invisible in the
        # CI log. Naming the arm is what makes a downgrade legible without guessing at synonyms.
        #
        # The selector is matched case-INSENSITIVELY (`${raw,,}`, ASCII-only under LC_ALL=C).
        # Synonyms are deliberately NOT accepted: every extra spelling widens what silently
        # TRIGGERS the strong arm, and the legibility above is the general fix — a reader who
        # wrote 'entry' sees `via content mention` on the OK line and corrects the prose.
        raw_lc="${raw,,}"
        case "$raw_lc" in
          *'[{{version}}] section'*)
            # A LINE beginning `## [<version>]`. Matched as a FIXED STRING against a
            # newline-prefixed copy rather than as `^## \[$V\]`: the dots in a version are regex
            # metacharacters, so an unescaped `0.1.2` would also match `0x1x2`. The leading
            # $'\n' is the left anchor — without it an inline mid-line mention ('see ## [0.1.2]
            # below') would satisfy a check that claims to be about a heading LINE.
            arm="via '## [$V]' heading line"
            case $'\n'"$content" in
              *$'\n'"## [$V]"*) ;;
              *) echo "::error::release artifact does not agree: '$p' at $HEAD_REF has no line beginning '## [$V]' (declared as: $raw)"
                 member_failed=1;;
            esac;;
          *)
            case "$p" in
              *"$V"*) arm="via version-bearing path" ;;  # e.g. sboms/vX.Y.Z.json
              *) arm="via content mention"
                 # DISCLOSED WEAKNESS: an UNANCHORED substring test. With V=0.25.0 a file
                 # containing only `10.25.0` (or `0.25.01`) satisfies this arm. It is the
                 # catch-all for members whose agreement has no structure to key on (a table
                 # row, a prose line), where there is nothing to anchor to — so the arm is
                 # deliberately weak rather than accidentally so, and `docs/INSTALL.md` §4
                 # states the same limit to the person writing the declaration. A member that
                 # needs a real assertion should declare the `[{{version}}] section` shape.
                 case "$content" in
                   *"$V"*) ;;
                   *) echo "::error::release artifact does not agree: '$p' at $HEAD_REF does not contain the version being shipped ($V) (declared as: $raw)"
                      member_failed=1;;
                 esac;;
            esac;;
        esac;;
      *)
        # Not a regular file. Each of these answers the content reads above — wrongly: a
        # symlink yields its TARGET PATH, a directory a tree listing, a gitlink whose commit is
        # in this store its COMMIT LOG. Any of the three can carry the version string and pass
        # an assertion that has read nothing about a release artifact.
        case "$mode" in
          120000) kind="a symlink";;
          040000) kind="a directory";;
          160000) kind="a gitlink (submodule entry)";;
          *)      kind="not a regular file (tree mode $mode)";;
        esac
        echo "::error::release artifact is not a regular file: '$p' at $HEAD_REF is $kind — a declared release artifact must be a regular file whose contents can be asserted (declared as: $raw)"
        member_failed=1;;
    esac

    if [ "$member_failed" -eq 0 ]; then
      echo "release-artifacts-check: OK — $p moved, exists at $HEAD_REF, agrees with $V $arm"
    else
      FAILED=$((FAILED + 1))
    fi
  done
done < <(printf '%s\n' "$HEAD_CFG" | jq -r '(.artifacts // []) | .[]')

if [ "$FAILED" -gt 0 ]; then
  echo "release-artifacts-check: $FAILED of $MEMBERS artifact member(s) failed" >&2
fi
if [ "$LOST" -gt 0 ]; then
  echo "release-artifacts-check: $LOST declared artifact(s) removed without acknowledgement — add them to .retired_artifacts or restore them" >&2
fi
if [ "$FAILED" -gt 0 ] || [ "$LOST" -gt 0 ]; then
  exit 1
fi
echo "release-artifacts-check: all $MEMBERS declared artifact member(s) moved and agree with $V"
exit 0
