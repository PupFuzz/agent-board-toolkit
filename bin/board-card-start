#!/usr/bin/env bash
# board-card-start — move the card correlated to a feature branch into "In Progress".
#
# Codifies "work has begun" so it's never a forgotten manual step (the recurring
# board-drift fix). Called by the post-checkout git hook; also runnable by hand:
#     board-card-start [--lint] [-h|--help] [--] [<branch-name>]   (no branch argument: the current branch)
#
# Correlation — try-in-order-with-fallback (framework contract #112), on the
# OUTCOME of a token not its presence:
#   1. A DL-NNN token (e.g. feature/dl156-foo) that RESOLVES → the board card whose
#      payload.dl_number is DL-NNN. A co-present card-id token is ignored (loud).
#   2. A DL-NNN that resolves to NO card → fall through to a CARD-ID token in the
#      same branch (never dead-end — the unstamped-card class). When we resolve via
#      the card-id path AND a DL was named, payload.dl_number is STAMPED if empty
#      (never overwriting a differing stamp) so downstream DL-correlated movers stop
#      no-op'ing on the card.
#   3. No DL token → a CARD-ID token → that card (task) id directly. Recognized as
#      an explicit `card#2950` (the bridge's grammar) / `#2950` / `card-2950` /
#      `card/2950` anywhere, or the leading
#      id of a typed branch (`feat/2950-…`, `fix/2950`, `chore/2950/…`). This is
#      how routine FR/bug work — branched by card id before a DL is assigned —
#      still moves. The card-id path only ever moves a card that actually lives
#      on the repo's configured board (the board-match guard below), so a stray
#      number can't promote an unrelated task.
#   4. A DL present but resolving to nothing with no card-id fallback → loud no-op
#      (a high-value miss), never silent.
#
# SAFE BY DESIGN:
#   - FAIL-SOFT: any missing config / unreachable board / no match → exit 0. It
#     must NEVER block a git checkout.
#   - IDEMPOTENT + no stage regression: promotes a card in Backlog or Prioritized
#     on any branch checkout, and a Held card ONLY on a genuine branch CREATION
#     (contract PR #113 — a re-checkout of an old branch won't un-park it). A card
#     already In Progress / In Review / Shipped / Released / Won't-Do is left alone.
#   - PINNED cards are never auto-moved: a non-empty block_reason or a `no-automove`
#     tag refuses the move (loud), regardless of stage.
#   - BOARD-SCOPED: the resolved card must be on the repo's configured board.
#   - RECORDED: every mover run on a named branch leaves the board's verdict on that branch in a
#     local record, which the pre-push `--lint` repeats without a request (the record's contract
#     sits above _bcs_verdict_write).
#
# OWNER TAG: once the move to In Progress has succeeded, this seat's owner tag is stamped by a
# separate tag write (kb_owner_tag_write in _kb-board-lib.sh, shared with `kbcard move
# --stamp-owner`). Its rules are README.md § The seat owner tag. Whatever it reports goes to stderr
# AND the durable log below. A card this hook does not move is not stamped.
set -uo pipefail

# Shared toolkit lib (DL canon, whole-board pagination, token read). Fail-soft:
# a missing lib must never block a git checkout.
KB_LIB="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)/_kb-board-lib.sh"
# shellcheck source=bin/_kb-board-lib.sh
[ -r "$KB_LIB" ] || { echo "board-card-start: _kb-board-lib.sh not found next to this script — board automation skipped (reinstall per INSTALL.md §3, or co-vendor _kb-board-lib.sh alongside this hook)." >&2; exit 0; }
source "$KB_LIB"
KB_PROG="board-card-start"

# --- pure helpers (unit-tested by tests/board-card-start-selftest.sh) --------

# _bcs_is_placeholder_host <api_base>: true (0) when the api_base host is an RFC-2606/6761
# reserved documentation/placeholder host — the host-scrub emits such a host so the real
# kanban host never lives in a repo, and the hook then falls back to $KB_API. Each reserved
# label is anchored to a host-label boundary (leading '.' or the scheme '//', trailing ':' /
# '/' / end) so a REAL host that merely CONTAINS the substring — kanban.latest-corp.com
# (…test…), example-corp.net, mytest.io — is NOT misread as a placeholder (which would wrongly
# override it to $KB_API or reject a valid config, #34). Empty → placeholder (fall back to KB_API).
_bcs_is_placeholder_host() {
    local api="${1:-}"
    [ -z "$api" ] && return 0
    # Herestring, never `printf … | grep -q` (card#7175): under `pipefail` a `grep -q` that
    # matches exits while its writer is still writing, the writer fails on the closed pipe, and
    # `pipefail` promotes its non-zero status — a MATCH read as a NON-MATCH. A bash builtin
    # upstream is not exempt; it is forked into a subshell and dies the same way once the payload
    # crosses the 64 KiB pipe buffer. `$api` is short today, which makes this latent, not safe.
    # `tests/pipeline-free-match-selftest.sh` owns the mechanism in full.
    grep -qiE '://([^/]*\.)?example\.(com|net|org)([:/]|$)|://([^/]*\.)?(invalid|test|example)([:/]|$)|://localhost([:/]|$)' <<< "$api"
}

# kb_bcs_log <reason>: the loud + DURABLE diagnostic for an *attempted-but-failed* move (a
# branch that carries a DL/card token but whose card did not move for an infra reason). The
# installed wrapper runs `board-card-start >/dev/null 2>&1 || true`, so stderr is invisible on
# the hook path — the durable record is the log FILE (KB_BCS_LOG override). Best-effort and
# set -u-safe (every ref defaulted); it swallows its own errors so it can NEVER fail the hook
# (which must exit 0, never blocking a checkout). A manual `board-card-start` run still sees stderr.
kb_bcs_log() {
    local reason="${1:-unspecified}"
    kb_bcs_note "board-card-start: branch '${branch:-?}' carries a DL/card token but the move did not happen — $reason"
}

# kb_bcs_note <line>: the stderr + durable-log write kb_bcs_log words for a failed move, for a line
# that is NOT about a failed move (the owner-tag refusals, where the move itself still happens).
kb_bcs_note() {
    local msg="${1:-}"
    printf '%s\n' "$msg" >&2
    local logf="${KB_BCS_LOG:-${HOME:-/tmp}/.cache/agent-board-toolkit/board-card-start.log}"
    local ts; ts="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf '?')"
    { mkdir -p "$(dirname "$logf")" 2>/dev/null && printf '%s %s\n' "$ts" "$msg" >>"$logf" 2>/dev/null; } || true
}

# bcs_skip <reason>: record the attempted-but-failed reason (kb_bcs_log), then exit 0 — the
# hook is fail-soft and must never block a checkout. Only ever called PAST the token-presence
# gate below, so a token IS present: a genuine no-op (no token) stays silent and never reaches here.
# The same reason becomes the branch's `not_checked` board verdict, unless an arm already set one.
bcs_skip() { _bcs_verdict not_checked "" "$1"; kb_bcs_log "$1"; exit 0; }

# _bcs_verdict <verdict> <subject> <reason>: set this run's board verdict for the branch — the
# FIRST call wins, so an arm that knows the verdict (a card the board says is not on it) keeps it
# through the bcs_skip it then calls, and a refusal after a resolved card (a pinned one) does not
# turn "resolved" into "not checked". The mover's EXIT trap writes it (_bcs_verdict_write).
_bcs_verdict() {
    [ -z "${bcs_verdict:-}" ] || return 0
    bcs_verdict="$1"; bcs_verdict_subject="$2"; bcs_verdict_reason="$3"
}

# _bcs_patch <cid> <json> <success-msg> <fail-reason>: PATCH the resolved card via the shared
# kb_api, which captures the HTTP status in KB_HTTP (the status-capture the hand-rolled
# `curl -fsS` here used to drop, #4337 — a 403 token-scope failure and a 422 were both a bare
# rc 22). On a 2xx, echo <success-msg> to stderr; on any failure, durably record <fail-reason>
# plus the status via kb_bcs_log (this hook never sets KB_LOG_FILE, so KB_BCS_LOG is its durable
# surface). Fail-soft: always returns 0 — a failed board write must never block a checkout.
# Reads KB_API / KB_TOKEN (pinned once above, before the first call).
_bcs_patch() {
    local cid="$1" json="$2" okmsg="$3" failreason="$4"
    if kb_api PATCH "/tasks/$cid.json" "$json" >/dev/null 2>&1; then
        [ -n "$okmsg" ] && printf '%s\n' "$okmsg" >&2
        return 0
    fi
    kb_bcs_log "$failreason (HTTP ${KB_HTTP:-?})"
    return 0
}

# Card-id extraction, split into two pure (network-free, sourceable) matchers so the
# grammar itself is unit-testable (tests/board-card-start-selftest.sh) rather than only
# reachable through the network-driving main body. They mirror the two-tier fallback the
# main body walks: an explicit named-card token first, then a typed-branch leading id.

# _bcs_explicit_card_id <branch>: the explicit named-card grammar, at a token boundary,
# >=2 digits. `card<N>` (the separator after `card` is OPTIONAL — so the natural, most-
# typed glued spelling `card4524` correlates, not only `card-4524` / `card/4524` /
# `card#4524`), or a bare `#N`. Echoes the zero-stripped id, or nothing. The `_` in the
# leading boundary is NOT accepted as the card separator (`card_4524` stays a lint case,
# card-4621) — only `#`, `-`, `/`, or glued.
_bcs_explicit_card_id() {
    printf '%s\n' "${1:-}" | grep -oiE '(^|[/_-])(card[-/#]?|#)0*[0-9]{2,}' | grep -oE '[0-9]+' | head -1 | sed 's/^0*//'
}

# _bcs_typed_card_id <branch>: a typed-branch leading id — a known type prefix, a slash,
# an optional `#`, then a >=3-digit id, token-bounded (so `feat/2signup`, a 2-digit
# version, or a `dl-189` token can't match). Echoes the id, or nothing.
_bcs_typed_card_id() {
    printf '%s\n' "${1:-}" \
        | grep -oiE '^(feat|feature|fix|hotfix|bug|chore|fr|refactor|perf|docs|ci|test|build|style)/#?0*[0-9]{3,}([/_-]|$)' \
        | grep -oE '[0-9]{3,}' | head -1 | sed 's/^0*//'
}

# _bcs_branch_lint_warning <branch>: fail-soft ADVISORY for the pre-push hook (card-4621).
# Empty (no warning) when the branch already carries a token the auto-move grammar
# recognizes — a DL, an explicit card id, or a typed leading id — OR when there is no
# card-ish signal at all. It warns ONLY on the narrow, high-precision residual: the literal
# `card`/`#` at a token boundary followed by >=2 digits through a separator the grammar does
# NOT accept (e.g. `card_4524`, `card.4524`) — an unmistakable "meant a card, won't correlate"
# case. Echoes a one-line hint at the compliant spelling; never blocks a push.
_bcs_branch_lint_warning() {
    local branch="${1:-}"
    [ -n "$branch" ] || return 0
    # Already correlates → nothing to warn about.
    [ -n "$(printf '%s\n' "$branch" | grep -oiE 'dl-?[0-9]+' | head -1)" ] && return 0
    [ -n "$(_bcs_explicit_card_id "$branch")" ] && return 0
    [ -n "$(_bcs_typed_card_id "$branch")" ] && return 0
    # `card`/`#` at a boundary + a separator OUTSIDE the accepted set (`-` `/` `#` glued) + digits.
    local id
    id="$(printf '%s\n' "$branch" | grep -oiE '(^|[/_-])(card|#)[^a-z0-9/#-]0*[0-9]{2,}' | grep -oE '[0-9]+' | head -1 | sed 's/^0*//')"
    [ -n "$id" ] || return 0
    printf "branch '%s' looks like it references card %s, but the board auto-move grammar won't recognize this spelling — the card will NOT move to In Progress on checkout. Rename it e.g. 'fix/card-%s-slug' (or 'fix/%s-slug').\n" "$branch" "$id" "$id" "$id"
}

# _bcs_card_id <branch>: the id the card-id path moves on — the explicit named-card grammar
# first, else a typed-branch leading id. Echoes the id, or nothing. The mover, the board verdict
# record and both id-space legs of the lint read this, so they cannot disagree about WHICH number
# is judged.
_bcs_card_id() {
    local id
    id="$(_bcs_explicit_card_id "${1:-}")"
    [ -n "$id" ] || id="$(_bcs_typed_card_id "${1:-}")"
    printf '%s' "$id"
}

# _bcs_board_id <path-to-.release-pr.json>: the board this repo maps to, as "<id> <source>" on
# stdout (source: `hostlocal` | `committed`), or nothing. Run from inside the work tree: the
# repo-local UNCOMMITTED `git config kanban.board-id` wins, else the committed
# .promote.board_id — the mover's full reasoning for that order sits at its call site below.
# Nothing is printed when jq is absent and only the committed file could have answered, or when
# the committed value is not a plain integer (`"42abc"`, `-42`, `42.0`, `["42"]`).
_bcs_board_id() {
    local cfg="${1:-}" board
    board="$(git config --get kanban.board-id 2>/dev/null | grep -oE '[0-9]+' | head -1 || true)"
    if [ -n "$board" ]; then
        printf '%s hostlocal\n' "$board"
        return 0
    fi
    [ -r "$cfg" ] || return 0
    # Anchored ^[0-9]+$ (not a substring scan): this value is committed and PR-editable, and it
    # keys the board-env lookup.
    board="$(jq -r '.promote.board_id // empty' "$cfg" 2>/dev/null | grep -oE '^[0-9]+$' | head -1 || true)"
    [ -z "$board" ] || printf '%s committed\n' "$board"
    return 0
}

# _bcs_uint_lt <a> <b>: true when a < b, both canonical unsigned decimals (no leading zero).
# Compared as DIGIT STRINGS, never arithmetically: a branch name can carry more digits than bash
# integers hold: past 2^63-1 `[ -lt ]` errors and `(( ))` wraps, so neither answers the
# comparison — and a wrapped one can accuse.
_bcs_uint_lt() {
    local LC_ALL=C
    [ "${#1}" -lt "${#2}" ] || { [ "${#1}" -eq "${#2}" ] && [[ "$1" < "$2" ]]; }
}

_bcs_id_space_rule="card ids and GitHub issue/PR numbers are separate id spaces — cut the branch from the CARD id ('fix/card-<card-id>-slug'), never from an issue/PR number: a wrong number moves no card on checkout, and since the branch beats the PR title at merge, closes none"

# _bcs_card_id_floor_warning <branch> <board-id> <board-env> <floor>: the card-id FLOOR leg of
# the pre-push lint (DL-223) — a second, independent predicate beside _bcs_branch_lint_warning.
# That one catches a spelling the grammar REJECTS; this one catches a spelling the grammar
# ACCEPTS carrying a number from the wrong id space (a GitHub issue/PR number), which correlates
# to no card, or to the wrong one. Pure: the caller resolves the three config inputs (empty =
# could not be resolved) and nothing here reads a board.
#
# Silent only when the branch carries no card id, or its id is at/above a seeded floor. Every
# input it could not judge SPEAKS, naming the missing piece: a floor that cannot be consulted is
# indistinguishable from a clean branch if it stays quiet. The floor is a MAGNITUDE heuristic
# whose bound is documented where it is seeded (docs/INSTALL.md §3b); within that bound its
# failure mode is a false clean, and the wording hedges ("most likely") for the rest.
_bcs_card_id_floor_warning() {
    local branch="${1:-}" board="${2:-}" envf="${3:-}" floor="${4:-}" id
    id="$(_bcs_card_id "$branch")"
    [ -n "$id" ] || return 0
    if [ -z "$board" ]; then
        printf "card-id floor NOT CHECKED for branch '%s' (card %s): this repo maps to no board — no 'git config kanban.board-id', and no .promote.board_id read from .release-pr.json (absent, unreadable, not a plain integer, or jq not on PATH) — so whether %s is a card id or a GitHub issue/PR number cannot be judged; %s.\n" \
            "$branch" "$id" "$id" "$_bcs_id_space_rule"
    elif [ -z "$envf" ]; then
        printf "card-id floor NOT CHECKED for branch '%s' (card %s): this repo maps to board %s, but no ~/.kanban-*-board.env has KB_BOARD_ID=%s, so there is no floor to consult; %s.\n" \
            "$branch" "$id" "$board" "$board" "$_bcs_id_space_rule"
    elif [ -z "$floor" ]; then
        printf "card-id floor not seeded for board %s — add 'export KB_CARD_ID_FLOOR=<at or below the board's lowest card id, archived cards included>' to %s (docs/INSTALL.md §3b); until then branch '%s' (card %s) cannot be told apart from a GitHub issue/PR number; %s.\n" \
            "$board" "$envf" "$branch" "$id" "$_bcs_id_space_rule"
    elif ! kb_is_uint "$floor"; then
        printf "card-id floor NOT CHECKED for branch '%s' (card %s): KB_CARD_ID_FLOOR='%s' in %s is not an unsigned integer without leading zeros (docs/INSTALL.md §3b); %s.\n" \
            "$branch" "$id" "$floor" "$envf" "$_bcs_id_space_rule"
    elif _bcs_uint_lt "$id" "$floor"; then
        printf "branch '%s' names card %s, which is BELOW board %s's card-id floor %s (KB_CARD_ID_FLOOR in %s) — %s is most likely a GitHub issue/PR number, not a card id; %s.\n" \
            "$branch" "$id" "$board" "$floor" "$envf" "$id" "$_bcs_id_space_rule"
    fi
    return 0
}

# --- the board verdict record (DL-225) --------------------------------------------------------
#
# The mover records what the board said about a branch at checkout, and `--lint` repeats it at push
# without reading the board. One file per branch, under the repo's COMMON git dir
# (`git rev-parse --git-common-dir`): branches belong to the repository rather than to a worktree,
# so every linked worktree reads and writes the same record; git never tracks anything there; and
# the records go away with the repository. The file is named by the branch name's blob hash, not
# by the name: a name can outgrow a file name, and `fix` beside `fix/x` would collide as a file
# and a directory. The name itself is the record's `branch=` line, and a reader checks it.
#
# Format — line 1 is `abtk-board-verdict 1`, then one `key=value` per line:
#   branch        the branch name
#   card          the id _bcs_card_id derived from that name when the record was written
#   dl            the DL number the name carries, if any
#   board         the board id the repo mapped to at checkout (empty: none resolved)
#   verdict       resolved | absent | not_checked
#   subject       the card the branch resolved to (resolved only)
#   reason        one line: what the board said, or why it was not asked
#   recorded_at   unix seconds;  recorded_utc — the same instant, for humans
# No value can carry a line break: git refuses control characters in a ref name, and the writer
# flattens them out of the reason.
#
# A record describes ONE checkout. It goes stale when the branch is re-created without a checkout
# (git branch / git update-ref after a delete), when the repo is re-mapped to another board, or
# when a toolkit with a different card-id grammar wrote it; _bcs_board_verdict_warning reports each
# of those as STALE. A card created, moved or deleted on the board after the checkout is NOT
# detectable without reading the board, which the lint never does: the next checkout re-records.
_BCS_VERDICT_HEADER="abtk-board-verdict 1"

# _bcs_verdict_file <branch>: the ABSOLUTE record path for <branch> in the repo around the current
# directory; rc 1 (nothing printed) outside a repository.
_bcs_verdict_file() {
    local common key
    common="$(git rev-parse --git-common-dir 2>/dev/null)" && [ -n "$common" ] || return 1
    common="$(cd "$common" 2>/dev/null && pwd -P)" || return 1
    key="$(printf '%s' "${1:-}" | git hash-object --stdin 2>/dev/null)" && [ -n "$key" ] || return 1
    printf '%s/agent-board-toolkit/board-verdict/%s\n' "$common" "$key"
}

# _bcs_verdict_write <branch> <verdict> <dl> <board> <subject> <reason>: replace <branch>'s record
# ATOMICALLY — a temp file in the record's own directory, renamed over the old one — so a reader
# sees the previous record or the new one, never a torn one. rc 1 on any failure, with no temp
# file left behind and, wherever the directory still allows it, no previous record either; what a
# failed write is worth is the caller's call.
_bcs_verdict_write() {
    local branch="${1:-}" verdict="${2:-}" dl="${3:-}" board="${4:-}" subject="${5:-}" reason="${6:-}"
    local f dir tmp
    f="$(_bcs_verdict_file "$branch")" || return 1
    dir="${f%/*}"
    mkdir -p "$dir" 2>/dev/null || return 1
    if tmp="$(mktemp "$dir/.tmp.XXXXXX" 2>/dev/null)" \
        && printf '%s\nbranch=%s\ncard=%s\ndl=%s\nboard=%s\nverdict=%s\nsubject=%s\nreason=%s\nrecorded_at=%s\nrecorded_utc=%s\n' \
            "$_BCS_VERDICT_HEADER" "$branch" "$(_bcs_card_id "$branch")" "$dl" "$board" "$verdict" "$subject" \
            "${reason//[$'\n\r']/ }" "$(date +%s)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$tmp" 2>/dev/null \
        && mv -f "$tmp" "$f" 2>/dev/null; then
        return 0
    fi
    # This checkout's verdict is lost, so the previous one must not stand in for it (latest
    # checkout wins). Best-effort: a directory that refused the write can refuse this too, and the
    # lint then still judges whatever record is left for staleness.
    rm -f ${tmp:+"$tmp"} "$f" 2>/dev/null
    return 1
}

# _bcs_branch_created_at <branch>: the unix time git logged <branch>'s creation at, or nothing. A
# branch reflog lists newest first, so its creation entry (`branch: Created from …`) is the LAST
# line for as long as it survives; nothing is printed when the last line is anything else — a
# clone, an expired reflog, reflogs turned off — or when the branch has no reflog at all.
_bcs_branch_created_at() {
    local last
    last="$(git reflog show --date=unix "refs/heads/${1:-}" -- 2>/dev/null | tail -1)"
    # Herestring for the reason _bcs_is_placeholder_host states (card#7175).
    grep -q 'branch: Created from' <<< "$last" || return 0
    printf '%s' "$last" | grep -oE '@\{[0-9]+\}' | tr -d '@{}'
}

# _bcs_board_verdict_warning <branch> <record-file> <board-now> <created-at>: the board-verdict leg
# of the pre-push lint. Prints its finding, or nothing, and answers whether the record DECIDES the
# branch:
#   rc 0 — decided: the branch carries no card id (silent); the board resolved it (silent); or the
#          board said the id is not a card on this repo's board (loud, teaching the id-space rule).
#   rc 1 — undecided: no record, an unreadable one, a stale one, or a checkout that never got an
#          answer from the board. Each speaks, by name. Only then is the card-id floor consulted.
# <board-now> is the board the repo maps to at push (_bcs_board_id); <created-at> is
# _bcs_branch_created_at's answer. Reads the record file and nothing else.
_bcs_board_verdict_warning() {
    local branch="${1:-}" f="${2:-}" board_now="${3:-}" created="${4:-}" id again
    id="$(_bcs_card_id "$branch")"
    [ -n "$id" ] || return 0
    again="check the branch out again ('git checkout $branch') to record a current verdict"
    if [ -z "$f" ] || [ ! -e "$f" ]; then
        printf "board verdict NOT RECORDED for branch '%s' (card %s): no checkout of it recorded what the board said — it was created without a checkout (git branch / fetch / update-ref), checked out without a post-checkout hook that records verdicts, or the record could not be written (the mover's durable log says so); %s.\n" \
            "$branch" "$id" "$again"
        return 1
    fi
    local hdr="" line k r_branch="" r_card="" r_board="" r_verdict="" r_reason="" r_at="" r_utc=""
    {
        IFS= read -r hdr
        while IFS= read -r line; do
            k="${line%%=*}"
            case "$k" in
                branch)       r_branch="${line#*=}" ;;
                card)         r_card="${line#*=}" ;;
                board)        r_board="${line#*=}" ;;
                verdict)      r_verdict="${line#*=}" ;;
                reason)       r_reason="${line#*=}" ;;
                recorded_at)  r_at="${line#*=}" ;;
                recorded_utc) r_utc="${line#*=}" ;;
            esac
        done
    } 2>/dev/null < "$f"
    case "$r_verdict" in resolved|absent|not_checked) ;; *) r_verdict="" ;; esac
    if [ "$hdr" != "$_BCS_VERDICT_HEADER" ] || [ "$r_branch" != "$branch" ] || [ -z "$r_verdict" ]; then
        printf "board verdict record for branch '%s' (card %s) is UNREADABLE — %s is not a '%s' record for this branch with a known verdict; %s.\n" \
            "$branch" "$id" "$f" "$_BCS_VERDICT_HEADER" "$again"
        return 1
    fi
    local stale=""
    if [ "$r_card" != "$id" ]; then
        stale="it was recorded for card ${r_card:-<none>}, but this branch name yields card $id to this board-card-start (a toolkit with a different card-id grammar wrote it)"
    elif [ "$r_board" != "$board_now" ]; then
        stale="it was recorded against ${r_board:+board }${r_board:-no board}, but this repo now maps to ${board_now:+board }${board_now:-no board}"
    elif kb_is_uint "$created" && kb_is_uint "$r_at" && _bcs_uint_lt "$r_at" "$created"; then
        stale="it was recorded at $r_utc, before a branch of this name was created (reflog: unix time $created) — the branch was deleted and re-created without a checkout since"
    fi
    if [ -n "$stale" ]; then
        printf "board verdict for branch '%s' (card %s) is STALE — %s; %s.\n" "$branch" "$id" "$stale" "$again"
        return 1
    fi
    case "$r_verdict" in
        resolved) return 0 ;;
        absent)
            printf "branch '%s' names card %s, which is NOT a card on board %s — the board said so when the branch was checked out (%s; recorded %s); %s.\n" \
                "$branch" "$id" "$r_board" "$r_reason" "$r_utc" "$_bcs_id_space_rule"
            return 0 ;;
    esac
    printf "board verdict NOT CHECKED for branch '%s' (card %s): its last checkout (%s) got no answer from the board — %s; once that is fixed, %s.\n" \
        "$branch" "$id" "$r_utc" "$r_reason" "$again"
    return 1
}

# When sourced (tests/board-card-start-selftest.sh), expose only the pure helpers above and
# stop here — sourcing must not run the checkout mover.
(return 0 2>/dev/null) && return 0

# Argument surface: `[--lint] [-h|--help] [--] [<branch-name>]`. `--lint` is the pre-push
# advisory path — print the branch-name findings (if any) and exit, moving nothing and issuing no
# request (its only reads are host-local: the board verdict record and config); no branch argument
# is the post-checkout path (the hook passes none), which targets the CURRENT branch. `-h`/`--help` prints the usage line to STDOUT at rc 0 and does nothing else:
# before it existed, a hand-typed `--help` fell to the `-*` arm, whose remedy line reads as
# advice to run `board-card-start -- --help` — which would target a BRANCH named `--help`
# (card#5354). The refusal text is deliberately unchanged: it is phrased conditionally ("for a
# branch name that starts with `-`"), and the actionable defect was the absent help surface.
#
# Parsed in a LOOP so the flag is honored in ANY position. Honoring `--lint` only in position 1
# meant `board-card-start <branch> --lint` silently dropped it and performed a REAL card move —
# the same defect install-board-hooks documents fixing for `--check` (see its parser), on the
# most natural mis-spelling of a flag whose entire contract is "moves nothing".
#
# `--` is a REAL end-of-options terminator (it sets a flag the loop honors), never the decorative
# `--) ;;` that is accepted and then ignored. It is load-bearing, not boilerplate: git ACCEPTS a
# branch whose name starts with `-` — `git check-ref-format refs/heads/-foo` is rc 0 and
# `git update-ref refs/heads/-foo HEAD` creates it; only the `git branch` PORCELAIN refuses the
# name — and hooks/pre-push hands us whatever git is pushing. Without the terminator the `-*` arm
# refuses `-foo` as an unknown option: a FALSE refusal, printing a "no card moved" line on every
# push of such a branch while the mover still moves its card (post-checkout passes no args, so it
# reaches the `git rev-parse HEAD` fallback and never enters this parser) — i.e. exactly the
# "can never disagree about the grammar" property docs/HOOKS.md claims for the pre-push lint,
# broken on the one axis the shared matchers do not cover.
# Everything after `--` is a positional, and there is ONE positional owner below that both sides
# of the terminator reach — a second copy of it is how the two arms would drift apart.
#
# An EMPTY positional is REFUSED rather than read as absent. `${1:-<HEAD>}` fires on empty as
# well as unset, so `board-card-start "$BRANCH"` with BRANCH unexpanded silently retargeted the
# move to whatever HEAD was on — a wrong-card write, not a no-op (the empty-value class, in a
# parser the earlier positional sweep did not reach). Rejecting it here is also what makes the
# `-n "$branch"` tests below sound: they are the "have I seen a positional?" question, and zero
# args (post-checkout's only call form) must still fall back to HEAD.
#
# Every refusal is LOUD on stderr and still exits 0. The binding reason is NOT post-checkout:
# that hook passes ZERO arguments, so no refusal arm here is reachable from it at all, and its
# wrapper is `board-card-start >/dev/null 2>&1 || true`, which would swallow a non-zero exit
# anyway. What binds is the OPERATOR-AUTHORED CHAINED hook — an explicitly supported topology
# (docs/HOOKS.md tells operators to chain the toolkit hook into a committed hook by hand;
# board-session-close models its CHAIN-BROKEN state and tests/board-session-close-selftest.sh
# fixtures the unguarded `command -v board-card-start && board-card-start` shape) whose wrapper
# carries no `|| true`. A non-zero exit there propagates: per githooks(5), post-checkout's exit
# status becomes the exit status of `git switch`/`git checkout` (measured on git 2.43 — the
# checkout is not undone, but the command reports failure), so anything driving the checkout
# sees it fail. Deliberately NOT bcs_skip/kb_bcs_log: their wording asserts the branch carries a
# DL/card token, which an argument refusal has not established — and since these forms are
# reachable only from a hand-typed invocation, stderr, not the log file, is the surface that
# reaches whoever typed the command.
_bcs_usage="usage: board-card-start [--lint] [-h|--help] [--] [<branch-name>]"
lint_mode=0
branch=""
end_of_opts=0
while [ "$#" -gt 0 ]; do
    arg="$1"; shift
    if [ "$end_of_opts" = 0 ]; then
        case "$arg" in
            --lint) lint_mode=1; continue ;;
            # STDOUT and rc 0: a REQUESTED help is the requested OUTPUT (pipeable, pageable),
            # unlike the refusals below, which are diagnostics and stay on stderr. Inside the
            # terminator guard on purpose — `board-card-start -- --help` still targets a branch
            # literally named `--help`, which git accepts.
            -h|--help) printf '%s\n' "$_bcs_usage"; exit 0 ;;
            --)     end_of_opts=1; continue ;;
            -*)     echo "board-card-start: unknown option: $arg — no card moved (for a branch name that starts with '-', pass it after --)" >&2
                    echo "$_bcs_usage" >&2; exit 0 ;;
        esac
    fi
    # The single positional owner, reached both before and after `--`.
    kb_require_positional "$branch" "$arg" "<branch-name>" " — no card moved" || {
        echo "$_bcs_usage" >&2; exit 0
    }
    branch="$arg"
done

[ -n "$branch" ] || branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
[ -n "$branch" ] && [ "$branch" != "HEAD" ] || exit 0

if [ "$lint_mode" = 1 ]; then
    warning="$(_bcs_branch_lint_warning "$branch")"
    [ -n "$warning" ] && printf 'board-branch-lint: %s\n' "$warning" >&2
    # A branch carrying a card id gets ONE id-space line at most. The BOARD VERDICT the mover
    # recorded at checkout decides it when there is a current one (silent when the board resolved
    # the id, loud when the board said it is not a card here); the card-id floor — a magnitude
    # guess — is consulted only when no current verdict exists, and its finding rides on the same
    # line as the reason there is none. Both legs read host-local state only — the record under
    # the git dir, the repo's board id, that board's env — never the board: an unreadable API
    # answer is not an empty one, and a lint that reached for the network would have to choose
    # which of those to report as clean. A branch with no card id reads none of it. The floor is
    # not a credential, so a COMMITTED board id may select the env it is read from; the
    # hostlocal-only gate below bounds the token, not this.
    if [ -n "$(_bcs_card_id "$branch")" ]; then
        root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
        board=""; board_envf=""; floor=""
        [ -z "$root" ] || read -r board _ <<<"$(_bcs_board_id "$root/.release-pr.json")"
        verdict_file="$(_bcs_verdict_file "$branch" || true)"
        if warning="$(_bcs_board_verdict_warning "$branch" "$verdict_file" "$board" "$(_bcs_branch_created_at "$branch")")"; then
            [ -z "$warning" ] || printf 'board-branch-lint: %s\n' "$warning" >&2
        else
            [ -z "$board" ] || board_envf="$(kb_board_env_for "$board" || true)"
            [ -z "$board_envf" ] || IFS= read -r floor <<<"$(kb_board_env_get "$board_envf" KB_CARD_ID_FLOOR)"
            floor_warning="$(_bcs_card_id_floor_warning "$branch" "$board" "$board_envf" "$floor")"
            printf 'board-branch-lint: %s%s\n' "$warning" \
                "${floor_warning:+ Meanwhile the card-id floor leg (a magnitude guess, which a recorded verdict overrides): $floor_warning}" >&2
        fi
    fi
    exit 0
fi

# The board verdict record (DL-225, _bcs_verdict_write above). From here on EVERY exit writes one
# for this branch, from the EXIT trap, so no arm — including one added later — can leave the
# previous checkout's verdict standing: an arm that knows the verdict sets it (_bcs_verdict),
# bcs_skip sets `not_checked` with its own reason, and an exit that set nothing is recorded as
# exactly that. A write that fails is logged and changes nothing else: the exit status is the
# `exit` that fired the trap, never the trap's own.
bcs_verdict=""; bcs_verdict_subject=""; bcs_verdict_reason=""
_bcs_verdict_flush() {
    _bcs_verdict not_checked "" "board-card-start exited without reaching a board verdict"
    _bcs_verdict_write "$branch" "$bcs_verdict" "${dl:-}" "${board:-}" "$bcs_verdict_subject" "$bcs_verdict_reason" \
        || kb_bcs_note "board-card-start: the board verdict for branch '$branch' ($bcs_verdict) could not be recorded under this repository's git dir — the pre-push lint will report the branch as NOT RECORDED"
    return 0
}
trap _bcs_verdict_flush EXIT

# DL token from the branch name (case-insensitive); kb_dl_num strips zeros and
# rejects a non-DL, so a malformed token degrades to the card-id path below.
dltok="$(printf '%s\n' "$branch" | grep -oiE 'dl-?[0-9]+' | head -1 || true)"
dl=""
[ -n "$dltok" ] && dl="$(kb_dl_num "$dltok" 2>/dev/null || true)"

# Card-id token — ALWAYS extracted (framework contract #112): a DL that resolves
# to no card falls through to the card-id path, so the native id must be available
# even when a DL token is also present. Extraction is card-id-specific (an explicit
# `card4524` / `card-2950` / `card/2950` / `#2950`, or a typed branch's leading
# >=3-digit id directly after a known type prefix, token-bounded so `feat/2signup`,
# a 2-digit version, or a `dl-189` token can't match), so it never mis-reads a DL as
# a card id. See _bcs_explicit_card_id / _bcs_typed_card_id for the two tiers.
cid_explicit=0
cid_token="$(_bcs_card_id "$branch")"
[ -n "$(_bcs_explicit_card_id "$branch")" ] && cid_explicit=1   # matched the explicit card#N / #N grammar (a named card)

[ -n "$dl" ] || [ -n "$cid_token" ] || { _bcs_verdict not_checked "" "the branch name carries no DL or card-id token"; exit 0; }

command -v curl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || bcs_skip "curl and jq are both required but not both on PATH"

# Board id + API base.
#   board_id: a repo-local UNCOMMITTED `git config kanban.board-id` (#4290) FIRST, else the
#   repo's committed .release-pr.json .promote.board_id. git config wins because the board id
#   now SELECTS A CREDENTIAL (the per-board token below), which makes it a trust decision, and
#   only the host-local value is beyond the reach of a PR. The committed value stays a
#   fallback (release repos carry it) but is digits-validated before use. In practice the two
#   are mutually-exclusive populations — a release repo has the committed file, a non-release
#   repo has the git config — so the order rarely decides anything; it is the per-board-token
#   gate below, not this order, that actually bounds the credential.
#   The board id is not a secret; api_base still resolves from ~/.kanban-host.env below, so
#   neither source adds a committed token surface. A repo unrelated to any board sets neither
#   and the hook no-ops.
#   api_base: the committed value — EXCEPT it is usually a host-scrubbed RFC-2606/6761
#   placeholder (the real kanban host must not live in a repo, bridge #218 / toolkit host-scrub),
#   or absent entirely (a non-release repo). In either case fall back to $KB_API — the real host
#   resolved from ~/.kanban-host.env (KBCARD_API) via kb_load_host_env below — so the hook
#   reaches the real board with NO per-repo config. A genuinely real committed host is used as-is.
root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$root" ] || bcs_skip "not inside a git work tree (cannot resolve the repo root)"
cfg="$root/.release-pr.json"
board=""; committed_api=""; board_src=""
[ -r "$cfg" ] && committed_api="$(jq -r '.promote.api_base // empty' "$cfg" 2>/dev/null)"
read -r board board_src <<<"$(_bcs_board_id "$cfg")"
[ -n "$board" ] || bcs_skip "no board_id — run 'git config kanban.board-id <id>' in this repo, or set .promote.board_id in .release-pr.json (docs/INSTALL.md)"

# Host env → KB_API + KB_HOST_TOKEN_FILE (the host-level token default). Cannot fail; the
# token itself is read below, once the board env is known.
kb_load_host_env

# The board env for THIS board, resolved ONCE — it supplies both the stage ids and (when
# allowed) the per-board token. It is only ever sourced inside kb_board_env_* subshells, so
# it can never move KANBAN_EXPECTED_HOST before the https-host guard that reads it below.
board_envf="$(kb_board_env_for "$board" || true)"

# Per-board token — ONLY when the board id came from the host-local git config. A committed
# .release-pr.json is PR-editable, so honoring it here would let a PR re-point the hook at
# another board's env and send THAT board's token; a committed board id therefore keeps the
# host/default token, exactly as before this change. Per-board tokens are an explicit
# host-local opt-in. (Inverting the board_id order alone would NOT have closed this: the two
# sources are mutually-exclusive populations, so the inversion only ever helps the population
# that never had the exposure — the gate is the real fix.)
board_tok=""
if [ "$board_src" = "hostlocal" ] && [ -n "$board_envf" ]; then
    IFS= read -r board_tok <<<"$(kb_board_env_get "$board_envf" KBCARD_TOKEN_FILE)"
fi
# Reads the token into memory only (not sent until the guarded curls below). MUST stay
# `|| bcs_skip`: unguarded, an unreadable token leaves KB_TOKEN unset and `set -u` aborts the
# next line — and the installed hook wrapper discards stderr, so that reads as a silent dead
# hook with no durable log entry.
# The declaration tiers are this board's env and the host env, and under them the coord
# credential store's `[kanban] api_token_file` pointer is discovered (card#7316). There is no
# DEFAULT tier any more (card#7245: the baked ~/.kanban-dev-token made one file the credential
# for every board on the box). The store rung does not weaken the gate above it: it is
# board-independent and lives outside the repo entirely, so a committed, PR-editable file
# still cannot select which board's credential this hook sends. kb_declared_token_file names
# the file to add the line to on its own stderr; this arm only has to carry the hook's
# fail-soft policy.
tok_where="${board_envf:-$HOME/.kanban-host.env}"
tokfile="$(kb_declared_token_file "$tok_where" "$board_tok" "${KB_HOST_TOKEN_FILE:-}")" \
    || bcs_skip "no kanban token file is declared for this board (see docs/INSTALL.md §3)"
kb_read_token "$tokfile" \
    || bcs_skip "kanban token file not readable: $tokfile (see docs/INSTALL.md §3)"
token="$KB_TOKEN"

# Effective api_base: the committed value, unless it is a documentation-placeholder host
# (host-scrubbed) or absent (committed_api empty — a non-release repo) — then the host-env-
# resolved KB_API is the real one. _bcs_is_placeholder_host recognizes the RFC-2606/6761
# reserved forms the scrub may emit (example.{com,net,org}, .invalid, .test, .localhost, the
# bare .example TLD), anchored so a real host that merely contains such a substring is not
# misread (#34); empty committed_api is treated as "placeholder" so it falls back to KB_API.
api="$committed_api"
if _bcs_is_placeholder_host "$api"; then
    api="${KB_API:-}"
fi
if [ -z "$api" ]; then
    bcs_skip "no usable kanban api_base — committed .release-pr.json is host-scrubbed/absent and \$KBCARD_API is unset (create ~/.kanban-host.env; see docs/INSTALL.md)"
fi

# THE ONLY SPELLING OF THE BASE THAT MAY BE RENDERED, resolved once here so every message
# from this point on inherits it rather than having to remember (card#7500). An api_base is
# allowed to carry userinfo (`https://u:pw@host/api/v3`) and the host guard ACCEPTS it by
# design — while this hook's diagnostics go to a DURABLE log ($KB_BCS_LOG, kb_bcs_log above),
# where a password outlives the run on disk. Reads $api, which is final by now.
api_shown="$(kb_redact_url_userinfo "$api")"

# Guard the api_base before sending the token — a malicious .release-pr.json edit (or
# host-env value) must not exfiltrate the token to an untrusted host (#3570). Fail-SOFT
# (exit 0 — this runs from a post-checkout hook and must NEVER block a checkout) but
# LOUD on stderr; the token is simply never sent when the host isn't trusted.
kb_require_https_host "$api" || bcs_skip "api_base '$api_shown' failed the https-host trust guard (KANBAN_EXPECTED_HOST)"

# The card read + the two writes below go through the shared kb_api / kb_api_status, which
# resolve the host and bearer from KB_API / KB_TOKEN. api is the effective base resolved+guarded
# above; KB_TOKEN is already this board's token (kb_read_token set it), but pin both explicitly
# so the shared callers can't reach for a stale ambient value.
KB_API="$api"; KB_TOKEN="$token"

# Stage ids for THIS board, from the SAME board env resolved above (a second matcher here
# was free to pick a different file than the token's on a duplicate KB_BOARD_ID), via the
# shared reader — so the ids get the same clean-slate read as the token: a key this env does
# not set comes back EMPTY rather than inheriting another board's exported value.
# Scope of that, honestly: stage ids are unique to one board, so a foreign id simply never
# matches this board's cards — the reachable case is a board env MISSING a required key,
# where the guard below would pass on an inherited id and the PATCH would then name a stage
# that isn't on this board. Empty is the correct answer, and it fail-softs at the guard.
inprog=""; backlog=""; prioritized=""; held=""
if [ -n "$board_envf" ]; then
    { IFS= read -r inprog; IFS= read -r backlog; IFS= read -r prioritized; IFS= read -r held; } \
        <<<"$(kb_board_env_get "$board_envf" KB_STAGE_IN_PROGRESS KB_STAGE_BACKLOG KB_STAGE_PRIORITIZED KB_STAGE_HELD)"
fi
# Held is optional (a board may not have the column); backlog/prioritized/in_progress
# are required for any promotion to make sense.
[ -n "$inprog" ] && [ -n "$backlog" ] && [ -n "$prioritized" ] || bcs_skip "no ~/.kanban-*-board.env has KB_BOARD_ID=$board with in-progress/backlog/prioritized stage ids"

# A branch CREATION is the genuine work-start signal for a Held card (contract
# PR #113); a re-checkout of an existing branch must not un-park it. The branch's
# reflog records `branch: Created from …` exactly once at creation and it stays the
# LAST entry (commits/checkouts prepend). On `git switch -c` the post-checkout hook
# fires with that entry ~0s old; a later re-checkout sees it aged. A fresh clone
# landing on an existing branch logs `clone: …`, which does not match — so cloning
# can't un-park. Fail-soft: no reflog / unparsable timestamp → NOT a creation.
branch_just_created() {
    local ts age
    ts="$(_bcs_branch_created_at "$branch")"
    [ -n "$ts" ] || return 1
    age=$(( $(date +%s) - ts ))
    [ "$age" -ge 0 ] && [ "$age" -le "${KB_HELD_CREATE_MAX_AGE:-15}" ]
}

# Resolve the card (task) id to move — try-in-order-with-fallback (framework #112):
# resolve on the OUTCOME of a token, not its presence. via_cardid records that the
# card was selected by native id (the stamp step below keys on it).
via_cardid=0
if [ -n "$dl" ]; then
    # Whole-board paginated fetch (fix: was page-1 only, so a DL beyond page 1 was
    # missed). Match NUMERICALLY through KB_JQ_REF_CANON, so every WELL-FORMED stored
    # form — "DL-093" (legacy 3-pad), "DL-0156" (canonical), or a bare 156 — resolves,
    # and a stamp that is not ONE decorated integer selects NO card (card#7592).
    #
    # ⛔ THE GUARD IS THE FIX, not decoration. The previous reader took the FIRST digit
    # run of the stored value (`capture("(?<n>[0-9]+)")`), so a card stamped "1.5"
    # answered to DL-1 and this hook MOVED it — the wrong card, on an ordinary branch
    # checkout, with the move landing in the board changelog as a legitimate event. It
    # now correlates to nothing, so the DL either falls through to a card-id token or
    # reaches the loud unresolved-DL refusal below; both are recoverable by hand, a
    # wrong move is not. The rule, the two shipped spellings of it, and the reasoning
    # live at KB_JQ_REF_CANON in _kb-board-lib.sh — never restate it here.
    #
    # A bare `||`, so this arm catches paginator rc 1, 2, 3 AND 4 — all four measured
    # reaching it. It therefore names the rc and no cause, per the wording rule at
    # fetch_board_cards' header. Where the cause is instead: this bin does not set
    # KB_FETCH_LOUD, so the paginator's own line is suppressed for rc 1 and rc 2 — it
    # still prints unconditionally for rc 3 and rc 4 — and on the installed hook path
    # (`board-card-start >/dev/null 2>&1 || true`, hooks/post-checkout) ALL of it is
    # discarded anyway. What survives there is kb_bcs_log's durable log FILE, which
    # carries this line and nothing from the lib, so a cause named here would be the
    # operator's only lead and wrong on three rcs out of four.
    cards="$(fetch_board_cards "$api" "$token" "$board")" \
        || bcs_skip "board $board did not return a complete card list (fetch rc=$?)"
    cid="$(printf '%s' "$cards" | jq -r --argjson want "$dl" "$KB_JQ_REF_CANON"'
        [ .[]
          | (.payload.dl_number | norm) as $n
          | select($n != "")
          | select(($n | tonumber) == $want)
          | .id ] | .[0] // empty' 2>/dev/null)"
    if [ -n "$cid" ]; then
        # (1)/(3) DL resolved → it wins. A co-present card-id token is ignored (loud).
        label="DL-$dl"
        [ -n "$cid_token" ] && [ "$cid_token" != "$cid" ] \
            && echo "board-card-start: branch names DL-$dl (card #$cid) and #$cid_token — DL wins; #$cid_token ignored" >&2
    elif [ -n "$cid_token" ]; then
        # (2) DL tracks no card yet (the unstamped-card class) → fall through to the
        # card-id path instead of dead-ending. The stamp step below writes dl_number.
        cid="$cid_token"; label="#$cid_token"; via_cardid=1
        echo "board-card-start: DL-$dl matches no card — falling through to #$cid_token (framework #112)" >&2
    else
        # (4) DL present, unresolved, no card-id fallback → a high-value miss (a
        # decision-logged-but-unstamped card). Loud, never a silent no-op.
        _bcs_verdict absent "" "DL-$dl matches no card on board $board, and the branch names no card id to fall back to"
        bcs_skip "branch names DL-$dl but no card carries that dl_number and there is no card-id fallback token"
    fi
else
    cid="$cid_token"
    label="#$cid_token"
    via_cardid=1
fi
[ -n "$cid" ] || bcs_skip "internal: no card id resolved after a token match"

# Fetch the card; read its current stage AND board. The board-match guard bounds
# the card-id path — a bare number can only move a card on the repo's own board.
# kb_api_status returns "<http>\n<body>" and always yields a clean status (a curl transport
# failure → "000"), so the caller can still tell a 404 (no such card) from a 401/403 (bad/scoped
# token) from an unreachable host — the distinction the local `-fsS` read would have collapsed.
resp="$(kb_api_status GET "/tasks/$cid.json")"
http="${resp%%$'\n'*}"
card="${resp#*$'\n'}"
if [ "$http" != "200" ]; then
    # Attribute the failure to its ACTUAL cause. Only a 404 means the card isn't there.
    case "$http" in
        404) ;;   # fall through to the not-a-card handling below
        000) bcs_skip "card #$cid could not be read — the kanban API at $api_shown is unreachable; the card was NOT confirmed missing" ;;
        401|403) bcs_skip "card #$cid could not be read — the kanban API rejected the token from ${KB_TOKEN_FILE:-?} (HTTP $http); the card was NOT confirmed missing" ;;
        *) bcs_skip "card #$cid could not be read — the kanban API returned HTTP $http; the card was NOT confirmed missing" ;;
    esac
fi
cur="$(printf '%s' "$card" | jq -r '.data.workflow_stage_id // empty' 2>/dev/null)"
cbd="$(printf '%s' "$card" | jq -r '.data.board_id // empty' 2>/dev/null)"
if [ -z "$cur" ]; then
    # The resolved id is not a real card (a 404, or a 200 whose body has no stage). For a DL
    # path this is unreachable (the fetch was board-scoped and matched); for the card-id path
    # the branch's number is not a card. Loud ONLY when the branch NAMED a card explicitly
    # (card#N / #N) — a genuine miss; the implicit typed-branch leading id (often a foreign
    # ticket number, a routine false positive) is silent.
    # The RECORD is stricter than that log line on two inputs. Only a 404 is the board saying "no
    # such card": a 200 whose body carries no stage is an answer nothing could be read out of. And
    # a record judges the branch's OWN card id: a card the DL search matched that then fails its
    # read says nothing about that id. Both are recorded as not checked, so the lint never repeats
    # them as a confirmed absence.
    if [ "$via_cardid" != 1 ]; then
        _bcs_verdict not_checked "" "DL-$dl matched card #$cid on the board search, but its read answered HTTP $http with no workflow stage — the branch's own card id was not judged"
    elif [ "$http" = 404 ]; then
        _bcs_verdict absent "" "card #$cid: HTTP 404"
    else
        _bcs_verdict not_checked "" "the board answered HTTP $http for card #$cid, but no workflow stage could be read from the body — the card was NOT confirmed missing"
    fi
    [ "${cid_explicit:-0}" = 1 ] && bcs_skip "card #$cid named in the branch does not exist"
    exit 0
fi
if [ "$cbd" != "$board" ]; then
    # Designed SILENT scope guard (see header): a card-id number that lives on ANOTHER board is
    # a deliberate no-op — a stray number must not promote an unrelated task. A routine correct
    # outcome, never a failure, so never loud (that would train agents to ignore hook output).
    # Silent HERE; the record still says the id is not a card on this board, for the lint — when
    # the id is the branch's own (a DL-matched card is not, as above).
    if [ "$via_cardid" != 1 ]; then
        _bcs_verdict not_checked "" "DL-$dl matched card #$cid on the search of board $board, but its read names board ${cbd:-<none>} — the branch's own card id was not judged"
    elif [ -n "$cbd" ]; then
        _bcs_verdict absent "" "card #$cid is a card on board $cbd"
    else
        _bcs_verdict not_checked "" "the board answered for card #$cid, but no board id could be read from the body — the card was NOT confirmed to be on another board"
    fi
    exit 0
fi
_bcs_verdict resolved "$cid" "card #$cid ($label)"

# Opt-out (framework contract, agent-board-framework PR #113): a card a human has
# pinned — a non-empty block_reason OR a `no-automove` tag — is NEVER auto-moved,
# regardless of stage. Loud refusal so the skipped move is visible.
breason="$(printf '%s' "$card" | jq -r '.data.block_reason // empty')"
sticky="$(printf '%s' "$card" | jq -r 'any((.data.tags // [])[]; . == "no-automove")')"
if [ -n "$breason" ] || [ "$sticky" = "true" ]; then
    bcs_skip "card #$cid ($label) is pinned (block_reason/no-automove) — auto-move refused"
fi

# Stamp the dl_number write-site (framework contract #112 step 2). When the card
# was selected by native id AND the branch also names a DL, write payload.dl_number
# so the downstream DL-correlated movers (bridge writeback, release promote) stop
# no-op'ing on this card — the failure that stranded the #2179 class. if-empty only:
# never overwrite a differing stamp (loud warn). The kanban API MERGES payload
# per-key (#2180), so PATCH only {dl_number} — the other custom fields are left as-is
# (and a concurrent edit to them survives, which read-merge-write would clobber). Runs
# regardless of the stage-gate below (a card past the move stages still needs the
# stamp), but AFTER the pinned/opt-out guard — a hands-off card gets no automated
# write at all. Fail-soft — never blocks.
if [ "$via_cardid" = 1 ] && [ -n "$dl" ]; then
    curdl="$(printf '%s' "$card" | jq -r '.data.payload.dl_number // empty' 2>/dev/null)"
    # The SAME reader rule as the selection above (KB_JQ_REF_CANON), for the same reason one
    # property over: this comparison used to take the FIRST digit run, so a card stamped
    # "1.5" on a DL-1 branch compared EQUAL and the conflict warning was suppressed (card#7592).
    # Both arms here are write-free — the stamp writes only when the card carries NO stamp —
    # so the cost was never a bad write, it was the operator not being told that the card
    # holds a value no correlating tool can read. It now answers "" for such a stamp, which
    # can never equal a DL ($dl is kb_dl_num-validated, so >= 1), and the warning fires.
    curdl_num="$(printf '%s' "$card" | jq -r "$KB_JQ_REF_CANON"'.data.payload.dl_number | norm' 2>/dev/null)"
    if [ -z "$curdl" ]; then
        want="$(kb_dl_canon "$dl" 2>/dev/null || true)"
        if [ -n "$want" ]; then
            _bcs_patch "$cid" "$(jq -nc --arg dl "$want" '{payload: {dl_number: $dl}}')" \
                "board-card-start: card #$cid stamped payload.dl_number=$want (was unstamped; DL-$dl named in branch)" \
                "card #$cid dl_number stamp (=$want) failed"
        fi
    elif [ "$curdl_num" != "$dl" ]; then
        echo "board-card-start: card #$cid has dl_number=$curdl but branch names DL-$dl — NOT overwriting (stamp conflict)" >&2
    fi
fi

# Promote-from policy (contract PR #113):
#   - Backlog / Prioritized → promote on any branch checkout (unchanged: a
#     never-worked card advancing on a checkout is the intended work-start signal).
#   - Held → promote ONLY on a genuine branch CREATION. Re-checking-out an existing
#     branch onto a Held card is a deliberate no-op — the original re-fire
#     protection the manual-only default guaranteed. `branch_just_created` reads the
#     branch's own reflog (fail-soft: no reflog / unparsable → not-a-creation).
#   - Anything else (In Progress / In Review / Shipped / Released / Won't-Do) →
#     never touched.
case "$cur" in
    "$backlog" | "$prioritized") ;;
    "$held")
        # Reached only when cur == held (a non-empty stage id); promote only on a
        # genuine creation, else leave the parked card put.
        branch_just_created || exit 0
        ;;
    *) exit 0 ;;
esac

_bcs_patch "$cid" "$(jq -nc --argjson s "$inprog" '{workflow_stage_id: $s}')" \
    "board-card-start: card #$cid ($label) → In Progress" \
    "card #$cid ($label) → In Progress move failed"
# _bcs_patch is fail-soft (rc 0 either way); kb_api left the move's status in KB_HTTP, in this
# shell, and only a move that landed gets an owner tag (see the header).
case "${KB_HTTP:-}" in
    2*) kb_owner_tag_write stamp "$cid" "card #$cid ($label)"
        [ -z "$KB_OWNER_NOTE" ] || kb_bcs_note "$KB_OWNER_NOTE" ;;
esac
exit 0
