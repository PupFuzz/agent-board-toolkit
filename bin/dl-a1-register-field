#!/usr/bin/env bash
# dl-a1-register-field — stand up the `dl_number` custom field on a DL board and
# real-surface-verify the server derives the `system=dl` by-ref index from it.
#
# ⛔ `dl_number` MUST be declared STRING-typed, and this tool is what declares it.
# Every toolkit writer of that field writes the canonical `DL-NNNN` STRING through the
# one renderer `kb_dl_canon` — `kbcard --dl`, `next-dl`, `adopt-to-dl` — and kanban's
# CustomFieldValidator enforces a field's DECLARED type per board, so a NUMBER-typed
# `dl_number` rejects every one of those writes with `422 {"message":"Must be a number."}`.
# The board is then broken at first use, with nothing in the setup log saying so. The
# type is not cosmetic and it is not interchangeable: the derived `system=dl` by-ref
# index canonicalizes by stripping non-digits, so it works from EITHER type — the index
# is why the wrong declaration looks fine, not evidence that it is.
#
# One-shot, idempotent (DL adoption Phase 0, A1). Steps:
#   1. register the `dl_number` custom field (type STRING) — flat body. A 409/422 means
#      a definition already exists, which is an idempotent success ONLY IF that existing
#      definition is string-typed: the type is READ BACK off the board's field index and
#      a non-string one is refused with its remedy (see step 1's block below).
#   2. create a THROWAWAY card carrying payload.dl_number = the CANONICAL DL-NNNN form
#      of <sentinel>, rendered through kb_dl_canon — the same renderer every production
#      writer stamps through. That is deliberate and load-bearing: this step is the only
#      acceptance test the setup path has, and while it wrote a bare JSON NUMBER it was
#      testing the ONE value shape no toolkit writer ever produces, so it passed on a
#      board where every real `--dl` write 422s (card#6517).
#   3. verify GET .../tasks/by-ref.json?system=dl&ref=<sentinel> resolves it.
#   4. CLEANUP — clear dl_number, verify by-ref is now empty, then DELETE the
#      throwaway. A leaked sentinel card would poison the DL minter's
#      max(dl_number) seed, so cleanup runs even if the verify failed.
#
# Exit 0 only if (found AND by-ref now empty AND throwaway deleted AND no
# residue on a final by-ref check). A re-run is a clean no-op.
#
# ⛔ A BY-REF READ THAT MEASURED NOTHING IS ITS OWN OUTCOME — exit 3, never 0 and never 1.
# Two of this tool's three by-ref dispositions treat an ABSENT result as their PASS condition
# ("after clear … empty", "zero residue"), so a read that could not be read — a gateway's HTML
# or JSON error page at 200, a truncated body, a non-2xx, a request that never completed — used
# to print BOTH pass lines and exit 0 over a board this tool never measured (card#10241). The
# caller of a setup tool has to be able to tell *"I checked and it is clean"* from *"I could not
# check"*, so they are different exit codes:
#
#   0  verified — every by-ref read completed and said what it had to say.
#   1  verification FAILED, measured: by-ref did not resolve the throwaway, or the sentinel
#      still resolves after the clear or after the delete — to the throwaway OR to any other
#      card (a sentinel leaked by an earlier run is residue too, card#10426).
#   2  usage / config — refused before any request.
#   3  UNMEASURED — at least one by-ref read returned nothing this tool could read, and no
#      measured failure was seen. NOTHING in a run that exits 3 says the route works, and
#      nothing says the board is residue-free. The throwaway teardown still runs.
#
# 3 is the toolkit's published "sent, but nothing could be read back" exit code (kbcard's rc 3
# UNVERIFIED WRITE, the lib's KB_RC_UNVERIFIED), so an operator reading a 3 out of any of these
# tools reads one meaning. A MEASURED failure OUTRANKS an unmeasured read when a run sees both —
# the ordering bin/run-coverage-check states for MISSING vs UNMEASURED, and for its reason:
# neither scores 0 in either ordering, so the ordering is free to report the strongest claim
# that is TRUE.
#
# Usage: dl-a1-register-field [--board NAME] [--stage ID] [--swimlane ID] [--sentinel N]
#
# Genericized (the reference hard-coded these):
#   board id / API base / token file  — from config at runtime (next-dl model).
#   --stage     throwaway's workflow_stage_id (default: KB_A1_STAGE or KB_STAGE_BACKLOG).
#   --swimlane  throwaway's swimlane_id        (default: KB_A1_SWIMLANE, else the key is
#               OMITTED from the create body entirely — see step 2).
#   --sentinel  the throwaway's dl_number      (default: KB_A1_SENTINEL or 999001).
#               Must be a value extremely unlikely to collide with a real DL, and it is
#               validated by kb_dl_num — the SAME strict parser `kbcard --dl` uses — so
#               it is bounded to 1..6 digits like every other DL this toolkit renders.
#               A sentinel this tool cannot canonicalize is refused at rc 2 before any
#               request, rather than at the create the board would have rejected.

set -euo pipefail

# --- shared lib -------------------------------------------------------------
# Sourced BEFORE the arg loop, which parses with the lib's kb_require_value. The
# ordering is load-bearing (it matches next-dl/kbcard/adopt-to-dl): a lib-less
# install now reports the missing lib at rc 1 on EVERY invocation, where it
# previously answered the whole arg loop first. `--help` is the widest-known case
# but not the only one — measured lib-less, `--help` went 0 -> 1 and `--bogus`, a
# trailing value-taking flag and a stray positional each went 2 -> 1.
# Board env: ~/.kanban-<name>-board.env (default kanban-dev). API base lives in
# ~/.kanban-host.env (board-independent). Token file path may be set inside
# either config; kb_load_config resolves it AFTER both are sourced.
# KB_API_QUIET=1 keeps kb_api silent on a non-2xx (this script's callers print
# their own FATAL message and branch on the status themselves).
KB_LIB="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)/_kb-board-lib.sh"
[ -r "$KB_LIB" ] || { echo "$(basename "${BASH_SOURCE[0]}"): shared lib _kb-board-lib.sh not found next to this script — reinstall per INSTALL.md §3 (symlink all of bin/), or vendor _kb-board-lib.sh alongside this tool." >&2; exit 1; }
# shellcheck source=bin/_kb-board-lib.sh
source "$KB_LIB"
KB_PROG="dl-a1-register-field"
KB_API_QUIET=1

USAGE='usage: dl-a1-register-field [--board NAME] [--stage ID] [--swimlane ID] [--sentinel N]'

board_name=""
stage_arg=""
swimlane_arg=""
sentinel_arg=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --board)    kb_require_value "$1" "${2:-}" || exit 2; shift; board_name="$1" ;;
        --stage)    kb_require_value "$1" "${2:-}" || exit 2; shift; stage_arg="$1" ;;
        --swimlane) kb_require_value "$1" "${2:-}" || exit 2; shift; swimlane_arg="$1" ;;
        --sentinel) kb_require_value "$1" "${2:-}" || exit 2; shift; sentinel_arg="$1" ;;
        -h|--help)  echo "$USAGE"; exit 0 ;;
        *) echo "$USAGE" >&2; exit 2 ;;
    esac
    shift
done

# --- config resolution (shared lib, sourced above) ---------------------------
kb_load_config "$board_name" || exit 2   # sets KB_API / KB_BOARD_ID / KB_TOKEN / KB_HTTP
BOARD="${KB_BOARD_ID:?KB_BOARD_ID not set — check $KB_BOARD_ENV}"

STAGE="${stage_arg:-${KB_A1_STAGE:-${KB_STAGE_BACKLOG:-}}}"
SWIMLANE="${swimlane_arg:-${KB_A1_SWIMLANE:-}}"
SENTINEL="${sentinel_arg:-${KB_A1_SENTINEL:-999001}}"
if [[ -z "$STAGE" ]]; then
    echo "dl-a1-register-field: no throwaway stage — pass --stage or set KB_A1_STAGE/KB_STAGE_BACKLOG in $KB_BOARD_ENV" >&2
    exit 2
fi
# The sentinel is validated by the SAME strict parser the write-side uses, not by a
# looser local one: what step 2 puts on the wire is kb_dl_canon's output, so a value
# kb_dl_num refuses cannot become a payload at all. kb_is_uint stood here and admitted
# every unsigned integer, including the 9-digit default this tool used to ship —
# canonicalizing that is rc 2 from kb_dl_canon, mid-run, AFTER the registration write.
# kb_dl_num prints its own refusal naming the value; add this tool's own required-shape
# line beside it so the message names the flag as the other refusals here do.
SENTINEL="$(kb_dl_num "$SENTINEL")" || {
    echo "dl-a1-register-field: --sentinel must be a DL number this toolkit can render (1..6 digits, optional DL- prefix)" >&2
    exit 2
}
SENTINEL_DL="$(kb_dl_canon "$SENTINEL")"

# The `--board` fragment the remediation lines below echo back, so the command they print is
# the one THIS run would need — an unqualified `kbcard field retype` would silently target the
# default board when this run was pointed at another one with --board.
KBC_BOARD_ARG=""
[[ -n "$board_name" ]] && KBC_BOARD_ARG=" --board $board_name"

# A1_RC_UNMEASURED — this tool's exit code for "a by-ref read measured nothing", and the rc
# by_ref_state returns for that outcome. Pinned once so the reads and the verdict cannot drift
# apart; the value is 3 for the reason the header states.
A1_RC_UNMEASURED=3

# The by-ref read for $SENTINEL, as THREE outcomes, never two:
#   0                   READ, and card $1 is in the result.
#   1                   READ, and it is not — a MEASURED negative.
#   $A1_RC_UNMEASURED   NOTHING WAS READ: the request did not complete, the server answered a
#                       non-2xx, or the 2xx body was not a by-ref result (kb_by_ref_hit's
#                       $KB_RC_BYREF_UNREADABLE).
# ⛔ The third outcome is NOT a miss, and folding it into rc 1 is the defect this shape exists to
# prevent: `|| return 1` on the kb_api failure, plus a predicate that scored an undecodable body
# as a non-hit, made every unreadable answer arrive at the two call sites below that treat a miss
# as their pass condition (card#10241). A non-2xx is in that third outcome for the same reason an
# undecodable 2xx is: a 500 on this GET is not evidence the index resolves nothing.
#
# BY_REF_WHY carries WHICH of those three producers it was, because they are three different
# next actions for the operator and this tool is the only surface that can say: KB_API_QUIET=1
# keeps the lib's own non-2xx line off stderr, and KB_HTTP is set inside the `$(…)` subshell the
# body capture needs, so the rc is the only channel that crosses (kb_api's own contract says so).
# It is set on EVERY path, including the ones that do not read it, so a stale value from an
# earlier read can never be printed beside a later one.
#
# BY_REF_IDS carries EVERY card id a READ result named, this run's throwaway or not, and is empty
# on the other two outcomes. The after-clear and acceptance reads ask whether the SENTINEL still
# resolves, not whether it resolves to $TID: a card an earlier run's failed teardown leaked carries
# the same sentinel and poisons the minter's seed exactly as this run's own would, so at those two
# reads any id here is residue, whoever it names (card#10426). rc 1 alone cannot say that — it is
# "$TID is not in the result", which a result naming only a foreign card also answers.
BY_REF_WHY=""
BY_REF_IDS=""
by_ref_state() {
    local resp arc=0 rc=0
    BY_REF_WHY=""
    BY_REF_IDS=""
    resp="$(kb_api GET "/boards/$BOARD/tasks/by-ref.json?system=dl&ref=$SENTINEL")" || arc=$?
    if [[ "$arc" != 0 ]]; then
        if [[ "$arc" == "$KB_API_RC_TRANSPORT" ]]; then
            BY_REF_WHY="the request DID NOT COMPLETE — no HTTP status came back at all"
        else
            BY_REF_WHY="the server ANSWERED the by-ref read and not with a 2xx"
        fi
        return "$A1_RC_UNMEASURED"
    fi
    kb_by_ref_hit "$resp" "$1" || rc=$?
    case "$rc" in
        0|1) BY_REF_IDS="$KB_BY_REF_ROW_IDS"
             return "$rc" ;;
        *)   BY_REF_WHY="the read returned a 2xx whose body is NOT a by-ref result — a gateway's sign-in or error page, a truncated read, or a JSON error envelope"
             return "$A1_RC_UNMEASURED" ;;
    esac
}

# --- 1. register dl_number (flat body) --------------------------------------
# This is the one call that must branch on the EXACT status (409/422 =
# already-registered = idempotent OK — the headline re-run guarantee). kb_api's
# status global can't cross the $() a body capture needs, so use the
# status-exposing kb_api_status, which emits "<http>\n<body>". HTTP 000 (curl
# transport failure) falls through to the FATAL else below.
reg_out="$(kb_api_status POST "/boards/$BOARD/custom_fields.json" '{"key":"dl_number","label":"DL","type":"string"}')"
reg_http="${reg_out%%$'\n'*}"
reg_body="${reg_out#*$'\n'}"
if [[ "$reg_http" =~ ^2 ]]; then
    # 2>/dev/null alone silenced the MESSAGE and kept the STATUS: a 2xx whose body is not JSON
    # (a proxy's HTML, a truncated read) still exited 5 through `set -e` — quietly, which is
    # worse than loudly. kb_parse_resp (shared lib) yields the empty value the `${fid:-?}` arm
    # below was already written for.
    fid="$(kb_parse_resp "$reg_body" -r '.data.id // empty')"
    echo "  registered dl_number as a STRING field (field id ${fid:-?})"
elif [[ "$reg_http" == "409" || "$reg_http" == "422" ]]; then
    # A PRE-EXISTING definition is not, on its own, a working one. The 409/422 says only
    # that the key is taken; it says nothing about the type it was taken WITH, and this arm
    # used to report "idempotent OK" over both. That is how a number-typed dl_number reaches
    # first use: the board this tool just certified rejects every `kbcard --dl` write with
    # `422 Must be a number.`, and the only surface that could have caught it — this one —
    # had already declared success (card#6517).
    #
    # So the type is READ BACK, not assumed. The board's field index is the only read
    # surface for a definition (there is no GET /custom_fields/<id>.json), which is why this
    # is a whole-board read for one field.
    fields_resp="$(kb_api GET "/boards/$BOARD/custom_fields.json")" || {
        echo "dl-a1-register-field: FATAL: registration was refused (HTTP $reg_http, i.e. a dl_number definition already exists) and the board's custom-field index could not be read, so the EXISTING declaration's type is unknown. This tool cannot certify a board it cannot read: re-run once the board reads, or check the type with 'kbcard${KBC_BOARD_ARG} field list'." >&2
        exit 1
    }
    existing_type="$(kb_parse_resp "$fields_resp" -r '.data[]? | select(.key == "dl_number") | .type')"
    case "$existing_type" in
        string)
            echo "  dl_number already registered, STRING-typed (HTTP $reg_http) — idempotent OK" ;;
        "")
            echo "dl-a1-register-field: FATAL register: HTTP $reg_http, but the board's custom-field index carries NO dl_number definition — so the refusal was not 'already registered'. The response body was: $reg_body" >&2
            exit 1 ;;
        *)
            echo "dl-a1-register-field: FATAL: this board declares dl_number as '$existing_type', and it must be 'string'. Every toolkit write of that field is the canonical DL-NNNN STRING (kbcard --dl, next-dl, adopt-to-dl, and step 2 of this tool), and kanban validates a payload value against the field's DECLARED type — so on this board every one of those writes is rejected with 422 \"Must be a number.\" No throwaway card was created." >&2
            echo "dl-a1-register-field:   Fix it in place — 'field retype' converts the definition AND every stored value in one server-side transaction, issuing no delete, so this costs no delete-and-recreate:" >&2
            echo "dl-a1-register-field:     kbcard${KBC_BOARD_ARG} field retype --field dl_number --to string --restamp-dl" >&2
            echo "dl-a1-register-field:   then re-run this tool. (--restamp-dl is what rewrites the converted values to the canonical DL-NNNN form; without it a card holding 305 converts to the string \"305\", which a DSL filter spelled DL-0305 does not match.)" >&2
            exit 1 ;;
    esac
else
    echo "dl-a1-register-field: FATAL register: HTTP $reg_http" >&2
    exit 1
fi

# --- 2. throwaway card with payload.dl_number = the CANONICAL DL-NNNN form -----
# `--arg`, not `--argjson`: the value on the wire is the DL-NNNN STRING every production
# writer stamps, which is the whole point of this step as an acceptance test. It used to be
# `--argjson` over a bare integer, i.e. the one shape no toolkit writer produces — so on a
# number-typed board this verification passed while every real `--dl` write 422'd.
#
# swimlane_id rides ONLY when the caller named a lane. The card is a throwaway the cleanup
# trap deletes seconds later and its lane placement is irrelevant to the one thing this step
# measures — that the server derives the by-ref index from payload.dl_number — so there is
# nothing for a default to be derived FROM. The `1` that stood here was fabricated: on a board
# that defines no swimlanes the create is refused
# `422 {"message":"The selected swimlane is not on this board."}` and no id exists that the
# caller could pass instead, which made the toolkit's own documented DL-board setup step
# unrunnable on a fresh install. Omitted, not null: the key-absent form is what `kbcard
# create-card` already sends when no --swimlane is given.
body="$(jq -n \
    --argjson board "$BOARD" \
    --argjson stage "$STAGE" \
    --arg swim_set "$SWIMLANE" \
    --argjson swim "${SWIMLANE:-null}" \
    --arg sentinel "$SENTINEL_DL" \
    '{board_id: $board, workflow_stage_id: $stage,
      name: "[A1-verify] dl_number throwaway — delete me",
      payload: {dl_number: $sentinel}}
     + (if $swim_set != "" then {swimlane_id: $swim} else {} end)')"
create="$(kb_api POST "/tasks.json" "$body")" || {
    # kb_api's KB_HTTP global doesn't cross this $(), so don't claim a code we can't see.
    echo "dl-a1-register-field: FATAL create throwaway (non-2xx or curl error)" >&2
    exit 1
}
# Tolerant parse: a 2xx body this cannot read is the SAME state as a 2xx carrying no id — the
# throwaway's id is unknown — and that is what the FATAL arm below already says. Dying at jq's
# rc 5 instead skipped it, and with it the cleanup trap's whole reason for existing: a leaked
# sentinel card poisons the minter.
TID="$(kb_parse_resp "$create" -r '.data.id // empty')"
if ! kb_is_uint "$TID"; then
    echo "dl-a1-register-field: FATAL create throwaway: no task id in response" >&2
    exit 1
fi
echo "  throwaway card $TID created with dl_number=$SENTINEL_DL"

# The two throwaway-teardown request bodies, single-sourced: the EXIT trap and the
# explicit success path below issue the identical clear-dl-then-delete pair.
CLEAR_DL_BODY='{"payload":{"dl_number":null}}'
DELETE_BODY='{"_action":"delete"}'

# --- cleanup trap: a leaked sentinel poisons the minter, so always try to ---
# delete the throwaway even if a later step fails loudly.
cleanup_done=0
delete_throwaway() {
    [[ "$cleanup_done" == 1 ]] && return 0
    cleanup_done=1
    kb_api PATCH "/tasks/$TID.json" "$CLEAR_DL_BODY" >/dev/null 2>&1 || true
    kb_api PATCH "/tasks/$TID.json" "$DELETE_BODY" >/dev/null 2>&1 || true
}
trap 'delete_throwaway' EXIT

# report_leaked — name every card in BY_REF_IDS that is NOT this run's throwaway. This run's
# teardown cannot remove those (it only ever touches $TID), so the operator has to, and a leaked
# sentinel left in place is what the minter would seed from.
report_leaked() {
    local id
    for id in $BY_REF_IDS; do
        [[ "$id" == "$TID" ]] && continue
        echo "  card $id is NOT this run's throwaway ($TID) but carries the sentinel — a leak (e.g. an earlier run's failed teardown). This run does not touch it; clear its dl_number and delete it before seeding a DL minter from this board: kbcard${KBC_BOARD_ARG} show --task $id" >&2
    done
}

# --- 3. by-ref must resolve the throwaway -----------------------------------
# `found` and `still` below carry the THREE states, not two: `UNMEASURED` is a value they take,
# so the verdict line cannot print a `0` or a `1` for a read that never produced one. `unmeasured`
# accumulates the names of those reads, in the order they ran, and is what selects the rc 3 arm.
unmeasured=""
brs=0; by_ref_state "$TID" || brs=$?
case "$brs" in
    0) found=1; echo "  by-ref system=dl ref=$SENTINEL: FOUND (card $TID)" ;;
    1) found=0; echo "  by-ref system=dl ref=$SENTINEL: NOT FOUND" >&2 ;;
    *) found=UNMEASURED; unmeasured="$unmeasured verify"
       echo "  by-ref system=dl ref=$SENTINEL: UNMEASURED — $BY_REF_WHY. That is not evidence the index does not resolve the throwaway." >&2 ;;
esac

# --- 4. cleanup — clear dl_number, verify by-ref empty, delete --------------
if ! kb_api PATCH "/tasks/$TID.json" "$CLEAR_DL_BODY" >/dev/null; then
    echo "dl-a1-register-field: FATAL clearing dl_number: HTTP $KB_HTTP" >&2
    exit 1   # trap still fires the delete
fi
brs=0; by_ref_state "$TID" || brs=$?
case "$brs" in
    0|1) if [[ -n "$BY_REF_IDS" ]]; then
             still=1; echo "  after clear: by-ref ref=$SENTINEL STILL PRESENT — resolves card(s) $BY_REF_IDS" >&2
             report_leaked
         else
             still=0; echo "  after clear: by-ref ref=$SENTINEL empty"
         fi ;;
    *) still=UNMEASURED; unmeasured="$unmeasured after-clear"
       echo "  after clear: by-ref ref=$SENTINEL UNMEASURED — $BY_REF_WHY. The clear itself was accepted by the server; whether the index stopped resolving the sentinel was NOT measured." >&2 ;;
esac

if ! kb_api PATCH "/tasks/$TID.json" "$DELETE_BODY" >/dev/null; then
    echo "dl-a1-register-field: FATAL deleting throwaway: HTTP $KB_HTTP" >&2
    exit 1
fi
cleanup_done=1   # the explicit delete above succeeded; skip the trap's retry
echo "  throwaway $TID deleted"

# Acceptance: final by-ref must be empty (zero residue).
# ⛔ "zero residue" is a POSITIVE claim about the board's state, so it may only be printed from a
# read that succeeded. An undecodable answer here leaves the residue question open — the delete
# was accepted, and nothing read it back — which is what the UNMEASURED arm says instead.
brs=0; by_ref_state "$TID" || brs=$?
case "$brs" in
    0|1) if [[ -n "$BY_REF_IDS" ]]; then
             echo "dl-a1-register-field: residue — by-ref still resolves $BY_REF_IDS after delete" >&2
             report_leaked
             exit 1
         fi
         echo "  acceptance: by-ref ref=$SENTINEL empty after delete — zero residue" ;;
    *) unmeasured="$unmeasured acceptance"
       echo "  acceptance: by-ref ref=$SENTINEL UNMEASURED — $BY_REF_WHY, so this run makes NO residue claim. Check by hand before seeding a DL minter from this board: kbcard${KBC_BOARD_ARG} show --task $TID" >&2 ;;
esac

# The verdict. A MEASURED failure outranks an unmeasured read (header: both are non-zero, so the
# ordering only decides which true statement the operator gets).
if [[ "$found" == 0 || "$still" == 1 ]]; then
    echo "dl-a1-register-field: verification failed (found=$found still_present=$still)" >&2
    exit 1
fi
if [[ -n "$unmeasured" ]]; then
    echo "dl-a1-register-field: UNMEASURED — the by-ref read(s)$unmeasured returned nothing this tool could read (found=$found still_present=$still). The dl_number field is registered and the throwaway was torn down, but NOTHING here says the system=dl by-ref route works or that the board is residue-free. Re-run once the board reads; a 2xx from an SSO gateway, a WAF or a maintenance page is the usual producer." >&2
    exit "$A1_RC_UNMEASURED"
fi
echo "dl-a1-register-field: OK (field registered + by-ref verified + throwaway removed)"
exit 0
