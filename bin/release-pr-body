#!/usr/bin/env bash
# release-pr-body — deterministically generate a release-PR body scaffold from git.
#
# Generic across repos: reads `.release-pr.json` in the repo root for per-project
# config. The MECHANICAL parts (the bundled-work list, the artifact checklist, the
# version line, the range) are derived from git truth and are 100% deterministic —
# no AI, no hand-curation. The one genuinely non-deterministic part, the
# human-readable "## Highlights", is left as a marked placeholder for the author
# (human or AI) to fill. That split is the design: automate the mechanical, leave
# only judgement to a person.
#
# Usage:
#   release-pr-body [--version X.Y.Z] [--base REF] [--head REF] [--config PATH]
#   release-pr-body --manifest        # print just the machine-readable shipped-ref list (one per line)
#   release-pr-body --card-manifest   # print just the shipped CARD IDs (bare integers, one per line)
#   release-pr-body --tag [--version X.Y.Z]  # print just the git TAG NAME this repo's tag_format maps a version to
#   release-pr-body --tool-version    # print the agent-board-toolkit version THIS FILE is, and exit
#
# STDOUT IS THE BODY, AND ONLY THE BODY (DL-224). It is written for the person installing the
# release: the scope line, `## Highlights`, `## Bundled`, `## Release artifacts` (only when
# `artifacts` is configured) and the machine lines (the `<!-- release-manifest:... -->` footers).
# No other H2 is ever emitted there. Builder diagnostics go to STDERR — kept, not dropped — one
# line per finding, each carrying a fixed prefix so a reader can lift them by grep:
#   release-pr-body: correlation gap: ...  an empty manifest over a non-empty range (card#8538)
#   release-pr-body: card coverage: ...    the promote dry-run's verdict. Emitted ONLY when the
#                                          check could run, so NO such line means it did not run;
#                                          WHEN it runs is the CARD COVERAGE PRECONDITIONS block
#                                          above card_coverage_report, the one statement of it
#   release-pr-body: note: ...             a local ref disagrees with the remote the range used
# No line this tool writes to stderr begins with `## `. Keep the streams apart: `2>&1` into a body
# file writes builder diagnostics into the release PR. And keep stderr OPEN: under `set -e` a
# closed stderr (`2>&-`) fails the run at rc 1 on its first stderr write — at the latest the
# announce block, so such a run can exit 1 with a complete body already on stdout.
#
# THE ANNOUNCE BLOCK — a stable, machine-readable stderr contract, for a release tool to LIFT
# rather than re-derive. A body run that exits 0 ends its stderr with exactly one block. Its
# field list, in emission order, is DECLARED here, and tests/release-pr-body-selftest.sh compares
# this declaration against what the tool emits, both ways and in order:
#     announce:begin
#     format: 1
#     version: <the release version this body describes>
#     tag: <the tag that version maps to under tag_format>
#     base: <the base ref as resolved; empty for a first release>
#     head: <the head ref as resolved>
#     range: <base-sha>..<head-sha>, or <head-sha> alone when there is no base
#     range-cmd: <a git log command that re-prints the bundled commit subjects>
#     shipped-refs: <DL tokens, comma-separated, as the shipped-refs footer has them>
#     shipped-refs-cmd: <the release-pr-body --manifest command that re-prints them>
#     shipped-cards: <bare card ids, comma-separated, as the shipped-cards footer has them>
#     shipped-cards-cmd: <the release-pr-body --card-manifest command that re-prints them>
#     announce:end
# STABILITY, format 1. `announce:begin` and `announce:end` are whole lines; every line between is
# `<key>: <value>`, and a value may be empty. Keys appear in the order above. `shipped-refs*` are
# present only when `ref_token_regex` is declared and `shipped-cards*` only when
# `card_token_regex` is — a declared key that matched nothing is PRESENT with an empty value.
# Within format 1 keys are only ever ADDED, so a reader must ignore a key it does not know;
# renaming or removing one, or changing what a value means, bumps `format`. NO FIELD IS A COUNT:
# a list is given with the command that re-prints it. Every `*-cmd` is shell-quoted, runs from the
# repo root, names this tool by its PATH name and pins each resolved range end by SHA, so it
# answers about the same range later (a first release has no base to pin). The block is never
# emitted by a query mode (`--manifest`, `--card-manifest`, `--tag`, `--tool-version`) or a refusal.
# "Not included" (the scope a release deferred) is not a field of this block: git cannot derive
# deferred scope, so it stays with the release-pr skill, which reports it outside the body.
#
# TWO VERSIONS, TWO FLAGS. `--version X.Y.Z` is an INPUT: the version of the release the body
# describes. `--tool-version` is a QUERY about the tool: the toolkit release this file was stamped
# at, from the `ABTK_TOOL_VERSION` line below. The stamp is EMBEDDED so that a per-seat copy
# away from any checkout answers from itself; tests/tool-version-stamp-selftest.sh holds it equal
# to the toolkit's VERSION file. Its resolution is the RELEASE: a copy taken from `dev` between
# releases reports the last release stamped. It needs no config, no repo and no network, and is
# counted with the other query modes below. BOOTSTRAP BOUND: only a copy new enough to carry the
# flag can answer. Every earlier revision of this file refuses `--tool-version` as `unknown arg`
# at rc 2 — that refusal means "older than the flag", never a version.
#
# `--tag` EXISTS SO THE MAPPING HAS ONE IMPLEMENTATION (card#7203). `.release-pr.json`'s
# `tag_format` is read here and nowhere else; `bin/release-tag-check` needs the same answer to
# know which tag to wait for, and hardcoding `v${VERSION}` there made it poll for a tag that
# cannot exist under a non-`v` scheme — refusing EVERY release at its bound, for any consumer
# who set the key this file documents. It resolves the tag by calling this mode on its sibling,
# exactly as it delegates the release classification to `release-artifacts-check`. The mode
# returns BEFORE the baseline block, so it performs no fetch and touches no network.
#
# TWO REF SPELLINGS, TWO ID SPACES — the config declares each separately because
# they correlate against DIFFERENT card fields, and conflating them promotes the
# wrong card:
#   * `ref_token_regex`  (e.g. "DL-[0-9]+")   — the token's numeric part is a DECISION-LOG
#     number, correlated against a card's `payload.dl_number`.
#   * `card_token_regex` (e.g. "card#[0-9]+") — the token's numeric part is a CARD ID,
#     correlated against the card's own `id`.
# Both are optional and independent; a repo whose commit subjects carry `card#NNNN`
# sets the second. Re-spelling `ref_token_regex` as `card#[0-9]+` is NOT the same
# thing and is a live defect: the numeric part would still be matched against
# `dl_number`, so a range naming card#42 promotes whichever card happens to carry
# DL-42 (measured — it moves that card and reports "0 no-card").
#
# BOTH ENDS OF THE RANGE ARE RESOLVED FROM ORIGIN, and a leg that is DEFAULTED is
# fetched first — a fetch failure is fatal, never a silent fall-back to the local
# ref. A stale local ref is wrong in both directions and silent in both: a stale
# baseline reports already-shipped PRs as new, and a stale head DROPS PRs from the
# bundled table and from the `shipped-cards` manifest footer (card#7517). Each leg's
# explicit flag is that leg's override and skips that leg's fetch, so an offline run
# passes BOTH: `--base <tag> --head <ref>`.
# AN EXPLICIT REF MUST STILL RESOLVE HERE (card#7525) — the flag says WHICH ref to
# use, never that a ref this repo does not have should be read as an empty range;
# skipping the fetch is precisely why nothing else would catch it.
#
# Exit non-zero on a config/usage error, when a required fetch from origin fails,
# or when an explicit --base/--head names no commit in this repo. An empty range
# yields an empty (but valid) bundled section, not a failure — and neither is a
# range that matches neither token spelling: that omits the optional manifest
# footers, and still exits 0. It is no longer SILENT, though: over a NON-EMPTY
# range, a declared token key that matched nothing (and the case where neither
# key is declared at all) is reported as a `correlation gap` on stderr, because an
# omitted footer and a footer with nothing to say are otherwise indistinguishable
# to every reader of this body (card#8538).
set -euo pipefail

ABTK_TOOL_VERSION='0.36.0'

die() { echo "release-pr-body: $*" >&2; exit 2; }

# require_value <flag> <value>: die unless a value-taking option was given a non-empty
# value. An option that consumes "$2" and is then dispatched with `[ -n "$var" ]` reads an
# explicitly-EMPTY value as an ABSENT flag, so `--flag ""` silently selects the default path
# instead of doing what was asked — here `--base ""` would fall back to deriving the
# baseline from local tags, which is the reading this tool exists to make explicit. Also
# converts a trailing flag with no argument from a bare `set -u` unbound-variable error into
# one naming the flag. Mirrors kb_require_value in _kb-board-lib.sh — like the sibling
# mover, this script is self-contained and does not source that lib, so the guard is
# duplicated. THE AGREEMENT IS CHECKED, NOT ASKED FOR (card#8529):
# `tests/mirror-pair-parity-selftest.sh` drives EVERY copy against the lib's over one corpus
# and derives the copy set from the tree, so a fifth one is compared on the day it lands.
require_value() { [ -n "${2:-}" ] || die "$1 requires a non-empty value"; }

CONFIG=".release-pr.json"; VERSION=""; BASE=""; HEAD_REF=""; MANIFEST_ONLY=0; CARD_MANIFEST_ONLY=0; TAG_ONLY=0; TOOL_VERSION_ONLY=0
while [ $# -gt 0 ]; do
  case "$1" in
    --version) require_value "$1" "${2:-}"; VERSION="$2"; shift 2;;
    --base)    require_value "$1" "${2:-}"; BASE="$2"; shift 2;;
    --head)    require_value "$1" "${2:-}"; HEAD_REF="$2"; shift 2;;
    --config)  require_value "$1" "${2:-}"; CONFIG="$2"; shift 2;;
    --tag)      TAG_ONLY=1; shift;;
    --manifest) MANIFEST_ONLY=1; shift;;
    --card-manifest) CARD_MANIFEST_ONLY=1; shift;;
    --tool-version) TOOL_VERSION_ONLY=1; shift;;
    # Contiguous leading comment block, not a fixed range — see the sibling mover. The old
    # `sed -n '2,20p'` happened to print all of the header it was written against, and would
    # have started truncating silently at the first header line added. No line COUNT is
    # restated here on purpose: a number in a comment is the same rot as a number in the
    # range, one indirection out. help-output-selftest re-derives it from the file.
    -h|--help) awk 'NR>1 { if (substr($0,1,1) == "#") print; else exit }' "$0"; exit 0;;
    *) die "unknown arg '$1'";;
  esac
done

# Query modes are mutually exclusive: each replaces the body with its own answer, so a caller
# passing two gets one of them and silently loses the other. This repo has already
# ruled on that shape once (card#5429 — drift-check read two positionals and dropped the
# rest at rc 0), and a query whose answer is about a different question than the one asked
# is worse here than in a body generator, because the output is machine-read.
# COUNTED, NOT PAIRWISE. Each query mode replaces the whole output with one answer, so any two
# of them means one is silently lost — and a pairwise test is the shape that admits exactly the
# combination nobody remembered to write down (n modes make n(n-1)/2 pairs, so every added mode
# adds more pairs than the last). The count is derived from the flags that were actually seen.
QUERY_MODES=""; QUERY_COUNT=0
query_mode() { [ "$1" = 1 ] || return 0; QUERY_MODES="${QUERY_MODES:+$QUERY_MODES, }$2"; QUERY_COUNT=$((QUERY_COUNT + 1)); }
query_mode "$TAG_ONLY"           --tag
query_mode "$MANIFEST_ONLY"      --manifest
query_mode "$CARD_MANIFEST_ONLY" --card-manifest
query_mode "$TOOL_VERSION_ONLY"  --tool-version
if [ "$QUERY_COUNT" -gt 1 ]; then
  die "$QUERY_MODES are mutually exclusive query modes (each prints a different answer — run the tool once per question)"
fi

# Before the config read: a copy must answer from whatever directory it is run in.
if [ "$TOOL_VERSION_ONLY" = 1 ]; then
  printf '%s\n' "$ABTK_TOOL_VERSION"
  exit 0
fi

# Runtime dependencies are checked only AFTER the --tool-version exit above: that question needs
# none of them, and a host lacking one must still be able to ask which release this copy is.
command -v jq  >/dev/null || die "jq is required"
command -v git >/dev/null || die "git is required"

[ -f "$CONFIG" ] || die "no $CONFIG in this repo (per-project config — see the kanban-board copy for the shape)"
cfg() { jq -re "$1" "$CONFIG" 2>/dev/null; }
cfg_opt() { jq -r "$1 // empty" "$CONFIG" 2>/dev/null; }

MAIN_BRANCH="$(cfg_opt '.main_branch')"; MAIN_BRANCH="${MAIN_BRANCH:-main}"
DEV_BRANCH="$(cfg_opt '.dev_branch')";  DEV_BRANCH="${DEV_BRANCH:-dev}"
VERSION_FILE="$(cfg_opt '.version_file')"
VERSION_REGEX="$(cfg_opt '.version_regex')"
VERSION_EXTRACT_CMD="$(cfg_opt '.version_extract_cmd')"  # optional; see the version block below
REF_TOKEN_REGEX="$(cfg_opt '.ref_token_regex')"    # e.g. "DL-[0-9]+"; optional — numeric part is a DL number
CARD_TOKEN_REGEX="$(cfg_opt '.card_token_regex')"  # e.g. "card#[0-9]+"; optional — numeric part is a CARD ID
# How a version maps to its git tag name, with {{version}} as the placeholder
# (symmetric with the `artifacts` template expansion below). Drives both the
# baseline own-tag exclude AND the body's display header, so a non-v scheme names
# the tag that actually exists in each place. Default `v{{version}}` preserves the
# historical `v`-prefixed tag; a non-prefixed scheme sets e.g. "{{version}}" (the
# date string IS the tag) or "release-{{version}}".
# NB: default assigned on its own line for readability. (An earlier comment here
# claimed `${VAR:-v{{version}}}` mis-parses on the `}}` — tested false in bash/sh;
# the inline form works. The two-line form is kept as the clearer one.)
TAG_FORMAT="$(cfg_opt '.tag_format')"; [ -n "$TAG_FORMAT" ] || TAG_FORMAT='v{{version}}'

# Resolve the version: explicit flag, else `version_extract_cmd` if the config names one,
# else the FIRST version_regex match in the version file. That regex is the ONE declaration
# of what a version looks like:
# `release-artifacts-check` classifies release PRs by it, and the toolkit's own
# `auto-tag-version.yml` anchors it (^…$) against the whole VERSION at merge time.
# How many segments a version has is therefore the CONFIG's to say, not this file's.
#
# ⛔ DO NOT RE-ADD A SECOND, WIDER PATTERN HERE. There was one until card#7208: a
# hardcoded `[0-9]+(\.[0-9]+){1,3}` ran as a second stage over the FIRST stage's
# output, and a stage that only ever sees what the config regex already matched can
# narrow it but can never widen it. It read as "2-4 segments accepted" and was not:
# with a 3-segment version_regex, `1.22.1.0` reached it already cut to `1.22.1`
# (measured — the comment that stood here named that exact truncation as prevented).
# What it did do was refuse a single-segment version_regex outright, cut a legal
# 5-segment one to four, and drop any non-numeric text the config regex was written
# to match. A repo that wants 4 segments declares them in version_regex.
#
# ── WHY THERE IS A SECOND RESOLUTION PATH AT ALL (card#7599) ──────────────────
# THE REGEX CANNOT BE THE EXTRACTOR FOR A REPO WHOSE VERSION LIVES INSIDE A CODE FILE.
# `grep -oiE` returns the WHOLE match, and a version declared inside a config file has to be
# matched WITH ITS SURROUNDING CONTEXT to be picked out of the file at all — kanban-board's
# `version_regex` is `'version' => '[0-9.]+'` over `config/app.php`. The match therefore IS
# `'version' => '0.43.0'`, and that whole string became $VERSION: the scope line rendered
# `release PR — v'version' => '0.43.0'.` (measured, at the v0.43.0 cut). There is no capture
# group to reach for — this is one `grep -o` — and the ⛔ note above is why a second pattern
# is not the answer either.
#
# `version_extract_cmd` names the repo's OWN extractor and takes its stdout as the version.
# ⛔ IT IS NOT A SECOND WAY OF SAYING WHAT version_regex SAYS — it COLLAPSES A DIVERGENCE THAT
# ALREADY EXISTS. A repo whose version needs context to match usually already owns a script
# that extracts it, because its tagging workflow needed one first: kanban's
# `auto-tag-version.yml` mints the release tag from `bin/extract-version.sh`, which answers
# `0.43.0`. Two extractors, one question, different answers — and that repo was safe only
# because the AUTHORITATIVE one was right and the cosmetic one was wrong. A capture group here
# would have fixed the display and LEFT the two implementations standing; pointing this tool
# at the repo's own extractor is what makes them one.
#
# PRECEDENCE: `--version` beats everything (the flag stays a complete bypass — it is what a
# releaser reaches for when resolution is broken, and it runs no command at all), then
# version_extract_cmd, then version_file+version_regex. A config declaring BOTH the cmd and the
# regex is the normal case, not a conflict: `release-artifacts-check` requires version_regex to
# classify release PRs and does not read this key (see below), so the two coexist by design.
# A config with no cmd key resolves exactly as it always has, byte for byte.
#
# ⛔ THIS RUNS A COMMAND NAMED BY A CONFIG FILE. The trust boundary, stated rather than assumed:
#   * WHAT IS TRUSTED, AND WHY THAT IS ENOUGH HERE. `.release-pr.json` and the script it names
#     are both COMMITTED IN THE REPO WHOSE RELEASE IS BEING PREPARED, and this tool is run by a
#     releaser, in a checkout of that repo, over the code they are about to ship. Anyone able to
#     edit either can already edit `bin/` in that same checkout. The key hands its holder no
#     capability they did not have — and that argument holds ONLY under those conditions.
#   * WHERE IT IS NOT REACHED — traced, not assumed. Exactly one CI path reaches this tool:
#     `release-tag-check`, on a push to the release branch (post-merge, already-trusted
#     content), delegates the tag-name mapping here — and it calls
#     `release-pr-body --tag --version "$VERSION"`, WITH an explicit version, so resolution
#     short-circuits above and this function never runs on that path. No PR-time job runs this
#     tool at all. And the PR-time gate must never grow this key: `release-artifacts-check`
#     runs on `pull_request` over an UNTRUSTED head and is built so the PR it judges cannot
#     steer its verdict (it reads its classification keys from the fork point for exactly that
#     reason). A config-named command, run by that gate from the head under review, is arbitrary
#     code execution by the PR author inside the job that judges them — strictly worse than the
#     head-retarget it already declines to honour. It does not read this key; keep it that way.
#   * WHAT IS CONSTRAINED ANYWAY, because "trusted" is not "unconstrained", and a typo should
#     refuse rather than surprise:
#       - NO SHELL. The value is an argv[0], not a command line. It is exec'd directly, so `>`,
#         `|`, `;`, `&&` and `$(…)` are never interpreted and arguments are not supported — a
#         value carrying any of them names no file and is refused by name.
#       - INSIDE THE REPO ONLY. An absolute path, or one with a `..` component, is refused.
#       - NO $PATH SEARCH. A value with no `/` is run as `./<value>`; without that, a bare
#         `extract-version.sh` would resolve against $PATH and a same-named script anywhere on
#         it would answer for this repo.
#       - It must exist and be executable (the interpreter comes from its own `#!` line).
#     Resolved relative to the CURRENT DIRECTORY, exactly as `version_file` already is.
#     ⚑ THE SCOPE OF THOSE CHECKS, STATED SO IT IS NOT OVER-CITED: they constrain the CONFIG
#     STRING, not the process. A committed SYMLINK is followed, and the script itself may do
#     anything a script can do. This is not a sandbox and cannot be one — the trust argument
#     above is what carries the safety; the checks only make a typo refuse instead of surprise.
#
# THE COMMAND'S STDOUT **IS** THE VERSION — taken verbatim, with no pattern applied to it.
# ⛔ DO NOT ADD A SHAPE CHECK HERE: that is precisely the "second, wider pattern" the ⛔ note
# above records, one indirection out — a check in this position can only narrow what the repo
# itself just told us, and the repo is the authority this key exists to defer to. Two answers
# are still refused, because neither is a version at all and both would be rendered silently
# into a one-line scope header, a tag name and the artifact checklist: EMPTY output, and output
# spanning more than one line. The newline case is refused HERE for the same reason
# `release-tag-check` refuses a tag name carrying one — a version reaches a `::error::`
# annotation through `tag_format`, where a newline is a workflow command — except that this end
# can name the extractor that produced it, while that end sees only an impossible tag.
#
# Sets the global rather than printing it, for the reason `release-artifacts-check`'s
# `_extract_version` states: `die` inside `$( … )` exits only the SUBSHELL, leaving the abort to
# depend on errexit noticing an assignment's status — which an `if` context or a later `|| true`
# silently defeats. Here every refusal runs in the script's own shell.
_version_from_cmd() {
  local cmd="$VERSION_EXTRACT_CMD" run out nl rc=0
  case "$cmd" in
    /*) die "version_extract_cmd '$cmd' is an absolute path — it must name a file inside this repo, relative to the directory this tool is run from (e.g. \"bin/extract-version.sh\")";;
  esac
  # The `..` test is on PATH COMPONENTS, not a `*..*` substring: a legal filename may carry two
  # dots (`v..sh`), and refusing that would be a refusal nobody could diagnose.
  case "/$cmd/" in
    */../*) die "version_extract_cmd '$cmd' has a '..' path component — it must name a file inside this repo";;
  esac
  case "$cmd" in
    */*) run="$cmd";;
    *)   run="./$cmd";;
  esac
  [ -f "$run" ] || die "version_extract_cmd '$cmd' is not a file here — it is exec'd directly with NO shell, so it must be a bare path to an executable in this repo: no arguments, no redirection, no pipeline (and it resolves from the current directory, like version_file)"
  [ -x "$run" ] || die "version_extract_cmd '$cmd' is not executable — \`chmod +x\` it; it is exec'd directly, so its interpreter comes from its own '#!' line"
  out="$("$run")" || rc=$?
  [ "$rc" -eq 0 ] || die "version_extract_cmd '$cmd' exited $rc (anything it printed on stderr is above) — refusing, rather than falling back to version_regex: this key exists BECAUSE that fallback answers differently, so a silent fall-back would re-introduce the divergence it removes"
  [ -n "$out" ] || die "version_extract_cmd '$cmd' printed nothing on stdout — its stdout IS the version"
  nl=$'\n'
  case "$out" in
    *"$nl"*) die "version_extract_cmd '$cmd' printed more than one line — its stdout IS the version, and a multi-line value would be rendered into the scope header, the tag name and the artifact checklist";;
  esac
  VERSION="$out"
}

if [ -z "$VERSION" ] && [ -n "$VERSION_EXTRACT_CMD" ]; then
  _version_from_cmd
elif [ -z "$VERSION" ] && [ -n "$VERSION_FILE" ] && [ -n "$VERSION_REGEX" ] && [ -f "$VERSION_FILE" ]; then
  # `|| true` is the SIGPIPE guard, not a swallowed read: `head -1` closes the pipe on the
  # first line and `pipefail` would promote the dead grep's status. Emptiness is tested below.
  VERSION="$(grep -oiE "$VERSION_REGEX" "$VERSION_FILE" | head -1 || true)"
fi
[ -n "$VERSION" ] || die "could not resolve version (pass --version, or set version_extract_cmd, or set version_file+version_regex)"

# The actual tag name for this version, per tag_format. Drives BOTH the baseline
# own-tag exclude (below) AND the body's display header — computed unconditionally
# here so an explicit --base (which skips the baseline block) still renders the
# real tag. Under the default `v{{version}}` this is `v<version>` (back-compat).
THIS_TAG="${TAG_FORMAT//\{\{version\}\}/$VERSION}"

# THE QUERY MODE RETURNS HERE, before the baseline block below — which FETCHES from origin and
# dies when it cannot. A caller asking only "what is this version's tag called?" must not need
# the network to be told, and `bin/release-tag-check` asks this question inside a CI job whose
# whole purpose is to survive a remote it may not be able to read.
if [ "$TAG_ONLY" = 1 ]; then
  printf '%s\n' "$THIS_TAG"
  exit 0
fi

# Range: BASE = last release tag reachable on ORIGIN's main (excluding THIS
# version's tag, in case it already exists — else a re-run after tagging returns
# the current release as its own 'previous tag'), HEAD = the work about to ship —
# ORIGIN's integration tip.
#
# ONE RULE FOR BOTH LEGS: a DEFAULTED leg is resolved against the REMOTE, fetching
# it first, and a fetch failure is FATAL rather than a silent fall-back to a stale
# local ref. That leg's explicit flag (--base / --head) is its override, skips its
# fetch, and is therefore what makes an offline run possible — with both legs
# defaulted there is no ref in this repo the tool is entitled to trust.
#
# WHY, PER LEG. The documented branch-off-dev release flow never checks out the
# local main ref, so it drifts a full release behind every cycle — a local
# `describe` names an already-shipped tag and the body reports shipped PRs as new.
# The local dev ref drifts the other way: a release worktree is cut once and dev
# keeps moving under it, so every merge after the cut is a commit the local ref
# does not have. ⛔ THE HEAD LEG DEFAULTED TO THAT LOCAL REF UNTIL card#7517 —
# three lines ABOVE a `die` whose own words say a local ref "is NOT a usable
# fallback". Measured at the v0.30.0 cut: local dev one commit behind origin/dev
# produced 38 rows instead of 39, no `#298`, and a `shipped-cards` manifest missing
# the SECURITY fix's card. A short range is WELL-FORMED, so nothing downstream can
# notice: the body renders, the count looks plausible, the manifest is valid and
# simply missing its newest entries. Do not re-introduce the asymmetry; the two ends
# feed ONE range.
#
# AN EXPLICIT LEG IS STILL CHECKED FOR RESOLVABILITY — not for freshness (card#7525).
# Honouring the handed-in ref verbatim is the point of the override, and this does NOT
# second-guess which ref the caller meant: no fetch, no substitution, no widening. It asks
# only whether the named ref EXISTS here, because skipping the fetch means nothing else ever
# looks it up. `git log "$RANGE"` runs under `2>/dev/null` at four sites below, so a typo'd or
# deleted ref is silent in every one of them: the two query modes (`--manifest`,
# `--card-manifest`) print an EMPTY list at rc 0 — the machine-read surfaces, whose consumers
# cannot tell that from a range with nothing in it — and the full body path aborts at
# the `COUNT=` pipeline (pipefail + errexit) with rc 128 and NOT ONE BYTE on either stream,
# naming neither the ref nor the flag. All three are "a typo is indistinguishable from a
# genuinely empty range". Refusing by name replaces all three.
#
# `^{commit}` IS LOAD-BEARING, not decoration. `git rev-parse --verify -q <40-hex>` exits 0 for
# a full-length hex string naming NO object — it verifies that the spelling can be turned into
# a raw object name, not that the object is here (measured, git 2.43.0) — while `git log` on it
# dies `bad object`. A stale sha copied off an old PR is exactly the "deleted ref" case, and it
# is the natural offline spelling of `--head`. Peeling asks the question the range actually
# needs: an annotated tag peels through, and anything `git log` could not use as a range end
# fails here too, so no ref that resolves today changes behaviour.
#
# NOT reached by `--tag`, which returns above: that mode builds no range, and `release-tag-check`
# asks it inside a CI job with no guarantee the range's refs are present at all.
#
# `bin/promote-released-cards` carries the same predicate under its own message (card#7525). The
# two are compared directly since card#8529 — tests/mirror-pair-parity-selftest.sh extracts both
# and runs one corpus of refs through each — so a divergence reds rather than waiting for a class
# of input only one of them meets.
require_resolvable() { # <flag> <ref>
  git rev-parse --verify -q "$2^{commit}" >/dev/null \
    || die "$1 '$2' does not resolve to a commit in this repo — an explicit $1 is the caller's override and skips its leg's fetch, so nothing else ever looks the ref up, and a range built from it walks NOTHING — indistinguishable from a genuinely empty release; check the spelling, or fetch the ref before passing it"
}

# The base leg fetches with tags (release tags point at main-only merge commits a
# dev-side fetch's tag auto-follow never brings over); the excluded tag name is
# derived from tag_format, not a hardcoded `v` prefix (preserves .NET / date tag
# schemes). The two fetches are SEPARATE commands on purpose: each resolves its own
# tip with a FETCH_HEAD fallback, for a clone whose refspec does not cover that
# branch and so never gets a `refs/remotes/origin/…` update — and one combined
# fetch leaves FETCH_HEAD naming two branches with no way to tell which line is
# whose. The base leg runs FIRST so its FETCH_HEAD is consumed before the head
# leg's fetch overwrites it.
if [ -z "$BASE" ]; then
  git fetch --quiet --tags origin "$MAIN_BRANCH" \
    || die "cannot fetch origin/'$MAIN_BRANCH' — the release baseline is resolved against the remote (the local '$MAIN_BRANCH' ref is stale by design under the branch-off-'$DEV_BRANCH' release flow, so it is NOT a usable fallback); fix network/remote access or pass an explicit --base <tag>"
  MAIN_TIP="$(git rev-parse --verify -q "refs/remotes/origin/$MAIN_BRANCH" || git rev-parse --verify -q FETCH_HEAD)" \
    || die "fetched origin '$MAIN_BRANCH' but cannot resolve its tip"
  LOCAL_TIP="$(git rev-parse --verify -q "refs/heads/$MAIN_BRANCH" || true)"
  if [ -n "$LOCAL_TIP" ] && [ "$LOCAL_TIP" != "$MAIN_TIP" ]; then
    echo "release-pr-body: note: local '$MAIN_BRANCH' ($(git rev-parse --short "$LOCAL_TIP")) is behind/apart from origin/$MAIN_BRANCH ($(git rev-parse --short "$MAIN_TIP")) — expected under the release flow; the baseline uses the remote tip." >&2
  fi
  BASE="$(git describe --tags --abbrev=0 --exclude="$THIS_TAG" "$MAIN_TIP" 2>/dev/null || true)"
else
  # An explicit --base has the SAME shape as an explicit --head, verified rather than assumed:
  # it skips this leg's fetch, `require_value` has already made it non-empty, and it is
  # substituted straight into `$BASE..$HEAD_REF` with nothing between the flag and `git log`.
  # Checked BEFORE the head leg's fetch below, so a bad baseline refuses without reaching the
  # network — the same ordering reason the base leg runs first at all.
  #
  # A DEFAULTED base needs no such check: it is either `git describe`'s answer about a tip this
  # process just fetched, or empty, and an empty BASE is a legitimate range (`${BASE:+…}` makes
  # it "everything reachable from HEAD" — the first-ever release).
  require_resolvable --base "$BASE"
fi

if [ -z "$HEAD_REF" ]; then
  git fetch --quiet origin "$DEV_BRANCH" \
    || die "cannot fetch origin/'$DEV_BRANCH' — the shipped range's head is resolved against the remote (the local '$DEV_BRANCH' ref lags every merge that lands after a release worktree is cut, and a short range silently drops PRs from the bundled table AND from the shipped-cards manifest); fix network/remote access or pass an explicit --head <ref>"
  if git rev-parse --verify -q "refs/remotes/origin/$DEV_BRANCH" >/dev/null; then
    HEAD_REF="origin/$DEV_BRANCH"      # the readable spelling, when the refspec produced it
  else
    HEAD_REF="$(git rev-parse --verify -q FETCH_HEAD)" \
      || die "fetched origin '$DEV_BRANCH' but cannot resolve its tip"
  fi
  HEAD_TIP="$(git rev-parse "$HEAD_REF")"
  # The baseline's divergence note, at the other end: say why the body lists work the
  # reader's own checkout does not have.
  LOCAL_DEV="$(git rev-parse --verify -q "refs/heads/$DEV_BRANCH" || true)"
  if [ -n "$LOCAL_DEV" ] && [ "$LOCAL_DEV" != "$HEAD_TIP" ]; then
    echo "release-pr-body: note: local '$DEV_BRANCH' ($(git rev-parse --short "$LOCAL_DEV")) is behind/apart from origin/$DEV_BRANCH ($(git rev-parse --short "$HEAD_TIP")) — expected under the release flow; the range uses the remote tip." >&2
  fi
else
  # An explicit --head is the caller's call: honoured as given, with no fetch, which is
  # what keeps it usable as the offline override. It is still worth SAYING when the ref
  # named is strictly BEHIND a remote tip this repo already knows about — that is the
  # card#7517 shape arriving by hand, and its omission leaves no trace in the body.
  #
  # STRICTLY BEHIND, not "differs" — and that is a deliberate divergence from the base
  # leg's note, because the two flags do not take the same kind of value. `--base` names
  # a TAG, which cannot be stale; `--head` routinely names a release branch that has
  # legitimately diverged from dev, and noting mere divergence on every release is noise
  # nobody reads. Behind-ness is the exact shape that costs the body a PR. No fetch: the
  # comparison uses only what is already local, so an unknown or absent origin/dev simply
  # yields no note rather than reaching the network on the override path.
  #
  # The resolvability check comes FIRST, before that note: `merge-base --is-ancestor` on an
  # unresolvable ref fails under its own `2>/dev/null` and simply draws no note, so an
  # unresolvable --head used to switch OFF the one diagnostic this path has.
  require_resolvable --head "$HEAD_REF"
  REMOTE_DEV="$(git rev-parse --verify -q "refs/remotes/origin/$DEV_BRANCH" || true)"
  if [ -n "$REMOTE_DEV" ] && git merge-base --is-ancestor "$HEAD_REF" "$REMOTE_DEV" 2>/dev/null; then
    BEHIND="$(git rev-list --count "$HEAD_REF..$REMOTE_DEV")"
    if [ "$BEHIND" -gt 0 ]; then
      echo "release-pr-body: note: --head '$HEAD_REF' is $BEHIND commit(s) behind origin/$DEV_BRANCH — those commits are NOT in this body, nor in its shipped-cards manifest." >&2
    fi
  fi
fi
RANGE="${BASE:+$BASE..}$HEAD_REF"

# Deterministic bundle: each non-merge commit subject in the range, with its PR
# number (trailing "(#NNN)") and optional project ref token pulled out of git —
# never hand-curated.
emit_manifest() {
  [ -n "$REF_TOKEN_REGEX" ] || return 0
  # `|| true`: grep exits 1 on no match — a release with no ref tokens is valid,
  # not a failure (would otherwise abort under `set -o pipefail`).
  { git log "$RANGE" --no-merges --format='%s' 2>/dev/null \
    | grep -oiE "$REF_TOKEN_REGEX" | tr '[:lower:]' '[:upper:]' | awk '!seen[$0]++'; } || true
}

# The card-id half of the manifest. Emits BARE INTEGERS, not tokens: the id space is
# what a consumer correlates on, and a bare id has no spelling to normalize — the
# DL side's `tr '[:lower:]' '[:upper:]'` fold would otherwise reach `card#7` as
# `CARD#7`. Leading zeros are stripped (>=1 digit kept) so `card#007` and `card#7`
# are one id, matching promote-released-cards' `numlist`/`norm` rule on both sides
# of its comparison.
#
# The id is the token's TRAILING digit run — `s/^.*[^0-9]//` per matched token, not a
# `grep -oE '[0-9]+'` over the stream. `card_token_regex` is operator-supplied and need
# not be `card#…`: a prefix that itself contains digits (`PROJ2-card#77`) makes the
# stream-grep yield TWO ids, `2` and `77`, and `2` is a real id belonging to some other
# card. Erring toward DROPPING an id is the right side of that asymmetry here — a token
# whose id is not trailing yields nothing and the coverage report says so, whereas a
# minted id silently reports an unrelated card as covered.
emit_card_ids() {
  [ -n "$CARD_TOKEN_REGEX" ] || return 0
  { git log "$RANGE" --no-merges --format='%s' 2>/dev/null \
    | grep -oiE "$CARD_TOKEN_REGEX" | sed -E 's/^.*[^0-9]//' \
    | sed 's/^0*\([0-9]\)/\1/' | awk 'NF && !seen[$0]++'; } || true
}

if [ "$MANIFEST_ONLY" = 1 ]; then
  emit_manifest
  exit 0
fi
if [ "$CARD_MANIFEST_ONLY" = 1 ]; then
  emit_card_ids
  exit 0
fi

bundle_lines() {
  local found=0
  while IFS=$'\t' read -r subj; do
    [ -n "$subj" ] || continue
    found=1
    local pr ref
    pr="$(printf '%s' "$subj" | grep -oE '\(#[0-9]+\)' | tail -1 | tr -d '(#)')"
    # The trailing `|| true` on each grep pipeline is load-bearing under `set -o
    # pipefail`, not decoration: a subject with no token makes grep exit 1 and the
    # assignment inherit it. Today the whole function runs inside `$(bundle_lines)`,
    # and bash suppresses errexit for a command substitution in an assignment — so
    # the abort is masked by WHERE the caller happens to put the call, and a future
    # caller that invokes it directly would silently truncate the bundled list at the
    # first token-less commit. Make the no-match case explicitly valid here instead.
    ref=""
    if [ -n "$REF_TOKEN_REGEX" ]; then
      ref="$(printf '%s' "$subj" | grep -oiE "$REF_TOKEN_REGEX" | head -1 | tr '[:lower:]' '[:upper:]' || true)"
    fi
    # Card tokens are the fallback, so a repo configuring both keeps its existing
    # DL-first rendering. Rendered VERBATIM (no case fold) — this is a display column,
    # and `card#5877` is the token's canonical spelling; the fold exists on the DL side
    # only to make `dl-1`/`DL-1` one manifest entry.
    if [ -z "$ref" ] && [ -n "$CARD_TOKEN_REGEX" ]; then
      ref="$(printf '%s' "$subj" | grep -oiE "$CARD_TOKEN_REGEX" | head -1 || true)"
    fi
    local clean; clean="$(printf '%s' "$subj" | sed -E 's/ *\(#[0-9]+\)$//')"
    printf -- '- %s%s%s\n' \
      "${pr:+**#$pr** }" \
      "${ref:+(\`$ref\`) }" \
      "$clean"
  done < <(git log "$RANGE" --no-merges --format='%s' 2>/dev/null)
  [ "$found" = 1 ] || echo "_(no non-merge commits in \`$RANGE\`)_"
}

# Shift-left card coverage: surface, AT RELEASE PREP, any shipped ref that has no board
# tracking card — so the gap is caught while it is cheap to fix instead of only on the
# post-merge promote run (a red check needing manual board surgery). Reuses
# `promote-released-cards --dls/--cards <manifest> --dry-run` (an explicit ref set → no
# squash/parent-count branch, just the cardless report).
#
# IT IS A STDERR REPORT, NOT A BODY SECTION (DL-224). It is a diagnostic for whoever builds the
# release, not content for whoever installs it: it was a `## Card coverage` H2 until DL-224
# (card#9248 reports the framework's PR-body lint redding on it, so every generated release body
# was hand-edited at the cut). The information is unchanged; only its home moved. See the
# header's STDOUT/STDERR contract.
#
# CARD COVERAGE PRECONDITIONS — THE ONE STATEMENT OF WHEN THIS REPORT RUNS (card#10039).
# `docs/INSTALL.md` §4, this repo's `VERSIONING.md` and consumer repos' release docs POINT HERE
# instead of restating it. The report is attempted only when EVERY line below holds; where any
# does not, the function returns before printing and there is NO `card coverage:` line at all.
# Each `precondition:` line is one gate the function tests before printing anything, and its
# `gates:` line names the identifiers it tests, spelled as the function spells them.
# tests/release-pr-body-selftest.sh drives each precondition, and checks the `gates:` names
# against the FUNCTION'S OWN SOURCE (`_fn_src`) rather than against a list written down in the
# test — THE CLAIM THIS BLOCK MAKES IS THAT PREDICATE AND IS NOT WIDER THAN IT: over the span
# from the function's first line to its last silent `return`, the subjects the function tests
# must be exactly the `gates:` names here, or that test reds. Past that span it reds on a
# `return` carrying a test of its own, or one no `coverage_line` precedes, and over the WHOLE
# function every subject it tests must be a `gates:` name here or one of the `non-gates:` names
# below — so a gate added past the span reds wherever it sits, in either bracket-test spelling
# or the `test` spelling.
# ⚠ The gate it does NOT reach is one past that span whose test offers no quoted operand to a
# bracket or `test` reader — a command's exit status (`if ! command -v x; then …coverage_line…
# fi`, `grep -q`) or an arithmetic `(( ${X:-0} == 0 ))` — with its print conditional: neither
# offers a subject to declare, which is why no wider reader closes them. Measured — each leaves
# the whole suite at rc 0, while `cmd && return 0` and a `case` arm are both caught, by the
# `return` rule above.
#
# "Set" means the key reads NON-EMPTY through `cfg_opt` (absent, `null`, `false` and "" all read
# as empty):
#   precondition: token-regex      `ref_token_regex` OR `card_token_regex` is set in the config.
#                                  Neither ⇒ silent, however complete the three below are.
#                                  gates: REF_TOKEN_REGEX CARD_TOKEN_REGEX
#   precondition: board-id         `.promote.board_id` is set. A `.promote` block WITHOUT that
#                                  key does NOT satisfy it — the block alone is not the gate.
#                                  gates: board
#   precondition: writeback-token  `$KANBAN_WRITEBACK_TOKEN` is non-empty in the environment.
#                                  gates: KANBAN_WRITEBACK_TOKEN
#   precondition: promoter         `promote-released-cards` is found — on `PATH`, OR as an
#                                  executable beside this script (`dirname "$0"`).
#                                  gates: promote promote-released-cards
# Past them the promoter itself needs more (`KANBAN_EXPECTED_HOST`, a real api base — see
# docs/INSTALL.md §4); a run that fails THERE is not silent: it prints the "could not run" line.
#
# THE REST OF WHAT THE FUNCTION TESTS, declared so that the check above can be complete over the
# function and not only over the gate region. These select WHICH line is printed; naming a subject
# here is the claim that its test cannot end the run in silence, because every path through it
# prints one. They are not preconditions and nothing points a reader here — an operator reads the
# `precondition:` lines. The list is here rather than in the test because the test would then hold
# a second copy of a set this block owns, whose repair on a red is to edit the copy:
#   non-gates: dl_manifest card_manifest COUNT rc miss stranded said
#
# It used to emit a heading unconditionally and, in that case, a
# placeholder saying "not checked here, run `promote-released-cards --dry-run` before merge":
# a report whose entire content is "this was not measured" says nothing about the release, and
# it was struck by hand from a real release PR body — which does not hold, because the next
# release re-emits it. The `--dry-run`-before-merge obligation did not go away; it is stated in
# the release doc a reader consults for release process (this repo's `VERSIONING.md` § Release
# flow; `docs/INSTALL.md` §4 for a consumer setting the keys up). So: a `card coverage:` line
# MEANS coverage was measured, or names a reason it could not be. A run that was attempted and
# failed, or a range that matched nothing, still says so — that is a fact about this release,
# not a placeholder.
#
# The two legs are passed SEPARATELY because they correlate against different card
# fields (see the header): DL tokens against `payload.dl_number`, card ids against the
# card's `id`. Deriving card ids from commit subjects is safe HERE and only here — this
# call is `--dry-run`, so a descriptive `card#NNNN` mention in a subject can at worst
# make a coverage line read "covered". promote-released-cards deliberately does NOT
# derive ids from subjects for its MOVE path, where the same mention would relocate an
# unrelated card.
coverage_line() { printf 'release-pr-body: card coverage: %s\n' "$1" >&2; }
card_coverage_report() {
  [ -n "$REF_TOKEN_REGEX" ] || [ -n "$CARD_TOKEN_REGEX" ] || return 0
  local board promote
  board="$(cfg_opt '.promote.board_id')"
  promote="$(command -v promote-released-cards 2>/dev/null || true)"
  if [ -z "$promote" ]; then
    local d; d="$(dirname "$0")"
    [ -x "$d/promote-released-cards" ] && promote="$d/promote-released-cards"
  fi
  # Nothing to measure with ⇒ nothing to say. The return is BEFORE any line is printed, so an
  # unmeasured run emits no coverage line at all.
  if [ -z "$board" ] || [ -z "${KANBAN_WRITEBACK_TOKEN:-}" ] || [ -z "$promote" ]; then
    return 0
  fi
  local dl_manifest card_manifest
  dl_manifest="$(emit_manifest | paste -sd, -)"
  card_manifest="$(emit_card_ids | paste -sd, -)"
  if [ -z "$dl_manifest" ] && [ -z "$card_manifest" ]; then
    # Named with the range's commit COUNT, and pointing at the correlation-gap lines when there
    # are any. "No shipped refs in range" over thirty commits is true and reads like "nothing to
    # do"; the reader needs to know the range was not empty (card#8538).
    if [ "${COUNT:-0}" -gt 0 ]; then
      coverage_line "_No shipped ref or card id matched in \`$RANGE\` ($COUNT commit(s)) — there is nothing to check coverage against; see the correlation gap lines above._"
    else
      coverage_line "_No shipped refs in range._"
    fi
    return 0
  fi
  # Built as an array with plain `if` blocks, never `[ -n "$x" ] && args+=(…)`: that
  # trailing-test form is what leaked a false status out of this script once already
  # (card#5874), and it is one edit away from becoming a function's last statement again.
  local -a args=(--dry-run)
  if [ -n "$dl_manifest" ]; then args+=(--dls "$dl_manifest"); fi
  if [ -n "$card_manifest" ]; then args+=(--cards "$card_manifest"); fi
  # An explicit-ref dry-run never moves and never hits the squash/parent-count branch, so
  # a non-zero exit is a real error (bad token / board read) — distinguish it from a
  # clean run, else a failed check would falsely read as "all carded".
  local out rc
  out="$("$promote" "${args[@]}" 2>&1)" && rc=0 || rc=$?
  if [ "${rc:-0}" -ne 0 ]; then
    coverage_line "_Coverage check could not run (\`promote-released-cards\` exited ${rc}). Run it manually before merge._"
    return 0
  fi
  # THE PROMOTE TOOL'S NO-CARD REPORT IS TWO LINES, and both are read here (card#8421). They
  # are not two spellings of one finding — they carry OPPOSITE remedies, so reading only the
  # first told an author to CREATE a board card for a card that was already on the board and
  # merely needed a stamp. `promote-released-cards` owns the contract in a block named THE
  # NO-CARD REPORT; a third kind added there needs a third read HERE, or this report
  # silently half-reads a report it presents as whole.
  #
  # Each `sed` cuts at the FIRST colon of the matched text, which is why `grep -oE` anchors on a
  # colon-free phrase and neither promote-side line may put a colon before its ref list.
  local miss stranded said=0
  miss="$(printf '%s\n' "$out" | grep -oE 'matched NO card[^:]*: .*' | sed 's/[^:]*: //' || true)"
  stranded="$(printf '%s\n' "$out" | grep -oE 'matched ONLY an unsourced card[^:]*: .*' | sed 's/[^:]*: //' || true)"
  if [ -n "$miss" ]; then
    coverage_line "⚠ **Shipped refs with no tracking card:** $miss"
    coverage_line "Create (or correct) a board card for each before merging — a cardless *feature* ref is a tracking gap; a cardless *docs* ref is acceptable but better carded. A \`card#NNNN\` naming no card on this board is usually a typo or a card belonging to a different board. Otherwise the post-merge promote step reports them as no-card."
    said=1
  fi
  if [ -n "$stranded" ]; then
    coverage_line "⚠ **Shipped refs whose card carries no by-ref source:** $stranded"
    coverage_line "**Do not create a card for these — the card already exists** and carries the ref. What it lacks is a repo-qualified source, so a repo-qualified promote (\`.promote.source\` set to an \`<owner>/<repo>\`) cannot tell whose card it is and will NOT move it. Stamp the card that is there — \`kbcard patch --pr-url https://github.com/<owner>/<repo>/pull/<N>\` — or promote it by hand after merge."
    said=1
  fi
  if [ "$said" = 0 ]; then
    coverage_line "_All shipped refs have a tracking card._"
  fi
}

COUNT="$(git log "$RANGE" --no-merges --oneline 2>/dev/null | wc -l | tr -d ' ')"

# --- correlation gaps: an EMPTY manifest over a NON-EMPTY range is a finding (card#8538) ---
# THE FAILURE THIS CLOSES IS A CLEAN LINE, NOT AN ERROR. With `card_token_regex` absent — or
# present and matching nothing — `emit_card_ids` yields nothing, the `shipped-cards` footer is
# simply omitted, and the coverage report says "All shipped refs have a tracking card" off
# whatever the OTHER key happened to see. Measured on a real release: 0 `shipped-cards` lines
# over a range carrying eight card ids, rc 0, and a coverage report reading clean (card#8423).
# An omitted footer and a footer that legitimately has nothing to say are indistinguishable to
# every reader of this body, so the body has to say which one it is.
#
# WHY IT IS ITS OWN REPORT AND NOT PART OF THE COVERAGE ONE. That report prints nothing unless
# its CARD COVERAGE PRECONDITIONS (above card_coverage_report) hold — its presence IS the claim
# that coverage was measured, or a named reason it could not be. This finding needs none of
# them: it is a fact about git and
# the config, so it must not inherit that report's preconditions, or the repos least able to
# measure coverage would also be the ones told nothing about why.
#
# ON STDERR ONLY (DL-224). It was a `## Correlation gaps` body section, echoed to stderr as well;
# it is a builder diagnostic, so the body copy is gone and the stderr lines are the report.
#
# IT STATES ONLY WHAT THIS GENERATOR ESTABLISHES (card#9248). The strong headline used to say
# "no card can be promoted from this release" — false about `bin/promote-released-cards` in this
# same repo, which derives its shipped refs from `git log <base>..<head>` and reads no manifest.
# What any promoter does with the range is the far end's behaviour, not a fact this end can
# measure; the headline says that by name instead of guessing.
#
# THE RULE, one predicate over both keys, so there is no second answer to one question:
#   * a key that IS declared and matched NOTHING over a non-empty range — its manifest is empty
#     and the reader cannot tell that from "the key was never set";
#   * a key that is NOT declared, when the range correlated nothing through the other one
#     either — the body correlates nothing at all, which is the shape `release-artifacts-check`
#     reds a `.promote`-declaring config for, seen here from the range's side.
# A key that is not declared while the OTHER one YIELDS is NOT a finding: a repo whose subjects
# carry only `card#NNNN` is not obliged to invent a DL scheme, and warning per release about a
# key it deliberately does not use is the noise that gets a real warning ignored. That gate is
# the yield, never the declaration — the card#8423 shape had `ref_token_regex` declared and
# `card_token_regex` absent, and the DECLARED key was the one matching nothing.
#
# It never changes the exit status. This tool GENERATES a body — a non-zero here would block
# the release PR it is being written for, and the finding belongs in front of the person
# preparing that PR, not in a runner's rc.
correlation_gap_report() {
  [ "${COUNT:-0}" -gt 0 ] || return 0
  local ref_yield="" card_yield=""
  if [ -n "$REF_TOKEN_REGEX" ];  then ref_yield="$(emit_manifest | paste -sd, -)"; fi
  if [ -n "$CARD_TOKEN_REGEX" ]; then card_yield="$(emit_card_ids | paste -sd, -)"; fi
  # ZERO_TOTAL is the strong shape: nothing in this range correlates to the board by EITHER id
  # space. It is what gates the "not declared" arm — an undeclared key is a finding only when
  # the release correlates nothing anyway, never on a repo that uses one spelling and yields.
  local zero_total=0
  [ -n "$ref_yield" ] || [ -n "$card_yield" ] || zero_total=1
  local -a gaps=()
  local key re yield manifest field
  for key in ref_token_regex card_token_regex; do
    case "$key" in
      ref_token_regex)  re="$REF_TOKEN_REGEX";  yield="$ref_yield";  manifest="shipped-refs";  field="a card's \`payload.dl_number\`";;
      *)                re="$CARD_TOKEN_REGEX"; yield="$card_yield"; manifest="shipped-cards"; field="the card's own \`id\`";;
    esac
    if [ -n "$re" ] && [ -z "$yield" ]; then
      gaps+=("⚠ **\`$key\` is declared (\`$re\`) and matched no commit subject in \`$RANGE\` ($COUNT commit(s)).** The \`$manifest\` manifest is EMPTY, so nothing here is correlated against $field — check the regex against the subjects this range actually carries before reading a coverage report as clean.")
    elif [ -z "$re" ] && [ "$zero_total" = 1 ]; then
      gaps+=("⚠ **\`$key\` is not declared in \`$CONFIG\`.** The \`$manifest\` manifest is absent, so nothing here is correlated against $field. Declare it if your commit subjects carry that spelling — the two keys are two id spaces, so do not re-spell the other one as this one.")
    fi
  done
  [ "${#gaps[@]}" -gt 0 ] || return 0
  if [ "$zero_total" = 1 ]; then
    gaps=("⚠ **NOTHING in \`$RANGE\` ($COUNT commit(s)) correlates to a board card through this config.** Both manifests are empty: the body carries no \`release-manifest\` footer, and card coverage was not measured here — a body with no manifest footer reads exactly like one whose range legitimately had nothing to say. What a card promoter does with this range is not established here." "${gaps[@]}")
  fi
  local g
  for g in "${gaps[@]}"; do
    printf 'release-pr-body: correlation gap: %s\n' "$g" >&2
  done
}

# The announce block (contract in the header). Written LAST, so it is the tail of stderr. Every
# list is printed beside the command that re-prints it, with both range ends pinned by SHA: a
# ref such as `origin/dev` moves, and a derivation that answers about a different range later
# is a restatement with a maintenance schedule.
announce_block() {
  local base_sha="" head_sha range_pinned
  if [ -n "$BASE" ]; then base_sha="$(git rev-parse --verify -q "$BASE^{commit}")"; fi
  head_sha="$(git rev-parse --verify -q "$HEAD_REF^{commit}")"
  range_pinned="${base_sha:+$base_sha..}$head_sha"
  local -a query=(--version "$VERSION")
  if [ -n "$base_sha" ]; then query+=(--base "$base_sha"); fi
  query+=(--head "$head_sha")
  if [ "$CONFIG" != ".release-pr.json" ]; then query+=(--config "$CONFIG"); fi
  local q; q="$(printf ' %q' "${query[@]}")"
  {
    echo "announce:begin"
    echo "format: 1"
    printf 'version: %s\n' "$VERSION"
    printf 'tag: %s\n' "$THIS_TAG"
    printf 'base: %s\n' "$BASE"
    printf 'head: %s\n' "$HEAD_REF"
    printf 'range: %s\n' "$range_pinned"
    printf 'range-cmd: git log --no-merges --format=%%s %s\n' "$range_pinned"
    if [ -n "$REF_TOKEN_REGEX" ]; then
      printf 'shipped-refs: %s\n' "$(emit_manifest | paste -sd, -)"
      printf 'shipped-refs-cmd: release-pr-body --manifest%s\n' "$q"
    fi
    if [ -n "$CARD_TOKEN_REGEX" ]; then
      printf 'shipped-cards: %s\n' "$(emit_card_ids | paste -sd, -)"
      printf 'shipped-cards-cmd: release-pr-body --card-manifest%s\n' "$q"
    fi
    echo "announce:end"
  } >&2
}


# --- the body --------------------------------------------------------------
cat <<EOF
**\`${DEV_BRANCH} → ${MAIN_BRANCH}\` release PR — ${THIS_TAG}.** Bundles ${COUNT} commit(s) since ${BASE:-the start}.

## Highlights
<!-- AUTHOR: write the 1–3 human-readable highlights of this release here. This is
     the ONLY non-deterministic section — everything below is generated from git. -->

## Bundled (generated — do not hand-edit)
$(bundle_lines)
EOF

# Optional artifact checklist from config (each {{version}} expanded).
if jq -e '.artifacts | type == "array"' "$CONFIG" >/dev/null 2>&1; then
  echo ""; echo "## Release artifacts"
  jq -r '.artifacts[]' "$CONFIG" | while IFS= read -r a; do
    printf -- '- [ ] %s\n' "${a//\{\{version\}\}/$VERSION}"
  done
fi

# Machine-readable manifest of shipped refs — a deterministic footer a downstream
# consumer (e.g. a bridge classifier) can parse instead of the prose above. The two id
# spaces get two SEPARATE keys rather than one merged list: a consumer has to know which
# field to correlate each value against, and `shipped-cards` carries bare ids so there is
# no token spelling to parse. `shipped-refs` is unchanged, so an existing consumer that
# only knows that key is unaffected.
if [ -n "$REF_TOKEN_REGEX" ]; then
  MANIFEST="$(emit_manifest | paste -sd, -)"
  if [ -n "$MANIFEST" ]; then
    printf '\n<!-- release-manifest:shipped-refs=%s -->\n' "$MANIFEST"
  fi
fi
if [ -n "$CARD_TOKEN_REGEX" ]; then
  CARD_MANIFEST="$(emit_card_ids | paste -sd, -)"
  if [ -n "$CARD_MANIFEST" ]; then
    printf '\n<!-- release-manifest:shipped-cards=%s -->\n' "$CARD_MANIFEST"
  fi
fi

correlation_gap_report
card_coverage_report
announce_block

# Reaching here means the body was generated: under `set -e` every real failure has already
# aborted, and a no-token range is valid by contract. Say so explicitly rather than inheriting
# whatever the last statement's status happens to be — an absent manifest previously left a
# failed `[ -n … ]` test as the script's exit status, reporting a correct body as a failure.
exit 0
