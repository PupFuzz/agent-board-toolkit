#!/usr/bin/env bash
# kbcard — thin wrapper for the kanban-board production board API
# Lives outside the kanbanboard repo. Board state lives in ~/.kanban-<name>-board.env
# and the token in whatever file that env (or ~/.kanban-host.env) DECLARES via
# KBCARD_TOKEN_FILE, so the script is portable. There is no default token path:
# ~/.kanban-dev-token was one until card#7245, and being one file for every board is
# what let a single overwrite take them all out at once. Failing all three declaration
# tiers, the coord credential store's `[kanban] api_token_file` POINTER is discovered
# (card#7316) — a path an operator wrote in their own store, never one baked in here.
#
# Usage:
#   THE FLAGS THAT CARRY PROSE COME IN PAIRS — text long enough that someone other than the
#   caller may have written it: --name/--name-file, --description/--description-file,
#   --block-reason/--block-reason-file and --content/--content-file. Pass exactly one of a
#   pair — both is rc 2.
#   USE THE FILE FORM FOR ANY TEXT YOU DID NOT WRITE YOURSELF — a description authored by someone
#   else, a report, a pasted log, a review comment. The inline form is expanded by YOUR shell
#   before kbcard is even started, so a $(...) or a backtick anywhere in that text RUNS as a
#   command on this box, and argv already holds its output by the time kbcard looks. Nothing here
#   can detect that, which is why this is a convention with a safe route and not a validator: a
#   file is read by kbcard itself and never meets a shell.
#   A --…-file takes a PATH. `-` is refused by name (it is not a stdin token here), and a missing, unreadable
#   or text-free (empty / whitespace-only) file is rc 2 BEFORE any request, so a bad invocation
#   costs no traffic. What a file puts on the wire: interior newlines and leading whitespace
#   verbatim, TRAILING newlines trimmed, CRLF normalized to LF (a file written on Windows/Git-Bash
#   would otherwise send a literal \r, which a reader renders as `?` at the end of every line);
#   a LONE \r is not a line ending and is left alone. THE TEXT-FREE REFUSAL IS THE ONE RULE EVERY
#   PAIR OBEYS THROUGH BOTH HALVES: an empty or whitespace-only value is rc 2 before any request
#   whether it arrived inline or in a file, on every free-text flag here. BLANK MEANS EXACTLY SIX
#   ASCII CHARACTERS — space, tab, CR, LF, VT (\v), FF (\f) — decided under an LC_ALL=C pin, so
#   identical bytes get the identical verdict whatever locale the caller runs in. Anything else is
#   CONTENT and is ACCEPTED: that includes the non-ASCII blanks (U+00A0, U+2003, U+3000), so a name
#   made only of those is SENT. What the board then does with it is the board's rule and is NOT
#   measured here. Named rather than hidden — see kb_is_blank in _kb-board-lib.sh for why the set
#   is spelled out as six literal characters instead of as a class.
#   --content and --block-reason are CRLF-folded and trailing-newline-trimmed inline as well.
#   Among the pairs, --name and --description are the one exception and only on the BYTES: their
#   inline spelling predates its file twin, so an inline value still reaches the wire exactly as
#   typed (a CRLF one included) — rewriting it would narrow what an already-shipped flag accepts,
#   which is an acceptance change nobody has asked for. Blank-checking it was one, and it was asked
#   and granted (card#9222); patch --clear-description is the clearer that refusal made necessary.
#   THE PAYLOAD TEXT FLAGS — --pr-url, --issue-url, --version and --origin, on create-card and
#   patch — have no file twin and take the same text-free refusal, rc 2 before any request, with
#   the same six-character blank set. A value with any text is sent AS TYPED, as a JSON string:
#   padding, CR and newlines included, never re-typed (" 123 ", "1.10" and "nan" stay strings)
#   and never split (a newline cannot end the value or add a payload key). Until card#9423 the
#   assembler split values into k=v lines and coerced each through jq's `tonumber`; retiring that
#   was an acceptance change, asked and granted. Only --pr / --issue are sent as JSON numbers
#   (a numeric spelling — "178", "00123", or one padded with spaces, tabs, CRs or newlines —
#   goes out as a number; a decorated one such as "#178" as the string, exactly as passed). A
#   blank one used to be SENT, and the board stored it as a CLEAR of the field at rc 0 (measured
#   on --origin); a blank --pr-url / --issue-url can also detach the card from its repo — unless
#   the card carries a payload.repo that is a string containing /, which outranks every URL, so
#   its source survives the clear. Refusing it was an acceptance change, asked and granted
#   (card#9338).
#   Emptying one ON PURPOSE is said, not spelled as a blank value: `patch --clear <field>` (see
#   patch below) — card#9420.
#   --tags, ON create-card AND patch, takes the same text-free refusal, rc 2 before any request,
#   with the same six-character blank set, decided on the RAW value (before create-card appends
#   `type:<alias>` / `triaged`). A value with any text is split on commas exactly as before — a
#   blank MEMBER ("a, ,b", "a,") is not refused and still reaches the wire. A blank one used to be
#   SENT as its own element, beside any `type:` / `triaged` the call appends: rc 0 wherever the
#   board accepted it, and on patch that REPLACES the card's whole tag list. What the board does with it is NOT measured here. Refusing it was
#   an acceptance change, asked and granted (card#9421).
#
#   kbcard create-card --type <alias> --name "title"|--name-file PATH \
#                      --column backlog|prioritized|in_progress|in_review|held|shipped_to_dev|released_to_main|wont_do \
#     <alias> is config-driven: any KB_TYPE_<ALIAS> in the board env writes that
#     native card_type_id; an unset/`000` alias (or KB_TYPING_MODE=tags) instead
#     omits card_type_id and tags the card `type:<alias>` — so create-card/list work
#     on native, all-tag, and mixed boards alike.
#                      [--swimlane NAME-OR-ID] [--description "..."|--description-file PATH] [--tags "tag1,tag2"] [--external-id 12345] \
#                      [--dl "DL-093"] [--pr 178] [--pr-url URL] [--issue 42] [--issue-url URL] [--version "v0.9.2"] [--origin preemptive|consumer-driven|incident-triggered|user-requested] [--triaged]
#     --triaged tags the card `triaged` at birth (symmetric with `patch --triaged`)
#     so a plain PM-minted card isn't a false-positive untriaged next session.
#     --swimlane births the card directly ON a lane (symmetric with `patch --swimlane`,
#     same board-env name map): the create POST honours swimlane_id, so this needs no
#     create-then-patch and leaves no laneless window for a lane-keyed reader to observe.
#     --swimlane none (or 0) births it explicitly laneless. An unresolved name fails
#     rc 2 BEFORE the POST — no card is created at all.
#     THE BOARD IS THE BOARD ENV'S KB_BOARD_ID, and a success names it on stderr:
#     `kbcard: create-card: card <id> created on board <n>` (stdout is unchanged, so do not
#     merge stderr into a JSON pipe). An exported KB_BOARD_ID is ignored, with a ⚠ line when
#     it differs; a board env declaring none is rc 2 before any request (card#10385).
#   kbcard move --task ID-OR-EXT --column COLUMN [--keep-refs] [--stamp-owner] [--card-start]
#     The stage the server ECHOES is compared against the stage this call asked for, and a
#     disagreement is rc 1 HARD FAILURE rather than a printed success. `create-card` and
#     `patch --column` carry the same compare. ⚠ WHAT THAT IS: the echo is the server's
#     post-write resource, so it is a statement about what the server holds — but it is not a
#     SECOND request, and only `workflow_stage_id` is compared. name / tags / external_id /
#     payload ride the server's own normalization (a decorated --pr goes as a string, --dl is
#     canonicalized, the tag list is replaced wholesale) and are NOT compared, because a
#     byte-wise compare there would manufacture a failure on a write that landed as asked.
#     Moving a card to wont_do (decline) CLEARS its correlation stamps
#     (payload.dl_number / pr_number / pr_url) in the SAME PATCH, so a stale stamp
#     can't later match a recycled DL/PR and resurrect the card in a release-promote
#     scan. --keep-refs opts out (retains them). Only wont_do clears — every other
#     target column is unaffected.
#     ⭐ A TERMINAL move ALSO CLEARS THE CARD'S ASSIGNMENT (assigned_user_id) in the same
#     PATCH — the terminal columns are the ones README.md § The seat owner tag names — so a
#     finished card never holds a stale claim on a seat that has moved on. `patch --column`
#     does it too: both verbs write through ONE primitive that owns the rule, rather than each
#     mover remembering it. The clear is announced on stderr.
#     ⭐ THE SAME TERMINAL MOVE THEN REMOVES THE SEAT OWNER TAG, and --stamp-owner stamps it once
#     a non-terminal move is confirmed. Both are a SEPARATE tag write after the move, never a
#     key on it; rc is the move's. The rules — refusals, the terminal set, what is printed — are
#     README.md § The seat owner tag. --stamp-owner beside a terminal --column is rc 2 before any
#     request.
#     ⭐ --card-start IS THE WORK-START GUARD, and it is OPT-IN (card#9556). With it the move is
#     REFUSED rather than made when the card is PINNED (a non-empty block_reason or a
#     `no-automove` tag) or is not in Backlog / Prioritized — so an automated starter cannot pull
#     a Shipped / Released / Won't-Do card back to In Progress, which is what a dispatch naming an
#     already-finished card used to do. A HELD card is refused too: it is promoted only by a
#     genuine branch creation, a signal this CLI does not have. The rules are the lib's
#     (kb_card_pinned / kb_card_start_stage_verdict), shared with bin/board-card-start so the two
#     starters cannot diverge again; hooks/agent-dispatch-card-start reaches them through this
#     flag, being installed standalone and unable to source that lib.
#     WHAT A REFUSAL IS: rc 0, NOTHING written, no owner tag, no move echo on stdout, and the
#     reason on stderr naming the stage or the pin. rc 0 because the guard did its job — the
#     callers that pass this flag are fail-soft automation, and reporting a correct refusal as a
#     failed move is how an operator learns to ignore the line. A card that could not be READ is
#     the OTHER answer and never reads as a policy refusal: rc 1, nothing written, because an
#     unreadable card and a startable one are opposite answers to a guard. A card already IN
#     PROGRESS is refused like any other started card, in its own words (it is left where it is,
#     not moved backward). An invariant answering with an rc outside its declared set — 127 from a
#     _kb-board-lib.sh that predates it — is a guard that cannot be applied: rc 2, nothing written,
#     and the line names the function and the rc (card#9756).
#     ONLY WITH --column in_progress (rc 2 otherwise, before any request): the policy is the
#     promotion's, and there is none to apply to any other column. It costs ONE extra GET before
#     the move, which is what makes the verdict a reading rather than an assumption.
#   kbcard reorder --ids "ID-OR-EXT[,ID-OR-EXT...]" --placement top|bottom
#   kbcard reorder --ids "ID-OR-EXT[,ID-OR-EXT...]" --before-task ID-OR-EXT
#   kbcard reorder --ids "ID-OR-EXT[,ID-OR-EXT...]" --after-task ID-OR-EXT
#     RANK cards WITHIN one column — the one thing `move` cannot do (it decides the COLUMN and
#     lets the card land wherever the board puts it). Writes ONLY `position`, so it can NEVER
#     move a card between columns or swimlanes: `move` / `patch --column` own the column and
#     `patch --swimlane` owns the lane, and this verb is not a third way to reach either.
#     SCOPE IS THE STAGE, ACROSS EVERY SWIMLANE IN IT. All the ids must be active cards of ONE
#     stage — a list spanning two is refused by the board, there being no ordering between
#     columns to express — while a list spanning several swimlanes of one stage is the ORDINARY
#     case and is accepted: the resulting positions totally order the whole column.
#     --ids IS THE MOVING BLOCK, IN TARGET ORDER, as ONE comma list (the spelling --tags and
#     --clear use). Each member is an ID-OR-EXT resolved through the SAME resolver every --task
#     takes, so an external id works here and a numeric id costs no request.
#     ⭐ EXACTLY ONE PLACEMENT, AND THIS TOOL DECIDES THAT OFFLINE. Zero placements, or more than
#     one, is rc 2 BEFORE any request, naming what was passed — it is the board's own rule (the
#     same call is refused server-side), applied where the flags are typed so a malformed
#     invocation costs no traffic, the posture --dl / --pr / --clear already take. --placement
#     takes `top` or `bottom` and NOTHING else (rc 2, naming the two). --before-task /
#     --after-task name an ANCHOR card to land the block against.
#     REFUSED OFFLINE, nothing sent: no --ids at all; an --ids member that is visually BLANK
#     ("5,,6", "5,", "5, ,6") — a token naming no card is a caller mistake about WHICH cards are
#     being ranked, and dropping it silently would land a DIFFERENT order at rc 0, which is the
#     board's own reasoning for refusing it too; the SAME card named TWICE once the members are
#     resolved; and an ANCHOR that is itself in --ids. The last two are one shape and are
#     reachable WITHOUT typing a repeat: an id and that card's external id are two spellings of
#     one card, so `--ids 901 --after-task EXT-A` with EXT-A resolving to 901 is a call the board
#     would refuse naming a number nobody typed. Both are decided from values already in hand,
#     with no board read and no re-derivation of any stage rule.
#     Surrounding blanks on a member are TRIMMED before it is resolved, so `--ids "10309, 10221"`
#     means what it looks like. The board trims the same list too; the two sets are NOT asserted
#     equal here and must not be read as equal (this one is kb_is_blank's six ASCII characters
#     under LC_ALL=C — see _kbc_trim_blank — and the board's is its own language's default, which
#     differs at the edges). What the trim is for is the ordinary padded spelling, not parity.
#     RELAYED, NOT RE-DERIVED — the board's refusals, at its own wording and rc 1: ids spanning
#     two stages, an id naming no active card, and an anchor that is not in the same stage. The
#     rule is exactly "a fact about cards this call has not READ": each of the three needs rows
#     only the board holds, and a second implementation of its stage rules here is the divergence
#     this verb exists to stop at the caller level. (Anchor-in-ids used to ride here and does
#     not: it needs no row at all — see the offline list above.)
#     ⭐ WHAT IS PRINTED IS THE SERVER'S OWN COLLECTION, never a restatement of the request. The
#     200 carries the ranked cards in their new order with their new `position`, plus a `meta`
#     naming the UNTOUCHED cards immediately bracketing the block — which is what makes the
#     ACHIEVED placement readable from data rather than from a status. stdout is ONE object:
#     {workflow_stage_id, before_task_id, after_task_id, renumbered,
#      ranked: [{id, name, workflow_stage_id, swimlane_id, position}, …]}.
#     ⭐ AND IT IS CONFIRMED, NOT ASSUMED — a 2xx is the server accepting the request, never the
#     board holding the rank. THREE comparisons against the returned data, and they answer three
#     DIFFERENT questions; read which is evidence of what, because they are not interchangeable:
#       GATE ONE, WHICH CARDS — the ids echoed must be the ids this call asked to rank, in that
#          order. ⚠ THIS IS A CONSISTENCY CHECK, NOT EVIDENCE OF THE ACHIEVED ORDER. The board
#          builds that collection from the request's OWN ordered id list, so it agrees with the
#          request by construction and can disagree only on a server already wrong about much more.
#       GATE TWO, THE ORDER INSIDE THE BLOCK — the `position` values must be STRICTLY INCREASING
#          in the order returned. This is the gate that measures `--ids`, because position is the
#          one value here the request never supplied: the board computes it from the column's live
#          coordinates. Not strictly increasing (ties included) is rc 1 HARD FAILURE; a row with
#          no NUMERIC position is not a wrong order but NO order that can be read, so it is an
#          UNVERIFIED WRITE at rc 3 rather than a claim nobody measured.
#       GATE THREE, WHERE THE BLOCK LANDED — the bracket must be the one asked for: `--placement
#          top` ⇒ NO card before the block, `bottom` ⇒ none after, `--before-task X` ⇒ X is the
#          card AFTER it, `--after-task X` ⇒ X is the card BEFORE it. rc 1 HARD FAILURE on a
#          disagreement.
#       ⛔ THOSE THREE ARE DELIBERATELY NOT A NUMBERED LIST, and that is not a style choice: a
#       line beginning `1. ` is a LIST ITEM to `tests/by-ref-source-claim-selftest.sh`, whose unit
#       is a PASSAGE and which therefore CUT this header in two — orphaning the by-ref precedence
#       claim in the half above from the `payload.repo` condition that discharges it further down,
#       and reding that gate on a change that added no claim at all. Measured both ways.
#     A 2xx carrying no readable collection or no meta is an UNVERIFIED WRITE at rc 3.
#     ⚠ THAT SECOND COMPARISON IS A CLAIM ABOUT ANOTHER REPO AND NOTHING HERE CAN CHECK IT. It
#     was read at the kanban tag the route shipped in: the brackets are DERIVED from the
#     positions actually written (BoardPositionService::bracketsAround — the last untouched card
#     below the block and the first above it), not echoed back out of the request, which is
#     exactly what makes them worth comparing against. A server build that changed that
#     derivation would make this verb report HARD FAILURE over a write that LANDED — the costlier
#     direction to be wrong in — so it is NAMED here rather than assumed, the same way the
#     --unblock paragraph names its middleware claim. Re-read the route before widening it.
#     ⚠ `renumbered: true` IS NOT MOVEMENT, and must not be reported as any. On the rare request
#     whose placement exhausts the float gap between two neighbours, the stage's position
#     COORDINATES are rebuilt onto an even ladder and NO CARD'S RANK CHANGES; the board records
#     that as ONE `lane.cards_renumbered`, never as N moves. `ranked` is the cards THIS call
#     ranked and never the re-spaced ones, and the flag is called out on stderr in those words so
#     a reader cannot take it for a bigger move than it was.
#   kbcard patch --task ID-OR-EXT [--pr N] [--pr-url URL] [--issue N] [--issue-url URL] [--version VER] [--column COL] [--swimlane NAME-OR-ID] [--description "..."|--description-file PATH] [--clear-description] [--dl DL-NNN] [--triaged] [--keep-refs] \
#                [--name "title"|--name-file PATH] [--tags "tag1,tag2"] [--type <alias>] [--external-id 12345] [--origin <origin>] \
#                [--assign <seat|user-id> [--steal]] [--unassign] \
#                [--block-reason "..."|--block-reason-file PATH] [--unblock] [--clear FIELD[,FIELD...]]
#     --name / --tags / --type / --external-id / --origin are the CORRECTIVE setters: each
#     writes the same field the identically-named create-card flag writes at birth, so a card
#     minted with a wrong title, type, tag set, sync id or provenance is fixable in place
#     instead of being permanently wrong (a card name stamped once from a retargeted PR title
#     is the shipped case). Nothing here is implicit — an omitted flag leaves its field alone.
#     --tags REPLACES the whole tag list (the API stores it as one list and replaces it
#     wholesale); to add a tag, pass the full intended set. --triaged still appends to what
#     the card already carries, and composes with --tags (given set, then `triaged`).
#     A visually blank --tags is rc 2 before any request: the --tags paragraph of the free-text
#     convention at the top owns it.
#     --type re-types the card: it writes the board's native card_type_id for the alias, or
#     the `type:<alias>` tag on a board with no native type for it — and either way DROPS any
#     `type:*` tag the card was carrying, so a retyped card never reads as two types at once.
#     --column wont_do declines: same stamp-clearing as `move` (see above) — the
#     correlation stamps are nulled unless --keep-refs; a ref flag passed IN THIS
#     CALL wins over the null (explicit beats hygiene).
#     --swimlane writes the card's top-level swimlane_id, resolving a name via the same
#     board-env map `list --swimlane` uses (numeric id passes through). --swimlane none
#     (or 0) un-assigns the card from its swimlane (writes swimlane_id null).
#     --clear FIELD[,FIELD...] IS THE PAYLOAD FIELDS' CLEARER — origin, version, pr-url, issue-url
#     (the setter flag's spelling; `_kbc_clearable` is the one declaration, and an unknown field is
#     rc 2 naming the accepted set). Each named field goes out as an EXPLICIT JSON null for its
#     payload key (version → version_target): the API merges payload per key, so an omitted key is
#     untouched and a null REMOVES it. For pr-url / issue-url that CAN drop the by-ref `source`:
#     the board re-derives it from what remains — payload.repo OUTRANKS every URL when it is a
#     string containing /, so on such a card clearing a URL cannot drop the source at all;
#     otherwise the other URL keys, then a GitHub external_link. Several fields are ONE comma list (`--clear origin,version`), the
#     spelling --tags uses; a second --clear is rc 2 rather than a silent last-wins that would drop
#     a clear. No padding is trimmed and an empty member is an unknown field. Naming a field AND its
#     setter (`--pr-url X --clear pr-url`) is rc 2 before any request, naming the flag passed. The
#     write echo shows every cleared key RAW under `payload`, so a removed one reads `null`. On a
#     board with no version_target field, `--clear version` is ignored with the same warning
#     --version gets. Beside --column wont_do an explicit clear composes with the decline nulls
#     (both write null), and — like an explicit ref flag — it wins over --keep-refs, whose notice
#     then leaves the cleared key out of what it retained. create-card
#     does not take it: there is nothing to clear at birth.
#     ⛔ --clear-description IS THE DESCRIPTION'S CLEARER — the shape --unblock is for
#     block_reason, and for the same reason: a field this tool can SET must be unsettable by it,
#     or a body written once outlives what it described with no way to retract it. It writes an
#     EXPLICIT JSON null: the API MERGES per key, so an omitted key leaves the field alone and a
#     null CLEARS it. Explicit rather than leaning on the board's TrimStrings /
#     ConvertEmptyStringsToNull rewriting a blank value into one — a clear that DEPENDS on
#     another repo's middleware is a clear that repo can withdraw. That inferred route is gone
#     regardless: a blank --description is rc 2 before any request (the free-text convention at
#     the top of this file), so clearing is now SAID rather than spelled as a value that means
#     nothing. Mutually exclusive with --description AND --description-file — rc 2 before any
#     request, a call naming the setter and the clearer states no end state at all — and the
#     write echo shows the RAW `description` for this call, so the caller SEES the null rather
#     than having to re-read the card. create-card does not take it: there is nothing to clear
#     at birth, and an omitted pair already leaves the field unset.
#     --assign SETS THE KANBAN ASSIGNEE, NOT THE SEAT OWNER: seats commonly share one kanban
#     user, so the seat working a card is the `owner:<project>/<seat>` tag (README.md § The
#     seat owner tag), and --assign neither reads nor writes that tag.
#     --assign / --unassign write the board's NATIVE assigned_user_id — the field that answers
#     WHICH KANBAN USER IS ALREADY WORKING THIS CARD when the card's stage never moved, which is
#     precisely the state two seats pull the same work in (a card sitting in backlog is
#     indistinguishable from an unclaimed one). A <seat> resolves through KB_USER_<SEAT> in
#     THIS board's env — the same config-driven shape as KB_STAGE_* / KB_TYPE_*, so nothing
#     here reads another product's config and a seat with no bridge installed works the same;
#     a numeric user id passes through. ⚠ AN UNKNOWN SEAT NAME IS rc 2 BEFORE ANY REQUEST,
#     naming the KB_USER_* vars this board env does define: an unresolvable name is a config
#     gap, and doing something other than what the caller believed is the failure this verb
#     exists to remove, so it is never a silent no-op and never a guessed id.
#     ⭐ ASSIGNING OVER ANOTHER SEAT'S CLAIM IS REFUSED — rc 1, the holder NAMED, and NO
#     WRITE. That refusal IS the collision detector: the second seat is told whose work it
#     was about to redo, and it works exactly where the stage cannot answer. --steal is the
#     opt-out and says loudly whose assignment it took. Assigning the seat that already holds
#     the card is not a conflict (it writes the same id it read).
#     --unassign is deliberately NOT gated the same way. kbcard has no notion of WHICH seat is
#     running it — the map resolves names to ids, never "me" — so it cannot tell a seat
#     releasing its OWN card (the ordinary case) from one clearing somebody else's, and gating
#     it would make --steal routine, which is the one thing that would stop the loud line
#     meaning anything. It NAMES the holder it released instead, so nothing is lost silently.
#     ⚠ A 401/403 on a write carrying assigned_user_id is called out as an INSTALL FAULT by
#     name — the board TOKEN'S ROLE (a role without `task.update` cannot write an assignee) or
#     a board that is read-only to it — rather than as a generic HTTP line: it is permanent for
#     that token, so no retry and no card edit changes it.
#     --block-reason / --unblock write the board's own top-level block_reason — the field a
#     sprint burn-down RENDERS as its "Blocker / next action" column. Nothing on any product
#     surface wrote it before this flag: not this CLI, not the board's web UI. So that column
#     read empty on every row of every board, and an operator reading it concluded nothing was
#     blocked — a false answer produced by a working renderer with no writer. A blocker recorded
#     in a card COMMENT, the only place an agent had, is not readable there.
#     ⛔ --unblock IS THE CLEARER AND IS NOT OPTIONAL DRESSING. A reason that can be set and not
#     unset goes stale in a structured field, which is the exact failure `_kbc-stale-blocker.py`
#     exists to report — a card still asserting a constraint that was true when written. It
#     writes an EXPLICIT JSON null, not an empty string. The distinction that is REAL is the
#     API's PER-KEY MERGE: an omitted key leaves the field alone, a null CLEARS it. "" is a third
#     thing ON THE WIRE and is NOT a third stored state — the board runs Laravel's TrimStrings
#     then ConvertEmptyStringsToNull over JSON bodies, so "" (and any all-whitespace value)
#     reaches the controller as null and stores NULL, collapsing into the clear. Sending null
#     explicitly is therefore the spelling that does not DEPEND on that: it asks for the clear
#     rather than being rewritten into one.
#     ⚠ THAT LAST PART IS A CLAIM ABOUT ANOTHER REPO, AND NOTHING HERE CAN CHECK IT. Read at the
#     kanban-board declaring end (its bootstrap leaves the global stack's TrimStrings /
#     ConvertEmptyStringsToNull in place, TransformsRequest::clean covers a JSON body, and the
#     board's own test header states the rewrite in its own words) and MEASURED against the live
#     board — a whitespace-only reason sent by a build without the refusal below returned rc 0
#     and stored null. A board that excepted that middleware would make "" a stored value again
#     with this file's suite unmoved, so it is named here rather than assumed.
#     The two are mutually exclusive — a call naming both says nothing about what the card should
#     end up holding — and that is rc 2 before any request, as is naming both halves of the
#     --block-reason/--block-reason-file pair. An omitted flag leaves the field exactly as it was.
#     ⚠ SETTING A REASON PINS THE CARD AGAINST THE WHOLE post-checkout HOOK, NOT JUST ITS MOVE:
#     bin/board-card-start EXITS at the pin, so the payload.dl_number stamp that sits below the
#     move is skipped as well, and an unstamped card is one a release promote later no-ops on.
#     What --unblock does and does not backfill is owned by README's `kbcard patch
#     --block-reason` section; not restated here.
#     ⚠ AND SINCE card#9556 IT PINS THE CARD ON THE DISPATCH PATH TOO: `move --card-start`
#     (see move, above) refuses a pinned card outright, whatever its stage, so a reason set here
#     parks the card against BOTH starters rather than only against the one at checkout.
#     ⛔ A WHITESPACE-ONLY REASON IS REFUSED — rc 2 before any request, on BOTH halves of the pair
#     alike — and what it prevents is a SILENT NO-OP, not a blank-looking blocker. Measured: the
#     same call without this refusal is rc 0, and the board stores NULL (the normalization above),
#     so the card ends up NOT BLOCKED while the caller was told the write landed. The echo was
#     already printing that null; the exit status said success, and automation reads the status.
#     That is the readback-before-success shape this repo has a name for. It is not special to
#     this pair: every free-text flag here refuses a text-free value through either half (the
#     free-text convention at the top of this file owns that rule and states it once).
#     ⚠ THE LENGTH CAP IS THE BOARD'S AND IS NOT RESTATED HERE. The API declares a maximum for
#     this column and refuses a longer value itself, naming it; kbcard sends what it was given
#     and NEVER TRUNCATES (a silently shortened blocker is a different sentence from the one the
#     caller wrote, stored under an rc 0 that says it landed). Copying that number into this
#     file would be a second copy of the board's own rule with nothing comparing the two, so a
#     board that widened the column would be refused by its own CLI — the same call --pr already
#     makes about the board's declared field type (see above).
#     --pr-url writes payload.pr_url — the kanban derives a card's by-ref `source` (owner/repo)
#     from it, UNLESS the card's payload.repo is a string containing /, which outranks every URL
#     (derive_source; `kbcard show --task N` prints the card); required for the repo-qualified
#     PR→card lookup on a multi-repo board (--pr alone sets pr_number, not source).
#     Pre-PR placeholder: https://github.com/<owner>/<repo>/pull/0
#     ON patch, ONE HALF OF A PAIR WITHOUT THE OTHER READS THE CARD FIRST and is rc 2, with NOTHING
#     written, when the stored other half names a DIFFERENT number: --pr without --pr-url, --issue
#     without --issue-url, and the mirrors --pr-url without --pr, --issue-url without --issue. The
#     write would leave the card naming one ref by number and another by URL, and the refusal
#     says that and what to pass — never where the card ends up attributed, which the pair does
#     not decide (payload.repo above; card#9918). Pass both halves. Numbers compare after the
#     same normalisation (#178 and PR-178 are 178); a URL's number is read from .../pull/<N> or
#     .../issues/<N> for either pair (one number sequence). No stored other half, the same number,
#     a STORED .../pull/0 or .../issues/0 placeholder ("no PR yet") and a STORED number of 0
#     (either names no ref) proceed unchanged;
#     so do both halves together, --clear pr-url / issue-url, and a wont_do decline without
#     --keep-refs (which nulls pr_number and pr_url, not the issue pair) — each replaces or
#     removes the other half, and none reads the card for it.
#     A GIVEN placeholder is not exempt: --pr-url .../pull/0 (or --issue-url .../0) alone over a
#     stored number naming a real ref is refused like any other divergence. Nor is a URL, GIVEN
#     or STORED, naming no number that still yields a repo (a commit/tree/blob URL, .../pull/
#     with no digits, or a number read from a different repo's URL in the same value — the
#     promote side's repo_from_gh_url, shared through the lib): --pr-url U alone over a stored
#     real number, and --pr N alone over such a stored URL, are refused, naming the missing flag
#     and the repo, never the URL.
#     A URL, given or stored, that yields NO repo (not a GitHub PR/issue/commit/tree/blob URL),
#     or a stored number naming no one number, proceeds with a notice that the check could not
#     be made; an unreadable card is rc 1, nothing written
#     (card#9837, card#9846, acceptance changes, operator-approved). Which pairs a call writes
#     by half is decided offline, on EVERY patch, so beside a _kb-board-lib.sh that predates the
#     check every patch is rc 2 before any request — the external-id lookup and the --assign read
#     included — naming the missing function (card#9756's rule).
#     --issue / --issue-url are the issue-lifecycle mirror of --pr / --pr-url: they write
#     payload.issue_number (numeric-canonicalized) + payload.issue_url, and --issue-url likewise
#     drives the by-ref `source` (owner/repo) for the issue→card lookup on a multi-repo board,
#     unless the card's payload.repo outranks it (_kbc_ref_pair_guard's header owns that rule).
#     Independent of the pr_* pair — a card can carry both an issue ref and a PR ref at once.
#     A visually blank --pr-url / --issue-url is rc 2 before any request, as is a blank --version
#     or --origin: the payload-text-flag paragraph of the free-text convention at the top owns it.
#     --pr / --issue MUST NAME ONE POSITIVE INTEGER, optionally decorated (178, #178, PR-178).
#     A value carrying no digits, or SEVERAL digit runs (1.5, 2026-08-23, "PR 12 of 34"), is
#     rc 2 before any request, on both create-card and patch — as is a NEGATIVE value (-5) and
#     ZERO in any spelling (0, 00, #0, PR-000). The shape half is the board's own rule for
#     deriving a card's by-ref key, applied at the point the value is typed: a stamp the board
#     derives no reference from correlates the card to NOTHING while looking set, and a reader
#     that instead concatenates the runs derives a real but DIFFERENT PR/issue (1.5 → 15,
#     2026-08-23 → 20260823). The sign/zero half is STRICTER than that rule on purpose: GitHub
#     numbers pull requests and issues from 1, so -5 and 0 name nothing to correlate to, and
#     each is read three incompatible ways (stored as typed here, sign-and-decoration stripped
#     to a real but DIFFERENT ref by the board, declined outright by the positive-only admission
#     test a reconciler applies to the same field) with no reader erring. Beyond shape, sign and
#     zero nothing about the value is checked here —
#     the board's declared field type is a separate question, and the two are not the same
#     narrowing: a DECORATED value is accepted by this check (as the board's own rule accepts
#     it) but is not numeric, so it goes on the wire as a JSON string, which a `number`-typed
#     pr_number/issue_number field then refuses server-side (docs/INSTALL.md §3b). --dl has
#     always been strict in the same way (kb_dl_canon, which refuses a sign and refuses 0);
#     --pr-url / --issue-url are URLs and are not covered — the pre-PR placeholder .../pull/0
#     is a URL and rides there, untouched by this shape check (the pair check above still
#     applies to it on patch).
#   kbcard list  [--column COL] [--type TYPE] [--swimlane NAME-OR-ID]
#     Prints a JSON array projecting id, name, stage, type, swimlane_id, swimlane,
#     external_id, tags, assigned_user_id, assignee, dl, pr per card — and nothing
#     else, so a downstream grep/jq
#     over a field OUTSIDE that set (description, any payload key but dl/pr) answers 0
#     no matter what the board holds. `show` returns a card whole; use it for the rest —
#     and use `search` to hunt a card BY its body, which is the question a grep over this
#     projection cannot answer at all.
#     `type` is the NATIVE card_type_id — null on every row of an all-tag board (and on
#     a mixed board's tag-typed cards), where the type rides `tags` as `type:<alias>`.
#     So select on `tags` there, not on `type`: `--type <alias>` matches those cards but
#     their projected `type` is null, and a filter keyed on it returns a confident 0.
#     `assigned_user_id` is the board's own field and is ALWAYS the raw id (null when the
#     card is unassigned); `assignee` is the seat NAME for it where this board env's
#     KB_USER_<SEAT> vars map that id, and null where they do not — the id is the answer,
#     the name is an ornament this install may not be able to supply, so an unmapped id
#     renders raw rather than failing or guessing.
#     --swimlane none (or 0) filters to the LANELESS cards — the read counterpart of the
#     same spelling on create-card/patch, so a deliberately laneless card is queryable
#     and not just creatable. Lane ids are positive, so `0` never named a real lane; a
#     lane literally NAMED `none` must be addressed by id.
#     With ANY filter flag active, one line goes to STDERR: `list <flags>: <M> of <N>
#     board cards matched` — the denominator a filtered result otherwise hides, so an
#     empty answer is distinguishable from an empty board. stdout is unchanged (still
#     just the array). Unfiltered, nothing is printed: the array's length IS N.
#     `stage` is a NATIVE NUMERIC ID and `--column` takes a NAME: `kbcard stages` prints
#     the map between them, so a consumer joins the two at run time instead of pinning a
#     number this install happens to use.
#   kbcard stages
#     READ the stage id → column name map as JSON, symmetric with `field list`: one
#     {"id": <n>, "name": "<column>"} object per mapped stage, and no other key. This is
#     the join `list` needs, and it exists because nothing read the map out: one seat
#     inferred a stage id from the order of the --column list above and another filtered a
#     board sweep on the wrong key and read `0` over a real backlog (card#7694). Both
#     answers were confident and wrong, which is what a hardcoded id buys you.
#     ⚠ IT READS THIS CALLER'S OWN CONFIG, NOT THE SERVER — the pairs are the KB_STAGE_*
#     variables VISIBLE TO THIS PROCESS (~/.kanban-<board>-board.env, selected by the global
#     --board flag, PLUS any KB_STAGE_* the calling shell exported: kb_resolve_env sources
#     the board env and does not clear pre-existing ones), and no request is issued. So these
#     ids are PER-INSTALL, which is the argument for reading them at run time rather than
#     baking them in, and a `name` here is a KB_STAGE_* variable's SUFFIX, LOWERCASED — this
#     install's word for the column rather than the board's own label. ⭐ THAT CLAIM ALSO
#     RIDES THE COMMAND'S OWN STDERR, on every successful call, because a consumer piping the
#     JSON never reads this help — and one that did not read it wrote a board-resolved config
#     in these local names (rt#442). stdout is unchanged — which is exactly why `stages` IS NOT
#     SAFE TO RUN WITH STDERR MERGED INTO IT: `kbcard stages 2>&1 | jq .` dies at `jq: parse
#     error` on line 1, so redirect stderr separately (`2>/dev/null`, or to a file) when you
#     pipe the JSON. A board env mapping NO stage is rc 1 with nothing on stdout — every column
#     this tool can address needs a KB_STAGE_* var, so an empty map is a config fault, not a
#     board with no columns — and a KB_STAGE_* whose value is not a stage id is NAMED on stderr
#     rather than dropped, which includes the `000` placeholder a copied board-env template
#     still carries.
#     THERE IS NO ORDINAL FIELD, deliberately: nothing this read can see carries the
#     board's column ORDER (the env is an unordered set of name=id pairs), so an ordinal
#     would be a plausible-looking sequence with no source. Rows are emitted sorted by
#     NAME for determinism; that is not the board's order and is not offered as one.
#     The name half is stage_name's — the same resolver `show` fills a card's `column`
#     from — so this read cannot disagree with it: ANY KB_STAGE_* var maps (a board's own
#     taxonomy, not just the eight aliases above) and a duplicate id resolves once.
#   kbcard search <query> [--column COL] [--type TYPE] [--brief | --count]
#     READ: the server's own free-text search over this board, printed as one BLOCK per hit —
#     a `card <id> · stage <sid> · <name>` header line, then the card's FULL description
#     indented two spaces on every line (a card with no description says so in words).
#     THIS IS THE VERB FOR FINDING A CARD BY WHAT ITS BODY SAYS. `list` projects a fixed
#     field set that excludes `description`, so grepping a card body through it answers 0
#     whatever the board holds; this prints the field the search matched on.
#     <query> is the endpoint's own `q=` token stream, sent AFTER this board's `board_id=`
#     term — which it cannot override, since a second board_id token is ANDed with the first,
#     not swapped for it. So: bare words are free text over `name` + `description`, the
#     field-scoped `name:<needle>` / `description:<needle>` narrow to one column, and the
#     rest of the DSL rides through unchanged (`tags:"x"`, `comments_count>=1`,
#     `updated_at>:2026-08-01`, `custom_field_<key>:v`). A token the server does not
#     recognise is not refused — it falls through and is searched as free text.
#     HOW A FREE-TEXT WORD MATCHES IS THE SERVER'S RULE, not this tool's, and it is not one
#     rule: on the MariaDB instance each word is required and matched as a PREFIX through the
#     FULLTEXT index (so `cat` reaches `category`, not `concatenate`), while a query carrying
#     any word shorter than the index's minimum token length (the server pins that at 3, which is
#     MariaDB's default) falls back to a literal substring match of the WHOLE term — which is a
#     PHRASE, not an AND of words. If a multi-word query surprises you, suspect that fallback
#     first. NO FIGURE IS QUOTED HERE ON PURPOSE: a hit count measured against a live board is
#     stale the next time anyone files a card, and this paragraph has drifted twice that way.
#     WHICH ARM RUNS IS THE SERVER'S, AND IT IS VERSION-DEPENDENT — newer servers narrow the
#     fallback to an AND of words and disclose the arm in the response meta, older ones do
#     neither, and this tool cannot tell you which you are talking to. Read the kanban API's own
#     free-text contract for the instance you point at; do not infer it from this comment.
#     COMMENT CONTENT IS SEARCHED: the free-text arms cover name + description + comment content
#     — a word appearing ONLY in a comment does reach the card (verified live). Separately,
#     `comments_count<op>N` filters on the COUNT, never the content: two different things, and
#     only the second is about counting.
#     --column / --type filter the matched set client-side exactly as on `list`, and add the
#     same `<M> of <N>` stderr denominator. A search that matched nothing prints one explicit
#     line at rc 0 — never a silent empty stdout — and says separately when the query DID
#     match cards that the filter flags then removed. A blank/whitespace-only query is rc 2
#     before any request: it matches every card on the board, which is not a search.
#     An incomplete board read is rc 1 with no blocks printed: a match set missing whatever
#     was on the page that failed reads as "not on the board", which is a wrong answer, not a
#     short one.
#     TWO OPT-IN NARROWINGS, AND THE BLOCK FORM STAYS THE DEFAULT: forgetting a flag costs you
#     too much output, never a silent truncation. Neither changes WHICH cards match — both
#     drop what is printed ABOUT them, so the filter flags and the denominator are unaffected.
#     --brief prints the header lines ONLY — the SAME BYTES the block form's header already
#     carries, one renderer owning that line, so nothing downstream needs a second parser and
#     the two cannot drift apart. It is the projection for "which cards match" on a board
#     where a handful of hits is tens of KB of bodies, i.e. the read whose absence sent
#     callers to `list` + a title match, which cannot answer a body question at all.
#     --count prints ONE line and no bodies: the `<M> of <N>` denominator above, in the same
#     words, on STDOUT because with this flag the count IS the requested output (it still
#     goes to stderr as well when a filter flag is active — that line is unchanged). It
#     REPLACES the zero-result prose too, so `0 of 0` and `0 of 5` are what tell a nothing-
#     matched apart from a filtered-to-nothing.
#     TOGETHER THEY ARE rc 2 BEFORE ANY REQUEST. --count is not a narrower --brief, it answers
#     a different question, and silently picking one would hand back a number where header
#     lines were asked for — the shape both flags exist to prevent.
#   kbcard link --from TASK --to TASK --relation "bundles"|"blocks"|"caused"
#   kbcard unlink --link-id N --on ID-OR-EXT
#   kbcard unlink --from TASK --to TASK --relation "bundles"|"blocks"|"caused"
#     REMOVE a task link — the half `link` shipped without, and without which a mislink is
#     PERMANENT. A link is deleted BY ID (the API has no from/to/relation delete form) and
#     there is no read route for a link on its own, so the id alone cannot be read back:
#     --link-id therefore takes --on, the card the link is witnessed on. EITHER end will do
#     — a link is carried on both, and the card's own entry says which direction it runs —
#     so the card you are LOOKING at is the card you name. The --from/--to/--relation form
#     is a convenience that resolves the id off the from-card first; it refuses, with NO
#     DELETE sent, when that matches zero links or more than one, naming the ids it found so
#     the ambiguous case is pickable with --link-id.
#     ⚠ THE 204 IS NOT THE REMOVAL — THE READ-BACK IS. Nothing is deleted that was not first
#     READ: an id that is not on the named card is rc 2 with no DELETE at all. After the
#     DELETE, BOTH ends are re-read and success is reported ONLY when the link is absent from
#     each — a cross-board link projects onto both boards, so one end is half a measurement.
#     A success status with the link still present is a HARD FAILURE that prints the card's
#     own entry as the evidence, and an end whose linked_tasks comes back TRUNCATED makes the
#     absence UNMEASURED, which is reported as a failure and never as a success.
#     Each way it can fail is NAMED rather than collapsed: 401/403 is the board POLICY
#     refusal (a read-only or trashed board at EITHER end — the mirror of what refuses the
#     create), 404 is no such link, and a request that never completed says exactly that
#     rather than claiming an outcome in either direction.
#     ⚠ A CROSS-BOARD UNLINK IS rc 1 UNLESS THIS BOARD'S TOKEN CAN READ THE FAR BOARD, and
#     that is the verb's motivating case, not an exotic one. The far end is re-read through
#     the same credentials as everything else here, so a token scoped to one board gets 401/403
#     on that read and the run ends "the removal is UNVERIFIED at that end" — with the DELETE
#     ALREADY SENT. That is a report about the MEASUREMENT, not about the removal: the link is
#     very likely gone, and this tool will not say so because it did not read it. Re-running is
#     safe and is the way to find out — the second run's pre-witness no longer lists the link,
#     so it refuses at rc 2 with no DELETE. To get a green, run it from a seat whose token
#     reads BOTH boards.
#     On success stdout carries the removed link as one JSON object — {task_link_id,
#     from_task_id, to_task_id, relation_type} — the same three keys `link` POSTs, so the
#     removal is machine-readable in the spelling the creation already uses. relation_type is
#     projected off the card's own entry, so an entry carrying no such key reports JSON `null`
#     rather than the string "null" a consumer could round-trip back into `link --relation`.
#   kbcard show --task ID-OR-EXT
#     The card WHOLE, plus this tool's own annotations resolved from the board env: `stage` /
#     `column` (the column name for the stage id) and `assignee` (the KB_USER_<SEAT> name for
#     assigned_user_id). An annotation this install cannot resolve is OMITTED, never emitted
#     null — the raw assigned_user_id is on the card either way, so an unmapped seat costs a
#     name, not an answer.
#   kbcard comment --task ID-OR-EXT --content "text" | --content-file PATH
#     WRITE a card comment — the routine audit trail — and print the CREATED COMMENT ID on
#     stdout. That id is the write verification — never a card timestamp: whether a comment
#     moves the card's updated_at is the kanban API contract's to state (DL-269), and nothing
#     here reads it. A success carrying no id is reported as an UNVERIFIED write (rc 3)
#     rather than printed as a plausible-looking `null`.
#     The id is then READ BACK on the card: the comment must be in the `comments` array the
#     task-detail GET carries (the only read surface a comment has — GET on the comments path
#     is 405), which is complete rather than a first page. Absent there is rc 1 HARD FAILURE;
#     a card that could not be re-read is rc 3.
#     Text sourcing is the shared free-text contract at the top of this block, with the one
#     difference that block states: this pair is REQUIRED — neither source given is rc 2, not a
#     silent no-op, because the text IS the request. Its INLINE half is NORMALIZED like its file
#     half (CRLF folded, trailing newlines trimmed); THAT is what distinguishes this pair from
#     --name/--description, and blank-checking is no longer a difference at all — every
#     free-text pair refuses a text-free value through both halves — so `--content "  "` is rc 2
#     exactly as an all-whitespace --content-file is. A comment's own indentation is content and
#     survives; only trailing newlines are trimmed.
#   kbcard comments --task ID-OR-EXT
#     READ the card's comments, one block each: `comment <id> · user <user_id> · <created_at>`
#     followed by the content indented. The author is a bare user id because that is the only
#     author field a comment row carries. There is NO comment read route (GET on the comments
#     path is 405, POST-only), so this projects the `comments` array the task detail GET
#     already carries — the same array `show` returns, without the rest of the card.
#     A card with none prints one explicit "no comments" line at rc 0, so an empty answer is
#     never a silent one. The array is the WHOLE ordered comment history (measured at N=60 on the
#     sandbox instance: 60 posted, 60 returned, created_at ascending, no gap) — this read is not
#     paged and takes no page argument.
#     Content is untrusted text printed to a terminal, so every C0 control character EXCEPT the
#     newline and the TAB is rendered as `?` — an embedded ESC is a terminal command, and
#     `ESC[2K ESC[1A` erases the `comment <id> · user <n>` line above it, i.e. its own
#     attribution. The tab is exempt because it cannot move the cursor backward (so it cannot
#     reach that line) while replacing it damages every pasted diff or indented block. The header
#     line's own fields come from the same untrusted body and are sanitized too, more strictly:
#     EVERY C0 control there, newline and tab included, since a newline in a header field would
#     forge a second attribution block where one in the content cannot (content is indented).
#   kbcard archive --task ID-OR-EXT [--force] [--dry-run]
#     Take the card off the board without deleting it (PATCH _action:archive) —
#     the row stays live + recoverable and keeps its stable id + dl_number.
#     Refuses (rc 1, no PATCH) if the card's backing coordination source (its
#     pr_number/issue_number by-ref, or id:<sid> tag) is still LIVE and has no
#     surviving twin card — archiving its only card would hide a live source from
#     the reconcile/detect backstop (roundtable #39). --force overrides the gate
#     and records an audited override line (stderr + the kbcard failure log).
#     The PATCH is READ BACK: `archived_at` must be stamped on a re-read of the card before
#     this reports an archive. Still on the board is rc 1 HARD FAILURE; a card that could not
#     be re-read is rc 3.
#   kbcard delete --task ID-OR-EXT [--hard] [--yes|-y] [--dry-run]
#     Default: soft-delete (trashed, recoverable within the retention window; RETAINS
#     dl_number). --hard: permanent force-delete (cascades subtasks/comments/links;
#     RELEASES dl_number; two-step soft-then-force). --hard prompts to confirm unless
#     --yes, and refuses without --yes in a non-interactive shell. --dry-run prints
#     the exact API calls without executing them.
#     ⚠ BOTH STEPS ARE READ BACK, and the re-read PASSES `?trashed=1` — which is the whole
#     difference between confirming a purge and confirming nothing. `GET /tasks/<id>.json`
#     404s a card that is merely in the TRASH unless that parameter is sent, so a bare re-read
#     cannot tell a soft-deleted card from a purged one, and a `--hard` confirmed on it would
#     report "DL ref released" for a card still pinning the board's allocation floor.
#     So: the soft step is confirmed by `deleted_at` being stamped, and --hard's force-delete
#     by the card being ABSENT from a trash-asking read. Under --hard the soft read-back is
#     also the force-delete's PRECONDITION (force-delete 422s unless the card is trashed) — a
#     soft step this run could not confirm sends NO force-delete at all, because an
#     irreversible request does not go out behind a precondition nobody read. A 2xx over a
#     card that did not move is rc 1 HARD FAILURE; a card that could not be re-read is rc 3,
#     and on --hard that rc explicitly says NOT to treat the DL ref as released.
#   kbcard field list
#     READ: list the board's custom fields (id/key/label/type); enum & multi_select
#     fields include their full {value,label} option sets. The board index
#     (GET /boards/<id>/custom_fields.json) is the ONLY field read surface — there
#     is no per-field GET (that route is PATCH/DELETE only). Board is selected with
#     the global --board flag: `kbcard --board <key> field list`.
#   kbcard field set-options --field <name|id> --options a,b,c
#     WRITE: an idempotent converge-to-set on an enum/multi_select field's options —
#     after the call the field's option set equals EXACTLY the given comma list (in
#     that order). A second call with the same list detects no drift and SKIPS the
#     PATCH (no-op, says so on stderr). Reconciles by value; labels default to the
#     value (labels for retained values are not preserved across a rewrite). Refuses
#     a non-enum/multi_select field, empty/duplicate values, and an unresolved
#     --field (enumerating the board's defined fields).
#     OBSERVED option-removal semantic (empirically pinned on the sandbox instance,
#     board 1162): removing an option is a DEFINITION-ONLY change — a card still
#     holding a removed value KEEPS it verbatim in tasks.payload (orphaned: no longer
#     a defined option, but preserved, not cleared and not cascaded).
#     WHETHER THE REMOVAL PATCH IS REFUSED IS A PROPERTY OF YOUR SERVER. Without
#     kanban's DL-242 (in no kanban release through v0.41.0) it is NOT rejected (HTTP
#     200) even while a card references the dropped value, and that card is stranded
#     silently; with it, the same PATCH is refused 422 naming the offenders when the
#     removal would strand a value the CURRENT definition still accepts. That check is
#     a DELTA — a carrier whose value the current definition ALREADY rejects is skipped
#     by design, since refusing on it would leave the field uneditable, including the
#     widening that would re-admit the value — and the board-IMPORT route still narrows
#     unchecked, so it is NOT the case that all narrowing is now checked. This verb
#     propagates either answer: a non-2xx fails loud with the server's error body.
#     add-option / rename-option are intentionally not provided (deferred to v2).
#   kbcard field create --key <k> --label <l> --type <t> [--options a,b,c]
#     WRITE: define a new custom field on the board (POST the board's custom_fields
#     route) and print the CREATED FIELD ID on stdout — that id is the write
#     verification, and a success carrying no id is reported as an UNVERIFIED write
#     (rc 3) rather than printed as a plausible-looking `null`. The definition is then READ
#     BACK off the board's field index (the only read surface a field has): not defined there
#     is rc 1 HARD FAILURE, an index that could not be re-read is rc 3.
#     --type is one of: string number date enum multi_select boolean url. enum and
#     multi_select REQUIRE --options; every other type REFUSES it (the API would store
#     the array and never interpret it — a silent no-effect, the same reason
#     set-options refuses a non-enum field). A key already defined on the board is
#     rc 2 before the POST — a key is unique per board, so "create over the top" is
#     not a re-type; `field retype` is (the server converts a type in place).
#   kbcard field delete --field <name|id> [--orphan-values]
#     WRITE: drop a custom-field DEFINITION. FAIL-CLOSED on the carriers it can SEE.
#     The board is enumerated first (the shared whole-board fetch) and the denominator
#     `N of M board cards carry <key>` ALWAYS goes to stderr — a census that RAN and
#     returned zero is then distinguishable from one that never ran.
#     ⚠ THE CENSUS IS A LIVE, NON-ARCHIVED BOARD READ, and the denominator line says so
#     on every run: an archived or soft-deleted carrier is in neither of its numbers,
#     while the index purge this delete performs is board-wide and filters out neither.
#     So a zero numerator is a measurement of what this tool can see, NOT a statement
#     that the key is unused, and the refusal below — gated on that count — does not
#     fire for a carrier the read cannot return.
#     With N > 0 this REFUSES (rc 2) unless --orphan-values, because two MEASURED
#     server behaviours make a silent delete a data-integrity event:
#       (A) resident tasks.payload values SURVIVE the definition's deletion and are
#           never revalidated — a later create over the key does not touch them.
#       (B) the delete PURGES the search-index side table for the key and a later
#           create does NOT rebuild it — DSL filters on that key match ZERO cards
#           until each card's key is REWRITTEN (any payload write re-indexes it).
#     So a delete-then-create "migration" looks migrated and silently filters to
#     zero. To CHANGE A TYPE, never do that at all: `field retype` calls the server's
#     atomic conversion, which deletes nothing. --orphan-values is the explicit opt-in
#     to both consequences of a real delete and still prints a loud warning.
#     A board read that failed or came back INCOMPLETE (page cap / short read)
#     refuses (rc 1): a truncated denominator is not a denominator. That refusal covers
#     the incompleteness the READ can detect; the archived/trashed blind spot above is
#     not one of them (a complete read returns none of those cards and reports no rc),
#     so it is DISCLOSED on the denominator line rather than refused.
#   kbcard field retype --field <name|id> --to <type> [--options a,b,c]
#                       [--accept-ref-impact] [--restamp-dl]
#     WRITE: change a custom field's TYPE, as ONE call on the server's atomic
#     conversion route (POST /custom_fields/<id>/change-type.json). The server
#     converts the DEFINITION and every stored tasks.payload value keyed by it in one
#     transaction, rebuilds the search index for the key inside it, and touches no
#     other attribute — placeholder, mask, multiline, is_filterable and position all
#     survive, which the client-side delete-and-recreate this replaces could not do.
#     This verb issues NO delete, no recreate and no per-card cast: there is nothing
#     left here for a crash to leave half-migrated.
#     THERE IS NO DRY RUN, and none is simulated. `--check` exists only on the
#     server's own `php artisan kanban:change-custom-field-type`; the HTTP route does
#     not take it. PREVIEW-BY-REFUSAL is what the API offers instead: the whole board
#     is scanned BEFORE anything is written, so a conversion any card value blocks
#     answers 422 naming EVERY offending card (with a category and the validator's own
#     reason) and leaves the board byte-identical. The refusal IS the preflight.
#     from_type is ALWAYS sent: resolving --field already reads the current type, so
#     the compare-and-swap is free — and a definition whose type moved under this run
#     is its OWN outcome (412, "changed under you", nothing written), never folded in
#     with a 422.
#     --options is a PASSTHROUGH (a comma list, as `field create` takes one). Every
#     rule about it is the SERVER's and is surfaced verbatim rather than re-derived
#     here: options are REQUIRED converting into enum/multi_select from a non-option
#     source and are NEVER inherited from the stored column, OPTIONAL between enum and
#     multi_select (omitted = carried over verbatim), and PROHIBITED otherwise. The
#     comma list is split and trimmed, and an empty value / an empty list are refused —
#     those two ARE the server's own rules (options => array|min:1, options.*.value =>
#     required), so they refuse nothing the wire would have accepted.
#     ⚠ ONE DOCUMENTED EXCEPTION to the passthrough: a DUPLICATE value is refused at
#     rc 2 by this tool, and the SERVER has no uniqueness rule on an option set. The
#     rule is `set-options`' (a converge-to-set target must be distinct), shared by
#     `create`, and it applies here too — so `--options a,a` never reaches the wire.
#     The refusal says whose rule it is.
#     ⚠ --options REPLACES the whole option set. Between enum and multi_select, sending
#     it therefore DESTROYS every explicit label the definition carried (a comma list
#     carries no labels, and each value's label then defaults to the value); the run
#     names each label it dropped. Omit --options to carry the set over verbatim.
#     --accept-ref-impact opts into the ONE refusal that can be opted into: a
#     conversion that would MOVE a card's external-reference correlation. It never
#     skips the first call — the un-acknowledged POST is always made, its 422 reports
#     the exact card id set, and only then is a second POST sent acknowledging exactly
#     THAT set (the server re-derives the set under the row lock and refuses one that
#     changed). Without the flag the ids and the server's message are printed, nothing
#     is written, and the rc is non-zero.
#     --restamp-dl is a SEPARATE pass AFTER a successful conversion, not part of it.
#     The server's text rule for a `number` source is json_encode, so the stored
#     number 1 converts to the string "1" — not "DL-0001". Correlation is not at risk
#     (the server canonicalizes DL-028 / 28 / #28 to one key), but a custom-field DSL
#     filter written as `DL-0001` string-MISSES a card storing "1", so the conversion
#     alone leaves the DL migration half-done. Each populated card's value is rewritten
#     through the ONE canonical DL renderer and VERIFIED by re-reading the card; a card
#     already holding the canonical form is left unwritten, so a re-run costs no writes.
#     ⚠ THE PASS SEES A SMALLER POPULATION THAN THE CONVERSION DID, and NO run of it can
#     tell you the field is done. The server converts every carrier including ARCHIVED
#     and SOFT-DELETED cards; the board read this pass runs on returns neither. Where the
#     server's own converted count EXCEEDS the census, the remainder is proven: it is
#     counted and reported as its own outcome, at rc 1. Where it does not, nothing is
#     proven either way — the compare is of two counts taken at two moments (live-side
#     growth masks an archived carrier one for one), and on a same-type re-run the
#     server scans nothing at all and reports 0 — so EVERY line this pass emits that
#     could read as "done" carries the census scope with it, unconditionally. Those
#     cards are never read and never written here, and un-archiving one puts a
#     non-canonical value back into the live set.
#     Seven outcomes are reported as the seven different boards they are —
#     canonicalized · already canonical · PATCH failed (the write did not complete, so
#     never counted as verified AND never claimed unwritten) · read back different ·
#     verification read could not observe it (UNKNOWN state) · not a DL number at all ·
#     outside this pass's census (the remainder above). Requires --to string.
#
# ─── WHAT A WRITE VERB'S EXIT CODE MEANS ────────────────────────────────────
#   0  APPLIED — the mutation was READ BACK and the read agrees with what was asked. Every
#      write verb below confirms on a surface the caller can go and read for itself, and a
#      success LINE says which surface and what it showed. A 2xx is not this: the status is
#      the server saying it accepted the request, never the board saying it holds the result.
#   1  NOT APPLIED, and KNOWN — the request was refused (the status and the server's own
#      message say why), or the read-back is a MEASUREMENT and it says the mutation did not
#      take. The second spelling is reported as HARD FAILURE and quotes what the board holds.
#      ⚠ ONE VERB REACHES rc 1 ON A THIRD STATE, and it is named rather than folded in: `reorder`
#      HARD FAILs when the board's read-back MEASURES the cards as ranked SOMEWHERE OTHER than
#      where the call asked — applied, but not as asked, which is not "did not take". It is rc 1
#      because rc 1 is the KNOWN-and-not-what-was-asked bucket and the outcome is fully measured
#      (rc 3 would assert the opposite, that nothing could be read), but the distinction is real:
#      those messages say outright that the cards WERE ranked, so a caller must re-read the
#      column rather than assume nothing happened. Every OTHER HARD FAILURE in this file means
#      the mutation did not take.
#   2  BAD INVOCATION — nothing was WRITTEN. Everything this tool can decide offline is decided
#      before the first request, so a typo'd flag costs no traffic; the post-read exceptions are
#      named below.
#   3  UNVERIFIED WRITE — the request WAS SENT and its outcome could NOT be read: the
#      confirming read did not complete, was refused (401/403 — a card this token cannot read
#      is not a card that is gone), or answered a 2xx nothing could be read out of. Nothing
#      here says the write landed and nothing says it did not. RE-READ before acting either
#      way; a retry is safe only where the verb is idempotent.
#      This is a THIRD outcome, not a rename of rc 1: every state that was rc 1 and is still
#      KNOWN is still rc 1. A caller that today treats "non-zero" as failure keeps working and
#      merely loses the distinction; one that must not act on an unconfirmed write tests for 3.
#
# A 2xx NOTHING CAN BE READ OUT OF is refused by the verb, not by jq: every single-card /
# single-field read and every write echo takes the verb's own empty-value arm at the verb's own
# rc, so an unreadable body is not reported as "no such card" / "no comments" / "no custom
# fields" (one measured exception, on `comments` — README) and an unreadable write echo is an
# UNVERIFIED WRITE at rc 3 rather than printed (the block above owns that contract). Two caller-visible boundaries on that: `list` reaches the same
# posture by a different route — it reads the board through the shared paginator, which refuses a
# page-1 body carrying no card array at its own rc 1 and takes `list` to rc 1 with empty stdout
# (card#6594) — and `patch --tags/--type/--triaged` refuses BEFORE the wire, rc 2 with no PATCH at
# all, when the tag read it must re-send WHOLESALE yields no usable list (a card genuinely carrying
# no `tags` key, or a null or empty one, is unaffected). `patch` writing one half of a pr/issue
# number–URL pair without the other is also rc 2 after a read: it reads the card and refuses, with
# no PATCH, when the stored other half names a different number, or when a URL naming no number —
# the given one or the stored one — still yields a repo (card#9837, card#9846). A
# guard whose lib invariant gives no answer — rc 127 from a _kb-board-lib.sh older than this
# kbcard — is rc 2 as well, with nothing written and the function named: `move --card-start`
# (card#9756) and, since the pair check's offline half runs on every patch, EVERY `patch`, before
# any request (card#9846).
# THE RULE: a read whose result DECIDES a write refuses that write when no card can be read out of
# it (non-2xx, or a 2xx whose `.data` is not an object) — it is never taken as an answer. Each such
# read is its own helper and states its own rc and any opt-out in its own header; this block does
# not list them.
# README.md § Reliability posture states in full what this covers and what it does not, and why —
# including what a `[]` from `list` does and does not establish. It is the ONE owner of that
# statement: this block deliberately does not restate it.
#
# Source of truth for IDs:
#   ~/.kanban-dev-board.env — sourced for stage/type/cf ID lookups.

set -euo pipefail

# Shared toolkit lib (config resolution, API wrapper, pagination, DL canon).
KB_LIB="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)/_kb-board-lib.sh"
[ -r "$KB_LIB" ] || { echo "$(basename "${BASH_SOURCE[0]}"): shared lib _kb-board-lib.sh not found next to this script — reinstall per INSTALL.md §3 (symlink all of bin/), or vendor _kb-board-lib.sh alongside this tool." >&2; exit 1; }
# shellcheck source=bin/_kb-board-lib.sh
source "$KB_LIB"

# kb_api knobs: own message prefix, the failure log, and echo the error body.
KB_PROG="kbcard"
KB_LOG_FILE="${KBCARD_LOG_FILE:-$HOME/.kbcard-failures.log}"
KB_API_ERRBODY=1
# fetch_board_cards (cmd_list) must report + log a page-fetch failure loudly like
# every other kbcard subcommand — not exit silently. KB_LOG_FILE above is the sink.
KB_FETCH_LOUD=1

# Config (board env + host env + token) is resolved in main() once the optional
# `--board NAME` global flag is parsed, via kb_load_config. Card types are
# per-board: `native_type_id` resolves a `--type` alias to KB_TYPE_<ALIAS> from
# the board env (any alias), writing the native id when present and falling back
# to a `type:<alias>` tag when the board lacks that native type — so an alias
# absent on one board (`fr` on kanban, `request`/`idea` on bridge) is tagged, not
# rejected. (`stage_id` still rejects an unknown column — stages are required.)
# API base is board-independent and NOT baked in — kb_load_config reads it from
# ~/.kanban-host.env (override via $KANBAN_HOST_ENV); see docs/INSTALL.md.

stage_id() {
    local id
    case "$1" in
        backlog) id="${KB_STAGE_BACKLOG:-}" ;;
        prioritized) id="${KB_STAGE_PRIORITIZED:-}" ;;
        in_progress) id="${KB_STAGE_IN_PROGRESS:-}" ;;
        in_review) id="${KB_STAGE_IN_REVIEW:-}" ;;
        held) id="${KB_STAGE_HELD:-}" ;;
        shipped_to_dev) id="${KB_STAGE_SHIPPED_TO_DEV:-}" ;;
        released_to_main) id="${KB_STAGE_RELEASED_TO_MAIN:-}" ;;
        wont_do) id="${KB_STAGE_WONT_DO:-}" ;;
        *) echo "kbcard: unknown column '$1'" >&2; return 2 ;;
    esac
    [[ -z "$id" ]] && { echo "kbcard: column '$1' is not defined on this board" >&2; return 2; }
    echo "$id"
}
# Reverse of stage_id: the column NAME for a native stage id, from whatever
# KB_STAGE_* vars the sourced board env defines (any of them, not just the eight
# stage_id aliases — a board's own taxonomy resolves too). Prints the lowercased
# suffix (KB_STAGE_SHIPPED_TO_DEV=51 → "shipped_to_dev" for 51); rc 1 and no
# output when no var maps the id. Names expand sorted, so a duplicate id
# resolves to the alphabetically-first var — deterministic, and duplicates are
# a board-env bug, not a shape to support.
stage_name() {
    local var val
    for var in "${!KB_STAGE_@}"; do
        val="${!var}"
        [[ -n "$val" && "$val" == "$1" ]] || continue
        printf '%s' "${var#KB_STAGE_}" | tr '[:upper:]' '[:lower:]'
        return 0
    done
    return 1
}
# Resolve a --type alias to the board's NATIVE card_type_id, config-driven from
# KB_TYPE_<ALIAS> in the board env — ANY alias, not a hardcoded six (so a board's
# own taxonomy, e.g. KB_TYPE_TECH_DEBT, types all its cards). Prints the id ONLY
# when the board has a real native type for the alias; prints nothing when the
# caller should fall back to a `type:<alias>` tag — i.e. the alias is unset/`000`,
# or KB_TYPING_MODE=tags forces tag mode. NEVER fails: a board with no native types
# (all-tag) or only some (mixed) is a supported shape, not an error. This
# generalizes the BR-3.3 field-skip (version_target) from custom fields to types.
# _kbc_env_var <KIND> <name>: the board-env VARIABLE NAME a config-driven <name> resolves
# through — KB_TYPE_<ALIAS> for a card type, KB_USER_<SEAT> for a seat. ONE owner for that
# spelling (upcase; hyphen → underscore, because an env-var suffix cannot hold a hyphen while
# a seat name routinely does), extracted at the second real caller — which is what --assign
# made it. Two lookups of one shape folding a name two different ways is the divergence this
# removes, not a style preference.
_kbc_env_var() {
    printf 'KB_%s_%s' "$1" "$(printf '%s' "$2" | tr '[:lower:]-' '[:upper:]_')"
}

native_type_id() {
    [[ "${KB_TYPING_MODE:-}" == "tags" ]] && return 0   # forced tag mode → no native id
    local var id
    var="$(_kbc_env_var TYPE "$1")"
    id="${!var:-}"
    # A real native id is a positive integer; "", "0", "000", non-numeric ⇒ tag fallback.
    kb_is_uint "$id" && [[ "$id" -gt 0 ]] && printf '%s' "$id"
    return 0
}

# --- assignment: the board's native assigned_user_id ------------------------------------
# ⭐ THE SEAT→ID MAP IS THIS INSTALL'S OWN BOARD ENV — KB_USER_<SEAT>=<kanban user id>, the
# same config-driven shape as KB_STAGE_* / KB_TYPE_*. Deliberately NOT another product's agent
# config: kbcard is a standalone CLI, and reaching into a file it does not own would make it
# depend on a product that need not be installed on this seat at all.
# ⭐ AND NO FLEET-WIDE TABLE IS NEEDED ANYWHERE, which is what keeps this free of cross-repo
# drift: a WRITER resolves only the one seat it was told to write, and a READER needs the map
# only to put a NAME on an id it can already print raw. The value on the wire is the same board
# fact either way — a numeric kanban user id — so there is nothing here for two products to
# disagree about.

# _kbc_user_id <seat|id>: the numeric kanban user id to WRITE. A numeric arg passes through
# unvalidated (the caller named a concrete id — the same rule swimlane_id's numeric arm
# follows). A NAME resolves through KB_USER_<SEAT>, and an unmapped one is rc 2 with the vars
# this board env DOES define enumerated — never a silent no-op and never a plausible wrong id,
# because "the tool did something other than what the operator believed" is the failure the
# whole verb exists to remove. A var present but not holding a positive integer is the same
# refusal as an absent one: `000` is what a copied board-env template still carries.
_kbc_user_id() {
    local arg="$1" var val
    kb_is_uint "$arg" && [[ "$arg" -gt 0 ]] && { printf '%s' "$arg"; return 0; }
    # A numeric arg that is not a positive id is refused in its OWN words: falling through to
    # the name lookup would answer `--assign 0` with "seat '0' is not defined", which points
    # the operator at a board-env line that was never the problem.
    kb_is_uint "$arg" && { echo "kbcard: --assign '$arg' is not a kanban user id — ids are positive integers, and 0 names nobody" >&2; return 2; }
    var="$(_kbc_env_var USER "$arg")"
    val="${!var:-}"
    if kb_is_uint "$val" && [[ "$val" -gt 0 ]]; then printf '%s' "$val"; return 0; fi
    echo "kbcard: seat '$arg' is not defined on this board — $var is unset or does not hold a kanban user id (\`000\` is the not-yet-configured placeholder)" >&2
    local seats; seats="$(_kbc_user_vars)"
    if [[ -n "$seats" ]]; then
        echo "kbcard:   this board env defines: $seats" >&2
    else
        echo "kbcard:   this board env defines NO seats at all — add one per seat that takes cards, e.g. export KB_USER_KANBAN_SOLO=7 (examples/kanban-board.env.example)" >&2
    fi
    return 2
}

# _kbc_user_vars: the KB_USER_* declarations this board env carries, as `VAR=id` pairs, for the
# refusal above. It prints the VARIABLE NAMES rather than folded seat names on purpose: the
# operator's next action is to add or fix a line in that file, and the var name IS that line.
_kbc_user_vars() {
    local var out=""
    for var in "${!KB_USER_@}"; do
        [[ -n "${!var}" ]] || continue
        out="${out:+$out, }$var=${!var}"
    done
    printf '%s' "$out"
}

# _kbc_user_name <id>: the SEAT NAME for a kanban user id — the reverse lookup, and the exact
# sibling of stage_name. Prints the lowercased KB_USER_ suffix; rc 1 and NO output when nothing
# maps the id, which is the case every render falls back to the raw id in. Names expand sorted,
# so a duplicate id resolves to the alphabetically-first var — deterministic, and a duplicate is
# a board-env bug rather than a shape to support.
# ⚠ A seat whose name carries a HYPHEN renders with UNDERSCORES (`kanban-solo` is declared
# KB_USER_KANBAN_SOLO and renders `kanban_solo`) — an env-var suffix cannot hold a hyphen. That
# is not lossy for a caller: _kbc_env_var folds `-` and `_` onto the SAME var, so the name this
# prints is always accepted back by `--assign`.
_kbc_user_name() {
    local var val
    for var in "${!KB_USER_@}"; do
        val="${!var}"
        # The same validity test the WRITE side applies, so the two halves cannot disagree
        # about which declarations are real: a `000` placeholder maps no id in either
        # direction, and never reaches the render map as a seat named after it.
        kb_is_uint "$val" && [[ "$val" -gt 0 ]] || continue
        [[ "$val" == "$1" ]] || continue
        printf '%s' "${var#KB_USER_}" | tr '[:upper:]' '[:lower:]'
        return 0
    done
    return 1
}

# _kbc_user_render <id>: how a holder is NAMED in a message — `<seat> (user <id>)` where this
# board env maps the id, `user <id>` where it does not. Never fails and never guesses: the raw
# id is in the line either way, so a seat missing from the map costs a name, not an answer.
_kbc_user_render() {
    local name; name="$(_kbc_user_name "$1" || true)"
    if [[ -n "$name" ]]; then printf '%s (user %s)' "$name" "$1"; else printf 'user %s' "$1"; fi
}

# _kbc_user_map: the id→seat-name object the `list` projection renders `assignee` from. The KEY
# is the id (a JSON object key, hence a string) and the VALUE is the seat — the inverse of how
# the var is written, because the render asks "who is user 7". The name comes from
# _kbc_user_name rather than being folded again here, so this map cannot disagree with what
# `show` and every refusal print. `{}` when the board env declares no seats: every row then
# renders `assignee` null beside its raw `assigned_user_id`, which is truthful.
_kbc_user_map() {
    local var obj='{}' name
    for var in "${!KB_USER_@}"; do
        [[ -n "${!var}" ]] || continue
        name="$(_kbc_user_name "${!var}" || true)"
        [[ -n "$name" ]] || continue
        obj="$(jq -c --arg k "${!var}" --arg v "$name" '. + {($k): $v}' <<<"$obj")"
    done
    printf '%s' "$obj"
}

# Swimlane id→name map for the `list` projection, as a JSON object built from the
# board env. Swimlanes are keyed by id (KB_SWIMLANE_<id>=<name>) — the INVERSE of
# KB_STAGE_<name>=<id> / KB_TYPE_<alias>=<id> — because swimlane names are freeform
# agent labels (hyphens, spaces) that can't be env-var suffixes, whereas stage/type
# names are a controlled vocabulary that can. Keys are strings (JSON object keys);
# empty-valued vars are skipped; `{}` when the board defines no swimlanes (then the
# projection resolves every name to null — truthful, not a fabrication).
_kbc_swimlane_map() {
    local var obj='{}'
    for var in "${!KB_SWIMLANE_@}"; do
        [[ -n "${!var}" ]] || continue
        obj="$(jq -c --arg k "${var#KB_SWIMLANE_}" --arg v "${!var}" '. + {($k): $v}' <<<"$obj")"
    done
    printf '%s' "$obj"
}
# Resolve a `--swimlane <name|id>` ref to a numeric swimlane id for the client-side
# filter. A numeric arg passes through unvalidated (the caller named a concrete id —
# an empty result is then a truthful "no cards in that lane", like an empty --column).
# A name reverse-resolves through the env map and errors LOUD (rc 2) when unmapped,
# so a typo never silently lists nothing — parity with stage_id's unknown-column contract.
swimlane_id() {
    local arg="$1" var
    kb_is_uint "$arg" && { printf '%s' "$arg"; return 0; }
    for var in "${!KB_SWIMLANE_@}"; do
        [[ -n "${!var}" && "${!var}" == "$arg" ]] || continue
        printf '%s' "${var#KB_SWIMLANE_}"; return 0
    done
    # Enumerate the board's defined swimlanes (id→name) so a "not defined" error
    # can't be misread as "the board has no such swimlane" — mirrors the board-not-
    # found error's "boards found on this box: …". The empty case (a board with no
    # KB_SWIMLANE_* declared) gets a distinct, honest line rather than an empty list.
    echo "kbcard: swimlane '$arg' is not defined on this board" >&2
    local lanes
    lanes="$(_kbc_swimlane_map | jq -r 'to_entries | sort_by(.key | tonumber) | map("\(.key)=\(.value)") | join(", ")')"
    if [[ -n "$lanes" ]]; then
        echo "kbcard:   defined swimlanes: $lanes" >&2
    else
        echo "kbcard:   this board defines no swimlanes (declare KB_SWIMLANE_<id>=<name> in its board env)" >&2
    fi
    return 2
}

# Is this `--swimlane` ref the LANELESS spelling? One owner for which refs mean "no lane"
# (canon #5 — extracted at the third real caller: patch, create-card, and now the list
# filter). `0` is included because swimlane ids are positive, so `0` never named a real
# lane; it must be recognised BEFORE swimlane_id(), which passes any numeric through
# unvalidated and would otherwise treat it as a real-looking id.
# Consequence of that rule, unchanged since v0.19.0 and now extended to `list`: a lane
# literally NAMED `none` is unreachable by name and must be addressed by id.
_kbc_swimlane_is_laneless_ref() {
    [[ "$1" == "none" || "$1" == "0" ]]
}

# Resolve a `--swimlane <name|id|none|0>` ref to the JSON value written to a task's
# top-level swimlane_id column. The laneless refs become an explicit JSON null (the
# un-assign form). Every other ref resolves through the SAME swimlane_id() helper `list`
# uses (name→id, numeric passthrough, loud rc 2 on a typo).
_kbc_swimlane_value() {
    local ref="$1"
    if _kbc_swimlane_is_laneless_ref "$ref"; then printf 'null'; return 0; fi
    swimlane_id "$ref"
}

# DL canonicalization (the strict `--dl` → DL-NNN write-site fix, #3400 / canon #5)
# lives in kb_dl_canon in the shared lib; call it directly below.

# Resolve a "task ref" to a numeric task id.
#   Numeric → returned as-is.
#   Non-numeric → looked up by external_id on the board (search endpoint).
resolve_task() {
    local ref="$1"
    if kb_is_uint "$ref"; then
        [[ "$ref" -ge 1 ]] || { echo "kbcard: invalid task id '$ref'" >&2; exit 1; }
        echo "$ref"; return 0
    fi
    local id q resp rows
    # URL-encode the whole query value so a ref with & # space % can't corrupt
    # the query string or inject params (e.g. ref='x&board_id=999' retargeting).
    q="$(jq -rn --arg b "$KB_BOARD_ID" --arg r "$ref" '"board_id=\($b) external_id:\($r)" | @uri')"
    resp="$(kb_api GET "/tasks/search.json?q=$q")" || return 1
    # The RESULT LIST first, then the id out of it — two steps because the two empties mean
    # opposite things and one filter cannot tell them apart. `.data[0].id // empty` is empty
    # both for a search that ran and matched nothing AND for a body no search result could be
    # read out of, so folding them together answers "no task found with external_id=…" — a
    # claim about the BOARD — for a read that never reached one. A well-formed empty result is
    # `[]`, which is truthy in jq, so it survives this test and still reaches the not-found arm.
    rows="$(kb_parse_resp "$resp" -c '.data // empty')"
    [[ -n "$rows" ]] || {
        echo "kbcard: external-id lookup for '$ref' returned success but no result list could be read out of its body — nothing was read (this is NOT 'no such card')" >&2
        return 1
    }
    # Through the primitive too: the guard above is a non-EMPTY test, which a `.data` that is a
    # JSON object or scalar satisfies, so a bare jq here still printed its own "Cannot index …"
    # ahead of the message below. Same rc, same stdout, same arm — this removes jq's stderr
    # line only. The residual WRONG WORDING on that shape (it reads as the not-found arm) is
    # left deliberately: refusing it would change what this READ verb accepts.
    id="$(kb_parse_resp "$rows" -r '.[0].id // empty')"
    if [[ -z "$id" || "$id" == "null" ]]; then
        echo "kbcard: no task found with external_id='$ref' on board $KB_BOARD_ID" >&2; return 1
    fi
    kb_is_uint "$id" && [[ "$id" -ge 1 ]] || { echo "kbcard: invalid task id '$id'" >&2; exit 1; }
    echo "$id"
}

# _kbc_build_payload <dl> <pr> <pr_url> <version> <issue> <issue_url> [origin] [clear]: assemble
# the task.payload object shared by create-card and patch from the optional card-metadata
# flags. Prints a JSON object (`{}` when nothing is set) on stdout; returns 2, before any
# output, on a malformed correlation value — a --dl kb_dl_canon refuses, or a --pr / --issue
# that is not ONE POSITIVE decorated integer (_kbc_require_ref_int) — or on a visually blank
# --pr-url / --issue-url / --version / --origin (_kbc_text_arg). Both callers assemble the payload
# BEFORE they resolve the task ref, so those refusals cost no request at all.
# EACH KEY IS SERIALIZED ON ITS OWN, with its JSON type fixed by the key's contract rather than
# guessed from the value: the text keys (dl_number, pr_url, issue_url, version_target, origin) go
# out as JSON strings, byte-for-byte as the validators left them; only pr_number/issue_number —
# declared `number` on the board (docs/INSTALL.md §3b) — pass through a padding-trimmed
# `tonumber? // .` (the same result on every jq; see the note at the jq call), and only
# after _kbc_require_ref_int accepted them, so a decorated spelling ("#178") still travels as the
# string it has always been. A text value is therefore never re-typed ("1.10" is not 1.1, "nan"
# is not null) and never split: a newline inside it is a character of that value, not the start
# of another key. (Values used to be joined as `k=v` LINES and each coerced through tonumber,
# which let an interior newline truncate a value, a leading one send "", and a `key=value` line
# inject a key the caller never named — card#9423.) issue_number/issue_url mirror pr_number/pr_url
# exactly: issue_url sets the by-ref `source` (owner/repo) for multi-repo boards unless the card's
# payload.repo outranks it (_kbc_ref_pair_guard's header owns that rule), issue_number alone
# does not — and the two lifecycle keys are INDEPENDENT of the pr_* pair, so a card can
# carry both. The positional contract: dl/pr/pr_url/version/issue/issue_url are common to both
# callers, so patch passes exactly that prefix; origin trails because it was create-card-only
# until card#5776 made it patchable, and keeping it last left every existing call site
# untouched. <clear> trails origin for the same reason: it is patch's raw --clear comma list, and
# create-card has no such flag. A value must flow through this single assembler rather than be
# appended by the caller, which would re-duplicate the per-key typing this helper exists to own.
# Declining a card (→ wont_do) clears its correlation stamps in the SAME PATCH: a stale
# dl_number/pr_number left on a declined card can later match a recycled DL/PR and
# resurrect it in a release-promote scan. issue_number/issue_url are deliberately NOT nulled:
# bin/promote-released-cards never matches on issue_number, so a stale one resurrects nothing.
# The kanban v3 payload PATCH merges per-key —
# an explicit JSON null DELETES a key, an omitted key is untouched. Merge order makes an
# explicitly-passed ref flag win over the null (right-hand precedence), so a caller who
# stamps a ref while declining keeps what they explicitly set. Shared by BOTH decline
# call-sites (move + patch --column wont_do) so the hygiene invariant has one owner.
_kbc_decline_nulls() {
    # NB: not `${1:-{}}` — bash ends the expansion at the FIRST `}`, mangling a
    # supplied argument into `<arg>}` (invalid JSON).
    local p="${1:-}"
    [[ -n "$p" ]] || p='{}'
    jq -n --argjson p "$p" '{dl_number: null, pr_number: null, pr_url: null} + $p'
}

# _kbc_clearable: THE ONE DECLARATION of the payload fields `patch --clear` may null — one
# `<field> <payload key>` line each, <field> spelled as its setter flag without the `--`. Both the
# key a clear writes and the accepted set a refusal prints are read from here. A field added here
# must reach _kbc_build_payload as a local named <field> with `-` as `_`: the setter exclusion
# reads the setter's value by that name.
_kbc_clearable() {
    printf '%s\n' 'origin origin' 'version version_target' 'pr-url pr_url' 'issue-url issue_url'
}

_kbc_build_payload() {
    local dl="$1" pr="$2" pr_url="$3" version="$4" issue="${5:-}" issue_url="${6:-}" origin="${7:-}" clear="${8:-}"
    # The free-text payload values take the blank refusal every free-text flag takes, from the
    # same resolver — single-source (no --…-file twin), and `verbatim` so this check rewrites
    # nothing: the value it accepts is the value the assembler below sends. A visually blank one used
    # to be SENT, and the board's trim-then-null rewrite turned it into a CLEAR of the stored
    # field under rc 0; for pr_url / issue_url that can also drop the card's by-ref `source`, unless
    # the card's payload.repo outranks it (_kbc_ref_pair_guard's header owns that rule). It sits
    # above the version_target branch on purpose: a blank --version is a malformed invocation
    # whether or not this board would have written it.
    _kbc_text_arg pr_url pr-url "" "$pr_url" "" verbatim || return 2
    _kbc_text_arg issue_url issue-url "" "$issue_url" "" verbatim || return 2
    _kbc_text_arg version version "" "$version" "" verbatim || return 2
    _kbc_text_arg origin origin "" "$origin" "" verbatim || return 2
    # <clear> resolves here, beside the setters it excludes, so its refusals are rc 2 before any
    # request exactly as the validators above are. A member is matched EXACTLY — " origin" and the
    # empty member of "origin," are unknown fields, not near-misses quietly taken — and a member
    # repeated in the list is one clear. The setter check runs above the version_target branch for
    # the reason the blank check does: naming both is malformed whatever this board would write.
    local clear_keys="" rest member field key pkey accepted=""
    if [[ -n "$clear" ]]; then
        rest="$clear,"
        while [[ -n "$rest" ]]; do
            member="${rest%%,*}"; rest="${rest#*,}"
            pkey=""
            while read -r field key; do
                if [[ "$field" == "$member" ]]; then pkey="$key"; fi
            done < <(_kbc_clearable)
            if [[ -z "$pkey" ]]; then
                while read -r field key; do accepted="${accepted:+$accepted, }$field"; done < <(_kbc_clearable)
                echo "kbcard: --clear: '$member' is not a clearable field — accepted: $accepted (several go in one comma list)" >&2
                return 2
            fi
            field="${member//-/_}"
            if [[ -n "${!field}" ]]; then
                echo "kbcard: --$member and --clear $member are mutually exclusive — pass exactly one (--clear $member is the clear)" >&2
                return 2
            fi
            [[ " $clear_keys " == *" $pkey "* ]] || clear_keys="${clear_keys:+$clear_keys }$pkey"
        done
    fi
    if [[ -n "$dl" ]]; then dl="$(kb_dl_canon "$dl")" || return 2; fi
    if [[ -n "$pr" ]]; then _kbc_require_ref_int --pr "$pr" || return 2; fi
    if [[ -n "$issue" ]]; then _kbc_require_ref_int --issue "$issue" || return 2; fi
    # BR-3.3: only write version_target if the board actually has that custom field
    # (its id declared as KB_CF_VERSION_TARGET in the board env) — else the write
    # 422s (kanban gates payload keys to registered fields). Warn, don't drop
    # silently, so a misconfigured board surfaces instead of vanishing the value.
    if [[ -n "$version" ]] && [[ -z "${KB_CF_VERSION_TARGET:-}" || "${KB_CF_VERSION_TARGET}" == "000" ]]; then
        echo "kbcard: --version ignored — this board has no version_target field (declare KB_CF_VERSION_TARGET in its board env to enable)" >&2
        version=""
    fi
    # A clear is a write of the key too, so the same gate holds it — with the same warning.
    if [[ " $clear_keys " == *" version_target "* ]] && [[ -z "${KB_CF_VERSION_TARGET:-}" || "${KB_CF_VERSION_TARGET}" == "000" ]]; then
        echo "kbcard: --clear version ignored — this board has no version_target field (declare KB_CF_VERSION_TARGET in its board env to enable)" >&2
        clear_keys=" $clear_keys "; clear_keys="${clear_keys/ version_target / }"
    fi

    # An empty value is an unset flag (every validator above refuses a blank one), so it is
    # omitted. The ref keys are trimmed of space/tab/CR/LF for the number attempt ONLY: jq-1.7's
    # tonumber accepts exactly that padding and jq-1.8 refuses it, so an untrimmed attempt makes
    # " 123 " a number or a string by jq version. `sub`, not `trim` (jq-1.7.1+). A value that is
    # still not a number after the trim is sent as passed, padding included. pr_url / issue_url
    # set the by-ref `source` (owner/repo) unless payload.repo outranks it (_kbc_ref_pair_guard's
    # header owns that rule); pr_number / issue_number do not. A cleared key is added
    # last, as an explicit null; the setter exclusion above means it never meets a value here.
    jq -nc \
        --arg dl_number "$dl" \
        --arg pr_number "$pr" \
        --arg pr_url "$pr_url" \
        --arg issue_number "$issue" \
        --arg issue_url "$issue_url" \
        --arg version_target "$version" \
        --arg origin "$origin" \
        --arg clear_keys "$clear_keys" \
        '{dl_number: $dl_number, pr_number: $pr_number, pr_url: $pr_url,
          issue_number: $issue_number, issue_url: $issue_url,
          version_target: $version_target, origin: $origin}
         | with_entries(select(.value != ""))
         | with_entries(if .key == "pr_number" or .key == "issue_number"
                        then .value |= ((sub("^[ \t\n\r]+"; "") | sub("[ \t\n\r]+$"; "")
                                         | tonumber?) // .)
                        else . end)
         | . + ($clear_keys | split(" ") | map(select(. != "") | {(.): null}) | add // {})'
}

# _kbc_require_type_alias <alias>: a --type alias must be tag-safe, because on a board
# with no native card type for it the alias becomes a `type:<alias>` member of a COMMA-
# separated tag list. Matched through kb_ere_match so `[A-Za-z0-9]` means ASCII: as a
# bare bash bracket RANGE it is a COLLATION range, and an en_US.UTF-8 shell then
# accepted é / Ⅳ / ﬁ against an error message promising alphanumeric / '-' / '_'.
_kbc_require_type_alias() {
    kb_ere_match "$1" '^[A-Za-z0-9_-]+$' && return 0
    echo "kbcard: --type '$1' must be alphanumeric / '-' / '_'" >&2
    return 2
}

# _kbc_require_ext_id <value>: external_id is the integer per-board sync id
# (tasks.external_id is an unsignedBigInteger). Reject a non-numeric value LOUDLY
# instead of silently coercing it to null and discarding the caller's input.
_kbc_require_ext_id() {
    kb_is_uint "$1" && return 0
    echo "kbcard: --external-id must be numeric (the integer per-board sync id); got '$1'. For a DL id use --dl." >&2
    return 2
}

# _kbc_require_ref_int <flag> <value>: a correlation value (--pr / --issue) must name ONE
# POSITIVE integer, optionally decorated. The SHAPE half is the board's OWN rule for deriving a
# card's by-ref key (kanban DL-251: `^\D*(\d+)\D*$` after trimming), applied here at the
# operator path that MINTS the stored value; the SIGN and ZERO halves are deliberately STRICTER
# than that rule — see the two blocks below for why each is refused rather than canonicalized.
#
# WHAT IT REFUSES AND WHY REFUSING BEATS COERCING. A value carrying no digits ("TBD") or SEVERAL
# digit runs ("1.5", "2026-08-23", "PR 12 of 34") names no single identifier. A reader applying
# DL-251 derives NO ref from it, so the stamp correlates the card to nothing while looking set;
# a reader still stripping every non-digit derives the CONCATENATION of the runs — "1.5" → 15,
# "2026-08-23" → 20260823 — which is a real but DIFFERENT pull request or issue, i.e. a card
# silently correlated to someone else's work. Both consumers are wrong about the same stamp, in
# opposite directions, and neither reports an error; the value is only unambiguous at the point
# it is typed, which is here.
#
# NOT a claim about the field's declared TYPE, and deliberately not narrowed to one.
# `pr_number`/`issue_number` are declared `number` (docs/INSTALL.md §3b) while the merge below
# only coerces a value `tonumber` accepts, so a DECORATED value such as "#178" — which this
# rule accepts, as the board's own rule does — travels as a JSON string and is refused
# server-side on TYPE. That is the server failing loud about a different question, and tying
# this predicate to kb_is_uint instead would refuse spellings the board itself canonicalizes
# (a board declaring the field `string` accepts them) — a narrowing this card did not rule on.
#
# ⭐ WHY THE SIGN AND ZERO ARE REFUSED HERE, STRICTER THAN THE BOARD'S OWN RULE. "-5" is ONE
# decorated integer under DL-251, so the shape leg alone accepts it — and the value it mints is
# then read THREE ways with no reader erring: this tool stores -5; the board drops the sign with
# the rest of the decoration and indexes the card under github_pr ref "5", i.e. somebody else's
# pull request (measured on the vendored 1:1 mirror: canonicalize('github_pr', '-5') === '5');
# and the admission test a reconciler applies to the same field, `is_numeric && (float) > 0`,
# DECLINES the value, so the card is invisible to it. Stored, mis-correlated and invisible at
# once. Zero is the same defect one value over: "0", "00", "#0", "PR-000" all name a pull
# request / issue that cannot exist on GitHub — the board indexes ref "0" and that same `> 0`
# declines it just the same.
#
# Refusing at the MINT costs no legitimate caller (GitHub numbers PRs and issues from 1) and
# collapses the three answers into one at the cheapest place — the only point where the value
# is still unambiguous. It is the rule `--dl` has always applied (kb_dl_num refuses a sign by
# anchoring, and refuses a token resolving to 0 in its own words); this brings the other two
# correlation keys alongside it. The pre-PR placeholder is the URL form `.../pull/0` carried by
# `--pr-url` / `--issue-url`, which are URLs and are not covered by this predicate at all.
_kbc_require_ref_int() {
    # `[^0-9]` rather than a bracket range, through kb_ere_match, so the class is ASCII bytes
    # and not a collation range (an en_US.UTF-8 shell reads `[0-9]` as the latter).
    if ! kb_ere_match "$2" '^[^0-9]*([0-9]+)[^0-9]*$'; then
        echo "kbcard: $1 '$2' must name ONE integer, optionally decorated (178, #178, PR-178) — a value with no digits, or with several digit runs (1.5, 2026-08-23), names no reference: the board derives none from it, and a reader that concatenates the runs derives a real but DIFFERENT PR/issue." >&2
        return 2
    fi
    # Captured BEFORE the next match clobbers BASH_REMATCH (kb_ere_match leaves it non-local
    # on purpose, so it survives the call but not a second one).
    local run="${BASH_REMATCH[1]}"
    # A LEADING minus is a sign; a minus anywhere else is decoration ("PR-178"), which the
    # board canonicalizes and this accepts. `[[:space:]]` is ASCII here because kb_ere_match
    # pins LC_ALL=C for the match — " -5" reaches this assembler as typed, and jq's tonumber
    # then stores it as -5, so the leading blank must not hide the sign.
    if kb_ere_match "$2" '^[[:space:]]*-'; then
        echo "kbcard: $1 '$2' is NEGATIVE — a pull request / issue number is positive (GitHub numbers them from 1). Refusing it at the mint is the only place this stamp's readers agree: stored, it keeps the sign here, while the board drops the sign as decoration and correlates the card to a real but DIFFERENT ref, and the reconciler's positive-only admission test declines the value outright — stored, mis-correlated and invisible at once." >&2
        return 2
    fi
    if kb_ere_match "$run" '^0+$'; then
        echo "kbcard: $1 '$2' names 0 — there is no pull request or issue 0 to correlate to (GitHub numbers them from 1), and --dl has always refused 0 the same way. The pre-PR placeholder is the URL form .../pull/0, which belongs on --pr-url / --issue-url and is unaffected." >&2
        return 2
    fi
    return 0
}

# _kbc_text_arg <outvar> <flag> <require-verb> <inline> <file> [inline-verbatim]:
# resolve a free-TEXT argument from its two mutually-exclusive sources — the inline `--<flag>`
# and its `--<flag>-file` twin — into <outvar>. Returns 2, with a diagnostic naming the flag the
# CALLER passed, when both sources were given, when a required pair got neither, when the file is
# `-`, missing or unreadable, or when the file's text is blank. Every one of those is decided
# with no network at all, so a bad invocation can never half-write.
# A free-text flag with NO file twin passes "" as <file>: it then gets the blank check and, with
# <inline-verbatim>, nothing else — its value comes back byte-identical or is refused.
#
# WHY THE FILE FORM IS THE CONVENTION FOR TEXT THIS AGENT DID NOT AUTHOR. An inline value is
# expanded by the CALLER's shell before kbcard is even started, so a `$(…)` or a backtick inside
# externally-authored text runs as a command on this box, and argv already holds its output by the
# time anything here can look. No validator can see the unsafe case — that is why this is a
# documented convention plus a safe route, and not a check. `--<flag>-file` is the safe route: the
# bytes are read by this process and never meet a shell. `-` is refused rather than silently
# treated as stdin: `-` is not a stdin token here, and "not readable: -" named the wrong problem.
# The claim is about the TOKEN, not about the descriptor — a caller who genuinely wants stdin passes
# the path `/dev/stdin`, which is a readable path like any other and works.
#
# THE POLICY KNOBS (ground rule 5 of docs/CONSOLIDATION-PLAN.md — mechanism in the primitive,
# policy at the caller) ARE TWO ARGUMENTS BECAUSE THEY ARE TWO PROPERTIES. They were one argument
# deciding both until card#9213, and that is exactly why they are separate now: the combination a
# new pair needed — OPTIONAL, but with its inline value checked — was the one a two-setting knob
# could not spell, so the new pair silently inherited a carve-out written for somebody else's
# shipped contract, and shipped an inline half that accepted what its own file half refused.
#   * <require-verb> decides whether the pair is REQUIRED. NON-EMPTY — the verb's own name, e.g.
#     `comment`: this text IS the request, so neither source given is rc 2 naming that verb.
#     EMPTY — an optional field setter, where neither source given is the ordinary case and is
#     silent.
#   * <inline-verbatim> decides whether the INLINE value's BYTES are rewritten — and that is ALL
#     it decides. NON-EMPTY — the value goes on the wire exactly as typed, CRLF and trailing
#     newlines included. The FILE half is never affected either way: it is always normalized.
#     ⛔ IT DOES NOT, AND MUST NOT, CARVE OUT THE BLANK CHECK. It did until card#9222, and that
#     is the defect that card closed: the two are independent properties and one argument was
#     deciding both, so a whitespace-only inline value was SENT while `--name-file` on the
#     identical bytes was rc 2 — one product refusing at one door and passing at the other.
#     ⚠ WHAT THE SENT VALUE THEN DID IS NOT THE SAME ON THE TWO FLAGS, and neither of them is
#     "a blank card was written" — measured against the live board, not inferred here:
#       * `--name "   "` came back HTTP 422 (`name` is not nullable, and the board's TrimStrings
#         → ConvertEmptyStringsToNull had already made it null), i.e. rc 1 after a wasted round
#         trip, under the server's wording, naming neither the flag nor the real problem.
#       * `--description "   "` came back 200 and CLEARED the field, at rc 0. That is the
#         quiet-wrong: `--description "$BODY"` with a $BODY that expanded to padding WIPED a
#         card's body while reporting success, and it was also the only route to clear it —
#         which is why `patch --clear-description` lands in the same change rather than after.
#     Narrowing what a shipped flag accepts IS an acceptance change and was ask-gated, not taken
#     here unasked: asked and GRANTED for `--name`/`--description` on 2026-09-12, on the ground
#     that the newly-refused set is values that are VISUALLY BLANK. What survives is the
#     bytes-only half — rewriting an inline value's line endings is a separate acceptance change
#     that has NOT been asked, which is why this argument still exists.
#     The call sites passing it ARE that population; there is nothing else to enumerate and
#     nothing to keep in sync.
#
# What a NORMALIZED value loses and keeps: interior newlines and leading whitespace ride verbatim
# (a comment's own indentation is content), TRAILING newlines are trimmed, and CRLF is folded to
# LF. That is the documented contract — the Usage block at the top of this file states it, and so
# does README — and it is applied here rather than left to the caller's command substitution, so
# the contract lives in the code that owns it.
_kbc_text_arg() {
    local _ta_out="$1" _ta_flag="$2" _ta_verb="$3" _ta_val="$4" _ta_file="$5" _ta_verbatim="${6:-}"
    # The noun the "holds no … text" refusals read with: the verb where there is one (so
    # `comment` keeps saying "no comment text"), the field name otherwise.
    local _ta_noun="${_ta_verb:-$_ta_flag}"
    if [[ -n "$_ta_val" && -n "$_ta_file" ]]; then
        echo "kbcard: --$_ta_flag and --$_ta_flag-file are mutually exclusive — pass exactly one" >&2
        return 2
    fi
    if [[ -z "$_ta_val" && -z "$_ta_file" ]]; then
        [[ -z "$_ta_verb" ]] || {
            echo "kbcard: $_ta_verb requires --$_ta_flag \"text\" or --$_ta_flag-file PATH" >&2
            return 2
        }
        printf -v "$_ta_out" '%s' ""
        return 0
    fi
    # Whether the value's BYTES get rewritten below. A file's always are. An inline value's are
    # unless this pair carries the shipped-acceptance carve-out — which is a carve-out from the
    # REWRITE only, never from the blank check: see the knob above.
    local _ta_rewrite=1
    if [[ -n "$_ta_file" ]]; then
        [[ "$_ta_file" != "-" ]] || {
            echo "kbcard: --$_ta_flag-file takes a PATH and '-' is not a stdin token here — pass a path (/dev/stdin if you mean stdin)" >&2
            return 2
        }
        [[ -r "$_ta_file" ]] || { echo "kbcard: --$_ta_flag-file is not readable: $_ta_file" >&2; return 2; }
        # The `x` sentinel keeps the file's own trailing newline INSIDE this substitution, which
        # would otherwise strip it here — before the CRLF normalization below could see it, so a
        # CRLF file's last line would keep a lone \r that nothing then owns. `&&` so a failed
        # read is still a failed read (with `;` the substitution would carry printf's rc 0).
        _ta_val="$(cat -- "$_ta_file" && printf x)" || { echo "kbcard: --$_ta_flag-file could not be read: $_ta_file" >&2; return 2; }
        _ta_val="${_ta_val%x}"
    elif [[ -n "$_ta_verbatim" ]]; then
        # The shipped-acceptance carve-out; see the knob above. It skips the REWRITE below and
        # nothing else: the blank check is reached by every source and every spelling alike.
        _ta_rewrite=""
    fi
    # CRLF → LF, at the ONE write site both sources pass through. Windows/Git-Bash is a documented
    # install target, so a --…-file written there arrives CRLF-terminated and an unnormalized
    # \r goes on the wire verbatim — where a reader, correctly, renders every C0 control as `?`,
    # so each line comes back ending in one. Only a CR immediately followed by LF is a line ending;
    # a LONE \r (classic-Mac, or mid-line) is a control character, not a line break, so it is left
    # for that sanitizer rather than silently rewriting content here.
    if [[ -n "$_ta_rewrite" ]]; then
        _ta_val="${_ta_val//$'\r'$'\n'/$'\n'}"
        while [[ "$_ta_val" == *$'\n' ]]; do _ta_val="${_ta_val%$'\n'}"; done
    fi
    # ONE emptiness owner for BOTH sources AND both spellings — no source reaches the wire without
    # passing it, which is what the name claims and what the carve-out above used to make false.
    # The test reads a STRIPPED COPY rather than the trimmed value, so it decides the same way on
    # a value the rewrite did not touch: a carve-out value carrying only CRLFs or trailing
    # newlines is as blank to a reader as one carrying only spaces. What counts as blank — six
    # ASCII characters, under a locale pin — belongs to kb_is_blank in the lib and is stated there.
    # Rationale for refusing at all: the comment server trims before it validates, so a
    # whitespace-only body is a 422 there — a refusal that costs a round trip and arrives as rc 1
    # instead of the rc 2 this class is; and for the optional setters, a board that trims-then-
    # nulls stores NULL under an rc 0 that said the write landed, or a name no reader can read.
    # Only the CHECK sees the stripped copy: what goes on the wire keeps its leading whitespace
    # and its interior newlines.
    if kb_is_blank "$_ta_val"; then
        if [[ -n "$_ta_file" ]]; then
            echo "kbcard: --$_ta_flag-file holds no $_ta_noun text: $_ta_file" >&2
        else
            echo "kbcard: --$_ta_flag holds no $_ta_noun text" >&2
        fi
        return 2
    fi
    printf -v "$_ta_out" '%s' "$_ta_val"
}

# _kbc_task_fields <name> <type_id> <desc> <tags_json> <ext_id> <swim_set> <swim_json> <payload_json> [assign_set] [assign_json] [block_set] [block_json] [desc_clear]:
# assemble the OPTIONAL top-level task-object fields shared by create-card and patch, as a JSON
# object carrying ONLY the keys whose argument was supplied. Each caller then adds the keys IT
# requires — create-card `board_id` + `workflow_stage_id`, patch the stage of a `--column`.
# This is the second half of the create/patch consolidation `_kbc_build_payload` began
# (card#4511): payload keys share one assembler, and these top-level task columns now share
# this one, so the NEXT settable field is added in ONE place and cannot land on create-card
# alone — which is exactly how the five write-once-at-birth fields of card#5776 accumulated.
# "" means "not supplied" for every argument, which is safe because kb_require_value already
# rejects `--flag ""` at every arm — EXCEPT swimlane, whose un-assign form is a real JSON null:
# <swim_set> non-empty is what makes swimlane_id ride at all, <swim_json> carries its value.
# <tags_json> is a JSON ARRAY (or ""), not a CSV, so a caller that read the live tag list back
# off the API round-trips it without a lossy re-split on a tag containing a comma.
_kbc_task_fields() {
    # NB: not `${4:-null}` / `${8:-{\}}` — bash ends a `${x:-{}}` expansion at the FIRST `}`,
    # mangling a supplied argument (see _kbc_decline_nulls).
    local name="$1" type_id="$2" desc="$3" tags_json="${4:-}" ext_id="$5" swim_set="$6" swim_json="${7:-}" payload_json="${8:-}"
    # assigned_user_id rides the same set-flag/value pair swimlane_id does, and for the same
    # reason: `null` is a REAL value here (the un-assign form), so "was the flag passed" cannot
    # be read off the value. Trailing + defaulted, so create-card's 8-argument call is
    # untouched — it has no assign flag of its own, and this is the one place a NEXT one would
    # be wired for both callers at once.
    local assign_set="${9:-}" assign_json="${10:-}"
    # block_reason joins on those same trailing+defaulted terms, for the same reason again: its
    # --unblock form is a real null.
    local block_set="${11:-}" block_json="${12:-}"
    # description's clearer needs a FLAG and not a set/value PAIR, which is the one way it differs
    # from the three above: `description` already has an argument of its own, and the value a
    # clear writes is always the same JSON null, so a second slot would carry no information.
    # Non-empty means --clear-description was passed; its caller has already refused it alongside
    # a <desc>, so the two cannot both be non-empty here.
    local desc_clear="${13:-}"
    [[ -n "$tags_json" ]] || tags_json='null'
    [[ -n "$swim_json" ]] || swim_json='null'
    [[ -n "$payload_json" ]] || payload_json='{}'
    [[ -n "$assign_json" ]] || assign_json='null'
    [[ -n "$block_json" ]] || block_json='null'
    jq -n \
        --arg name "$name" \
        --arg type_id "$type_id" \
        --arg desc "$desc" \
        --argjson tags "$tags_json" \
        --arg ext_id "$ext_id" \
        --arg swim_set "$swim_set" \
        --argjson swim "$swim_json" \
        --arg assign_set "$assign_set" \
        --argjson assign "$assign_json" \
        --arg block_set "$block_set" \
        --argjson block "$block_json" \
        --arg desc_clear "$desc_clear" \
        --argjson payload "$payload_json" \
        '{}
         + (if $name    != "" then {name: $name} else {} end)
         + (if $type_id != "" then {card_type_id: ($type_id | tonumber)} else {} end)
         + (if $desc_clear != "" then {description: null}
            elif $desc      != "" then {description: $desc} else {} end)
         + (if $tags    != null then {tags: $tags} else {} end)
         + (if $ext_id  != "" then {external_id: ($ext_id | tonumber)} else {} end)
         + (if $swim_set != "" then {swimlane_id: $swim} else {} end)
         + (if $assign_set != "" then {assigned_user_id: $assign} else {} end)
         + (if $block_set != "" then {block_reason: $block} else {} end)
         + (if ($payload | length) > 0 then {payload: $payload} else {} end)'
}

# _kbc_patch_tags <task> <tags_csv> <type_alias> <type_id> <triaged>: resolve the tag array a
# patch should WRITE, printing nothing when the call touches no tag at all. `tags` is a
# top-level string list the API replaces WHOLESALE, so adding one tag means re-sending the
# others — hence the read-merge-write here; create-card needs none because it builds the whole
# list at birth. The three inputs compose in one place so they can't fight each other:
#   --tags     supplies the base list outright (and spares the read).
#   --type     strips ANY existing `type:*` tag, then re-adds `type:<alias>` only when the
#              board has no native id for the alias. The strip runs on BOTH paths on purpose:
#              on a MIXED board a card retyped from a tag-mode alias to a native one would
#              otherwise keep its stale `type:<old>` tag and still answer `list --type <old>`
#              (which resolves that alias through the tag clause) — a card reading as two
#              types at once, and the quiet-wrong the retype was meant to fix.
#   --triaged  appends `triaged`.
# Dedupe preserves FIRST-SEEN order instead of sorting, so a patch that only adds `triaged`
# leaves the caller's existing tag order alone, and `--tags a,b` writes the order it was given
# exactly as create-card does.
_kbc_patch_tags() {
    local task="$1" tags_csv="$2" type_alias="$3" type_id="$4" triaged="$5"
    [[ -n "$tags_csv" || -n "$type_alias" || -n "$triaged" ]] || return 0
    local base
    if [[ -n "$tags_csv" ]]; then
        base="$(jq -n --arg t "$tags_csv" '$t | split(",")')"
    else
        # THE READ IS PART OF THE WRITE here, so an unreadable one must abort it. `tags` is
        # replaced wholesale by the API, so a read that yields nothing and is then treated as
        # "the card has no tags" writes only what THIS call adds and DESTROYS every tag the
        # card carried. Refuse instead — the caller turns this rc into its own rc 2, before any
        # PATCH is issued.
        #
        # What counts as "no tag list could be read" is kb_card_tags' rule (_kb-board-lib.sh), the
        # one owner of the shape tests every read-before-replace of `tags` goes through — this one,
        # and the owner-tag write in kb_owner_tag_write. What differs is the POLICY: this read is
        # the base of a list the CALLER asked to write, so an unreadable one aborts the whole
        # patch; the owner-tag write follows a move that has already happened, so an unreadable
        # read there skips only the tag write.
        local resp
        resp="$(kb_api GET "/tasks/$task.json")" || return 1
        base="$(kb_card_tags "$resp")"
        [[ -n "$base" ]] || {
            echo "kbcard: patch on task $task: the tag read returned success but no tag list could be read out of its body — refusing to replace this card's tags with a list built from nothing" >&2
            return 1
        }
    fi
    jq -n --argjson base "$base" \
        --arg type_alias "$type_alias" --arg type_id "$type_id" --arg triaged "$triaged" \
        '($base
          | (if $type_alias != "" then map(select(startswith("type:") | not)) else . end)
          | (if $type_alias != "" and $type_id == "" then . + ["type:\($type_alias)"] else . end)
          | (if $triaged != "" then . + ["triaged"] else . end))
         | reduce .[] as $t ([]; if index($t) then . else . + [$t] end)'
}

cmd_create_card() {
    local type="" name="" name_file="" column="backlog" desc="" desc_file="" tags="" ext_id="" dl="" pr="" pr_url="" issue="" issue_url="" version="" origin="" triaged="" swimlane=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --type) kb_require_value "$1" "${2:-}" || return 2; type="$2"; shift 2 ;;
            --name) kb_require_value "$1" "${2:-}" || return 2; name="$2"; shift 2 ;;
            --name-file) kb_require_value "$1" "${2:-}" || return 2; name_file="$2"; shift 2 ;;
            --column) kb_require_value "$1" "${2:-}" || return 2; column="$2"; shift 2 ;;
            --swimlane) kb_require_value "$1" "${2:-}" || return 2; swimlane="$2"; shift 2 ;;
            --description) kb_require_value "$1" "${2:-}" || return 2; desc="$2"; shift 2 ;;
            --description-file) kb_require_value "$1" "${2:-}" || return 2; desc_file="$2"; shift 2 ;;
            --tags) kb_require_value "$1" "${2:-}" || return 2; tags="$2"; shift 2 ;;
            --external-id) kb_require_value "$1" "${2:-}" || return 2; ext_id="$2"; shift 2 ;;
            --dl) kb_require_value "$1" "${2:-}" || return 2; dl="$2"; shift 2 ;;
            --pr) kb_require_value "$1" "${2:-}" || return 2; pr="$2"; shift 2 ;;
            --pr-url) kb_require_value "$1" "${2:-}" || return 2; pr_url="$2"; shift 2 ;;
            --issue) kb_require_value "$1" "${2:-}" || return 2; issue="$2"; shift 2 ;;
            --issue-url) kb_require_value "$1" "${2:-}" || return 2; issue_url="$2"; shift 2 ;;
            --version) kb_require_value "$1" "${2:-}" || return 2; version="$2"; shift 2 ;;
            --origin) kb_require_value "$1" "${2:-}" || return 2; origin="$2"; shift 2 ;;
            --triaged) triaged=1; shift ;;
            *) echo "kbcard: unknown arg '$1'" >&2; return 2 ;;
        esac
    done
    # Both text pairs resolve BEFORE any other check, and long before the POST: a `-`, an absent
    # or an unreadable file must cost no request at all, and --name's requirement below is a
    # question about the RESOLVED name, not about which of the two flags carried it.
    _kbc_text_arg name name "" "$name" "$name_file" verbatim || return 2
    _kbc_text_arg desc description "" "$desc" "$desc_file" verbatim || return 2
    # --tags is checked RAW, here: the `type:` / `triaged` appends below make it non-blank.
    _kbc_text_arg tags tags "" "$tags" "" verbatim || return 2
    [[ -z "$name" ]] && { echo "kbcard: --name or --name-file required" >&2; return 2; }
    [[ -z "$type" ]] && { echo "kbcard: --type required" >&2; return 2; }
    _kbc_require_type_alias "$type" || return 2
    if [[ -n "$ext_id" ]]; then _kbc_require_ext_id "$ext_id" || return 2; fi

    # The board env is the only source of the board id (kb_resolve_env), so an empty one is a
    # board env that declares none — refused before anything is resolved or sent.
    [[ -n "$KB_BOARD_ID" ]] || { echo "kbcard: create-card: $KB_BOARD_ENV declares no KB_BOARD_ID — there is no board to create the card on (docs/INSTALL.md §3b)" >&2; return 2; }

    local stage type_id
    stage="$(stage_id "$column")"
    type_id="$(native_type_id "$type")"
    # Resolve the lane BEFORE the POST so a typo'd --swimlane fails rc 2 with no write
    # at all — a card born in the wrong lane (or laneless after an accepted flag) is
    # worse than no card. Empty when the flag was absent; "null" for the un-assign forms.
    local swim_json=""
    if [[ -n "$swimlane" ]]; then
        swim_json="$(_kbc_swimlane_value "$swimlane")" || return 2
    fi
    # Tag fallback (generalizes BR-3.3): a board with no native type for this alias
    # (all-tag, mixed, or KB_TYPING_MODE=tags) gets a `type:<alias>` tag instead of a
    # bad card_type_id:0. The native path (real id) is unchanged.
    [[ -z "$type_id" ]] && tags="${tags:+$tags,}type:${type}"
    # --triaged: born-triaged, symmetric with `patch --triaged`. On a fresh card the
    # CSV is built here, so a plain append suffices (no read-merge-write like patch).
    [[ -n "$triaged" ]] && tags="${tags:+$tags,}triaged"

    # Assemble task.payload from the card-metadata flags (shared with cmd_patch).
    local payload_json
    payload_json="$(_kbc_build_payload "$dl" "$pr" "$pr_url" "$version" "$issue" "$issue_url" "$origin")" || return 2

    # The whole tag list is known at birth, so a plain CSV→array split is all this needs
    # (patch has to read-merge-write instead — see _kbc_patch_tags).
    local tags_json=""
    [[ -n "$tags" ]] && tags_json="$(jq -n --arg t "$tags" '$t | split(",")')"

    # Build the task object; the v3 write API takes task fields FLAT at the top level
    # (kanban DL-219 dropped the {task: ...} body wrapper), so the object IS the POST body.
    local fields body
    fields="$(_kbc_task_fields "$name" "$type_id" "$desc" "$tags_json" "$ext_id" "${swimlane:+1}" "$swim_json" "$payload_json")" || return 2
    body="$(jq -n --argjson f "$fields" --argjson board "$KB_BOARD_ID" --argjson stage "$stage" \
        '$f + {board_id: $board, workflow_stage_id: $stage}')"

    # Surface swimlane_id in the echo only when --swimlane was passed — same rule as
    # `patch`, so the caller sees the lane the server actually recorded (the whole point
    # of birthing the card on a lane) without changing every other create's echo shape.
    local resp out
    resp="$(kb_api POST "/tasks.json" "$body")" || return 1
    out="$(_kbc_write_echo create-card "on board $KB_BOARD_ID" "$resp" \
        "${swimlane:+swimlane_id: (.swimlane_id // null)}" "$stage")" || return $?
    printf '%s\n' "$out"
    # ⭐ THE BOARD RIDES STDERR ON EVERY SUCCESS (card#10385). The stdout projection carries no
    # board key and widening it is a consumer-contract change, so — as with `stages` — the
    # provenance goes to stderr, which reaches the operator without touching the piped JSON.
    echo "kbcard: create-card: card $(jq -r '.id' <<<"$out") created on board $KB_BOARD_ID" >&2
}

# --- the ONE task PATCH both stage-writing verbs go through -----------------------------

# _kbc_terminal_column <column>: is this column TERMINAL — the card's work is finished, so nobody
# is working it any more? The set is README.md § The seat owner tag's; this is its one spelling
# in code, and it decides both the assignment clear and the owner-tag clear.
_kbc_terminal_column() {
    [[ "$1" == "shipped_to_dev" || "$1" == "released_to_main" || "$1" == "wont_do" ]]
}

# _kbc_stage_patch <verb> <task> <column> <body>: the task PATCH `move` and `patch` BOTH issue,
# and the one owner of the invariants that belong to the WRITE rather than to either caller.
# Both verbs assembled their own body and then wrote it themselves; the rules below would
# otherwise be the same block copied into each, which is how one copy comes to differ from the
# other (canon #5). <column> is "" for a patch that names no column, which is a call making no
# claim about a stage and gets no stage-derived behaviour.
#
#   TERMINAL ⇒ THE ASSIGNMENT IS CLEARED IN THE SAME PATCH. A finished card that still names a
#   holder is exactly the stale claim `--assign` exists to make readable, and the alternative
#   is every mover — here and in whatever calls kbcard next — remembering to unassign.
#   An assignment named EXPLICITLY in the same call WINS and is left alone, the same "explicit
#   beats hygiene" rule the decline-stamp clear follows; the stderr line then says which of the
#   two happened, because a notice that claimed a clear this call did not make would be false.
#
#   ⚠ THE CLEAR PUTS assigned_user_id ON THE MOVE, AND THAT RAISES THE PERMISSION THE MOVE NEEDS.
#   The kanban server authorizes a PATCH whose ONLY key is `workflow_stage_id` as a move, and any
#   other key as a task update (`TaskMutator`), so a terminal move needs `task.update` where a
#   stage-only move would not. _kbc_write_fault is what makes that refusal legible rather than
#   reading as a broken move.
#
#   THE OWNER TAG IS NOT WRITTEN HERE. It is its own tag write after the move is confirmed
#   (_kbc_owner_after_move), so no owner-tag outcome can refuse the move.
#
#   A POLICY REFUSAL OF AN ASSIGNMENT WRITE IS NAMED (see _kbc_write_fault). That naming lives
#   HERE rather than at either caller because it needs KB_HTTP, which kb_api sets inside the
#   command substitution the caller captures the response with — where the caller can no longer
#   read it. This function runs in that same subshell, so it can.
#
# Response on stdout, kb_api's rc returned unchanged, so both callers' existing arms are intact.
_kbc_stage_patch() {
    local verb="$1" task="$2" column="$3" body="$4" rc=0
    if _kbc_terminal_column "$column"; then
        if jq -e 'has("assigned_user_id")' <<<"$body" >/dev/null 2>&1; then
            echo "kbcard: $column is a terminal column, but this call names an assignee explicitly — the explicit value wins and the card stays assigned" >&2
        else
            body="$(jq -c -n --argjson b "$body" '{assigned_user_id: null} + $b')"
            echo "kbcard: cleared the card's assignment (assigned_user_id) — $column is a terminal column and a finished card holds nobody's claim" >&2
        fi
    fi
    kb_api PATCH "/tasks/$task.json" "$body" || {
        rc=$?
        _kbc_write_fault "$verb" "$task" "$body" "${KB_HTTP:-}"
        return "$rc"
    }
}

# _kbc_owner_after_move <task> <column> <stamp_owner>: the seat owner tag, written AFTER a move
# this call has CONFIRMED — removed when <column> is terminal, stamped when <stamp_owner> is
# non-empty, otherwise nothing. The write and its rules are kb_owner_tag_write's
# (_kb-board-lib.sh); whatever it reports goes to stderr, and the verb's rc stays the move's.
_kbc_owner_after_move() {
    local task="$1" column="$2" stamp_owner="$3"
    if _kbc_terminal_column "$column"; then
        kb_owner_tag_write clear "$task" "task $task"
    elif [[ -n "$stamp_owner" ]]; then
        kb_owner_tag_write stamp "$task" "task $task"
    else
        return 0
    fi
    [[ -z "$KB_OWNER_NOTE" ]] || printf '%s\n' "$KB_OWNER_NOTE" >&2
}

# _kbc_write_fault <verb> <task> <body> <http>: name the ONE failure this file's newest write
# can hit that no retry and no card edit will ever clear. Writing assigned_user_id is a write
# the toolkit did not make before, and it needs the board token to be PERMITTED to make it — a
# role without `task.update` (or a board that is read-only to this token) answers 401/403 to
# every such write, forever. Reported as kb_api's bare status line it reads as a bad card or a
# flake, and the operator retries. Silent on every other status and on any body that carries no
# assignment: kb_api has already printed the status, and a second generic line about a write
# this function knows nothing about would be noise.
_kbc_write_fault() {
    local verb="$1" task="$2" body="$3" http="$4"
    case "$http" in 401|403) : ;; *) return 0 ;; esac
    jq -e 'has("assigned_user_id")' <<<"$body" >/dev/null 2>&1 || return 0
    echo "kbcard: $verb on task $task: HTTP $http is a POLICY refusal and this write carries assigned_user_id — an INSTALL FAULT, not a card problem. Writing an assignee needs the board token's role to carry \`task.update\` (and the board not to be read-only to it); a token without it gets this answer every time, so retrying and editing the card change nothing. Fix the role/token for this board (docs/INSTALL.md §3b)." >&2
    return 0
}

# _kbc_assign_guard <task> <target-json> <steal>: rule, from a READ of what the card holds NOW,
# on whether this call may write assigned_user_id=<target-json>. rc 1 refuses (no write); rc 0
# proceeds, having said on stderr what it is about to overwrite.
#
# ⭐ THE REFUSAL IS THE COLLISION DETECTOR THE FIELD EXISTS FOR, and it answers exactly in the
# case that motivated it: a card whose STAGE never moved is indistinguishable from an unclaimed
# one, so two seats pull the same work and neither finds out. Assigning over a DIFFERENT seat's
# id is rc 1 with the holder NAMED and NO write — the second seat learns whose work it was
# about to redo. Assigning the seat that already holds it is not a conflict; it writes the id
# it just read.
#
# --unassign (<target-json> `null`) is deliberately NOT gated the same way, and the reason is a
# fact about this tool rather than a policy preference: kbcard has no notion of WHICH seat is
# running it — the map resolves names to ids, never "me" — so it cannot tell a seat releasing
# its OWN card, the ordinary case, from one clearing somebody else's. Gating it would make
# --steal routine, and a loud line nobody can avoid stops being loud. It NAMES the holder it
# released instead, so the fact is on the record rather than gone.
#
# THE READ FAILING IS A REFUSAL, not an empty answer: a body no card can be read out of would
# otherwise be indistinguishable from an unassigned card, and this whole guard exists to keep
# those two apart. --steal is the opt-out of the CHECK, so it proceeds — saying plainly that
# what it is overwriting went unread.
_kbc_assign_guard() {
    local task="$1" target="$2" steal="$3" resp data holder
    if ! resp="$(kb_api GET "/tasks/$task.json")"; then
        [[ "$target" == "null" ]] && { echo "kbcard: --unassign on task $task: the card's current assignment could not be READ, so this run cannot say whose claim it is clearing — clearing it anyway (an unassign takes nothing for itself)" >&2; return 0; }
        [[ -n "$steal" ]] && { echo "kbcard: --steal on task $task: the card's current assignment could not be READ, so nothing here can name the holder it is taking from — overwriting an assignment this run never saw" >&2; return 0; }
        echo "kbcard: patch on task $task: the card's current assignment could NOT be read, so nothing here can say whether this write would take another seat's claim — refusing before the write. Re-run when the board reads, or pass --steal to overwrite regardless." >&2
        return 1
    fi
    # Two steps, not `.data.assigned_user_id // empty`: an unreadable body and an UNASSIGNED
    # card both project empty through that filter, and they are opposite answers here — the
    # first must refuse, the second must proceed.
    data="$(kb_parse_resp "$resp" -c '.data | select(type == "object")')"
    if [[ -z "$data" ]]; then
        [[ "$target" == "null" ]] && { echo "kbcard: --unassign on task $task: the read returned success but no card could be read out of its body, so the holder being cleared is unknown — clearing it anyway (an unassign takes nothing for itself)" >&2; return 0; }
        [[ -n "$steal" ]] && { echo "kbcard: --steal on task $task: the read returned success but no card could be read out of its body — overwriting an assignment this run never saw" >&2; return 0; }
        echo "kbcard: patch on task $task: the assignment read returned success but no card could be read out of its body — nothing was read, so this run cannot say whether the write would take another seat's claim, and refuses before the write." >&2
        return 1
    fi
    holder="$(jq -r '.assigned_user_id // empty' <<<"$data")"
    [[ -n "$holder" && "$holder" != "null" ]] || return 0   # unheld — nothing to collide with
    if [[ "$target" == "null" ]]; then
        echo "kbcard: --unassign on task $task: RELEASING $(_kbc_user_render "$holder")'s assignment" >&2
        return 0
    fi
    [[ "$holder" == "$target" ]] && return 0                # already this seat's — idempotent
    if [[ -n "$steal" ]]; then
        echo "kbcard: --steal on task $task: TAKING the card from $(_kbc_user_render "$holder") and assigning it to $(_kbc_user_render "$target"). The previous holder is NOT notified and may still be working it." >&2
        return 0
    fi
    echo "kbcard: patch on task $task: REFUSING to assign — this card is already held by $(_kbc_user_render "$holder"), and this call would give it to $(_kbc_user_render "$target"). NOTHING WAS WRITTEN. That seat may be working it right now (a card whose column never moved looks unclaimed and is not). Talk to them, or pass --steal to take it anyway." >&2
    return 1
}

# _kbc_ref_pair_guard <task> <payload-json> <pairs> <pr> <issue>: refuse a `patch` that would leave
# the card naming one pull request or issue by NUMBER and a different one by URL (card#9837,
# card#9846). <payload-json> is the payload this call will send (after the decline merge); <pairs>
# is what _kbc_ref_pair_preflight printed for it; <pr> / <issue> are the raw --pr / --issue values,
# used only to name them in a message. rc 0 proceed; rc 2 refused, nothing written; rc 1 the card
# could not be read, nothing written. rc 2 also when kb_ref_pair_verdicts answers with an rc that is
# not one of its answers. A lib too old to have the check at all never reaches here:
# _kbc_ref_pair_preflight refuses that, offline, on every patch.
#
# by-ref-source-rule: HOME — THE DEFECT IT CLOSES. This paragraph is kbcard's full statement of
# the derivation, and the pointers elsewhere in this file cite it rather than restate it. No count
# of them is kept here, and deliberately no grep either: the obvious one is line-scoped, and some of
# those pointers wrap `_kbc_ref_pair_guard's` across a line break, so a published command would
# under-report — which is the exact failure card#9957 exists to end, and a wrong derivation is
# worse than none. It is a copy rather than a pointer for the reason
# KB_JQ_REPO_FROM_GH_URL's header gives for its own: this bin is vendored standalone,
# beside neither docs/ nor promote-released-cards, so it can read neither. What makes it a pinned
# copy rather than an unpinned one is tests/by-ref-source-claim-selftest.sh, which holds the field
# order below against the shipped `derive_source`.
# The payload PATCH merges per key, so a call that writes one half of a
# number/URL pair leaves the stored other half untouched. The board derives a card's by-ref
# `source` (owner/repo) from a URL (a payload.repo that is a string containing `/` outranks every
# URL; else the first of pr_url, issue_url, html_url, external_link yielding a repo) and never from
# the number, so, where a URL is what attributes the card:
#   --pr N / --issue N alone        re-points the number and leaves the card attributed to the
#                                   OLD URL's repo;
#   --pr-url U / --issue-url U alone moves the attribution to U's repo while the card still names
#                                   the OLD number — and for the pr pair a release in U's repo
#                                   shipping that number then promotes the card (promote reads no
#                                   issue key at all: card#9935).
# Either way the card ends up at rc 0 naming two different refs, with nothing on it to show the two
# keys disagree. Refusing, operator-approved as an acceptance change (2026-09-18, card#9837; widened
# to the whole class by card#9846), is the one answer that needs no guess: neither half can be
# rewritten into the other without the value the call did not pass.
#
# WHICH PAIRS ARE CHECKED, AND WHAT COUNTS AS A DIVERGENCE, are NOT decided here: kb_ref_pairs_alone
# and kb_ref_pair_verdicts in _kb-board-lib.sh own both, because adopt-to-dl must ask the same
# question before it mints. This function owns the read, the messages and the exit code. No pair to
# check ⇒ no read at all; several pairs cost ONE read, and every refusal is printed.
#
# ⭐ WHAT A REFUSAL SAYS — AND WHAT IT DELIBERATELY DOES NOT (operator ruling, card#9918). Each
# message states the DIVERGENCE (which half names what, by the derived owner/repo and number) and
# the flag to pass. It states no downstream CONSEQUENCE — not who the card ends up attributed to,
# not what a release in that repo would promote. Those follow from where the card's source comes
# from, which the guard cannot read off the pair: a payload.repo string containing `/` outranks
# every URL (above), so a consequence clause written from the URL's repo is false on some card and
# a clause written the other way is false on the rest. The divergence is true on all of them, and
# is the whole reason for the refusal. The verdicts are unaffected either way.
#
# A STORED URL NAMING NO NUMBER is refused under a given number exactly as a given one is under a
# stored number (operator ruling "A", card#9846): a commit/tree/blob URL, or a pull/issues segment
# with no digits, still names a repo, so --pr N alone would name PR N with a URL naming no PR at
# all. Only a stored URL yielding NO repo keeps the notice.
#
# ⛔ NO MESSAGE ECHOES A URL, STORED OR GIVEN. It can carry userinfo, and because the capture is
# unanchored the scheme need not sit at byte 0 (leading blanks, or any prefix at all), where
# kb_redact_url_userinfo — whose input is a URL — does not recognise one and returns it verbatim.
# A refusal prints only what the parse DERIVED, the owner/repo and number after `github.com/`,
# which cannot hold a userinfo, and a number only as `norm` printed it; a notice points at
# `kbcard show` for the stored value itself.
_kbc_ref_pair_guard() {
    local task="$1" payload="$2" pairs="$3" pr="$4" issue="$5" resp data verdicts
    local r side disp kind num repo stored nflag uflag nkey ukey noun given
    local refusals=() notices=() lrc=0
    [[ -n "$pairs" ]] || return 0
    if ! resp="$(kb_api GET "/tasks/$task.json")"; then
        while IFS=$'\t' read -r r side; do
            _kbc_ref_pair_names "$r" "$side"
            if [[ "$side" == number ]]; then
                echo "kbcard: patch on task $task: the card could NOT be read, so nothing here can say whether $given diverges from the $ukey it already carries — refusing before the write. Re-run when the board reads, or pass $uflag with $nflag." >&2
            else
                echo "kbcard: patch on task $task: the card could NOT be read, so nothing here can say whether $given diverges from the $nkey it already carries — refusing before the write. Re-run when the board reads, or pass $nflag with $uflag." >&2
            fi
        done <<<"$pairs"
        return 1
    fi
    data="$(kb_parse_resp "$resp" -c '.data | select(type == "object")')"
    if [[ -z "$data" ]]; then
        while IFS=$'\t' read -r r side; do
            _kbc_ref_pair_names "$r" "$side"
            if [[ "$side" == number ]]; then
                echo "kbcard: patch on task $task: the read returned success but no card could be read out of its body — nothing was read, so this run cannot say whether $given diverges from the card's $ukey, and refuses before the write." >&2
            else
                echo "kbcard: patch on task $task: the read returned success but no card could be read out of its body — nothing was read, so this run cannot say whether $given diverges from the card's $nkey, and refuses before the write." >&2
            fi
        done <<<"$pairs"
        return 1
    fi
    verdicts="$(kb_ref_pair_verdicts "$data" "$payload" "$pairs")" || lrc=$?
    if (( lrc )); then _kbc_lib_unruled "patch on task $task" "the number/URL pairs" kb_ref_pair_verdicts "$lrc"; return 2; fi
    while IFS=$'\t' read -r r side disp kind num repo stored; do
        _kbc_ref_pair_names "$r" "$side"
        case "$disp:$side:$kind" in
            ok:*) ;;
            notice:number:unparsed-url)
                notices+=("kbcard: patch on task $task: the card's $ukey is not a GitHub pull-request or issue URL (kbcard show --task $task prints it), so whether $given diverges from it could not be checked — writing $nkey and leaving $ukey as it is (pass $uflag to replace it)") ;;
            notice:url:unparsed-url)
                notices+=("kbcard: patch on task $task: the $uflag given is not a GitHub pull-request or issue URL, so whether it diverges from the card's $nkey could not be checked — writing $ukey and leaving $nkey as it is (pass $nflag to replace it)") ;;
            notice:url:unparsed-number)
                notices+=("kbcard: patch on task $task: the card's $nkey is not a $noun number (kbcard show --task $task prints it), so whether $given diverges from it could not be checked — writing $ukey and leaving $nkey as it is (pass $nflag to replace it)") ;;
            refuse:number:diff)
                refusals+=("kbcard: patch on task $task: REFUSING $given without $uflag — the card's $ukey names $noun $num in $repo, so this write would leave the card naming one $noun by number and another by URL. Pass $uflag with the new $noun's URL alongside $nflag. NOTHING WAS WRITTEN.") ;;
            refuse:url:diff)
                refusals+=("kbcard: patch on task $task: REFUSING $given without $nflag — the $uflag given names $noun $num in $repo but the card's $nkey is $noun $stored, so this write would leave the card naming one $noun by number and another by URL. Pass $nflag with the new $noun's number alongside $uflag. NOTHING WAS WRITTEN.") ;;
            refuse:number:unnumbered-stored)
                refusals+=("kbcard: patch on task $task: REFUSING $given without $uflag — the card's $ukey names no $noun number, only the repo $repo, so this write would leave the card naming $noun $stored by number and a URL naming no $noun at all. Pass $uflag with the $noun's URL alongside $nflag. NOTHING WAS WRITTEN.") ;;
            refuse:url:unnumbered-given)
                refusals+=("kbcard: patch on task $task: REFUSING $given without $nflag — the $uflag given names no $noun number, only the repo $repo, while the card's $nkey is $noun $stored, so this write would leave the card naming $noun $stored by number and a URL naming no $noun at all. Pass $nflag with $uflag to re-point both. NOTHING WAS WRITTEN.") ;;
            refuse:url:placeholder-given)
                refusals+=("kbcard: patch on task $task: REFUSING $given without $nflag — the $uflag given is the pre-$noun placeholder (a .../0 URL, \"no $noun yet\") in $repo, but the card's $nkey is $noun $stored, so this write would leave the card naming $noun $stored by number while its URL says there is none. Pass $nflag with $uflag to re-point both. NOTHING WAS WRITTEN.") ;;
            *)
                # A verdict this case does not name is refused, not written: the lib owns the
                # vocabulary, and a new refusal kind landing here must not ride through as rc 0.
                refusals+=("kbcard: patch on task $task: REFUSING $given — the $r pair check returned '$disp:$kind', which this kbcard does not know how to act on. NOTHING WAS WRITTEN.") ;;
        esac
    done <<<"$verdicts"
    if (( ${#refusals[@]} )); then
        printf '%s\n' "${refusals[@]}" >&2
        return 2
    fi
    (( ${#notices[@]} )) && printf '%s\n' "${notices[@]}" >&2
    return 0
}

# _kbc_ref_pair_preflight <task-ref> <payload-json>: the pair check's OFFLINE half, run with the
# rest of patch's no-network preflight, ABOVE resolve_task. Prints kb_ref_pairs_alone's answer for
# <payload-json> (the pairs _kbc_ref_pair_guard must read the card for; empty when there are none).
# rc 2, having printed nothing on stdout, when the lib cannot answer: kb_ref_pairs_alone returning an
# rc outside its answers, or kb_ref_pair_verdicts not being defined at all. Both are asked on EVERY
# patch — kb_ref_pairs_alone is what decides whether there is a pair to check, so an empty answer
# from it would read as "none" and skip the guard — so a kbcard beside a _kb-board-lib.sh that
# predates the check refuses every patch at rc 2 having issued no request at all, not even the
# external-id lookup or the --assign read, with the function named (card#9756's rule, card#9846).
_kbc_ref_pair_preflight() {
    local pairs lrc=0
    pairs="$(kb_ref_pairs_alone "$2")" || lrc=$?
    if (( lrc )); then _kbc_lib_unruled "patch on task $1" "the number/URL pairs" kb_ref_pairs_alone "$lrc"; return 2; fi
    if ! declare -F kb_ref_pair_verdicts >/dev/null; then
        _kbc_lib_unruled "patch on task $1" "the number/URL pairs" kb_ref_pair_verdicts undefined; return 2
    fi
    printf '%s' "$pairs"
}

# _kbc_ref_pair_names <ref> <side>: _kbc_ref_pair_guard's message vocabulary for one pair. Sets the
# CALLER's locals nflag / uflag / nkey / ukey / noun / given, where `given` names this call's half
# of the pair: the number as passed (read from the caller's pr / issue), or the URL flag ALONE,
# because no message echoes a URL (the guard's header says why).
_kbc_ref_pair_names() {
    nflag="--$1" uflag="--$1-url" nkey="$1_number" ukey="$1_url" noun="issue"
    [[ "$1" == pr ]] && noun="PR"
    if [[ "$2" == number ]]; then
        if [[ "$1" == pr ]]; then given="$nflag $pr"; else given="$nflag $issue"; fi
    else
        given="$uflag"
    fi
}

# _kbc_card_start_guard <task> <backlog-id> <prioritized-id> <held-id> <in-progress-id>: what --card-start DOES
# about the two card-start invariants — which it does NOT own. kb_card_pinned and
# kb_card_start_stage_verdict in _kb-board-lib.sh own them, shared with bin/board-card-start
# (card#9556); this owns only what kbcard does when they answer. The verdict is READ off the card
# immediately before the move, so nothing here assumes a stage.
#   rc 0  proceed with the move
#   rc 1  refused BY POLICY — the reason is on stderr and nothing was written
#   rc 2  the card could not be READ, so there is no verdict to give
#   rc 3  an invariant returned an rc outside its declared set — the lib could not rule (rc 127 is
#         a _kb-board-lib.sh older than this kbcard, lacking the function), so neither could this
_kbc_card_start_guard() {
    local task="$1" backlog="$2" prioritized="$3" held="$4" inprog="$5" got http body cur col where pinned=0 sv=0
    # kb_api_status, not kb_api: the STATUS is half the diagnostic here, and kb_api strands it in
    # the command substitution the caller reads the body through.
    got="$(kb_api_status GET "/tasks/$task.json")"
    http="${got%%$'\n'*}"; body=""
    [[ "$got" == *$'\n'* ]] && body="${got#*$'\n'}"
    if [[ "$http" != 2* ]]; then
        echo "kbcard: move --card-start on task $task: the card could NOT be read (HTTP $http), so nothing here can say whether this move would pull a finished or pinned card back to In Progress — refusing before the write. Re-run when the board reads." >&2
        return 2
    fi
    kb_card_pinned "$body" || pinned=$?
    case "$pinned" in
        0) echo "kbcard: move --card-start on task $task: the card is PINNED — a non-empty block_reason or a no-automove tag — so an automated work-start move is refused whatever its stage, and NOTHING was written. Clear the pin (kbcard patch --unblock, or drop the tag) to let it move." >&2
           return 1 ;;
        2) echo "kbcard: move --card-start on task $task: the read returned success but no card could be read out of its body — nothing was read, so this run cannot rule on the move and refuses before the write." >&2
           return 2 ;;
        1) ;;
        *) _kbc_lib_unruled "move --card-start on task $task" "the move" kb_card_pinned "$pinned"; return 3 ;;
    esac
    cur="$(kb_parse_resp "$body" -r '.data.workflow_stage_id // empty')"
    if [[ -z "$cur" ]]; then
        echo "kbcard: move --card-start on task $task: the read returned success but no workflow stage could be read out of its body, so the card was NOT confirmed startable — refusing before the write." >&2
        return 2
    fi
    kb_card_start_stage_verdict "$cur" "$backlog" "$prioritized" "$held" || sv=$?
    case "$sv" in
        0) return 0 ;;
        1|2) ;;
        *) _kbc_lib_unruled "move --card-start on task $task" "the move" kb_card_start_stage_verdict "$sv"; return 3 ;;
    esac
    col="$(stage_name "$cur" 2>/dev/null || true)"
    where="stage $cur${col:+ ($col)}"
    if [[ "$cur" == "$inprog" ]]; then
        echo "kbcard: move --card-start on task $task: the card is already In Progress ($where), so it was left where it is and NOTHING was written." >&2
        return 1
    fi
    if [[ "$sv" == 2 ]]; then
        echo "kbcard: move --card-start on task $task: the card is HELD ($where) — a parked card is promoted only by a genuine branch creation, which this call is not, so NOTHING was written." >&2
        return 1
    fi
    echo "kbcard: move --card-start on task $task: the card is in $where, which is neither Backlog nor Prioritized, so this work-start move would move an already-started or FINISHED card BACKWARD — refused, and NOTHING was written." >&2
    return 1
}

# _kbc_lib_unruled <context> <subject> <function> <rc>: the line for a lib invariant that answered
# with none of its declared rcs, so the guard asking it cannot rule on <subject>. Read as an
# answer, such an rc was "not pinned" and then a policy refusal naming the card's stage — for every
# card, never naming the lib (card#9756); for the patch pair check it was an rc 1 that named no
# function, or said nothing at all (card#9846).
# <rc> `undefined` is a function found missing without calling it (declare -F).
# The CALLER returns the rc: rc 2 at the verb, like every guard that cannot be applied.
_kbc_lib_unruled() {
    local said="returned rc $4, which is not one of its answers — rc 127 means"
    [[ "$4" == undefined ]] && said="is not defined —"
    echo "kbcard: $1: $3 $said the _kb-board-lib.sh beside this kbcard predates it, so re-vendor the lib with this kbcard. This run cannot rule on $2 and refuses before the write, so NOTHING was written." >&2
}

cmd_move() {
    local task_ref="" column="" keep_refs="" stamp_owner="" card_start=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --task) kb_require_value "$1" "${2:-}" || return 2; task_ref="$2"; shift 2 ;;
            --column) kb_require_value "$1" "${2:-}" || return 2; column="$2"; shift 2 ;;
            --keep-refs) keep_refs=1; shift ;;
            --stamp-owner) stamp_owner=1; shift ;;
            --card-start) card_start=1; shift ;;
            *) echo "kbcard: unknown arg '$1'" >&2; return 2 ;;
        esac
    done
    [[ -z "$task_ref" || -z "$column" ]] && { echo "kbcard: --task and --column required" >&2; return 2; }
    if [[ -n "$stamp_owner" ]] && _kbc_terminal_column "$column"; then
        echo "kbcard: --stamp-owner claims the card for this seat, and $column is a terminal column, whose move removes every owner tag — pass one or the other" >&2
        return 2
    fi
    # --card-start's stage ids come from the SAME board env every other column does, and they are
    # resolved BEFORE the task ref so a board env missing them costs no request. A guard that
    # cannot be applied REFUSES rather than falling through: falling through is precisely the
    # unguarded move this flag exists to remove.
    local cs_backlog="" cs_prioritized="" cs_held=""
    if [[ -n "$card_start" ]]; then
        if [[ "$column" != "in_progress" ]]; then
            echo "kbcard: --card-start is the guard on the work-start promotion to in_progress, and has no policy to apply to a move to '$column' — pass one or the other" >&2
            return 2
        fi
        cs_backlog="$(stage_id backlog)" || return 2
        cs_prioritized="$(stage_id prioritized)" || return 2
        # Held is OPTIONAL — a board need not have the column, and one that does not has no held
        # cards for the verdict to reach.
        cs_held="$(stage_id held 2>/dev/null)" || cs_held=""
    fi
    local task stage body
    task="$(resolve_task "$task_ref")"
    stage="$(stage_id "$column")"
    if [[ -n "$card_start" ]]; then
        local csv=0
        _kbc_card_start_guard "$task" "$cs_backlog" "$cs_prioritized" "$cs_held" "$stage" || csv=$?
        # 1 is a POLICY refusal — the guard worked, so the verb did not fail. 2 is a card this run
        # could not READ, which is a failure to establish and must never read as a policy call: the
        # two need different operator actions. 3 is a guard that could not be APPLIED (the lib gave
        # no answer), which is rc 2 like the other guard-cannot-apply refusals above — re-running
        # does not fix an install, where a board that did not read may answer next time.
        case "$csv" in
            0) ;;
            1) return 0 ;;
            3) return 2 ;;
            *) return 1 ;;
        esac
    fi
    # Decline hygiene lives in _kbc_decline_nulls (shared with patch --column wont_do).
    # --keep-refs opts out. Only wont_do clears — no other move touches the payload.
    if [[ "$column" == "wont_do" && -z "$keep_refs" ]]; then
        body="$(jq -n --argjson stage "$stage" --argjson p "$(_kbc_decline_nulls '{}')" \
            '{workflow_stage_id: $stage, payload: $p}')"
        echo "kbcard: cleared correlation stamps (dl_number, pr_number, pr_url) on decline — pass --keep-refs to retain them" >&2
    else
        body="$(jq -n --argjson stage "$stage" '{workflow_stage_id: $stage}')"
        [[ "$column" == "wont_do" ]] && echo "kbcard: --keep-refs — correlation stamps (dl_number, pr_number, pr_url) retained" >&2
    fi
    # move's echo is deliberately NOT _kbc_write_echo's: that projection also carries `payload`
    # when the serializer sent it, and this verb has never emitted it. Same refusal, its own
    # field set — widening a verb's stdout is a change to what its consumers parse.
    local resp echo_out
    resp="$(_kbc_stage_patch move "$task" "$column" "$body")" || return 1
    echo_out="$(kb_parse_resp "$resp" '.data | {id, name, workflow_stage_id}')"
    [[ -n "$echo_out" ]] || _kbc_unverified move "on task $task" || return $?
    # The whole point of this verb is the stage, so the stage is what it checks. Same owner as
    # create-card's and patch's, per its own header rule: the PROJECTION differs here, the
    # outcome contract does not.
    _kbc_confirm_stage move "on task $task" "$echo_out" "$stage" || return 1
    _kbc_owner_after_move "$task" "$column" "$stamp_owner"
    printf '%s\n' "$echo_out"
}

# _kbc_trim_blank <string>: the string with leading and trailing BLANKS removed, where "blank"
# is kb_is_blank's six ASCII characters and nothing else — the `LC_ALL=C` pin is what makes that
# true, since `[[:space:]]` in a pattern asks bash for a LOCALE class and a UTF-8 seat answers a
# wider set (card#9337 measured that divergence on U+2003/U+3000). Pinned so a value this trims
# to empty is EXACTLY a value kb_is_blank calls blank, on every seat.
#
# It exists for `reorder --ids`, whose members the board itself trims before reading them; not
# trimming here would refuse a spelling the board accepts, by sending " 10221" to the
# external-id lookup. ⚠ IT IS NOT A COPY OF THE BOARD'S TRIM AND MUST NOT BE READ AS ONE: the two
# sets differ at the edges (this one carries \f, the board's language's default trim carries NUL
# instead), and asserting parity is the "second copy of another repo's rule" shape this file's
# --unblock paragraph warns about. What the trim buys is the ordinary padded spelling `"5, 6"`
# reaching the resolver as `5` and `6`; a member whose only difference from the board's verdict is
# one of those edge bytes is not a case this repo has measured or claims.
# The same idiom sits inline in _kb-board-lib.sh's board-env parser; hoisting
# ONE trim primitive into the lib is a consolidation this card does not take — it would widen a
# vendored file for a caller that does not need it yet (the second real caller is the moment).
_kbc_trim_blank() {
    local LC_ALL=C s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    printf '%s' "${s%"${s##*[![:space:]]}"}"
}

# --- reorder: rank cards WITHIN one column, and REPORT FROM WHAT CAME BACK ----------------
# The flag shape, every refusal and the stdout contract are stated in the usage block above and
# are NOT restated here. What this header owns is why the confirmation is shaped the way it is.
#
# ⭐ THE ROUTE HANDS BACK THE RANKED CARDS ON PURPOSE. `PUT /tasks/reorder.json` answers with the
# moved cards in their new order carrying their new `position`, plus a `meta` naming the
# untouched cards bracketing the block — its own docblock says this exists "so a caller can
# confirm the ACHIEVED placement from data rather than from a 2xx". A verb that printed `ok` off
# the status would throw away the one thing that makes the write verifiable at all, which is the
# class `readback-before-success-census.sh` measures.
#
# ⛔ THE BRACKET COMPARISON IS A CLAIM ABOUT THE BOARD'S CODE AND THIS REPO CANNOT CHECK IT — the
# ⚠ paragraph in the usage block states it in the caller's words and is the one place it is
# stated; nothing here re-derives it. What matters at THIS end: the bracket is computed from the
# positions the board actually wrote, so it is evidence independent of the id echo (which the
# controller builds from the request's own ordered list and therefore cannot disagree with it
# except on a server that is wrong about something much larger). Comparing both is not belt and
# braces — one measures that the right cards were ranked, the other that they landed where the
# call asked. A single comparison would leave the other question answered by the status code.
#
# THE ANCHOR AND ids ARE NOT CROSS-CHECKED HERE, deliberately. Whether an anchor is in the same
# stage as the block, and whether it is itself one of the moving cards, are facts about rows this
# call never reads; the board holds them under the same lock it does the placement under, and it
# refuses on both in its own words. Re-deriving either here would need reads this verb does not
# take and would put a second copy of the board's stage rules in a client — the divergence this
# card exists to prevent one layer up.
# _kbc_reorder_anchor_offline <anchor-id> <ids-csv> <as-typed> <flag>: rc 1, with the diagnostic,
# when the anchor is itself one of the cards being moved. The CALLER owns the exit status.
#
# ⭐ WHY THIS ONE IS DECIDED HERE WHILE THE OTHER THREE BOARD REFUSALS ARE RELAYED. The rule the
# relay follows is "a fact about rows this call never reads" — true of a list spanning two stages,
# an id naming no active card, and an anchor outside the block's stage, each of which needs the
# board's own rows. It is FALSE of this one: both values are already in hand, the test is set
# membership, and nothing about any stage is re-derived. Leaving it to the board also put a purely
# malformed invocation in the wrong exit bucket — rc 1 (the server answered) where its sibling,
# the same card named twice in --ids, is rc 2 (nothing sent) — so a caller branching on rc 2 as
# "my argv is wrong, do not retry" was told to retry a call that can never succeed.
# The case is reachable WITHOUT typing a repeat, exactly as the dedupe above is: `--ids 901
# --after-task EXT-A` where EXT-A resolves to 901 is two spellings of one card, and the board's
# refusal would then name a number the caller never typed.
_kbc_reorder_anchor_offline() {
    case ",$2," in
        *",$1,"*)
            echo "kbcard: reorder $4 names card $1, which is also in --ids (as '$3') — a block cannot be placed relative to one of its own members, so this call states no position at all. Nothing was sent." >&2
            return 1 ;;
    esac
}

cmd_reorder() {
    local ids_raw="" placement="" before_ref="" after_ref=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ids)         kb_require_value "$1" "${2:-}" || return 2; ids_raw="$2"; shift 2 ;;
            --placement)   kb_require_value "$1" "${2:-}" || return 2; placement="$2"; shift 2 ;;
            --before-task) kb_require_value "$1" "${2:-}" || return 2; before_ref="$2"; shift 2 ;;
            --after-task)  kb_require_value "$1" "${2:-}" || return 2; after_ref="$2"; shift 2 ;;
            *) echo "kbcard: unknown arg '$1'" >&2; return 2 ;;
        esac
    done
    [[ -n "$ids_raw" ]] || {
        echo "kbcard: reorder requires --ids \"<id-or-ext>[,<id-or-ext>...]\" — the cards to rank, in the order they should end up in" >&2
        return 2
    }

    # EXACTLY ONE PLACEMENT, decided before anything is resolved or sent. The three are three
    # ways to say WHERE the block lands, so a call naming two states two different positions for
    # it and a call naming none states no position at all — neither is a request this tool can
    # complete, and relaying either to the server would spend a round trip to be told what is
    # already knowable from argv.
    local given="" n_given=0
    [[ -n "$placement" ]]  && { given="$given --placement";   n_given=$((n_given + 1)); }
    [[ -n "$before_ref" ]] && { given="$given --before-task"; n_given=$((n_given + 1)); }
    [[ -n "$after_ref" ]]  && { given="$given --after-task";  n_given=$((n_given + 1)); }
    if [[ "$n_given" -eq 0 ]]; then
        echo "kbcard: reorder requires EXACTLY ONE placement and got none — pass --placement top|bottom, --before-task <id-or-ext> or --after-task <id-or-ext>. A rank with nothing to land against states no position at all, so nothing was sent" >&2
        return 2
    fi
    if [[ "$n_given" -gt 1 ]]; then
        echo "kbcard: reorder takes EXACTLY ONE placement and got$given — they are three ways to say where the block lands, and a call naming more than one states more than one position for it. Nothing was sent" >&2
        return 2
    fi
    if [[ -n "$placement" && "$placement" != "top" && "$placement" != "bottom" ]]; then
        echo "kbcard: reorder --placement takes top or bottom, got '$placement' — to land the block against a particular card use --before-task/--after-task <id-or-ext>" >&2
        return 2
    fi

    # The members are split and BLANK-refused offline, then resolved one by one. A blank member
    # is refused rather than dropped for the board's own reason: a token naming no card is a
    # mistake about WHICH cards are being ranked, and silently dropping it lands a DIFFERENT
    # order at rc 0. Trimming first matches what the board does to the same list, so a spelling
    # it accepts is not refused here on whitespace alone.
    local ids_csv="" rest="$ids_raw" ref id
    while :; do
        ref="$(_kbc_trim_blank "${rest%%,*}")"
        if [[ -z "$ref" ]]; then
            echo "kbcard: reorder --ids '$ids_raw' has a member that names no card — every member must be a task id or an external id. Nothing was sent (dropping it would rank a DIFFERENT set of cards than you asked for)" >&2
            return 2
        fi
        # resolve_task refuses at rc 1 and says why. It is NOT downgraded to a bad invocation
        # here: its failures include an external-id lookup that could not be READ, which is not
        # the caller's typing. Nothing is written either way — this runs before the PUT.
        id="$(resolve_task "$ref")" || return 1
        case ",$ids_csv," in
            *",$id,"*)
                echo "kbcard: reorder --ids names card $id twice (as '$ref', and already once above) — the board refuses a repeated id, and two spellings of one card (its id and its external id) reach that refusal as a number you never typed. Nothing was sent" >&2
                return 2 ;;
        esac
        ids_csv="${ids_csv:+$ids_csv,}$id"
        [[ "$rest" == *,* ]] || break
        rest="${rest#*,}"
    done

    local body anchor=""
    if [[ -n "$placement" ]]; then
        body="$(jq -n --arg ids "$ids_csv" --arg p "$placement" '{ids: $ids, placement: $p}')"
    elif [[ -n "$before_ref" ]]; then
        anchor="$(resolve_task "$before_ref")" || return 1
        _kbc_reorder_anchor_offline "$anchor" "$ids_csv" "$before_ref" --before-task || return 2
        body="$(jq -n --arg ids "$ids_csv" --argjson a "$anchor" '{ids: $ids, before_task_id: $a}')"
    else
        anchor="$(resolve_task "$after_ref")" || return 1
        _kbc_reorder_anchor_offline "$anchor" "$ids_csv" "$after_ref" --after-task || return 2
        body="$(jq -n --arg ids "$ids_csv" --argjson a "$anchor" '{ids: $ids, after_task_id: $a}')"
    fi

    local resp ranked meta
    # ⚠ A TRANSPORT FAILURE IS REPORTED HERE AS rc 1 — "NOT APPLIED, and KNOWN" — AND IT IS
    # NEITHER. kb_api answers $KB_API_RC_TRANSPORT (its own header: "NOT rc 1 — nothing was read
    # here") when the request never completed, and a --max-time cut or a reset AFTER the server
    # committed leaves the column ranked while this line says the mutation did not take; by this
    # file's own ladder that is the rc 3 case. ⛔ IT IS A CLASS, NOT THIS VERB'S: the identical
    # `|| return 1` sits on every other mutating kb_api call site in this file, so the fix is one
    # shared idiom and not six hand-edits (canon #5/#7) — re-derive the set with
    # `command grep -n 'kb_api\(_status\)\? \(POST\|PUT\|PATCH\|DELETE\)' bin/kbcard` rather than
    # trusting a count here. `reorder` is idempotent under retry, which is why it is NAMED here
    # and left level with its siblings rather than silently diverging from them.
    resp="$(kb_api PUT "/tasks/reorder.json" "$body")" || return 1
    # `select(type == "array")` on the near side of any default, per the rule the tag read
    # learned the hard way: a `.data` that is not a list must reach the UNVERIFIED arm, not be
    # folded into an empty one that reads as "the server ranked nothing".
    ranked="$(kb_parse_resp "$resp" -c '.data | select(type == "array") | map({id, name, workflow_stage_id, swimlane_id, position})')"
    [[ -n "$ranked" ]] || _kbc_unverified reorder "on ids $ids_csv" "The PUT answered 2xx and no ranked-card list could be read out of its body, so where those cards now sit is UNMEASURED." || return $?
    meta="$(kb_parse_resp "$resp" -c '.meta | select(type == "object")')"
    [[ -n "$meta" ]] || _kbc_unverified reorder "on ids $ids_csv" "The PUT answered 2xx with a ranked-card list and no meta block, so the ACHIEVED placement — which card the block landed between — is UNMEASURED." || return $?

    # Bare jq from here: both values came through the tolerant parse and a non-empty guard.
    #
    # GATE 1 — a CONSISTENCY check on WHICH cards came back, and it is deliberately not offered
    # as evidence of the achieved order. The board builds the returned collection as
    # `collect($orderedIds)->map(…)`, straight from the request's own ordered id list, so this
    # echo AGREES WITH THE REQUEST BY CONSTRUCTION: it can only disagree on a server that has
    # already gone wrong about something much larger than ordering. That is worth catching and
    # is not worth calling a read-back. GATE 2 below is the one that measures.
    local got_ids
    got_ids="$(jq -r '[.[].id] | join(",")' <<<"$ranked")"
    if [[ "$got_ids" != "$ids_csv" ]]; then
        echo "kbcard: reorder on ids $ids_csv: HARD FAILURE — the PUT answered 2xx and the cards the board returned, in the order it returned them, are '$got_ids'. The status is not the rank; the read-back is. The write DID go out, so the column may have been ranked some other way — re-read it before re-issuing." >&2
        return 1
    fi

    # ⭐ GATE 2 — THE ONLY GATE THAT MEASURES THE ORDER INSIDE THE BLOCK, and the reason the
    # other two cannot. `--ids` states a TARGET ORDER; gate 1 restates the request (above) and
    # gate 3 rules on where the block landed AS A WHOLE (the brackets). Neither says anything
    # about the order of the cards WITHIN it. `position` is the one value in this response that
    # the request never supplied at any point — it is computed from the column's live coordinates
    # and written — so it is the only field here that CAN contradict what was asked, which makes
    # it the only field worth calling a read-back. Printing it and not comparing it was the
    # defect: a response that is the request's own id list plus a correct meta block, with the
    # positions descending or absent, is exactly the echo this verb exists to refuse, and it
    # passed at rc 0 under a success line that said "read back from the board".
    #
    # THE TWO OUTCOMES ARE DIFFERENT ANSWERS AND TAKE DIFFERENT rcs. Positions that ARE numbers
    # and are not strictly increasing is a MEASUREMENT that the rank is wrong (rc 1). A row with
    # no numeric position is not a wrong ordering — it is no ordering that can be READ, which is
    # the rc 3 case by this file's own ladder, and folding it into rc 1 would assert an ordering
    # nobody measured. Ties count as not-increasing: two cards on one coordinate leave the order
    # between them to be broken by something this response does not carry.
    local pos_verdict
    pos_verdict="$(jq -r '[.[].position] as $p
        | if ([$p[] | select(type != "number")] | length) > 0 then "not-numeric"
          elif $p != ($p | sort) or (($p | unique | length) != ($p | length)) then "not-ascending"
          else "ok" end' <<<"$ranked")"
    case "$pos_verdict" in
        ok) ;;
        not-numeric)
            _kbc_unverified reorder "on ids $ids_csv" "The PUT answered 2xx and at least one ranked card carries no numeric position (got $(jq -c '[.[].position]' <<<"$ranked")). Position is the only value in this response the request did not supply, so the ORDER the board wrote is UNMEASURED and what is left is this call's own id list handed back. The write DID go out — re-read the column before re-issuing." || return $? ;;
        *)
            echo "kbcard: reorder on ids $ids_csv: HARD FAILURE — the PUT answered 2xx and the positions the board wrote are not strictly increasing in the order it returned them (got $(jq -c '[.[].position]' <<<"$ranked")), so the block is NOT ranked in the order --ids asked for. The status is not the rank; the read-back is. The cards WERE ranked — just not in that order — so re-read the column before re-issuing." >&2
            return 1 ;;
    esac

    # GATE 3 — where the block landed AS A WHOLE, against the untouched cards bracketing it.
    local want_side want_val got_val
    case "${placement:-anchor}" in
        top)    want_side="before_task_id"; want_val="null"     ;;
        bottom) want_side="after_task_id";  want_val="null"     ;;
        *)      if [[ -n "$before_ref" ]]; then want_side="after_task_id"; else want_side="before_task_id"; fi
                want_val="$anchor" ;;
    esac
    got_val="$(jq -r --arg k "$want_side" '.[$k] // "null"' <<<"$meta")"
    if [[ "$got_val" != "$want_val" ]]; then
        echo "kbcard: reorder on ids $ids_csv: HARD FAILURE — the PUT answered 2xx and the board reports the block landed with $want_side=$got_val, where this call asked for $want_side=$want_val. The status is not the placement; the read-back is. The cards WERE ranked — they are just not where this call asked — so re-read the column before re-issuing. The board's own meta: $meta" >&2
        return 1
    fi

    if [[ "$(jq -r '.renumbered' <<<"$meta")" == "true" ]]; then
        echo "kbcard: reorder: the board reports renumbered=true — the stage's position COORDINATES were re-spaced onto an even ladder because the gap between two neighbours was exhausted. NO card's rank changed by it — the re-spaced cards kept their order and are NOT in the list below, which is the cards THIS call ranked — and the board records it as ONE lane.cards_renumbered event rather than as N moves." >&2
    fi
    echo "kbcard: reorder: $(jq 'length' <<<"$ranked") card(s) ranked in stage $(jq -r '.workflow_stage_id' <<<"$meta") — read back from the board's own returned collection, landing between card $(jq -r '.before_task_id // "none"' <<<"$meta") and card $(jq -r '.after_task_id // "none"' <<<"$meta")." >&2
    # Assembled then `printf`-ed, the spelling every other verb here ends on — not a `jq` writing
    # straight to stdout. Two reasons, and neither is style: the write's own emission is then on
    # the same line-oriented idiom the rest of this file uses, and `readback-before-success
    # -census.sh` reads an `echo`/`printf` to decide a site's `emits` attribute, so a verb whose
    # only stdout came out of jq reported `stderr-only` — a write that prints its result being
    # censused as one that says nothing.
    printf '%s\n' "$(jq -n --argjson meta "$meta" --argjson ranked "$ranked" '$meta + {ranked: $ranked}')"
}

cmd_patch() {
    local task_ref="" pr="" pr_url="" issue="" issue_url="" version="" column="" desc="" desc_file="" desc_clear="" dl="" triaged="" swimlane="" keep_refs=""
    local name="" name_file="" tags="" type="" ext_id="" origin=""
    local assign="" unassign="" steal=""
    local block="" block_file="" unblock="" clear=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --task) kb_require_value "$1" "${2:-}" || return 2; task_ref="$2"; shift 2 ;;
            --pr) kb_require_value "$1" "${2:-}" || return 2; pr="$2"; shift 2 ;;
            --pr-url) kb_require_value "$1" "${2:-}" || return 2; pr_url="$2"; shift 2 ;;
            --issue) kb_require_value "$1" "${2:-}" || return 2; issue="$2"; shift 2 ;;
            --issue-url) kb_require_value "$1" "${2:-}" || return 2; issue_url="$2"; shift 2 ;;
            --version) kb_require_value "$1" "${2:-}" || return 2; version="$2"; shift 2 ;;
            --column) kb_require_value "$1" "${2:-}" || return 2; column="$2"; shift 2 ;;
            --swimlane) kb_require_value "$1" "${2:-}" || return 2; swimlane="$2"; shift 2 ;;
            --description) kb_require_value "$1" "${2:-}" || return 2; desc="$2"; shift 2 ;;
            --description-file) kb_require_value "$1" "${2:-}" || return 2; desc_file="$2"; shift 2 ;;
            --clear-description) desc_clear=1; shift ;;
            --clear) kb_require_value "$1" "${2:-}" || return 2; [[ -z "$clear" ]] || { echo "kbcard: --clear was passed twice — name every field in ONE comma list (--clear origin,version)" >&2; return 2; }; clear="$2"; shift 2 ;;
            --dl) kb_require_value "$1" "${2:-}" || return 2; dl="$2"; shift 2 ;;
            --name) kb_require_value "$1" "${2:-}" || return 2; name="$2"; shift 2 ;;
            --name-file) kb_require_value "$1" "${2:-}" || return 2; name_file="$2"; shift 2 ;;
            --tags) kb_require_value "$1" "${2:-}" || return 2; tags="$2"; shift 2 ;;
            --type) kb_require_value "$1" "${2:-}" || return 2; type="$2"; shift 2 ;;
            --external-id) kb_require_value "$1" "${2:-}" || return 2; ext_id="$2"; shift 2 ;;
            --origin) kb_require_value "$1" "${2:-}" || return 2; origin="$2"; shift 2 ;;
            --assign) kb_require_value "$1" "${2:-}" || return 2; assign="$2"; shift 2 ;;
            --block-reason) kb_require_value "$1" "${2:-}" || return 2; block="$2"; shift 2 ;;
            --block-reason-file) kb_require_value "$1" "${2:-}" || return 2; block_file="$2"; shift 2 ;;
            --unblock) unblock=1; shift ;;
            --unassign) unassign=1; shift ;;
            --steal) steal=1; shift ;;
            --triaged) triaged=1; shift ;;
            --keep-refs) keep_refs=1; shift ;;
            *) echo "kbcard: unknown arg '$1'" >&2; return 2 ;;
        esac
    done
    [[ -z "$task_ref" ]] && { echo "kbcard: --task required" >&2; return 2; }

    # Everything resolvable WITHOUT the network is resolved first, so a typo'd --type /
    # --external-id / --column / --swimlane fails rc 2 having issued no request at all —
    # not even the tag read below, and never a half-applied PATCH. The text flags belong
    # in that set for the same reason: a `-`, an absent or an unreadable file is a bad
    # invocation, and a bad invocation must cost no traffic.
    _kbc_text_arg name name "" "$name" "$name_file" verbatim || return 2
    _kbc_text_arg desc description "" "$desc" "$desc_file" verbatim || return 2
    _kbc_text_arg block block-reason "" "$block" "$block_file" || return 2
    # Here and not in _kbc_patch_tags, which runs after resolve_task's lookup.
    _kbc_text_arg tags tags "" "$tags" "" verbatim || return 2
    if [[ -n "$type" ]];   then _kbc_require_type_alias "$type" || return 2; fi
    if [[ -n "$ext_id" ]]; then _kbc_require_ext_id "$ext_id" || return 2; fi
    local stage=""
    if [[ -n "$column" ]]; then stage="$(stage_id "$column")" || return 2; fi
    # swimlane_id is a top-level column (not a payload key), so it rides the inner task
    # object like workflow_stage_id — not the payload merge. The ref→JSON rule (none/0 →
    # null, else resolve) is shared with create-card in _kbc_swimlane_value.
    local swim_json=""
    if [[ -n "$swimlane" ]]; then swim_json="$(_kbc_swimlane_value "$swimlane")" || return 2; fi
    # The assignment resolves in that same offline preflight, for the same reason: an unknown
    # SEAT NAME is a config gap, and a config gap must cost no request at all. The two
    # directions are mutually exclusive — a call naming both says nothing about what the card
    # should end up holding, and silently picking one is the quiet-wrong this verb removes —
    # and --steal means nothing without one of them, so it is refused rather than ignored (a
    # flag accepted and not acted on reads as a flag that worked).
    local assign_set="" assign_json=""
    if [[ -n "$assign" && -n "$unassign" ]]; then
        echo "kbcard: --assign and --unassign are mutually exclusive — pass exactly one" >&2; return 2
    fi
    if [[ -n "$steal" && -z "$assign" && -z "$unassign" ]]; then
        echo "kbcard: --steal is the opt-in to overwrite ANOTHER seat's claim — it does nothing without --assign (or --unassign), so pass one of them or drop it" >&2; return 2
    fi
    if [[ -n "$assign" ]]; then
        assign_json="$(_kbc_user_id "$assign")" || return 2
        assign_set=1
    elif [[ -n "$unassign" ]]; then
        assign_json="null"
        assign_set=1
    fi

    # block_reason rides the SAME set-flag/value pair swimlane_id and assigned_user_id do, for
    # the same reason: null is a REAL value here (the --unblock form), so "was a flag passed" is
    # not readable off the value. Both directions are decided offline — a call naming the setter
    # AND the clearer states no end state at all, and silently picking one is the quiet-wrong
    # this field exists to remove. The value is built with jq rather than spliced, so a reason
    # carrying a quote or a backslash is a string and not a broken body — and that build is
    # guarded, unlike the neighbouring jq assignments, because an EMPTY block_json here would not
    # fail: `_kbc_task_fields` reads it as `null` while block_set still says a flag was passed,
    # so a failure at this one line would silently INVERT a set into a clear.
    # --clear-description is --unblock's shape on `description`, decided in the same offline
    # preflight and refused the same way: a call naming the setter AND the clearer states no end
    # state at all, and silently picking one is the quiet-wrong both pairs exist to remove. The
    # message names the half the caller actually passed — `$desc` here already holds whichever of
    # the two the resolver above read, so ONE check covers both halves of the pair.
    if [[ -n "$desc" && -n "$desc_clear" ]]; then
        echo "kbcard: --description${desc_file:+-file} and --clear-description are mutually exclusive — pass exactly one (--clear-description is the clear)" >&2; return 2
    fi

    local block_set="" block_json=""
    if [[ -n "$block" && -n "$unblock" ]]; then
        echo "kbcard: --block-reason and --unblock are mutually exclusive — pass exactly one (--unblock is the clear)" >&2; return 2
    fi
    if [[ -n "$block" ]]; then
        block_json="$(jq -n --arg v "$block" '$v')" || return 2
        block_set=1
    elif [[ -n "$unblock" ]]; then
        block_json="null"
        block_set=1
    fi

    # Assemble task.payload from the card-metadata flags (shared with cmd_create_card).
    # ORDER IS LOAD-BEARING: this sits with the no-network preflight, ABOVE resolve_task,
    # because it is where a malformed correlation value is refused (a --dl kb_dl_canon rejects,
    # a --pr / --issue that is not one positive decorated integer). Assembled after the ref lookup, that
    # rc-2 refusal arrived having already issued a GET — a bad invocation must cost no traffic,
    # exactly as the --type / --external-id / --column / --swimlane refusals above do. Nothing
    # here reads the resolved task id.
    # pr_url sets payload.pr_url, from which the kanban derives a card's by-ref `source`
    # (owner/repo, lowercased) unless the card's payload.repo outranks it (_kbc_ref_pair_guard's
    # header owns that rule and it is not restated here) — required for the repo-qualified
    # PR→card lookup on a multi-repo board; pr_number alone does NOT set source. Pre-PR
    # placeholder form is .../pull/0 (the repo segment is what matters; the poll reconciler
    # overwrites the URL).
    local payload_json
    payload_json="$(_kbc_build_payload "$dl" "$pr" "$pr_url" "$version" "$issue" "$issue_url" "$origin" "$clear")" || return 2
    # The keys this call CLEARS, read BEFORE the decline merge below adds nulls of its own: the
    # assembler omits an unset flag and never nulls a value, so every null it emits is a --clear.
    local cleared_json
    cleared_json="$(jq -c '[to_entries[] | select(.value == null) | .key]' <<<"$payload_json")"

    # patch --column wont_do is the SECOND decline call-site — same hygiene as move
    # (canon: one owner, _kbc_decline_nulls). Explicit ref flags in this call win.
    if [[ "$column" == "wont_do" && -z "$keep_refs" ]]; then
        payload_json="$(_kbc_decline_nulls "$payload_json")"
        echo "kbcard: cleared correlation stamps (dl_number, pr_number, pr_url) on decline — pass --keep-refs to retain them" >&2
    elif [[ "$column" == "wont_do" ]]; then
        # Retained = the decline's stamps minus what --clear removed in this same call.
        local retained
        retained="$(_kbc_decline_nulls | jq -r --argjson c "$cleared_json" 'keys_unsorted - $c | join(", ")')"
        echo "kbcard: --keep-refs — correlation stamps ($retained) retained" >&2
    fi

    # Which number/URL pairs this call writes by half is decided HERE, offline, from the payload just
    # assembled, so a lib too old to answer refuses before resolve_task's lookup or any read below.
    local ref_pairs
    ref_pairs="$(_kbc_ref_pair_preflight "$task_ref" "$payload_json")" || return 2

    local task; task="$(resolve_task "$task_ref")"
    # The collision check is a READ, so it sits BELOW the offline preflight and ABOVE every
    # write — it refuses at rc 1 (the write did not happen and this run KNOWS it did not),
    # never at rc 2, which in this file means a bad invocation (the number/URL pair refusal below
    # is rc 2 AFTER a read: the call itself is wrong for this card, and only a read can say so).
    # It is its OWN read, not folded into the tag read below: --assign + --tags/--type/--triaged
    # therefore costs two GETs. Deliberate — the tag read is a read-merge-WRITE whose result
    # becomes the body, and merging a refusal that must happen BEFORE any write into it would
    # tie one verb's refusal to whether another flag was passed.
    if [[ -n "$assign_set" ]]; then
        _kbc_assign_guard "$task" "$assign_json" "$steal" || return 1
    fi
    # A number without its URL (or a URL without its number) leaves the stored other half in place;
    # its own read, for the reason the assignment read above is its own (card#9837, card#9846). rc 2
    # is the refusal, rc 1 the unread card.
    _kbc_ref_pair_guard "$task" "$payload_json" "$ref_pairs" "$pr" "$issue" || return $?
    # Empty when the board has no native card type for the alias — _kbc_patch_tags then
    # writes the `type:<alias>` tag instead, exactly as create-card does at birth.
    local type_id=""
    if [[ -n "$type" ]]; then type_id="$(native_type_id "$type")"; fi

    # Empty unless --tags/--type/--triaged makes this call touch the tag list at all.
    local tags_json
    tags_json="$(_kbc_patch_tags "$task" "$tags" "$type" "$type_id" "$triaged")" || return 2

    # Send only the keys we're changing: the kanban v3 API MERGES task.payload
    # per-key (kanban #2180) — a key we omit is left as-is, an explicit null
    # clears it. So a bare {dl_number} no longer wipes the other custom fields,
    # and no read-merge-write is needed. Sending only the delta also preserves a
    # concurrent edit to any OTHER field: a full read-merge-write would clobber
    # it with our stale pre-PATCH read (the lost-update guarantee #2180 adds).
    # `tags` is the documented exception — the API replaces that list wholesale.
    local body
    body="$(_kbc_task_fields "$name" "$type_id" "$desc" "$tags_json" "$ext_id" "${swimlane:+1}" "$swim_json" "$payload_json" "$assign_set" "$assign_json" "$block_set" "$block_json" "$desc_clear")" || return 2
    if [[ -n "$column" ]]; then
        body="$(jq -n --argjson cur "$body" --argjson stage "$stage" '$cur + {workflow_stage_id: $stage}')"
    fi
    # Surface a field in the write echo only when this call set it, so the caller sees what
    # the server actually recorded (the whole point of a corrective patch) without changing
    # the echo shape of every other patch. `name` already rides _kbc_write_echo's projection.
    local echo_extra='description: (.description // "" | .[0:80])'
    # The clearer's whole claim is that the server now holds NULL, and the default projection
    # coerces a null to "" — in the echo, indistinguishable from a description this call never
    # touched. So the one call that means to see a null gets the RAW field, exactly as --unblock's
    # block_reason does. Untruncated on purpose: there is nothing to truncate.
    [[ -n "$desc_clear" ]] && echo_extra='description: .description'
    [[ -n "$swimlane" ]] && echo_extra="$echo_extra, swimlane_id: (.swimlane_id // null)"
    [[ -n "$tags_json" ]] && echo_extra="$echo_extra, tags: (.tags // [])"
    [[ -n "$type" ]] && echo_extra="$echo_extra, card_type_id: (.card_type_id // null)"
    [[ -n "$ext_id" ]] && echo_extra="$echo_extra, external_id: (.external_id // null)"
    # assigned_user_id rides the echo whenever this call set it — including the terminal-column
    # clear, which sets it without a flag — so the caller SEES what the server recorded. It is
    # surfaced, NOT compared: _kbc_confirm_stage's narrowness is deliberate (only a field this
    # file resolved itself and the server stores verbatim is safe to compare byte-wise), and
    # this field's round-trip has not been measured against a live board, so a compare here
    # could only manufacture a HARD FAILURE on a write that landed exactly as asked.
    if [[ -n "$assign_set" ]] || _kbc_terminal_column "$column"; then
        echo_extra="$echo_extra, assigned_user_id: (.assigned_user_id // null)"
    fi
    # Surfaced on BOTH directions, the clear included: its whole claim is that the server now
    # holds null, and a caller who cannot see that in the echo has to re-read the card to learn
    # whether the unblock took.
    [[ -n "$block_set" ]] && echo_extra="$echo_extra, block_reason: .block_reason"
    local resp
    resp="$(_kbc_stage_patch patch "$task" "$column" "$body")" || return 1
    # $stage is empty unless --column was passed, and an absent flag makes no claim to check.
    _kbc_write_echo patch "on task $task" "$resp" "$echo_extra" "$stage" "$cleared_json" || return $?
    _kbc_owner_after_move "$task" "$column" ""
}

# _kbc_card_filter <stage_filter> <type_filter> <typetag> <swimlane_filter>: the pure
# client-side SELECT over a card array on STDIN — the cards that pass, WHOLE and
# unprojected. Each filter arg is "" for absent, and an all-absent call passes every card through.
# Extracted at the SECOND caller (canon #5): `list` projects its row fields off it and
# `search` renders the description off it, and a divergence between two copies of these
# clauses would be a card matching one verb's --type and not the other's.
#   --type resolves per alias by board capability: a NATIVE id ($type != null)
#   matches card_type_id; otherwise ($type == null — all-tag/mixed/KB_TYPING_MODE)
#   the `type:<alias>` tag. The two clauses are MUTUALLY EXCLUSIVE — gating the tag
#   clause on $type == null avoids (a) an all-tag board matching every null-typed
#   card and (b) a native board surfacing a card carrying a stray type:<alias> tag.
#   The swimlane FILTER keys on the STRINGIFIED id — unlike the numeric stage/type
#   filters, whose id types are verified by the working --column path — because no
#   board reachable here populates swimlanes, so the API's swimlane_id JSON type
#   (number vs string) is unverifiable; stringifying both sides matches either and
#   shares the exact key derivation the name-map lookup uses (a numeric == would
#   silently drop a string-typed id — the quiet-wrong class this whole change fights).
#   That key derivation is why the swimlane filter arrives as a STRING (--arg, absent
#   = ""), not JSON (--argjson, absent = null) like stage/type: a laneless card's key
#   is `(null | tostring)` == "null", so the LANELESS filter is that same derived key
#   rather than a new comparison. It also keeps "filter absent" ("") distinguishable
#   from "filter on laneless" ("null") — collapsing those two is the trap this filter
#   exists to avoid, since a laneless filter that reads as absent returns the WHOLE
#   BOARD while looking correct (see _kbc_swimlane_is_laneless_ref's callers).
_kbc_card_filter() {
    local stage_filter="$1" type_filter="$2" typetag="$3" swimlane_filter="$4"
    jq \
        --argjson stage "${stage_filter:-null}" \
        --argjson type "${type_filter:-null}" \
        --arg typetag "$typetag" \
        --arg swim "${swimlane_filter:-}" \
        '(. // [])
         | map(select(($stage == null or .workflow_stage_id == $stage)
                and ($typetag == ""
                     or ($type != null and .card_type_id == $type)
                     or ($type == null and ((.tags // []) | index($typetag)) != null))
                and ($swim == "" or ((.swimlane_id // null) | tostring) == $swim)))'
}

# _kbc_list_project <stage_filter> <type_filter> <typetag> <swimlane_filter>: `list`'s
# fixed row projection, over the cards _kbc_card_filter above selected from STDIN. Same
# argument list, passed straight through — the filter half is that function's, and this
# one owns only what a row LOOKS like. Extracted from cmd_list so it is unit-testable on
# synthetic cards (board 12 has no swimlanes to exercise live).
#   swimlane_id / swimlane are surfaced on every row; the name resolves through the
#   env map (null when the card has no lane or the board doesn't map that id).
#   The PROJECTED FIELD SET is the only thing a consumer of this output can filter on:
#   a downstream `grep`/`jq select` over a field this projection drops gets a confident
#   0 that reads exactly like an empty board (a live consumer concluded "745 cards, 0
#   dependabot cards" while `show` returned the very tag it was looking for). `tags` and
#   `external_id` therefore ride every row — tags carry the whole `id:<sid>` provenance
#   namespace and the `type:*` fallback the filter above already keys on, and
#   external_id is the per-board sync id, i.e. the two identity surfaces a card is
#   actually hunted by. `description` is deliberately NOT projected: it is unbounded
#   free text on every row of a whole-board read, and the bound matters more here than
#   on `show`, which returns one card. That bound is why hunting a card BY ITS BODY is
#   the `search` verb's job and not a wider projection here — search's population is the
#   server's match set, so it prints each hit's description in full without ever putting
#   a whole board's free text on stdout. Absent tags project as [] (not null) — the same
#   normalization the type filter applies, so the filter and the emitted value can
#   never disagree about what a card is tagged.
#
# ⛔ THE PROJECTED KEY SET IS STATED TWICE MORE, ON SURFACES NEITHER OF WHICH CAN BE REPLACED BY
# A POINTER TO THE OTHER — the `Usage:` header above (read at a terminal, possibly with no
# browser) and README.md's `list` projection bullet (read before the tool is installed). The
# duplication is GUARDED rather than removed: `tests/kbcard-contract-selftest.sh` reads the key
# sequence out of a LIVE call to this function and requires both copies to publish exactly that
# sequence, IN ORDER. Add, drop or reorder a key here and expect it red until both documents
# name it — that is the guard working. It is there because README published this projection as
# a fixed TEN-key list while this function emitted TWELVE, and nothing noticed (card#9173).
#
# ⛔ THE GUARD'S UNIQUENESS LEG IS NOT THE SAME WIDTH ON BOTH SURFACES, and the narrow side is
# named rather than left to be assumed from the sentence above. On README it refuses a second
# copy of the key list's anchor phrase ANYWHERE IN THE FILE; on the rendered help it refuses one
# only INSIDE THIS VERB'S OWN BLOCK, so a third statement planted in another verb's help block
# — `search`'s, `show`'s — ships green (measured). That scope is deliberate and stays: the help
# anchor is the ordinary English word `projecting`, so a help-wide count would red on any
# unrelated verb whose block happened to use it, under a message blaming THIS key list — a
# check that fails for a reason other than its own claim. The comment is scoped to the code.
_kbc_list_project() {
    local swmap; swmap="$(_kbc_swimlane_map)"
    local umap; umap="$(_kbc_user_map)"
    _kbc_card_filter "$1" "$2" "$3" "$4" \
      | jq \
        --argjson swmap "$swmap" \
        --argjson umap "$umap" \
        'map(.payload = (if (.payload | type) == "object" then .payload else {} end))
         | map({id, name, stage: .workflow_stage_id, type: .card_type_id,
                swimlane_id: (.swimlane_id // null),
                swimlane: ($swmap[((.swimlane_id // null) | tostring)] // null),
                external_id: (.external_id // null),
                tags: (.tags // []),
                assigned_user_id: (.assigned_user_id // null),
                assignee: ($umap[((.assigned_user_id // null) | tostring)] // null),
                dl: .payload.dl_number, pr: .payload.pr_number})'
}

# cmd_stages: the stage id → column name map, as JSON. NO REQUEST — the pairs are the KB_STAGE_*
# vars VISIBLE TO THIS PROCESS (the board env, plus any the calling shell exported: kb_resolve_env
# clears KB_TOKEN_FILE/KB_BOARD_ENV and the two KBCARD_* ambients, never KB_STAGE_*, and
# tests/kbcard-selftest.sh scrubs ${!KB_STAGE_@} for exactly that reason). Which is why the read
# is worth having: the ids are per-install, so a consumer that hardcodes one is guaranteed wrong
# on somebody else's box, and `list` projects `stage` as one of those numbers while every write
# flag takes a name.
#
# ⭐ IT CALLS stage_name AND BUILDS NO MAP OF ITS OWN. That is the whole point of the verb: this
# output is BY CONSTRUCTION the set of pairs (id, stage_name(id)), so it cannot answer anything
# `show`'s `column` annotation would not. Lowercasing the var suffix here instead would be a
# second mapping of the same thing — and the argument for not doing it is NOT that the two
# disagree today. Measured: they agree on every input this env can hold, duplicate ids included
# (both resolve through the same prefix expansion, so both pick the alphabetically-first var).
# The point is that the agreement would then be a coincidence maintained by hand, and the ONE
# claim this verb makes to its consumer — the name here is the name `show` will print — would
# stop being a property of the code and become something a reader has to re-verify.
#
# Every successful call also declares on stderr that the names are local aliases — see the
# provenance line in the body for why that is stderr and not a row key.
#
# ⛔ THIS CONTRACT IS STATED TWICE MORE, ON SURFACES NEITHER OF WHICH CAN BE REPLACED BY A
# POINTER TO THE OTHER — the `Usage:` header above (read at a terminal, possibly with no
# browser) and README.md § `kbcard stages` (read before the tool is installed). The duplication
# is GUARDED rather than removed: `tests/kbcard-contract-selftest.sh` observes each fact
# by RUNNING this verb and reds when either surface stops saying what the run showed. Change the
# behaviour here and expect it red until both are updated — that is the guard working, and it is
# there because card#9171's change landed on one surface and not the other (card#9173).
#
# A value that is not a stage id is NAMED on stderr and left off, rather than dropped or emitted
# as a string: `list`'s `stage` is a JSON number, so one row typed differently from the rest is a
# join that silently misses, and a silent miss is the defect this verb exists to close.
cmd_stages() {
    [[ $# -gt 0 ]] && { echo "kbcard: stages takes no arguments (select the board with the global --board flag)" >&2; return 2; }
    local var val name rows=""
    for var in "${!KB_STAGE_@}"; do
        val="${!var}"
        [[ -n "$val" ]] || continue
        if ! kb_is_uint "$val"; then
            echo "kbcard: stages: $var='$val' is not a native stage id and is NOT listed — a KB_STAGE_* value is the board's numeric workflow_stage_id (\`000\` is the not-yet-configured placeholder examples/kanban-board.env.example ships)" >&2
            continue
        fi
        name="$(stage_name "$val")" || continue
        rows+="$val"$'\t'"$name"$'\n'
    done
    # rc 1, never `[]`: an empty array here would read as "this board has no columns", and a
    # board with no columns is not a thing this tool can address at all — stage_id refuses every
    # --column on such an env. So the empty map is a config fault, reported as one.
    [[ -n "$rows" ]] || {
        echo "kbcard: no KB_STAGE_* variable is defined for board $KB_BOARD_ID — that is a board-env gap, not a board with no columns (docs/INSTALL.md §3b)" >&2
        return 1
    }
    # ⭐ THE PROVENANCE LINE, and why stderr. Everything below is local configuration wearing
    # the exact shape of a board read — {id, name} pairs from a verb named `stages` — and the
    # help text that says so is the one surface a consumer piping the JSON never opens. A seat
    # did exactly that and wrote a board-resolved sprint filter in these names, which are this
    # install's KB_STAGE_* variable suffixes and have no causal connection to the board's own
    # labels (rt#442). So the declaration goes where the output goes. It rides STDERR rather
    # than a third key on the row because stdout's contract is the join `list --column`/`show`
    # depend on — one {id, name} object and no other key — and widening it to carry a caveat
    # would break every consumer to warn the one that never reads. This is the same channel
    # `list` uses for the denominator its own stdout cannot carry.
    echo "kbcard: stages: these NAMES ARE LOCAL — each is a KB_STAGE_* variable's suffix, lowercased, over the KB_STAGE_* variables VISIBLE TO THIS PROCESS (this install's board env for board ${KB_BOARD_ID:-?}, plus any you exported in your own shell), not a board read (no request was issued). The board's own label for the same stage id may differ, and anything that RESOLVES against the board — a sprint filter, another tool's config — takes the BOARD's name, not this one." >&2
    # unique_by drops the duplicate rows a duplicated id produces (both resolve through
    # stage_name to the same name, so the pair is identical); sort_by(.name) is jq's codepoint
    # order, i.e. deterministic and locale-free — and NOT the board's column order, which
    # nothing readable here carries.
    printf '%s' "$rows" | jq -R -s \
        'split("\n") | map(select(length > 0) | split("\t") | {id: (.[0] | tonumber), name: .[1]})
         | unique_by(.id) | sort_by(.name)'
}

cmd_list() {
    local column="" type="" swimlane=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --column) kb_require_value "$1" "${2:-}" || return 2; column="$2"; shift 2 ;;
            --type) kb_require_value "$1" "${2:-}" || return 2; type="$2"; shift 2 ;;
            --swimlane) kb_require_value "$1" "${2:-}" || return 2; swimlane="$2"; shift 2 ;;
            *) echo "kbcard: unknown arg '$1'" >&2; return 2 ;;
        esac
    done
    # TaskSearch DSL doesn't expose workflow_stage_id / card_type_id / swimlane_id
    # directly — by design, not a bug. workflow_stage_id was explicitly declined per
    # sola-pm 2026-05-19 (client-side filtering deemed sufficient); card_type: is on
    # the DL-013 long-tail list. All three filters are client-side jq selects. A bad
    # --column/--swimlane exits 2 loudly under set -e (the resolver returns 2).
    local stage_filter type_filter swimlane_filter
    if [[ -n "$column" ]];   then stage_filter="$(stage_id "$column")"; fi
    if [[ -n "$type" ]];     then type_filter="$(native_type_id "$type")"; fi
    if [[ -n "$swimlane" ]]; then
        # The laneless refs must NOT reach swimlane_id() — it would reject `none` as an
        # undefined lane name (the read/write asymmetry this closes: the write side can
        # create a laneless card the read side could not query). The filter value is the
        # projection's own key for a laneless card, `(null | tostring)` — see
        # _kbc_list_project on why that is a string and not JSON null.
        if _kbc_swimlane_is_laneless_ref "$swimlane"; then
            swimlane_filter="null"
        else
            swimlane_filter="$(swimlane_id "$swimlane")"
        fi
    fi

    # Whole-board fetch (paginated, accumulate-via-STDIN, dedup) is the shared
    # fetch_board_cards primitive — reading only page 1 silently UNDERCOUNTS every
    # column once a board exceeds one page. EVERY non-zero paginator rc — a bare `||`,
    # so 1, 2, 3 and 4, all four measured reaching this arm — exits 1 rather than print
    # a truncated list, and the message names the rc and no cause, per the wording rule
    # at fetch_board_cards' header. This bin DOES set KB_FETCH_LOUD, so the paginator's
    # own line (which is the one that knows the cause) prints directly above.
    local cards frc
    cards="$(fetch_board_cards "$KB_API" "$KB_TOKEN" "$KB_BOARD_ID" "${BOARD_PAGE_CAP:-50}")" \
        || { frc=$?; echo "kbcard: board $KB_BOARD_ID did not return a complete card list (fetch rc=$frc)" >&2; exit 1; }
    local out
    out="$(printf '%s' "$cards" | _kbc_list_project \
        "${stage_filter:-}" "${type_filter:-}" "${type:+type:$type}" "${swimlane_filter:-}")"
    printf '%s\n' "$out"

    # Denominator, on stderr, and only when a filter actually narrowed something. A
    # filtered `[]` is indistinguishable from an empty board at the call site — the
    # caller sees the numerator and never the population it came out of, so a filter
    # that matched nothing for a WRONG reason reads exactly like a truthful empty
    # answer. Naming both numbers makes a suspicious 0-of-N legible where it happens.
    # stderr, so stdout stays the same bytes it always was (nothing parsing the array
    # is affected); the flags are echoed AS TYPED so a caller running several list
    # reads can tell the lines apart. Unfiltered there is nothing to say: the array's
    # own length IS the denominator, already on stdout.
    if [[ -n "$column" || -n "$type" || -n "$swimlane" ]]; then
        local flags="" matched total
        [[ -n "$column" ]]   && flags="$flags --column $column"
        [[ -n "$type" ]]     && flags="$flags --type $type"
        [[ -n "$swimlane" ]] && flags="$flags --swimlane $swimlane"
        matched="$(jq 'length' <<<"$out")"
        # `<<<`, never --argjson: a whole board is ~200KB, so passing it in argv trips
        # "Argument list too long" over MAX_ARG_STRLEN — execve fails and jq never runs,
        # which under set -e aborts a `list` that had already printed its cards. The
        # denominator would be missing exactly on the biggest boards, i.e. the ones it
        # matters most on. Same stdin rule the whole-board reads in this file follow.
        total="$(jq '(. // []) | length' <<<"$cards")"
        echo "kbcard: list$flags: $matched of $total board cards matched" >&2
    fi
}

cmd_link() {
    local from="" to="" relation=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --from) kb_require_value "$1" "${2:-}" || return 2; from="$2"; shift 2 ;;
            --to) kb_require_value "$1" "${2:-}" || return 2; to="$2"; shift 2 ;;
            --relation) kb_require_value "$1" "${2:-}" || return 2; relation="$2"; shift 2 ;;
            *) echo "kbcard: unknown arg '$1'" >&2; return 2 ;;
        esac
    done
    [[ -z "$from" || -z "$to" || -z "$relation" ]] && { echo "kbcard: --from --to --relation required" >&2; return 2; }
    local f t body
    f="$(resolve_task "$from")"
    t="$(resolve_task "$to")"
    body="$(jq -n --argjson from "$f" --argjson to "$t" --arg rel "$relation" '{from_task_id: $from, to_task_id: $to, relation_type: $rel}')"
    local resp link
    resp="$(kb_api POST "/task_links.json" "$body")" || return 1
    link="$(kb_parse_resp "$resp" '.data')"
    [[ -n "$link" ]] || _kbc_unverified link "$from→$to" || return $?

    # READ IT BACK ON THE CARD, through the same witness `unlink` re-reads both ends with —
    # this is the create half of that shape and it owes the same proof. The echo is the POST's
    # own answer; a link is only really there once the card that carries it says so.
    #
    # WHAT THE PREDICATE ESTABLISHES, exactly: a link from card $f to card $t with this
    # relation is on $f's list now. It does NOT establish that it is the row this POST created
    # — a duplicate link would match either way. "The link you asked for exists" is the claim
    # this verb makes and all it makes.
    #
    # ⚠ THAT NARROWNESS IS A DELIBERATE DEFERRAL, NOT A CONSTRAINT — written out because the
    # weaker predicate is easy to justify with a claim that is FALSE. The READ carries the link
    # id: every `linked_tasks` entry has `task_link_id`, stated in the unlink header above,
    # measured against live boards by card#8545, and it is the key `unlink` addresses its own
    # DELETE with. What is UNMEASURED is the OTHER half — nothing in this repo records the shape
    # of a LIVE `link` POST response, so whether the CREATE ECHO carries that id, and under which
    # key, is unknown here. The only echo the tree contains is `tests/kbcard-selftest.sh`'s
    # `LINK_BODY`, a fixture this repo wrote: evidence about the fixture, not about a server.
    # Matching on it would compare against a key nobody has
    # read off a real echo, and a key that turned out to be named differently would report HARD
    # FAILURE over a link that LANDED — a false claim in the direction that costs more than the
    # ambiguity accepted here.
    # REVISIT the moment a live `link` runs and its echo is captured: match `task_link_id`
    # against the echoed id, keeping this shape predicate as the fallback for an echo that
    # carries no id. That is a strictly narrower predicate and needs the measurement first.
    # Only the FROM end is re-read: the far card may live on a board this token cannot read,
    # and `unlink`'s own header records that a cross-board read is a policy refusal there —
    # making it one here would turn a landed cross-board link into a refusal.
    local w still
    w="$(_kbc_link_witness "$f" link)" || {
        _kbc_unverified link "$from→$to" "The POST answered 2xx and echoed a link; card $f could not be re-read, so whether the link is on it is UNMEASURED."
        return $?
    }
    still="$(jq -c --argjson t "$t" --arg rel "$relation" \
        'first(.links[] | select(.direction == "outgoing" and .id == $t and .relation_type == $rel)) // empty' <<<"$w")"
    if [[ -z "$still" ]]; then
        if [[ "$(jq -r '.truncated' <<<"$w")" == "true" ]]; then
            _kbc_unverified link "$from→$to" "Card $f reports its linked_tasks list TRUNCATED and no '$relation' link to card $t is in the part it returned, so the link's PRESENCE is UNMEASURED."
            return $?
        fi
        echo "kbcard: link $from→$to: HARD FAILURE — the POST answered 2xx and echoed a link, and card $f carries no '$relation' link to card $t on a re-read. The status is not the link; the read-back is." >&2
        return 1
    fi
    printf '%s\n' "$link"
}

# --- unlink: remove a task link, and PROVE it is gone -----------------------
# ⛔ THE DELETE HALF OF THIS SHAPE HAS NEVER BEEN EXERCISED FROM THIS REPO: that
# `DELETE /task_links/<id>.json` answers 204, and that the row actually goes, are the only parts
# still taken on the word of the seat this change was adopted from. No live `unlink` has ever run
# here, and every leg under this header drives a FIXTURE, so if that half is wrong the fixture is
# wrong with it and nothing would notice.
# THE READ HALF IS NO LONGER INHERITED — it was measured against live boards, read-only, with no
# link created and nothing written: the seven per-entry keys below, `id` being the OTHER task
# while `task_link_id` is the link (both ends of one link carry the SAME `task_link_id` and each
# names the other card as `id`), `direction` taking no third value and reading opposite on the
# two ends, `linked_tasks_truncated` typed boolean, `linked_tasks_count` shaped
# {outgoing, incoming} — and the cross-board case, one link spanning two boards read from both
# ends with each board's own token. card#8545 owns that sweep, its denominator and its date; cite
# it rather than restating a figure here, which would go stale on the next linked card. Re-derive
# by re-running the read, not by trusting this comment: `kbcard show` cards on the boards
# configured for the seat and compare the `linked_tasks` entries the two ends of each link carry.
# It is a measurement of the boards this install can read, not a promise about every server build.
# The residual DELETE half ships rather than waits because a wrong shape there is still fail-closed
# or loud: a renamed or differently-typed key matches no entry (rc 2, NO DELETE), a `direction`
# outside the two values below is rc 2, and the one branch that would delete the WRONG link — `id`
# and `task_link_id` swapped, the reading the sweep above found no instance of — would still find
# the entry present on the re-read and report HARD FAILURE at rc 1, so it costs one wrong DELETE on
# first use and says so rather than reading back clean.
# WHAT CLOSES THE REST, and it has to be run rather than argued: on a sandbox board running the same
# server build, link two throwaway cards and `unlink` one. The entry shape no longer needs capturing
# — what the run is for is the 204 and the link's absence on a re-read. card#8545 owns that run and
# its result.
# The shape is written out here because it is easy to get wrong in a way nothing would catch:
#   * GET /tasks/<id>.json carries `linked_tasks` on EVERY card read — an array of
#     {id, board_id, name, relation_type, direction, created_at, task_link_id} — alongside
#     `linked_tasks_count` ({outgoing, incoming}) and `linked_tasks_truncated` (a bool).
#   * ⚠ AN ENTRY'S `id` IS THE OTHER TASK, NOT THE LINK. The link id is `task_link_id`.
#     Reading `id` as the link id addresses a REAL link_id row that belongs to some other
#     pair of cards, so the wrong-target DELETE would 204 and read back as a success here.
#   * `direction` is THIS card's end of the link — "outgoing" means the card being read is
#     the from-task, "incoming" that it is the to-task. That is what lets either end be the
#     card the caller names, and it is what the reported from/to is derived from.
#   * DELETE /task_links/<task_link_id>.json answers 204 with an empty body. There is no
#     from/to/relation delete form and no per-link GET — the two absences the usage block
#     above turns into the caller's contract, which is why the flag shape and the failure
#     vocabulary are stated THERE and are not restated here.
# `linked_tasks_count` is deliberately NOT used as a second truncation oracle: it equalled
# the array length on every card probed, which is an observation and not a contract, and a
# second source that can disagree with the server's own flag would manufacture UNMEASURED
# verdicts of its own. The flag is the server's declaration and this verb reads only it.

# _kbc_link_witness <task-id> [verb]: the card's link surface as ONE object on stdout —
# {"links": [...], "truncated": <bool>}. Returns 1, with the diagnostic, when the card
# cannot be read or its 2xx carries no linked_tasks LIST. [verb] is the caller's own verb and
# names it in that diagnostic; it defaults to `unlink`, the three call sites that predate it.
#
# ONE OWNER FOR FOUR CALL SITES — `unlink`'s pre-witness and both post-witness ends, and
# `link`'s post-write read-back (card#8556) — because the question each asks is identical and
# the refusal each owes is identical: an end that could not be read is UNMEASURED, and neither
# verb may report a link's presence or absence it did not measure. Four copies of that would be
# four chances to soften one.
# The `select(type == "array")` is on the near side of any default, per the rule the tag
# read learned the hard way: `// []` yields its right-hand side for `false` as well as for
# null, so a `linked_tasks` of `false` would arrive here as an empty list and read as
# "no links", which is the shape that turns an unmeasured end into a green one.
_kbc_link_witness() {
    local task="$1" verb="${2:-unlink}" resp data out
    resp="$(kb_api GET "/tasks/$task.json")" || {
        echo "kbcard: $verb: card $task could not be read (see the status above) — its links are UNMEASURED" >&2
        return 1
    }
    data="$(kb_parse_resp "$resp" -c '.data | select(type == "object")')"
    [[ -n "$data" ]] || {
        echo "kbcard: $verb: the read of card $task returned success but no card could be read out of its body — its links are UNMEASURED (nothing was read)" >&2
        return 1
    }
    out="$(kb_parse_resp "$data" -c '{links: (.linked_tasks | select(type == "array")), truncated: (.linked_tasks_truncated == true)}')"
    [[ -n "$out" ]] || {
        echo "kbcard: $verb: card $task carries no linked_tasks LIST that could be read — its links are UNMEASURED (nothing was read)" >&2
        return 1
    }
    printf '%s\n' "$out"
}

cmd_unlink() {
    local link_id="" on_ref="" from_ref="" to_ref="" relation=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --link-id)  kb_require_value "$1" "${2:-}" || return 2; link_id="$2"; shift 2 ;;
            --on)       kb_require_value "$1" "${2:-}" || return 2; on_ref="$2"; shift 2 ;;
            --from)     kb_require_value "$1" "${2:-}" || return 2; from_ref="$2"; shift 2 ;;
            --to)       kb_require_value "$1" "${2:-}" || return 2; to_ref="$2"; shift 2 ;;
            --relation) kb_require_value "$1" "${2:-}" || return 2; relation="$2"; shift 2 ;;
            *) echo "kbcard: unknown arg '$1'" >&2; return 2 ;;
        esac
    done

    # The two forms are two ways to name ONE link, so mixing them is refused rather than
    # given a precedence: a precedence rule silently ignores half of what the caller typed,
    # and the half it ignores is the half they would have checked.
    local by_id="" by_rel=""
    [[ -n "$link_id$on_ref" ]] && by_id=1
    [[ -n "$from_ref$to_ref$relation" ]] && by_rel=1
    if [[ -n "$by_id" && -n "$by_rel" ]]; then
        echo "kbcard: unlink takes EITHER --link-id + --on OR --from + --to + --relation, never both — they are two ways to name one link, and mixing them leaves it ambiguous which one selects" >&2
        return 2
    fi
    if [[ -z "$by_id" && -z "$by_rel" ]]; then
        echo "kbcard: unlink requires --link-id <id> --on <id-or-ext>, or --from <task> --to <task> --relation <rel>" >&2
        return 2
    fi
    if [[ -n "$by_id" ]]; then
        # Two refusals, not one: the missing half is what the caller has to supply, and a
        # message naming the flag they DID pass sends them to re-read the wrong one.
        [[ -n "$link_id" ]] || {
            echo "kbcard: unlink --on names the card to read the link back on but not WHICH link — add --link-id <id>, or select by relation with --from/--to/--relation" >&2
            return 2
        }
        [[ -n "$on_ref" ]] || {
            echo "kbcard: unlink --link-id requires --on <id-or-ext> — the id names the link, and a card is the only surface a link can be READ BACK on (there is no per-link GET)" >&2
            return 2
        }
        # `||` short-circuits, so the arithmetic test is never reached for a value the
        # uint predicate already refused — an `-lt` on a non-numeric string is a fatal
        # bash error, not a false.
        if ! kb_is_uint "$link_id" || [[ "$link_id" -lt 1 ]]; then
            echo "kbcard: unlink: --link-id must be a positive integer, got '$link_id'" >&2
            return 2
        fi
    else
        [[ -n "$from_ref" && -n "$to_ref" && -n "$relation" ]] || {
            echo "kbcard: unlink --from/--to/--relation is ONE form — all three are required (or name the link directly with --link-id <id> --on <id-or-ext>)" >&2
            return 2
        }
    fi

    local witness_ref="${on_ref:-$from_ref}" witness w_json links trunc entry=""
    witness="$(resolve_task "$witness_ref")" || return 2
    w_json="$(_kbc_link_witness "$witness")" || return 1
    # Bare jq from here: $w_json came through the tolerant parse and a non-empty guard, and
    # its shape is this file's own, not the server's.
    links="$(jq -c '.links' <<<"$w_json")"
    trunc="$(jq -r '.truncated' <<<"$w_json")"

    if [[ -n "$by_id" ]]; then
        entry="$(jq -c --argjson id "$link_id" 'first(.[] | select(.task_link_id == $id)) // empty' <<<"$links")"
        [[ -n "$entry" ]] || {
            if [[ "$trunc" == "true" ]]; then
                echo "kbcard: unlink: card $witness reports its linked_tasks list TRUNCATED and link $link_id is not in the part it returned — whether that link is on this card is UNMEASURED, so NO DELETE was sent" >&2
            else
                echo "kbcard: unlink: link $link_id is not among card $witness's linked_tasks — NO DELETE was sent (this verb deletes only a link it has first read on the card you named)" >&2
            fi
            return 2
        }
    else
        # The convenience form. Its refusals cost no DELETE — but they are NOT free of
        # traffic, and cannot be: resolving a from/to/relation triple to an id means reading
        # the from-card, because the API offers no lookup that takes the triple.
        local to_id matches n
        to_id="$(resolve_task "$to_ref")" || return 2
        if [[ "$trunc" == "true" ]]; then
            echo "kbcard: unlink: card $witness reports its linked_tasks list TRUNCATED, so '$relation' → card $to_id cannot be resolved to EXACTLY ONE link from it — a second match may be in the part that was not returned. NO DELETE was sent; name the link directly with --link-id <id> --on $witness_ref" >&2
            return 2
        fi
        matches="$(jq -c --argjson to "$to_id" --arg rel "$relation" \
            '[.[] | select(.direction == "outgoing" and .id == $to and .relation_type == $rel)]' <<<"$links")"
        n="$(jq 'length' <<<"$matches")"
        if [[ "$n" -eq 0 ]]; then
            echo "kbcard: unlink: no '$relation' link from card $witness to card $to_id — NO DELETE was sent" >&2
            return 2
        fi
        if [[ "$n" -gt 1 ]]; then
            echo "kbcard: unlink: $n links match '$relation' from card $witness to card $to_id — refusing to pick one. NO DELETE was sent; name the one you mean with --link-id <id> --on $witness_ref. Their ids: $(jq -r '[.[].task_link_id] | join(", ")' <<<"$matches")" >&2
            return 2
        fi
        entry="$(jq -c '.[0]' <<<"$matches")"
        link_id="$(jq -r '.task_link_id' <<<"$entry")"
        # A boundary check, not a defensive one: this value came off the server and is about
        # to become a URL PATH. Unchecked, a missing key addresses /task_links/null.json.
        if ! kb_is_uint "$link_id" || [[ "$link_id" -lt 1 ]]; then
            echo "kbcard: unlink: the matching link on card $witness carries no usable task_link_id ('$link_id') — there is nothing to address a DELETE to, so none was sent" >&2
            return 2
        fi
    fi

    # Which end is which comes from the card's own `direction`, never from the flag the
    # caller used — --on takes either end, so inferring from the flag would print a reversed
    # relation for half the invocations. A third value is refused rather than defaulted: it
    # would make the reported from/to a guess, and this verb reports no guesses.
    local other rel_type direction from_id to_end
    other="$(jq -r '.id' <<<"$entry")"
    if ! kb_is_uint "$other" || [[ "$other" -lt 1 ]]; then
        echo "kbcard: unlink: link $link_id on card $witness names its other end as '$other', which is not a task id — that end could not be re-read, so NO DELETE was sent" >&2
        return 2
    fi
    rel_type="$(jq -r '.relation_type' <<<"$entry")"
    direction="$(jq -r '.direction' <<<"$entry")"
    case "$direction" in
        outgoing) from_id="$witness"; to_end="$other" ;;
        incoming) from_id="$other";   to_end="$witness" ;;
        *) echo "kbcard: unlink: link $link_id on card $witness declares direction '$direction', which is neither 'outgoing' nor 'incoming' — this tool cannot say which end is which, so NO DELETE was sent" >&2
           return 2 ;;
    esac

    # kb_api_status, not kb_api, for the reason `field retype`'s conversion call gives: the
    # statuses here are DIFFERENT OUTCOMES an operator acts on differently — a policy refusal
    # at either end, a link the server does not know, a request that never left — and kb_api
    # collapses every one of them to rc 1 with KB_HTTP stranded in a subshell.
    local del http errbody=""
    del="$(kb_api_status DELETE "/task_links/$link_id.json")"
    http="${del%%$'\n'*}"
    # The body only exists if the capture still HOLDS a newline: kb_api_status emits
    # "<status>\n<body>", and `$()` strips the trailing newline of an EMPTY body — so the
    # unguarded `${del#*\n}` yields the STATUS and would be quoted back as the server's
    # own message. A 204 and a policy 403 both routinely carry no body at all.
    [[ "$del" == *$'\n'* ]] && errbody="${del#*$'\n'}"
    case "$http" in
        2*) : ;;
        000) echo "kbcard: unlink: the DELETE of link $link_id DID NOT COMPLETE — no HTTP status came back at all, so whether the server received it is UNKNOWN. Re-read card $witness before retrying; nothing here claims an outcome in either direction." >&2
             return 1 ;;
        401|403) echo "kbcard: unlink: the server REFUSED the DELETE of link $link_id (HTTP $http — POLICY, not a transport or address problem). A link is deletable only while BOTH ends' boards are writable: a read-only or trashed board at either end refuses, which is the mirror of what refuses the create. The link is UNCHANGED." >&2
             [[ -n "$errbody" ]] && echo "kbcard:   server said: $errbody" >&2
             return 1 ;;
        404) echo "kbcard: unlink: the server does not know link $link_id (HTTP 404) although card $witness listed it on the read just above — nothing was deleted." >&2
             return 1 ;;
        *) echo "kbcard: unlink: the DELETE of link $link_id failed (HTTP $http). Whether anything was removed is UNKNOWN — re-read card $from_id and card $to_end before retrying." >&2
           [[ -n "$errbody" ]] && echo "kbcard:   server said: $errbody" >&2
           return 1 ;;
    esac

    # BOTH ENDS, ALWAYS, and neither short-circuits the other: a cross-board link projects
    # onto both boards, so a single-end read is half a measurement — and an end that cannot
    # be re-read is a result the caller needs BY NAME, not a reason to stop looking at the
    # other one. Presence is tested before truncation: a link still listed is a definite
    # failure whether or not the list was complete, while its absence from a truncated list
    # is not a measurement at all.
    local end end_json still fail=""
    for end in "$from_id" "$to_end"; do
        end_json="$(_kbc_link_witness "$end")" || {
            echo "kbcard: unlink: the DELETE of link $link_id answered HTTP $http, but card $end could not be re-read — the removal is UNVERIFIED at that end." >&2
            fail=1
            continue
        }
        still="$(jq -c --argjson id "$link_id" 'first(.links[] | select(.task_link_id == $id)) // empty' <<<"$end_json")"
        if [[ -n "$still" ]]; then
            echo "kbcard: unlink: HARD FAILURE — the server answered HTTP $http to the DELETE of link $link_id and the link is STILL on card $end. The status is not the removal; the read-back is. Evidence, that card's own linked_tasks entry: $still" >&2
            fail=1
            continue
        fi
        if [[ "$(jq -r '.truncated' <<<"$end_json")" == "true" ]]; then
            echo "kbcard: unlink: the DELETE of link $link_id answered HTTP $http, but card $end reports its linked_tasks list TRUNCATED — the ABSENCE of link $link_id there is UNMEASURED, which is not a success." >&2
            fail=1
        fi
    done
    if [[ -n "$fail" ]]; then
        return 1
    fi

    # relation_type is projected off the ENTRY rather than routed through $rel_type, which is a
    # `jq -r` and therefore renders an ABSENT key as the four-character string "null". This
    # object is advertised as machine-readable in the spelling `link` POSTs, and a consumer
    # round-tripping that string back through `kbcard link --relation` would mint a relation
    # literally NAMED null. Projected, an absent key is JSON `null` — a value a reader can test
    # for. $rel_type stays what the human line below interpolates; that one is prose.
    local removed
    removed="$(jq -c --argjson id "$link_id" --argjson f "$from_id" --argjson t "$to_end" \
        '{task_link_id: $id, from_task_id: $f, to_task_id: $t, relation_type: .relation_type}' <<<"$entry")"
    printf '%s\n' "$removed"
    echo "kbcard: unlink: link $link_id ($from_id --$rel_type--> $to_end) is GONE — re-read on BOTH ends after the DELETE and absent from each" >&2
}

# --- the write-outcome contract: APPLIED / NOT APPLIED / UNVERIFIED --------
# The class this section owns: a mutating verb that reports success it never READ BACK. The
# verb issues its write, the status class says 2xx, and it prints a success built out of what
# it SENT — so a mutation the server did not apply reaches the caller as applied. `unlink` is
# the shape that does not do that (it re-reads BOTH ends after the DELETE and refuses to call
# a removal it did not measure a removal), and this section is that shape hoisted so the other
# verbs stop hand-rolling three quarters of it.
#
# KBC_RC_UNVERIFIED — the THIRD outcome, and it is a THIRD because the two that existed
# cannot carry it. A caller scripting this tool has to tell "the server now holds what I asked
# for" from "the request went out and nobody here can say what happened", and neither rc 0 nor
# rc 1 is that: rc 0 asserts the mutation, rc 1 asserts its absence, and an unverified write
# asserts NEITHER. Spelled as an EXIT CODE rather than a word in a message because the
# distinction has to survive `2>/dev/null` and has to be readable without parsing prose — the
# same argument kb_api's rc contract makes for its own transport rc.
#   rc 0  APPLIED     — a read of what the server now holds agrees with what was asked.
#   rc 1  NOT APPLIED — KNOWN: the request was refused, or the read-back is a measurement and
#                       it says the mutation did not take (the HARD FAILURE arm).
#   rc 2  bad invocation — nothing was sent.
#   rc 3  UNVERIFIED  — the request WAS SENT and its outcome could not be read. Nothing here
#                       says it landed and nothing says it did not; re-read before acting on
#                       either reading. This is NOT a widening of rc 1: every state that used
#                       to be rc 1 and IS still known stays rc 1.
#
# ⛔ THE VALUE IS THE LIB'S, NOT A SECOND CONSTANT (card#10029). `_kb-board-lib.sh` defines
# `KB_RC_UNVERIFIED` for the read-back primitive it now owns (`kb_confirm_card`, hoisted out of
# this file), and this name is kbcard's published EXIT CODE for that same outcome — so it takes
# the lib's value rather than re-spelling `3` where nothing compares the two. This file sources
# the lib, so it has nothing to pin. ⚠ A STANDALONE COPY OF THIS RC IS WHAT NEEDS PINNING, and
# this comment cannot tell you whether one exists — the set moves with every bin that lands, and
# nothing reds when it does. RE-DERIVE it instead of reading a verdict here: run
# `command grep -l UNVERIFIED bin/*` and open each file it names; any one that does not
# `source "$KB_LIB"` — and is not `bin/_kb-board-lib.sh`, which IS the lib and DEFINES the value —
# carries its own copy of this rc and needs a parity row in
# `tests/mirror-pair-parity-selftest.sh`. Nothing holds such a copy level on its own.
KBC_RC_UNVERIFIED="$KB_RC_UNVERIFIED"

# _kbc_unverified <verb> <subject> [detail]: the ONE owner of the unverified-write report.
# Every "the write returned success but nothing could be read back" arm in this file routes
# through it, so the vocabulary and the rc are decided once. Seven hand-written copies of this
# sentence is what let one of them drift into a plausible-looking success in the first place.
# Always returns $KBC_RC_UNVERIFIED, and the caller propagates it — an arm that swallowed it
# into rc 1 would be re-asserting the very thing the arm exists to refuse to assert.
_kbc_unverified() {
    local verb="$1" subject="$2" detail="${3:-}"
    echo "kbcard: $verb $subject: the write was SENT and its outcome could NOT be read back — UNVERIFIED WRITE (rc $KBC_RC_UNVERIFIED). Nothing here says it landed and nothing says it did not; re-read before acting.${detail:+ $detail}" >&2
    return "$KBC_RC_UNVERIFIED"
}

# The card read-back — kb_card_witness (the post-write state as ONE object) and kb_confirm_card
# (read + rule on a jq predicate, saying nothing) — lives in the shared lib, hoisted there when
# board-card-start became its second caller (card#10029). Its contract, including why
# `?trashed=1` is load-bearing and why an unrunnable predicate is rc 3 and never rc 1, is
# documented there.

# The tolerant response parse is kb_parse_resp, in the shared lib — its contract (and why a
# caller's diagnostic may never say "the body is not JSON") is documented there. It moved out of
# this file in card#6426: the same 2xx reaches every tool that reads through kb_api, so one owner
# serves them all. It is applied at the FIRST projection off a response body, not at every jq in
# this file: a value that has already come through it (or through a guard that refuses on empty)
# is parsed bare afterwards on purpose. Three places below are neither — `_kbc_archive_decision`'s
# board array and `_kbc_field_populated`'s census, both of which read the PAGINATOR's output
# rather than a kb_api body (so the unguarded read they descend from is one level up, where
# card#6594 closed it at page 1), and the `field` verbs' reads off `_kbc_fetch_fields`, whose
# non-empty guard admits a `.data` that is not a list. All three are recorded in
# docs/CONSOLIDATION-PLAN.md with their blockers; none is silence.

# _kbc_write_echo <verb> <subject> <response> [extra-fields]: the create/patch echo projection —
# payload rides ONLY when the serializer sent the key (fabricating `payload: null` asserts "no
# payload" where the truth is "key absent", #4390); a server-sent null passes through unaltered.
# <extra-fields> is extra jq object fields (e.g. description truncation), defaults to none.
# [cleared-keys] is a JSON array of payload keys this call CLEARED (patch --clear). Those keys ride
# RAW under `payload` even when the server's echo omits them: the board REMOVES a cleared key
# rather than storing a null, so absence is what a landed clear looks like, and rendering it as
# `null` for the keys the caller named is what lets them SEE the clear (a key still held shows its
# value). It is scoped to those keys, so #4390's rule stands for every other payload read.
#
# IT OWNS ITS OWN REFUSAL, and that is why it takes the response rather than reading stdin. Both
# write verbs project the echo through this one filter, so both meet an unreadable 2xx here —
# and a refusal written at each call site would be the same four lines twice, i.e. the shape
# card#6426 exists to stop. <verb> and <subject> are what a shared owner cannot know: the
# diagnostic still names the verb the caller typed. Returns 1 with that diagnostic and no
# stdout; the caller propagates it (rc 1 is what a failed write already returns there).
_kbc_write_echo() {
    local verb="$1" subject="$2" resp="$3" extra="${4:-}" expect_stage="${5:-}" cleared="${6:-[]}" out
    out="$(kb_parse_resp "$resp" --argjson cleared "$cleared" ".data | {id, name, workflow_stage_id${extra:+, $extra}} + (if (\$cleared | length) > 0 then {payload: (reduce \$cleared[] as \$k ((.payload // {}); .[\$k] = .[\$k]))} elif has(\"payload\") then {payload} else {} end)")"
    [[ -n "$out" ]] || _kbc_unverified "$verb" "$subject" || return $?
    _kbc_confirm_stage "$verb" "$subject" "$out" "$expect_stage" || return 1
    printf '%s\n' "$out"
}

# _kbc_confirm_stage <verb> <subject> <echo-json> <expected-stage>: the echo's own
# workflow_stage_id against the stage this call ASKED for. A no-op when <expected-stage> is
# empty — a call that named no column is making no claim about one.
#
# WHAT THIS IS AND IS NOT, because the difference decides how far it can be trusted. The echo
# is the server's post-write TaskResource, not what this tool sent — `update` returns the model
# the mutator persisted and the `_action` path returns `$task->fresh()` — so it IS a statement
# about what the server now holds. What was missing at these three sites was never the read; it
# was the COMPARISON. It is still not an independent second request: a server that echoed a
# transaction it then failed to commit would satisfy this and not satisfy a re-read. That
# residual is stated rather than closed, because closing it costs a GET on every create, patch
# and move — a cost decision, not this file's to take unasked.
#
# ONLY workflow_stage_id is compared, and the narrowness is deliberate rather than partial
# work: the stage is an INTEGER this file resolved itself and the server stores verbatim, so a
# disagreement is a real disagreement. name / tags / external_id / payload are echoed through
# the server's own normalization (a decorated --pr rides as a string, --dl is canonicalized, the
# tag list is replaced wholesale) and comparing them byte-wise would manufacture a HARD FAILURE
# on a write that landed exactly as asked — which is a false claim in the other direction, and
# a worse one. Widening this needs those round-trips MEASURED first; card#8556 records it.
_kbc_confirm_stage() {
    local verb="$1" subject="$2" out="$3" expect="${4:-}" got
    [[ -n "$expect" ]] || return 0
    got="$(jq -r '.workflow_stage_id // "null"' <<<"$out")"
    [[ "$got" == "$expect" ]] && return 0
    echo "kbcard: $verb $subject: HARD FAILURE — the write answered 2xx and the card the server echoed back is in stage $got, not the stage $expect this call asked for. The status is not the move; the read-back is." >&2
    return 1
}

# _kbc_annotate_card <task-json>: the task with `stage` populated from
# workflow_stage_id (parity with cmd_list's stage field) and `column` set to the
# board's column name for that stage (stage_name reverse lookup). A field this
# tool cannot populate is OMITTED, never null — an emitted `"stage": null` on a
# card that IS in a stage reads as "no stage" and caused a false "auto-move is
# broken" escalation (card #4387). Deleting also scrubs a serializer-provided
# null stage/column, so the rule holds regardless of the API's response shape.
_kbc_annotate_card() {
    local data="$1" sid col="" uid seat=""
    sid="$(printf '%s' "$data" | jq -r '.workflow_stage_id // empty')"
    if [[ -n "$sid" ]]; then
        col="$(stage_name "$sid" || true)"
    fi
    # `assignee` follows the SAME omit-don't-null rule, for the same reason: an emitted
    # "assignee": null on a card that IS assigned reads as "nobody is working this", which is
    # the claim this whole field exists to make readable. The raw assigned_user_id is on the
    # card either way, so an id this board env does not map costs a NAME, not an answer.
    uid="$(printf '%s' "$data" | jq -r '.assigned_user_id // empty')"
    if [[ -n "$uid" ]]; then
        seat="$(_kbc_user_name "$uid" || true)"
    fi
    printf '%s' "$data" | jq --arg col "$col" --arg seat "$seat" '
        (if .workflow_stage_id != null then .stage = .workflow_stage_id else del(.stage) end)
        | (if $col != "" then .column = $col else del(.column) end)
        | (if $seat != "" then .assignee = $seat else del(.assignee) end)'
}

cmd_show() {
    local task_ref=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --task) kb_require_value "$1" "${2:-}" || return 2; task_ref="$2"; shift 2 ;;
            *) echo "kbcard: unknown arg '$1'" >&2; return 2 ;;
        esac
    done
    local task resp data
    task="$(resolve_task "$task_ref")"
    resp="$(kb_api GET "/tasks/$task.json")" || return 1
    data="$(kb_parse_resp "$resp" '.data')"
    [[ -n "$data" ]] || {
        echo "kbcard: show on task $task: the read returned success but no card could be read out of its body — nothing was read" >&2
        return 1
    }
    _kbc_annotate_card "$data"
}

# --- comment verbs: the card audit trail ------------------------------------
# MEASURED semantics, on the sandbox instance (board 1162), because each one shapes the code:
#   * POST /tasks/<id>/comments.json takes the comment object FLAT — {"content": "…"} — and
#     201s echoing the created row (id, task_id, user_id, content, created_at, updated_at).
#     The wrapped {"comment":{"content":…}} form is 422 "The content field is required", so
#     the flat shape here is a measurement rather than a guess.
#   * The write is verified from the echoed id, NEVER from a card timestamp. Whether a comment
#     moves the card's updated_at is the kanban API contract's to state
#     (docs/api-stability-contract.md there, DL-269), not this file's; the verification below
#     reads neither answer — hence the loud refusal on a success carrying no id.
#   * There is no comment READ route: GET on the same path is 405 (POST only). The task
#     detail GET already carries the whole `comments` array, so `comments` projects that.
#     user_id is the only author field a row carries — there is no name to print.
#   * That array is COMPLETE and ORDERED, which is what makes projecting it a legitimate
#     audit-trail read rather than a first-page one: 60 comments posted to one card came back
#     as 60 rows, created_at ascending, first == probe-01 and last == probe-60, the returned
#     content set equal to the posted set (no gap, no duplicate). Corroborated in the server's
#     own source — Task::comments() is hasMany ordered by created_at with no limit, eager-loaded
#     whole by fullTaskResource — so the detail GET carries the relation, not a page of it. The
#     probe bounds what was OBSERVED (no cap and no re-ordering at 60); the source read is the
#     argument that there is no cap at any N.
#   * DELETE on a comment is a SOFT delete — it 200s echoing the row with deleted_at STAMPED,
#     so the row is still live — and the task detail's array then EXCLUDES it rather than
#     carrying it with that timestamp. So deleted_at is null on every row this read can
#     return, and rendering it would be rendering a state this surface cannot observe.
# And the trap none of this may fall into: the UN-suffixed path /tasks/<id>/comments 404s
# with a well-formed JSON body ({message, exception, file, line, trace}) that any "did the
# body parse?" test reads as SUCCESS — it carries no .data, so the failure degrades to a
# silent empty-id success rather than a crash. Success is therefore decided by kb_api on the
# HTTP STATUS CLASS alone; nothing below infers it from the response body's shape.

cmd_comment() {
    local task_ref="" content="" content_file=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --task) kb_require_value "$1" "${2:-}" || return 2; task_ref="$2"; shift 2 ;;
            --content) kb_require_value "$1" "${2:-}" || return 2; content="$2"; shift 2 ;;
            --content-file) kb_require_value "$1" "${2:-}" || return 2; content_file="$2"; shift 2 ;;
            *) echo "kbcard: unknown arg '$1'" >&2; return 2 ;;
        esac
    done
    [[ -z "$task_ref" ]] && { echo "kbcard: --task required" >&2; return 2; }
    # Text FIRST, before resolve_task: an ambiguous, absent or unreadable source must cost no
    # request at all — the same offline-first rule cmd_patch follows for its typo'd flags.
    local text=""
    _kbc_text_arg text content comment "$content" "$content_file" || return 2

    local task body resp cid
    task="$(resolve_task "$task_ref")" || return 1
    body="$(jq -nc --arg c "$text" '{content: $c}')"
    resp="$(kb_api POST "/tasks/$task/comments.json" "$body")" || return 1
    # kb_api has already decided success on the status class (and printed the status + error
    # body on a failure). What is left is the WRITE VERIFICATION, and the echoed id is the only
    # confirmation this verb reads (never a card timestamp), so a success carrying no echoed
    # id leaves the write unconfirmed — say so, rather than print a `null` that reads exactly
    # like an id.
    # A 2xx whose body is not JSON at all (a proxy's HTML, a truncated read) fails the parse;
    # that is the SAME "success with no confirmed id" state as a JSON body with no id, so
    # kb_parse_resp lets it fall into the arm below rather than dying at jq's raw parse error.
    cid="$(kb_parse_resp "$resp" -r '.data.id // empty')"
    [[ -n "$cid" ]] || _kbc_unverified comment "on task $task" "No comment id was echoed, and the echoed id is the only confirmation this verb reads." || return $?

    # READ IT BACK ON THE CARD. The echoed id is the POST's own answer; the card's `comments`
    # array is the audit trail a reader actually sees, and it is the ONLY read surface a comment
    # has (`GET` on the comments path is 405, POST-only — card#6051's measurement, which is also
    # why `kbcard comments` projects this same array). It is complete rather than a first page
    # (60 posted, 60 returned, ascending, no cap in the server's own hasMany), so a posted id
    # missing from it is a real absence and not a paging artifact. A soft-deleted comment is
    # excluded from the array — a comment deleted between the POST and this read therefore reads
    # as an absence, which is the honest answer: it is not there.
    if ! kb_is_uint "$cid"; then
        _kbc_unverified comment "on task $task" "The write echoed a comment id of '$cid', which is not an id this tool can look for on the card, so the comment's presence is UNMEASURED."
        return $?
    fi
    local crc=0
    kb_confirm_card "$task" "([.card.comments[]? | select((.id|tostring) == \"$cid\")] | length) > 0" >/dev/null || crc=$?
    if [[ "$crc" -eq "$KBC_RC_UNVERIFIED" ]]; then
        _kbc_unverified comment "on task $task" "The POST answered 2xx and echoed comment id $cid; the confirming read produced no measurement (its cause is on the line above), so whether the comment is on it is UNMEASURED."
        return $?
    fi
    if [[ "$crc" -ne 0 ]]; then
        echo "kbcard: comment on task $task: HARD FAILURE — the POST answered 2xx and echoed comment id $cid, and that comment is not in card $task's comments on a re-read. The status is not the comment; the read-back is." >&2
        return 1
    fi
    printf '%s\n' "$cid"
}

# The C0 sanitizer the untrusted-text renderers share, as a jq prelude concatenated onto each
# program. TWO filters, because a renderer's two halves are not equally forgeable:
#   c0_safe   — every C0 control but LF and TAB becomes `?`. For CONTENT that a renderer prints
#               INDENTED: the newline is exempt because it is the structure the renderer reads
#               (it drives the indent-every-line split), and the tab because it cannot move the
#               cursor BACKWARD — it only advances to the next tab stop — while replacing it
#               damages every pasted diff, log line or indented block the text carries.
#   c0_header — every C0 control becomes `?`, LF and TAB included. For a HEADER line assembled
#               from response fields: nothing there is structure, so an unindented newline mints
#               a whole extra block, i.e. a FORGED attribution, which is what indented content
#               can never do. Applied to the ASSEMBLED line rather than per field, because ids
#               arrive as numbers and `explode` on a number is a jq error.
# The hazard both exist for: an embedded ESC is a terminal command, and `ESC[2K ESC[1A` erases
# the line above the text — i.e. the rendered text can rewrite the part of the output that says
# which card or comment it came from.
# Done by CODEPOINT rather than a `gsub` character class, because the obvious spelling of that
# class is silently wrong here: jq hands the pattern to Oniguruma, which does NOT read `\uXXXX`
# (jq-1.7 measured), so `gsub("[\\u0000-\\u001f]"; …)` degenerates into a class over the
# literal characters and replaces ordinary printable text while leaving the ESC untouched —
# a sanitizer that damages the safe input and passes the dangerous one.
_KBC_C0_DEFS='
      def c0_safe: explode | map(if . < 32 and . != 10 and . != 9 then 63 else . end) | implode;
      def c0_header: explode | map(if . < 32 then 63 else . end) | implode;'

# _kbc_comments_render: the projection for a comments ARRAY on STDIN — one block per comment,
# a header line then the content indented two spaces on EVERY line (content is stored
# verbatim, multi-line included, and an unindented second line would read as a new comment).
# Extracted from cmd_comments so it is unit-testable on synthetic comments.
#
# Content is UNTRUSTED text going straight to a terminal, so every C0 control but the newline
# and the tab is replaced with `?` before it is printed: an embedded ESC is a terminal command,
# and `ESC[2K ESC[1A` erases the attribution header line above it — i.e. the rendered content
# can rewrite the part of the output that says who wrote it. The newline is exempt because it is
# the structure this renderer reads (it drives the indent-every-line split). The TAB is exempt
# because it cannot move the cursor BACKWARD — it only advances to the next tab stop, so it
# cannot reach the attribution line this filter exists to protect — while replacing it damages
# every pasted diff, log line or indented block a comment carries.
#
# THE HEADER FIELDS ARE THE SAME UNTRUSTED BODY and are sanitized too — id, user_id and
# created_at all come from the response, so leaving them raw would leave the whole hole open one
# line up from the content that is filtered. Their filter is STRICTER, and the difference is the
# point: c0_safe exempts the newline because it is content STRUCTURE, and content can never forge
# a header because every one of its lines is indented. Nothing in a header field is structure —
# an unindented newline there mints a whole extra `comment N · user M · t` block, i.e. a forged
# attribution, which is the very thing this filter exists to prevent. So the header replaces
# every C0 control, newline and tab included. Applied to the ASSEMBLED line rather than per
# field because id/user_id arrive as numbers and `explode` on a number is a jq error.
#
_kbc_comments_render() {
    jq -r "$_KBC_C0_DEFS"'
      .[] | (("comment \(.id // "?") · user \(.user_id // "?") · \(.created_at // "?")" | c0_header),
             (((.content // "") | c0_safe | split("\n"))[] | "  " + .))'
}

cmd_comments() {
    local task_ref=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --task) kb_require_value "$1" "${2:-}" || return 2; task_ref="$2"; shift 2 ;;
            *) echo "kbcard: unknown arg '$1'" >&2; return 2 ;;
        esac
    done
    [[ -z "$task_ref" ]] && { echo "kbcard: --task required" >&2; return 2; }
    local task resp comments n
    task="$(resolve_task "$task_ref")" || return 1
    # The task detail IS the read surface — there is no comment read route to call.
    resp="$(kb_api GET "/tasks/$task.json")" || return 1
    # A 2xx body no comment list can be read out of — unparseable, or parseable but not a card
    # (a proxy's HTML, a truncated read, a 200 `[]`) — is NOT an empty comment list: the
    # `no comments` line below is a statement about the card, and printing it here would answer a
    # question this read never reached — the same silent-empty trap the 404's parseable body sets
    # one layer up.
    # THE SHAPE THE RENDERER NEEDS, tested here rather than discovered mid-render. `.data.comments`
    # is whatever the body carried, and the renderer dies at jq's rc 5 on two of those shapes —
    # a non-ARRAY (`.[]` is "Cannot iterate over …") and a row whose content is not a string
    # (`explode` is "explode input must be a string"), the second of them PART WAY THROUGH the
    # output, so the caller gets a truncated audit trail, no attributable diagnostic, and an rc
    # from a program it never ran. Neither is an empty comment list, so both belong in the arm
    # below. The row test also requires each row to be an OBJECT: the header line indexes .id /
    # .user_id / .created_at, which is the same jq error one line earlier.
    # SCOPE, deliberately: this tests the COMMENTS value, not `.data` itself — a 2xx that is
    # valid JSON but carries no `.data` still yields `[]` here and still reads as "no comments"
    # (card#6426 §b, an accepted-input question that is not this change's to answer).
    #
    # AND THE `select(type == "array")` BELOW SITS ON THE FAR SIDE OF `//`, so it never sees a
    # `comments` of `false`. jq's `//` yields its right-hand side for `false` exactly as it does
    # for `null`, so `(.data.comments // [])` substitutes `[]` before the container test runs and
    # `{"data":{"id":505,"comments":false}}` prints "card 505 has no comments" at rc 0 — measured
    # — which is precisely the claim the paragraph above forbids. KNOWN AND DELIBERATELY OPEN:
    # the remedy is the one `_kbc_patch_tags` already carries (decide absent-or-null explicitly
    # with `has("comments") and .comments != null`, so `false` reaches the container test as
    # itself), but applying it moves a READ verb from rc 0 to rc 1, which changes what this verb
    # ACCEPTS and was not granted. Filed as the class in docs/CONSOLIDATION-PLAN.md — "a shape
    # test applied downstream of `//` does not see `false`" — instance 2 of 2.
    comments="$(kb_parse_resp "$resp" -c '
        (.data.comments // [])
        | select(type == "array")
        | select(all(.[]; type == "object" and ((.content // "") | type == "string")))')"
    [[ -n "$comments" ]] || {
        echo "kbcard: comments on task $task: the read returned success but no comment list could be read out of its body — nothing was read (this is NOT an empty comment list)" >&2
        return 1
    }
    n="$(jq 'length' <<<"$comments")"
    if [[ "$n" -eq 0 ]]; then
        # Explicit, never a bare empty stdout: "this card has no comments" and "the read
        # failed" must not look the same at the call site.
        echo "kbcard: card $task has no comments"
        return 0
    fi
    printf '%s' "$comments" | _kbc_comments_render
}

# _KBC_SEARCH_HEADER: the jq expression for a hit's HEADER LINE, and the ONE owner of it. Both
# render forms below interpolate this same string, which is what makes `--brief`'s output the
# same BYTES as the block form's first line rather than a second rendering that agrees today —
# the promise the flag makes to a caller is that nothing downstream needs a new parser, and a
# promise about bytes cannot be kept by two expressions kept in step by hand (canon #5).
_KBC_SEARCH_HEADER='("card \(.id // "?") · stage \(.workflow_stage_id // "?") · \(.name // "" | tostring)" | c0_header)'

# _kbc_search_render [--brief]: the projection for a matched-card ARRAY on STDIN — one block per
# hit, a header line then the card's FULL description indented two spaces on EVERY line, or with
# --brief the header lines alone. Extracted from cmd_search so it is unit-testable on synthetic
# cards.
#
# PRINTING THE DESCRIPTION IS THE POINT OF THE VERB (card#6771). `list`'s row projection drops
# it, so a grep for a phrase in a card BODY through that projection answers 0 whatever the board
# holds — and a search result that hid the field it had matched ON would reproduce that same miss
# one layer over. The indent-every-line rule is the comment renderer's, applied to the field this
# verb exists to show: without it a multi-line description reads as several hits.
# A card whose description is empty or absent SAYS SO IN WORDS, because an empty indented block
# reads as a rendering fault — "matched on the name, the body is empty" and "the description got
# dropped again" must not look the same. (A card whose body is literally the text `(no
# description)` is indistinguishable from one with no body here. Accepted: the alternative is a
# sentinel no card body could contain, and there is none.)
# TOTAL BY CONSTRUCTION rather than gated by a shape test ahead of it: every value printed goes
# through `(… // "") | tostring`, so a name or description that is not a string renders as its
# JSON text instead of dying at jq's rc 5 PART WAY THROUGH the blocks — the shape that hands a
# caller a truncated result at an exit status from a program it never ran.
#
# --brief DROPS THE BODIES AND NOTHING ELSE — same hits, same order, same header bytes. The C0
# sanitizer still applies to the header under its stricter arm, because a NEWLINE in a card name
# forges a second `card N · …` line here exactly as it would there, and this form is the one a
# consumer is most likely to count lines of.
_kbc_search_render() {
    if [[ "${1:-}" == "--brief" ]]; then
        jq -r "$_KBC_C0_DEFS"'
      .[] | '"$_KBC_SEARCH_HEADER"
        return
    fi
    jq -r "$_KBC_C0_DEFS"'
      .[] | ((.description // "" | tostring) as $d
             | '"$_KBC_SEARCH_HEADER"',
               (if $d == "" then "  (no description)"
                else (($d | c0_safe | split("\n"))[] | "  " + .) end))'
}

cmd_search() {
    local query="" column="" type="" brief=0 count=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --column) kb_require_value "$1" "${2:-}" || return 2; column="$2"; shift 2 ;;
            --type) kb_require_value "$1" "${2:-}" || return 2; type="$2"; shift 2 ;;
            --brief) brief=1; shift ;;
            --count) count=1; shift ;;
            -*) echo "kbcard: unknown arg '$1'" >&2; return 2 ;;
            *) kb_require_positional "$query" "$1" "<query>" || return 2; query="$1"; shift ;;
        esac
    done
    # Refused, never silently resolved in the caller's stead: --count is not a narrower --brief
    # (one asks which cards matched, the other how many), so picking a winner would answer a
    # question nobody asked — the silent-narrowing shape both flags exist to avoid. Offline, so
    # a bad invocation costs no request.
    [[ "$brief" -eq 1 && "$count" -eq 1 ]] && {
        echo "kbcard: search --brief and --count are different reads (header lines vs one number) — pass one, not both" >&2
        return 2
    }
    [[ -n "$query" ]] || {
        echo "kbcard: search requires a query — kbcard search \"text\" [--column COL] [--type ALIAS] [--brief|--count]" >&2
        return 2
    }
    # A term with no non-space character does not narrow anything: the server trims the q value,
    # finds no token in it, and answers the WHOLE BOARD — which this verb would then print as
    # matches, every description included. Refused here and not in the paginator, which cannot
    # know whether its caller meant to read a board or to search one. Costs no request.
    if kb_is_blank "$query"; then
        echo "kbcard: search query holds no text — a blank query matches every card on the board, which is not a search" >&2
        return 2
    fi
    # The same two client-side filters `list` offers, resolved by the same owners (a bad
    # --column/--type exits 2 loudly under set -e). They narrow the SERVER's match set; the
    # query itself is the server's job and is passed through untouched.
    local stage_filter type_filter
    if [[ -n "$column" ]]; then stage_filter="$(stage_id "$column")"; fi
    if [[ -n "$type" ]];   then type_filter="$(native_type_id "$type")"; fi

    # The match set, read through the SAME paginator `list` uses — with the query as its search
    # term, which is the only difference between the two reads. EVERY non-zero rc it defines is
    # a refusal (a bare `||`), because a search answer that is missing whatever was on the page
    # that failed is indistinguishable from one where those cards do not exist: the reader would
    # take "not in the output" as "not on the board". The message names the rc and no cause, per
    # the wording rule at fetch_board_cards' header; this bin sets KB_FETCH_LOUD, so the
    # paginator's own line — the one that knows the cause — prints directly above it.
    local cards frc
    cards="$(fetch_board_cards "$KB_API" "$KB_TOKEN" "$KB_BOARD_ID" "${BOARD_PAGE_CAP:-50}" "$query")" \
        || { frc=$?; echo "kbcard: board $KB_BOARD_ID did not return a complete card list for this search (fetch rc=$frc) — refusing to present a partial match set as a whole one" >&2; exit 1; }
    local hits matched total
    hits="$(printf '%s' "$cards" | _kbc_card_filter "${stage_filter:-}" "${type_filter:-}" "${type:+type:$type}" "")"
    matched="$(jq 'length' <<<"$hits")"
    # `<<<`, never --argjson: a match set can be a whole board, and passing it in argv trips
    # "Argument list too long" over MAX_ARG_STRLEN. Same stdin rule as the reads above.
    total="$(jq '(. // []) | length' <<<"$cards")"
    # The flags echoed on the denominator line are the ones that narrowed the MATCH SET, so
    # --brief/--count are deliberately absent from it: they change what is printed about a hit,
    # never which cards are hits, and echoing them would move bytes an existing caller reads.
    local flags=""
    [[ -n "$column" ]] && flags="$flags --column $column"
    [[ -n "$type" ]]   && flags="$flags --type $type"
    local denom="kbcard: search$flags: $matched of $total cards matched by the query"
    if [[ "$count" -eq 1 ]]; then
        # The count IS the requested output, so it goes to STDOUT — in the denominator's own
        # words, from the denominator's own string, so the two can never quote different
        # numbers. It replaces the zero-result prose below rather than adding to it: `0 of 0`
        # and `0 of N` already separate a query that matched nothing from a filter that removed
        # everything, which is the distinction that prose exists to make.
        printf '%s\n' "$denom"
    elif [[ "$matched" -eq 0 ]]; then
        # Explicit, never a bare empty stdout: "nothing matched" and "the read failed" must not
        # look the same at the call site. The two zero cases are DIFFERENT answers — a query
        # that matched nothing, and a query that matched cards the filter flags then removed —
        # and reporting the first for the second would send a caller hunting the wrong thing.
        if [[ "$total" -eq 0 ]]; then
            echo "kbcard: no card on board $KB_BOARD_ID matched this search"
        else
            echo "kbcard: the query matched $total card(s) on board $KB_BOARD_ID, none of which passed the filter flags"
        fi
    elif [[ "$brief" -eq 1 ]]; then
        printf '%s' "$hits" | _kbc_search_render --brief
    else
        printf '%s' "$hits" | _kbc_search_render
    fi
    # The denominator, on stderr, on the same rule `list` follows: a filtered result hides the
    # population it came out of. Unfiltered there is nothing to add — the query's match count IS
    # what was printed, one block each. Unchanged by the two projection flags, --count included:
    # a caller who already reads this line must keep reading the same bytes on the same stream.
    if [[ -n "$column" || -n "$type" ]]; then
        printf '%s\n' "$denom" >&2
    fi
}

# _kbc_board_repo: the board's canonical GitHub repo (owner/name), read from the
# coord config's kanban.boards[] entry whose board_id matches this board — the same
# board→repo map the reconcile hook uses. Best-effort: prints "" when the config is
# absent or the board isn't declared (the shim then falls back to the card's own
# derived source — payload.repo outranks the URL keys, `docs/INSTALL.md` §4 states the
# whole derivation — and finally to fail-closed). No network.
_kbc_board_repo() {
    local cfg
    cfg="$(kb_coord_config_path)"
    [[ -r "$cfg" ]] || return 0
    jq -r --arg id "$KB_BOARD_ID" '
        ((.kanban.boards // [])[] | select((.board_id|tostring) == $id) | .repo) // empty
    ' "$cfg" 2>/dev/null | head -n1
}

# _kbc_archive_decision <task-id>: run the may_archive safety gate for a card and
# print "<token>\t<reason>" (token = ok|blocked|noprimitive) on stdout. Delegates
# the policy to the shipped framework primitive via the _kbc-may-archive.py shim;
# builds no archive policy here. A missing shim, an unfetchable card, or any shim
# fault resolves to a fail-closed token so cmd_archive refuses rather than archiving
# unchecked. surviving_cards is the whole live board (twin detection is the
# primitive's job); a partial/failed board read yields fewer twins → more blocking
# (fail-closed), never a false allow.
_kbc_archive_decision() {
    local task="$1" shim card board repo
    shim="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)/_kbc-may-archive.py"
    [[ -r "$shim" ]] || { printf 'noprimitive\tarchive-gate shim _kbc-may-archive.py not found next to kbcard'; return 0; }
    local resp
    resp="$(kb_api GET "/tasks/$task.json")" \
        || { printf 'noprimitive\tcould not fetch card %s to verify archive safety' "$task"; return 0; }
    # Read the card out of the body TOLERANTLY. The unguarded jq that used to be piped here
    # already fell into the fail-closed arm below (its own `||` caught jq's rc 5), so the SAFETY
    # posture is unchanged — this is about the diagnostic only: it printed jq's raw parse error
    # to the operator's stderr above a refusal ("could not fetch card N") that names a fetch
    # failure, which is not what happened. Empty lands in the same arm, quietly.
    card="$(kb_parse_resp "$resp" -c '.data')"
    # A 2xx with .data null/absent (trashed / permission-limited / edge card) yields
    # the literal "null" (or "") at rc 0 — non-empty, so the `||` above never fires.
    # For the CARD input the degenerate default is UNSAFE (no card ⇒ no sources ⇒ a
    # false `ok` that archives a live-and-untwinned card), the mirror of the board
    # input's safe `[]` default above — so fail closed here, never reach the shim.
    [[ "$card" == "null" || -z "$card" ]] && { printf 'noprimitive\tcard %s fetch returned null .data — cannot verify archive safety' "$task"; return 0; }
    # More than one JSON text is not one card: on the shared stdin stream below, the second would
    # be read as the first board text.
    [[ "$card" == *$'\n'* ]] && { printf 'noprimitive\tcard %s fetch returned more than one JSON text — cannot verify archive safety' "$task"; return 0; }
    # Capture the board array regardless of the paginator's rc — a partial or EMPTY
    # census only removes twins (more conservative), never invents one. The `|| true`
    # keeps EVERY non-zero paginator rc — 1, 2, 3 and 4 — from aborting this function
    # under `set -e`: rc 3 and rc 4 emit a partial array, rc 1 and rc 2 emit none at all
    # and land on the `[]` below. No cause is enumerated here, for the reason the
    # wording rule at fetch_board_cards' header gives: this site sees all four rcs, and
    # they share none. Fewer twins is the fail-closed direction, per this function's
    # header — and this site makes no operator-facing claim at all, by design.
    board="$(fetch_board_cards "$KB_API" "$KB_TOKEN" "$KB_BOARD_ID" 2>/dev/null)" || true
    [[ -n "$board" ]] || board="[]"
    repo="$(_kbc_board_repo)" || true
    # The board array (~200KB) AND the card both reach jq via STDIN, never argv: one argv
    # string is capped at MAX_ARG_STRLEN (131072 B) and a single card crosses that by
    # accreting comments, so neither is "small" (the #3091/#3362 class). A failed exec
    # leaves the shim an empty stdin, which it refuses as a card-less request. The card is
    # the FIRST text on the stream; `inputs` then yields one object per board text, exactly
    # as a board-only stdin did.
    { printf '%s\n' "$card"; printf '%s' "$board"; } | jq -c -n --arg repo "$repo" --arg board_id "$KB_BOARD_ID" \
            'input as $card | inputs | {card:$card, surviving_cards:., repo:$repo, board_id:$board_id}' \
        | python3 "$shim"
}

# Take a card off the board without deleting it: PATCH _action:archive. The row
# stays live (recoverable via _action:unarchive) and keeps its stable id + any
# dl_number — so archiving never releases a DL ref. Before the PATCH the
# may_archive gate refuses to archive a card whose backing coordination source is
# still live-and-untwinned (archiving its only card would hide a live source from
# the reconcile/detect backstop); --force overrides with an audited log line.
# `--dry-run` prints the call without evaluating the gate (offline, no mutation).
cmd_archive() {
    local task_ref="" dry="" force=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --task) kb_require_value "$1" "${2:-}" || return 2; task_ref="$2"; shift 2 ;;
            --dry-run) dry=1; shift ;;
            --force) force=1; shift ;;
            *) echo "kbcard: unknown arg '$1'" >&2; return 2 ;;
        esac
    done
    [[ -z "$task_ref" ]] && { echo "kbcard: --task required" >&2; return 2; }
    local task; task="$(resolve_task "$task_ref")" || return 2
    if [[ -n "$dry" ]]; then
        echo "  archive:  PATCH /tasks/$task.json  {\"_action\":\"archive\"}"
        [[ -n "$force" ]] || echo "  note: the live-source archive gate is evaluated at execution (not in --dry-run)" >&2
        return 0
    fi

    # Archive-safety gate (roundtable #39). Skipped entirely under --force, which
    # then emits an audited override line rather than a silent bypass.
    if [[ -z "$force" ]]; then
        local decision token reason
        decision="$(_kbc_archive_decision "$task")"
        token="${decision%%$'\t'*}"; reason="${decision#*$'\t'}"
        case "$token" in
            ok) : ;;   # gate cleared — proceed to the PATCH below
            blocked)
                echo "kbcard: ⚠ archive withheld: card #$task — $reason" >&2
                echo "kbcard: pass --force to override (records an audited override); the card was NOT archived." >&2
                return 1 ;;
            *)  # noprimitive / any unrecognized token → fail LOUD, never silent-archive
                echo "kbcard: ⚠ archive withheld: card #$task — $reason" >&2
                echo "kbcard: cannot verify archive safety; pass --force to override (records an audited override). The card was NOT archived." >&2
                return 1 ;;
        esac
    else
        # Audit the override: what the gate WOULD have said, durably logged + on
        # stderr — a forced archive is never a silent bypass of the gate. Tolerate a
        # gate-infra failure (e.g. python3 absent → rc 127): --force is the escape
        # hatch, so it must not itself be blocked by the very gate infra it exists to
        # bypass. An empty decision still proceeds to the archive AND still writes the
        # audited override line (never a SILENT forced archive). The non-force branch
        # deliberately keeps no `|| …` here so a gate-infra failure there fails closed.
        local decision token reason
        decision="$(_kbc_archive_decision "$task")" || decision=""
        if [[ -z "$decision" ]]; then
            token=""; reason="archive-gate infra could not run — forced without a verified decision"
        else
            token="${decision%%$'\t'*}"; reason="${decision#*$'\t'}"
        fi
        if [[ "$token" != "ok" ]]; then
            local line="⚠ archive FORCED past live-source gate: card #$task — $reason"
            echo "kbcard: $line" >&2
            [[ -n "${KB_LOG_FILE:-}" ]] && echo "$(date -u +%FT%TZ) ARCHIVE-FORCE task=$task $line" >> "$KB_LOG_FILE"
        fi
    fi

    kb_api PATCH "/tasks/$task.json" '{"_action":"archive"}' >/dev/null \
        || { echo "kbcard: archive failed for task $task" >&2; return 1; }

    # The PATCH's status is the server saying it accepted the request; `archived_at` on a
    # re-read is the card being off the board. This verb's whole claim — "off-board, live row,
    # DL ref kept" — is a claim about a state, so it is made from a read of that state.
    local w
    local rc=0
    w="$(kb_confirm_card "$task" '.state == "present" and .card.archived_at != null')" || rc=$?
    if [[ "$rc" -eq "$KBC_RC_UNVERIFIED" ]]; then
        _kbc_unverified archive "on task $task" "Whether card $task is off the board is UNKNOWN; re-read it before deciding whether to re-run."
        return $?
    fi
    if [[ "$rc" -ne 0 ]]; then
        if [[ "$(jq -r '.state' <<<"$w")" == "absent" ]]; then
            echo "kbcard: archive on task $task: the PATCH answered 2xx and the server does not know card $task at all on a ?trashed=1 re-read — this verb archives, it does not delete, so that is not the state it asked for." >&2
        else
            echo "kbcard: archive on task $task: HARD FAILURE — the PATCH answered 2xx and card $task is STILL ON THE BOARD (archived_at is null on the re-read). The status is not the archive; the read-back is." >&2
        fi
        return 1
    fi
    echo "kbcard: task $task archived (off-board, recoverable; live row — stable id + DL ref kept) — re-read after the PATCH and archived_at is stamped"
}

# Remove a card. Default is a soft delete (PATCH _action:delete) — trashed, but
# recoverable within the retention window, and it RETAINS the dl_number. `--hard`
# force-deletes (POST force-delete.json): permanent, cascades subtasks/comments/
# links, and RELEASES the DL ref. force-delete 422s unless the card is already
# trashed, so --hard is a two-step soft-then-force; the confirmation gates the
# whole thing, BEFORE the soft-delete, so a declined --hard leaves the card live.
cmd_delete() {
    local task_ref="" hard="" dry="" yes="" ans=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --task) kb_require_value "$1" "${2:-}" || return 2; task_ref="$2"; shift 2 ;;
            --hard) hard=1; shift ;;
            --dry-run) dry=1; shift ;;
            --yes|-y) yes=1; shift ;;
            *) echo "kbcard: unknown arg '$1'" >&2; return 2 ;;
        esac
    done
    [[ -z "$task_ref" ]] && { echo "kbcard: --task required" >&2; return 2; }
    local task; task="$(resolve_task "$task_ref")" || return 2

    if [[ -n "$dry" ]]; then
        echo "  soft:  PATCH /tasks/$task.json  {\"_action\":\"delete\"}"
        [[ -n "$hard" ]] && echo "  hard:  POST  /tasks/$task/force-delete.json  (IRREVERSIBLE — releases DL ref)"
        return 0
    fi

    # Confirm the destructive path FIRST — before any deletion — so declining (or
    # a non-interactive shell without --yes) leaves the card fully live, never in a
    # half-trashed state. A non-TTY with no --yes refuses rather than reading a
    # confirmation from a stream that carries none (fail-closed on irreversibility).
    if [[ -n "$hard" && -z "$yes" ]]; then
        if [[ ! -t 0 ]]; then
            echo "kbcard: --hard requires --yes in a non-interactive shell (refusing to permanently delete without an explicit confirmation)" >&2
            return 2
        fi
        # `|| ans=""` so an EOF (Ctrl-D) at the prompt takes the graceful abort
        # path (read returns non-zero on EOF, which set -e would otherwise fatal).
        read -r -p "HARD-delete task $task PERMANENTLY (cascades subtasks/comments/links; releases DL ref; irreversible)? [y/N] " ans || ans=""
        [[ "$ans" == [yY] ]] || { echo "kbcard: aborted — task $task left live (not deleted)"; return 0; }
    fi

    kb_api PATCH "/tasks/$task.json" '{"_action":"delete"}' >/dev/null \
        || { echo "kbcard: soft-delete failed for task $task" >&2; return 1; }

    # THE SOFT LEG'S READ-BACK — and under --hard it is also the force-delete's PRECONDITION,
    # which is why it is not skipped there to save a request: force-delete 422s unless the card
    # is already trashed, so a soft leg this run could not confirm is not a leg to send an
    # IRREVERSIBLE request behind.
    local w
    local rc=0
    w="$(kb_confirm_card "$task" '.state == "present" and .card.deleted_at != null')" || rc=$?
    if [[ "$rc" -eq "$KBC_RC_UNVERIFIED" ]]; then
        _kbc_unverified delete "on task $task" "Whether task $task is in the trash is UNKNOWN.${hard:+ NO force-delete was sent: this tool does not send an irreversible request behind a precondition it could not read. Re-read the card, then re-run --hard.}"
        return $?
    fi
    if [[ "$rc" -ne 0 ]]; then
        # Two different boards, and the operator acts differently on each, so each says which
        # it is. `absent` here is NOT a success spelled oddly: the caller asked for a
        # RECOVERABLE delete and the row is gone, which is the one outcome a soft delete
        # promises cannot happen.
        if [[ "$(jq -r '.state' <<<"$w")" == "absent" ]]; then
            echo "kbcard: delete on task $task: the soft-delete answered 2xx and the server does not know card $task AT ALL — 404 on a ?trashed=1 read, which DOES return trashed cards, so the row is GONE rather than in the trash. There is nothing to restore.${hard:+ NO force-delete was sent.}" >&2
        else
            echo "kbcard: delete on task $task: HARD FAILURE — the soft-delete answered 2xx and card $task is STILL LIVE (deleted_at is null on the re-read). The status is not the deletion; the read-back is.${hard:+ NO force-delete was sent.}" >&2
        fi
        return 1
    fi
    if [[ -z "$hard" ]]; then
        echo "kbcard: task $task soft-deleted (recoverable within the retention window; DL ref RETAINED — use --hard to release it) — re-read after the PATCH and deleted_at is stamped"
        return 0
    fi
    kb_api POST "/tasks/$task/force-delete.json" '' >/dev/null \
        || { echo "kbcard: force-delete failed for task $task (needs task.delete / admin). The card is now SOFT-DELETED (in the trash, recoverable) — retry --hard with an admin token, or restore it." >&2; return 1; }

    # THE READ-BACK THIS WHOLE SECTION EXISTS FOR. A false success here does not stop at one
    # bad print: it tells the operator the DL ref is RELEASED, and that release is an input to
    # the next DL mint (docs/DL-COUNTER-RECOVERY.md § Why it strands), so the wrong answer
    # propagates into the numbering. The 204 is the server saying it acted; it is not the purge.
    rc=0
    w="$(kb_confirm_card "$task" '.state == "absent"')" || rc=$?
    if [[ "$rc" -eq "$KBC_RC_UNVERIFIED" ]]; then
        _kbc_unverified "delete --hard" "on task $task" "Do NOT treat the DL ref as released on the strength of the 204: a release that did not happen is the input to the next DL mint, so the wrong answer would propagate into the numbering rather than stopping here."
        return $?
    fi
    if [[ "$rc" -ne 0 ]]; then
        echo "kbcard: delete --hard on task $task: HARD FAILURE — the force-delete answered 2xx and card $task is STILL READABLE on a ?trashed=1 re-read. It is in the trash, NOT purged, and its DL ref is NOT released. Evidence, that card's own lifecycle stamps: $(jq -c '.card | {id, archived_at, deleted_at}' <<<"$w")" >&2
        return 1
    fi
    echo "kbcard: task $task HARD-deleted (permanent; DL ref released) — re-read after the force-delete and ABSENT (404 on a ?trashed=1 read, which DOES return trashed cards, so this is a purge and not a soft delete)"
}

# --- field verb: per-board custom-field schema read + lifecycle --------------
# Custom fields are per-board definitions; tasks.payload values are gated to the
# registered keys (an unknown key 422s on a task write). The board index
# GET /boards/<id>/custom_fields.json is the ONLY read surface — there is no
# GET /custom_fields/<id>.json (that route is PATCH/DELETE only), so EVERY sub-verb
# reads the whole board's field set and selects by id/key.
#
# THE FIVE ROUTES, read out of the server's own routes/api.php:
#   GET    /boards/<id>/custom_fields.json        index   (any board member)
#   POST   /boards/<id>/custom_fields.json        store   (custom_field.manage — admin)
#   PATCH  /custom_fields/<id>.json               update  (key is IMMUTABLE; a genuine
#                                                          type change 422s and the
#                                                          message points at the route
#                                                          below)
#   POST   /custom_fields/<id>/change-type.json   changeType — the ATOMIC conversion
#   DELETE /custom_fields/<id>.json               destroy (204, empty body)
#
# WHY `delete` IS FAIL-CLOSED, and why `retype` is NOT built out of it. Two measured
# server behaviours compose into a silent data-integrity trap on the DELETE route:
#   * Deleting a definition does NOT cascade to tasks.payload — the values survive,
#     orphaned, and are NEVER revalidated. A later create over the same key leaves
#     them holding whatever JSON type they were written as.
#   * Deleting PURGES the search-index side table for the key, and creating does NOT
#     rebuild it. Only a payload WRITE touching the key re-indexes it.
# ⚠ WHAT "FAIL-CLOSED" IS QUANTIFIED OVER, stated because the refusal is easy to read as
# wider than it is: both behaviours above are BOARD-WIDE — CustomFieldMutator::delete
# leaves tasks.payload untouched for every carrier and TaskCustomFieldIndexer::purgeField
# is `where board_id … where field_key … delete()`, with no archive and no trash filter —
# while the census that GATES the refusal is a live, non-archived board read. So a board
# whose only carriers are archived reports "0 of M", does not refuse, and purges the
# index for all of them; un-archiving one puts an undefined payload key back into the
# live set. The gate is what this file can see, and the denominator line says so on every
# run (see _kbc_field_census_population_note). Widening the gate to the carriers it
# cannot see would change what this verb REFUSES, which is the caller's decision, not
# this file's; it is recorded as a request.
# So the obvious hand-rolled type migration — delete, create, done — leaves a board
# that READS migrated (the definition says `string`) while every DSL filter on the key
# matches zero cards and every resident value still has the old JSON type. Nothing
# about that state is visible without asking each card, which is why `delete` refuses
# a populated field outright rather than being the sharp half of a two-step nobody
# finishes. `retype` does not compose those two routes at all: the conversion route
# converts the definition and every stored value in ONE transaction and rebuilds the
# index inside it, so this trap is not on its path (see its own section below).

# _KBC_FIELD_TYPES: the server's CustomField::TYPES, in its declared order. A type
# outside this set is refused BEFORE any request — the server would 422 anyway, but a
# typo costs no round trip and the refusal names the whole set.
_KBC_FIELD_TYPES=(string number date enum multi_select boolean url)

# _kbc_field_type_takes_options <type>: 0 for the two types whose `options` the
# server interprets. On any other type it STORES the array and never reads it — a
# silent no-effect, which is why set-options has always refused it and why create
# refuses it too rather than accepting a flag that does nothing.
_kbc_field_type_takes_options() { [[ "$1" == "enum" || "$1" == "multi_select" ]]; }

_kbc_field_require_type() {
    local t
    for t in "${_KBC_FIELD_TYPES[@]}"; do [[ "$1" == "$t" ]] && return 0; done
    echo "kbcard: '$1' is not a custom-field type (expected one of: ${_KBC_FIELD_TYPES[*]})" >&2
    return 2
}

# _KBC_FIELD_ROW: the jq projection for one custom field. enum/multi_select carry
# their {value,label} option set (label defaults to value); every other type reports
# options as null (the API stores none). Shared by `field list` (mapped over the
# array), the set-options no-op echo, and the PATCH-result echo.
_KBC_FIELD_ROW='{id, key, label, type,
    options: (if (.options // null) == null then null
              else (.options | map({value, label: (.label // .value)})) end)}'

# _kbc_fetch_fields: the board's custom fields as a JSON array (.data). One read
# surface for both sub-verbs. A non-2xx propagates loudly (kb_api prints the error
# body — KB_API_ERRBODY=1 — and returns non-zero).
#
# A 2xx no field set can be read out of refuses HERE rather than downstream, because both
# sub-verbs would otherwise turn an unreadable body into a claim about the BOARD: `field list`
# projects it (an unreadable body is not an empty field set) and set-options resolves --field
# against it (an unreadable body is not "that field is not defined"). One owner, one refusal.
_kbc_fetch_fields() {
    local resp fields
    resp="$(kb_api GET "/boards/$KB_BOARD_ID/custom_fields.json")" || return 1
    fields="$(kb_parse_resp "$resp" '.data')"
    [[ -n "$fields" ]] || {
        echo "kbcard: field read on board $KB_BOARD_ID: the read returned success but no custom-field set could be read out of its body — nothing was read (this is NOT a board with no custom fields)" >&2
        return 1
    }
    printf '%s\n' "$fields"
}

# _kbc_field_enumerate <fields-json>: the board's defined fields as `id=key [type]`,
# id-sorted, to stderr — mirrors swimlane_id()'s "defined swimlanes: …" so an
# unresolved --field reads as "wrong name, here are the real ones", never a false
# "the board has no fields".
_kbc_field_enumerate() {
    local defined
    defined="$(jq -r 'sort_by(.id) | map("\(.id)=\(.key) [\(.type)]") | join(", ")' <<<"$1")"
    if [[ -n "$defined" ]]; then
        echo "kbcard:   defined fields: $defined" >&2
    else
        echo "kbcard:   this board defines no custom fields" >&2
    fi
}

_kbc_field_list() {
    [[ $# -gt 0 ]] && { echo "kbcard: field list takes no arguments (select the board with the global --board flag)" >&2; return 2; }
    _kbc_fetch_fields | jq "map($_KBC_FIELD_ROW)"
}

# _kbc_field_resolve <name|id> <fields-json>: the ONE resolver for a --field
# reference, by numeric id OR key, against the board's field set. Prints the field
# object on stdout; on no match prints the not-defined diagnostic + the enumeration
# and returns 2. set-options, delete and retype all select a field the same way, so
# this is one owner rather than three copies of the same jq pair (the third copy is
# what would have drifted).
_kbc_field_resolve() {
    local ref="$1" fields="$2" fld
    if kb_is_uint "$ref"; then
        fld="$(jq -c --argjson id "$ref" 'map(select(.id == $id)) | .[0] // empty' <<<"$fields")"
    else
        fld="$(jq -c --arg k "$ref" 'map(select(.key == $k)) | .[0] // empty' <<<"$fields")"
    fi
    if [[ -z "$fld" ]]; then
        echo "kbcard: custom field '$ref' is not defined on board $KB_BOARD_ID" >&2
        _kbc_field_enumerate "$fields"
        return 2
    fi
    printf '%s' "$fld"
}

# _kbc_field_option_values <csv>: the desired option VALUE list as a JSON array of
# strings, trimmed per value (internal spaces preserved so "In Progress" is one
# value). Three refusals, and WHOSE RULE EACH ONE IS is the load-bearing part, because
# `retype` calls this under a stated PASSTHROUGH claim:
#   * at least one value  — the server's own (assertOptionsMatchTarget validates
#                           `options => array|min:1`), reached by derivation, so a
#                           caller refused here would have been refused on the wire.
#   * no empty value      — likewise the server's (`options.*.value => required`).
#   * no duplicate value  — ⚠ THIS TOOL'S, and the server has NO uniqueness rule at all:
#                           assertOptionsMatchTarget validates the array, the value's
#                           presence/type/length and an optional label, and nothing more
#                           (read at CustomFieldMutator, not recalled). The rationale is
#                           `set-options`' — a converge-to-set target must be distinct —
#                           and `create` shares it (it mints the set). `retype` does NOT
#                           own that rationale: its --options is a body element whose
#                           rules are the server's, so this refusal is the ONE documented
#                           exception to the passthrough claim rather than part of it,
#                           and it is named as an exception in this file's usage
#                           header, README and the changelog, instead of being quietly
#                           counted as one of the server's.
# Shared by every verb that takes an --options comma list.
#
# ⚠ REMOVING IT FROM `retype`'S PATH WOULD CHANGE WHAT THAT VERB ACCEPTS — `--options a,a`
# is rc 2 today and would become a request — which is an rc-contract change this file's
# callers own, not a cleanup. It is recorded as a recommendation rather than made here.
_kbc_field_option_values() {
    local options="$1" desired n_total n_empty n_uniq
    desired="$(jq -Rc 'split(",") | map(gsub("^\\s+|\\s+$";""))' <<<"$options")"
    n_total="$(jq 'length' <<<"$desired")"
    n_empty="$(jq '[.[] | select(. == "")] | length' <<<"$desired")"
    n_uniq="$(jq 'unique | length' <<<"$desired")"
    [[ "$n_total" -eq 0 ]] && { echo "kbcard: --options needs at least one value" >&2; return 2; }
    [[ "$n_empty" -gt 0 ]] && { echo "kbcard: --options has an empty value (check for a stray/leading/trailing comma)" >&2; return 2; }
    # Says whose rule it is, because the operator cannot otherwise tell it from the two
    # above — and being sent to argue with the server about a rule the server does not
    # have is the worst version of this refusal.
    [[ "$n_total" -ne "$n_uniq" ]] && { echo "kbcard: --options has duplicate values; a set must be distinct. This is kbcard's own rule, not the server's — the API has no uniqueness rule on an option set" >&2; return 2; }
    printf '%s' "$desired"
}

# _kbc_field_set_options: idempotent converge-to-set on an enum/multi_select field.
# The option set converges to EXACTLY the given comma list (membership AND order),
# so the result is deterministic and a second identical call is a no-op. Drift is
# computed on the ordered VALUE list — labels are out of scope (a value being
# written gets label=value, the API's default when a label is omitted), which also
# makes the no-op detection independent of whether existing options carry labels.
_kbc_field_set_options() {
    local field="" options="" have_options=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --field)   kb_require_value "$1" "${2:-}" || return 2; field="$2"; shift 2 ;;
            --options) kb_require_value "$1" "${2:-}" || return 2; options="$2"; have_options=1; shift 2 ;;
            *) echo "kbcard: unknown arg '$1'" >&2; return 2 ;;
        esac
    done
    [[ -z "$field" ]]        && { echo "kbcard: field set-options requires --field <name|id>" >&2; return 2; }
    [[ -z "$have_options" ]] && { echo "kbcard: field set-options requires --options <a,b,c> (converge-to-set; at least one value)" >&2; return 2; }

    local desired
    desired="$(_kbc_field_option_values "$options")" || return 2

    # Resolve --field by numeric id OR key against the board's field set. Propagate
    # a read failure EXPLICITLY (kb_api already surfaced the error body) rather than
    # leaning on set -e — errexit is suppressed when this fn runs in a `||`/`if`
    # context, and a swallowed empty read would mis-surface as "field not defined".
    # The `||` arm carries no message of its own: _kbc_fetch_fields already speaks on both of
    # its failing paths (kb_api's error body on a non-2xx, its own refusal on a 2xx nothing
    # could be read out of), so a second line here named no cause the first did not. `field
    # list` is the shape — one message, rc 1.
    local fields fld
    fields="$(_kbc_fetch_fields)" || return 1
    fld="$(_kbc_field_resolve "$field" "$fields")" || return 2

    local fid ftype fkey
    fid="$(jq -r '.id' <<<"$fld")"
    ftype="$(jq -r '.type' <<<"$fld")"
    fkey="$(jq -r '.key' <<<"$fld")"

    # Options only mean something for the option-bearing types; on any other type the
    # API would STORE the array but never interpret it — a silent no-effect. Refuse.
    if [[ "$ftype" != "enum" && "$ftype" != "multi_select" ]]; then
        echo "kbcard: field '$fkey' is type '$ftype'; set-options applies only to enum / multi_select fields" >&2
        return 2
    fi

    local current
    current="$(jq -c '(.options // []) | map(.value)' <<<"$fld")"
    if [[ "$current" == "$desired" ]]; then
        echo "kbcard: field '$fkey' options already match [$(jq -r 'join(", ")' <<<"$desired")] — no change" >&2
        jq "$_KBC_FIELD_ROW" <<<"$fld"
        return 0
    fi

    # Converge: PATCH the whole options array (the API replaces it wholesale). Send
    # value-only entries; the server defaults each label to its value.
    local body result
    body="$(jq -nc --argjson vals "$desired" '{options: ($vals | map({value: .}))}')"
    # Propagate a write failure EXPLICITLY (not via set -e — suppressed in a `||`/`if`
    # caller); kb_api already surfaced the HTTP status + error body on stderr, so a
    # failed reconcile never prints the success echo below.
    if ! result="$(kb_api PATCH "/custom_fields/$fid.json" "$body")"; then
        return 1
    fi
    local row
    row="$(kb_parse_resp "$result" ".data | $_KBC_FIELD_ROW")"
    [[ -n "$row" ]] || _kbc_unverified "field set-options" "'$fkey'" "The reconcile PATCH answered 2xx; which option set the board now holds is UNKNOWN." || return $?

    # THE OPTION SET IS READ BACK OFF THE BOARD INDEX, not off the PATCH's own echo — the same
    # surface, and the same argument, as `field delete`'s confirming re-read (the board index is
    # the ONLY read surface a custom field has; there is no per-field GET). This verb's claim is
    # a converge-to-set: "the options are now EXACTLY this list, in this order". That is a claim
    # about the board, so it is made from a read of the board.
    local after fld2 now
    after="$(_kbc_fetch_fields)" || {
        _kbc_unverified "field set-options" "'$fkey'" "The reconcile PATCH answered 2xx and the board's field set could not be re-read, so the converged option set is UNMEASURED."
        return $?
    }
    fld2="$(jq -c --argjson id "$fid" 'first(.[]? | select(.id == $id)) // empty' <<<"$after")"
    if [[ -z "$fld2" ]]; then
        echo "kbcard: field set-options '$fkey': HARD FAILURE — the reconcile answered 2xx and field id $fid is no longer defined on board $KB_BOARD_ID at all. The status is not the reconcile; the read-back is." >&2
        return 1
    fi
    now="$(jq -c '(.options // []) | map(.value)' <<<"$fld2")"
    if [[ "$now" != "$desired" ]]; then
        echo "kbcard: field set-options '$fkey': HARD FAILURE — the reconcile answered 2xx and the board now holds $now, not the $desired this call converged to (membership AND order are the target). The status is not the reconcile; the read-back is." >&2
        return 1
    fi
    echo "kbcard: field '$fkey' options reconciled: [$(jq -r 'join(", ")' <<<"$current")] -> [$(jq -r 'join(", ")' <<<"$desired")] — re-read off the board's field index and equal" >&2
    printf '%s\n' "$row"
}

# --- field lifecycle: the two HTTP primitives -------------------------------
# The create POST and the delete DELETE, one owner each, so a fix to either lands
# once. `retype` is built out of NEITHER of them and composes nothing — it is one
# call on the server's conversion route, which creates and deletes nothing. The
# `field retype` section below owns that statement in full; this header points at it
# rather than restating it, and the conversion route's own POST site lives there.

# _kbc_field_create_call <key> <label> <type> <options-json|"">: POST the board's
# custom_fields route and print the CREATED FIELD ID. That id is the write
# verification (the 201 echoes the whole CustomFieldResource, id first); a success
# whose body carries no id is an UNVERIFIED write, reported as such rather than
# printed as a plausible-looking `null` — same contract as `comment`.
# `options` is the server's OWN wire shape — an array of objects `[{value, label?}]`
# — and goes on the wire verbatim. It is deliberately NOT a value list this
# flattens: an explicit label is data the server will not re-derive, so a
# `map({value: .})` here would silently destroy one on any caller that has real
# labels to send. A caller whose input IS a value list (the `create` verb, whose
# --options is a comma list) builds the objects at its own call site, where omitting
# the label is a deliberate choice the server answers by defaulting label to value.
_kbc_field_create_call() {
    local key="$1" label="$2" type="$3" opts="${4:-}"
    local body resp fid
    if [[ -n "$opts" ]]; then
        body="$(jq -nc --arg k "$key" --arg l "$label" --arg t "$type" --argjson o "$opts" \
            '{key: $k, label: $l, type: $t, options: $o}')"
    else
        body="$(jq -nc --arg k "$key" --arg l "$label" --arg t "$type" '{key: $k, label: $l, type: $t}')"
    fi
    resp="$(kb_api POST "/boards/$KB_BOARD_ID/custom_fields.json" "$body")" || return 1
    # A 2xx whose body is not JSON at all (a proxy's HTML, a truncated read) fails the
    # parse; that is the SAME "success with no confirmed id" state as a JSON body with
    # no id, so it falls into the arm below rather than dying at jq's raw parse error.
    fid="$(kb_parse_resp "$resp" -r '.data.id // empty')"
    [[ -n "$fid" ]] || _kbc_unverified "field create" "'$key'" "The 201 echoes the whole definition, id first, so a success carrying no id confirms nothing." || return $?

    # And read the DEFINITION back off the board index — the mirror of what the delete primitive
    # below does, on the same and only read surface a custom field has. The id in the 201 is the
    # write's own answer; the index is the board. A create reported as done but not defined is a
    # board every later `field` call then acts on as though the key were there.
    local after
    after="$(_kbc_fetch_fields)" || {
        _kbc_unverified "field create" "'$key'" "The POST echoed field id $fid and the board's field set could not be re-read, so the definition's presence is UNMEASURED (treat it as LANDED: the server reported success)."
        return $?
    }
    jq -e --arg id "$fid" 'any(.[]?; (.id|tostring) == $id)' <<<"$after" >/dev/null 2>&1 || {
        echo "kbcard: field create '$key': HARD FAILURE — the POST answered success with field id $fid and board $KB_BOARD_ID does not define it on a re-read. The status is not the definition; the read-back is." >&2
        return 1
    }
    printf '%s' "$fid"
}

# _kbc_field_delete_call <id> <key>: DELETE the definition and VERIFY it is gone.
# The 204 carries no body, so the response can verify nothing at all — the board
# index (the only field read surface) is re-read and the id asserted absent. A
# delete reported as done but still defined is a board the caller would otherwise act
# on as empty — including a `field create` over the same key, which 422s on the
# duplicate.
#
# THE RC IS THE BOARD STATE: the three failure arms are three DIFFERENT boards, and
# each one SAYS which it is in its own words. The rc is what a caller that wants to
# branch on them reads, and the one caller in this file DOES branch — `_kbc_field_delete`
# maps 3 to rc 3 (UNVERIFIED) and folds 1 and 4 together into rc 1, because those two are
# both KNOWN boards while 3 is the one nobody read. It used to collapse all three to rc 1,
# which reads as "the delete did not happen" and is false for exactly one of them.
# Distinguishing them is the primitive's contract regardless: a caller that folded them
# together before printing would be describing a board it never read.
#
#   1 — the DELETE itself was refused. The definition stands; the board is INTACT.
#   3 — the DELETE returned 2xx and the confirming re-read failed. The definition is
#       gone as far as anything can tell (a 2xx is the server saying it acted), the
#       index is purged and the values are orphaned. Assume it LANDED, unverified —
#       a caller that reports this as "nothing happened" is describing a board that
#       does not exist and hiding the one state that needs finishing.
#   4 — the DELETE returned 2xx and the field is STILL defined. Board intact, but a
#       create on that live key would 422 on the duplicate.
_kbc_field_delete_call() {
    local fid="$1" fkey="$2" fields
    kb_api DELETE "/custom_fields/$fid.json" >/dev/null || return 1
    fields="$(_kbc_fetch_fields)" || {
        echo "kbcard: field '$fkey' DELETE returned success but the board's field set could not be re-read — the delete is UNVERIFIED (treat it as LANDED: the server reported success)" >&2
        return 3
    }
    if jq -e --argjson id "$fid" 'any(.[]?; .id == $id)' <<<"$fields" >/dev/null 2>&1; then
        echo "kbcard: field '$fkey' (id $fid) is STILL defined on board $KB_BOARD_ID after a successful DELETE — the delete is UNVERIFIED" >&2
        return 4
    fi
    return 0
}

# _kbc_field_census_population_note <key>: the ONE statement of WHAT a census this file
# takes can see, embedded by every line that reports one.
#
# The census is fetch_board_cards -> GET /tasks/search.json, and TasksController::search
# applies the default SoftDeletes scope AND whereNull('archived_at') unless asked
# otherwise — and the census URL is not built in this file at all: it is built in
# _kb-board-lib.sh's fetch_board_cards, which sends board_id, limit and page and no
# archive or trash parameter of any kind. An archived or soft-deleted carrier of the key
# is therefore counted by neither the numerator nor the denominator — while the two
# server routes these counts are read against are both wider than that:
# CustomFieldMutator::candidateQuery is withTrashed() with no archive filter, and
# TaskCustomFieldIndexer::purgeField is `where board_id … where field_key … delete()`,
# board-wide with no filter of either kind.
#
# One owner because two callers state it: the denominator line below, on every census
# this file takes — which is NOT every run of both write verbs. _kbc_field_populated has
# exactly two call sites: `field delete` censuses on every run that resolves its --field,
# while on `field retype` the census belongs to the --restamp-dl pass alone, so a plain
# retype takes no census at all and a --restamp-dl run whose conversion does not answer a
# readable 2xx returns before the pass ever runs. The second caller is
# _kbc_field_census_scope_note, which adds the conversion's own population compare on
# top of it. They are two claims sharing one fact, and the fact is invariant — it holds
# on every run of this file against every board — so it is stated unconditionally and
# spelled once.
_kbc_field_census_population_note() {
    printf '%s' "The census reads LIVE, NON-ARCHIVED cards only (GET /tasks/search.json applies the soft-delete scope and archived_at IS NULL), so an archived or trashed card carrying '$1' is in neither the numerator nor the denominator"
}

# _kbc_field_populated <key>: the board's cards that CARRY the payload key, as
# `[{task_id, value}]` on stdout, with the denominator `N of M board cards carry
# <key>` ALWAYS on stderr. The census is the whole point of both write verbs, so it
# is FAIL-CLOSED on EVERY non-zero rc fetch_board_cards defines — 1, 2, 3 and 4, all
# four measured reaching the arm below. The rc set is named and no CAUSE is, per the
# wording rule at that function's header: an arm reached by four rcs shares no cause
# with them (rc 1 alone has three, since card#6594). What they do share is the
# outcome — the read is not a whole board — and a census over a partial board, or
# over no board at all, undercounts the cards a delete would orphan. A truncated
# denominator is not a denominator, and the one thing that must not happen is a
# "0 of M" that reads like a safe delete. This bin sets KB_FETCH_LOUD, so the
# paginator's own line — the only one that knows the cause — prints above this one.
#
# THE OTHER WAY THIS DENOMINATOR IS NOT THE POPULATION is not an rc at all, so no
# refusal can carry it: a COMPLETE read of the whole board still returns no archived and
# no soft-deleted card, and both write verbs are read against server routes that touch
# them (see _kbc_field_census_population_note). A "0 of M" is therefore a measurement of
# what this tool can see and never a statement that the key is unused, so the scope rides
# the count itself, on the line that prints it, for every consumer of this census at
# once — the previous two fixes of this shape hoisted a note and then wired it to ONE
# consumer, leaving the other stating the same unqualified number.
_kbc_field_populated() {
    local key="$1" cards rc=0 rows n m
    cards="$(fetch_board_cards "$KB_API" "$KB_TOKEN" "$KB_BOARD_ID" "${BOARD_PAGE_CAP:-50}")" || rc=$?
    if [[ "$rc" -ne 0 ]]; then
        echo "kbcard: board $KB_BOARD_ID did not return a complete card list (fetch rc=$rc) — refusing to act on a truncated denominator" >&2
        return 1
    fi
    # `<<<`, never --argjson: a whole board is ~200KB and passing it in argv trips
    # "Argument list too long" over MAX_ARG_STRLEN (the #3091/#3362 class) — here that
    # would silently produce an EMPTY census, i.e. exactly the false "nothing carries
    # this key" a caller is about to delete on. Same stdin rule as cmd_list.
    rows="$(jq -c --arg k "$key" \
        '[ .[] | select((.payload // {}) | has($k)) | select(.payload[$k] != null)
           | {task_id: .id, value: .payload[$k]} ]' <<<"$cards")" || {
        echo "kbcard: board $KB_BOARD_ID read could not be projected for key '$key'" >&2
        return 1
    }
    n="$(jq 'length' <<<"$rows")"
    m="$(jq '(. // []) | length' <<<"$cards")"
    echo "kbcard: $n of $m board cards carry $key — ⚠ SCOPE: $(_kbc_field_census_population_note "$key"). A zero numerator is therefore not evidence that the key is unused, and an N is a FLOOR: whatever is gated on this count — a refusal, a compare — is blind to exactly the carriers this read cannot return." >&2
    printf '%s' "$rows"
}

_kbc_field_create() {
    local key="" label="" type="" options="" have_options=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --key)     kb_require_value "$1" "${2:-}" || return 2; key="$2"; shift 2 ;;
            --label)   kb_require_value "$1" "${2:-}" || return 2; label="$2"; shift 2 ;;
            --type)    kb_require_value "$1" "${2:-}" || return 2; type="$2"; shift 2 ;;
            --options) kb_require_value "$1" "${2:-}" || return 2; options="$2"; have_options=1; shift 2 ;;
            *) echo "kbcard: unknown arg '$1'" >&2; return 2 ;;
        esac
    done
    [[ -z "$key" ]]   && { echo "kbcard: field create requires --key <k>" >&2; return 2; }
    [[ -z "$label" ]] && { echo "kbcard: field create requires --label <l>" >&2; return 2; }
    [[ -z "$type" ]]  && { echo "kbcard: field create requires --type <${_KBC_FIELD_TYPES[*]}>" >&2; return 2; }
    _kbc_field_require_type "$type" || return 2

    local opts=""
    if [[ -n "$have_options" ]]; then
        _kbc_field_type_takes_options "$type" || {
            echo "kbcard: --options applies only to enum / multi_select fields; on type '$type' the server stores the array and never interprets it" >&2
            return 2
        }
        opts="$(_kbc_field_option_values "$options")" || return 2
        # --options is a VALUE list, so the wire objects are built here rather than in
        # the POST primitive: omitting the label is this verb's own choice (the server
        # then defaults each label to its value), and it is not baked into the primitive,
        # which stays able to send a caller's EXPLICIT labels unflattened.
        opts="$(jq -c 'map({value: .})' <<<"$opts")"
    elif _kbc_field_type_takes_options "$type"; then
        echo "kbcard: type '$type' requires --options <a,b,c> (the server rejects an enum / multi_select carrying no options)" >&2
        return 2
    fi

    # A key is UNIQUE PER BOARD, so a create over an existing key is not a re-type —
    # it is a 422. Refuse it here, before the POST,
    # naming the verb that IS the re-type. The board index is the read surface (there
    # is no per-key GET), so this costs the read every sub-verb already makes.
    local fields
    fields="$(_kbc_fetch_fields)" || return 1
    if jq -e --arg k "$key" 'any(.[]?; .key == $k)' <<<"$fields" >/dev/null 2>&1; then
        echo "kbcard: board $KB_BOARD_ID already defines a custom field with key '$key' — a key is unique per board, so this is not a re-type; use 'field retype --field $key --to <type>', which converts the type in place (or 'field delete' first)" >&2
        _kbc_field_enumerate "$fields"
        return 2
    fi

    # PROPAGATE the primitive's rc verbatim. Collapsing it to 1 would re-merge the two
    # outcomes it exists to separate: its rc 3 is a write that WAS SENT and could not be
    # confirmed, and reporting that as "the create failed" is a claim about a board nobody read.
    local fid
    local crc=0
    fid="$(_kbc_field_create_call "$key" "$label" "$type" "$opts")" || crc=$?
    [[ "$crc" -eq 0 ]] || return "$crc"
    echo "kbcard: field '$key' created on board $KB_BOARD_ID as type '$type' (id $fid)" >&2
    printf '%s\n' "$fid"
}

_kbc_field_delete() {
    local field="" orphan=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --field)         kb_require_value "$1" "${2:-}" || return 2; field="$2"; shift 2 ;;
            --orphan-values) orphan=1; shift ;;
            *) echo "kbcard: unknown arg '$1'" >&2; return 2 ;;
        esac
    done
    [[ -z "$field" ]] && { echo "kbcard: field delete requires --field <name|id>" >&2; return 2; }

    local fields fld fid fkey
    fields="$(_kbc_fetch_fields)" || return 1
    fld="$(_kbc_field_resolve "$field" "$fields")" || return 2
    fid="$(jq -r '.id' <<<"$fld")"
    fkey="$(jq -r '.key' <<<"$fld")"

    local rows n
    rows="$(_kbc_field_populated "$fkey")" || return 1
    n="$(jq 'length' <<<"$rows")"

    if [[ "$n" -gt 0 && -z "$orphan" ]]; then
        echo "kbcard: refusing to delete field '$fkey' — $n board card(s) still carry it." >&2
        echo "kbcard:   (A) the definition's deletion does NOT touch tasks.payload: those $n values survive, keep their current JSON type, and are never revalidated." >&2
        echo "kbcard:   (B) the deletion PURGES the search index for '$fkey' and a later create does NOT rebuild it — DSL filters on '$fkey' then match ZERO cards until each card's key is rewritten." >&2
        echo "kbcard:   To CHANGE THE TYPE, run 'kbcard --board <board> field retype --field $fkey --to <type>' — it calls the server's ATOMIC conversion, which deletes nothing, so neither (A) nor (B) is on its path at all." >&2
        echo "kbcard:   To delete anyway and accept both, pass --orphan-values." >&2
        return 2
    fi
    if [[ "$n" -gt 0 ]]; then
        echo "kbcard: ⚠ --orphan-values: deleting '$fkey' ORPHANS $n card value(s) — they stay in tasks.payload, undefined and never revalidated — and PURGES the search index for '$fkey', so DSL filters on that key will match ZERO cards until each card's key is rewritten." >&2
    fi

    # The primitive already distinguishes three boards; this used to collapse all three to
    # rc 1, which reads as "the delete did not happen" and is FALSE for one of them. Its rc 3
    # is a 2xx whose confirming re-read failed — the definition is gone as far as anything can
    # tell — and that is the UNVERIFIED outcome, not a failure. rc 1 (the DELETE was refused,
    # board INTACT) and rc 4 (2xx and the field is STILL defined) are both KNOWN, so both stay
    # rc 1. The primitive has already said which in its own words.
    local drc=0
    _kbc_field_delete_call "$fid" "$fkey" || drc=$?
    [[ "$drc" -eq 3 ]] && return "$KBC_RC_UNVERIFIED"
    [[ "$drc" -eq 0 ]] || return 1
    echo "kbcard: field '$fkey' (id $fid) deleted from board $KB_BOARD_ID" >&2
}

# --- field retype: the server's atomic conversion, called once ---------------
# `type` was immutable via PATCH until the API grew a conversion route, which made
# re-typing a CLIENT-SIDE delete -> recreate -> restamp -> verify sequence: it could
# not be atomic, so every step between the DELETE and the last restamp was a
# half-migrated board a crash could leave behind, and this file carried a whole
# apparatus (a cast matrix, a pre-flight plan, a stranded-board report and the
# finishing command to print) whose entire job was to make that window survivable.
# The server now owns the conversion — one transaction over the definition AND every
# stored payload value keyed by it, with the search index rebuilt inside it and no
# delete, so `placeholder` / `mask` / `multiline` / `is_filterable` / `position`
# survive, which delete-and-recreate could never do. The apparatus is therefore
# DELETED rather than kept in step: this verb holds no opinion the server holds.
#
# _kbc_field_change_type_call <field-id> <body>: the ONE POST site for the
# conversion route, emitting "<http>\n<body>".
#
# kb_api_status, not kb_api, for two reasons that are both load-bearing:
#   * FIVE statuses are five different boards — 200 converted · 412 the type moved
#     under us (CAS), nothing written · 413 over one of the server's two resource
#     rails, nothing written · 422 refused (a type PAIR that has no conversion, or
#     named offending cards) · 404 the definition is gone. kb_api collapses all of
#     them to rc 1.
#   * the ref-impact handshake must READ a 422's body (it carries the id set the
#     second call has to acknowledge), and kb_api sends an error body to stderr,
#     where no caller can capture it.
_kbc_field_change_type_call() {
    kb_api_status POST "/custom_fields/$1/change-type.json" "$2"
}

# _kbc_unfinished_write_note <re-run-sentence>: the ONE wording for a write whose
# TRANSPORT never completed, printed as the tail of the caller's own sentence.
#
# It exists because "nothing was written" is not a readable outcome here. kb_api_status
# maps EVERY non-zero curl exit to "000" and kb_api answers $KB_API_RC_TRANSPORT for all of
# them alike — including exit 28 (--max-time, which KB_CURL_MAX_TIME turns on for every
# request this lib makes) and a connection reset mid-response, where the server may already
# have COMMITTED the transaction. The lib's own header states exactly that and names this bin
# as one of the writers it applies to. So a run that meets this state has read no answer
# at all, and the two sentences it can honestly say are: this is UNKNOWN, and its caller
# can name a way to resolve it — a re-run where one is idempotent, and otherwise the read
# that says WHICH re-run resolves it (see the owner below). Both call sites — the conversion's 000 arm and the
# restamp pass's failed PATCH — make the same claim about the same transport, so they
# make it in one place: a second spelling would drift into "nothing was written" again on
# whichever side was edited last.
#
# WHAT IT NO LONGER OWNS, and why. It used to print `Re-run this exact command:` itself
# and take only the clause after it. That directive is NOT invariant across its callers:
# on the conversion path a command carrying --options is refused (422) once the
# conversion has landed, so "this exact command" is the wrong command to name — see
# _kbc_field_conversion_rerun_note, which owns that whole sentence for both arms that
# print it. This owner states the UNKNOWN half, and the caller hands in the re-run
# sentence its own path can honestly make.
#
# ⚠ THE UNKNOWN HALF IS NOT TRUE OF EVERY CALLER. It holds on the conversion's 000 arm,
# which read no answer at all. It does NOT hold on the restamp pass's failed-PATCH
# bucket: that bucket is filled by `kb_api PATCH … || patch_failed+=(…)`, a BARE `||` that
# catches every non-zero rc alike — so a card whose PATCH the server REFUSED (403/404/422/
# 500, with that status already on stderr from kb_api itself absent KB_API_QUIET) is still
# told here that the request did not complete.
#
# THE PRIMITIVE NO LONGER MERGES THE TWO — this caller does (card#6680). kb_api now answers
# 1 when the server ANSWERED non-2xx and $KB_API_RC_TRANSPORT when the request did not
# complete, so the bucket above CAN be split (capture the rc, and the answered-non-2xx side
# gets a sentence naming the status instead of this one). That split changes what this pass
# REPORTS to an operator about a WRITE it may or may not have landed, so it is not made in
# the same change as the primitive; it is recorded on card#6680. What changed here is only
# that the obstacle is no longer the lib's contract.
#
# THE ONE CALL SITE THAT DID MOVE with the primitive is board-stats' changelog window, and
# the difference is why: that arm was already PRINTING a status, and printing a fabricated
# one — `HTTP 000` read off the global across a `$( … )` on every failure, transport or not,
# with kb_api's own status line suppressed. Its reads are all GETs, so no write-ambiguity
# sentence had to be re-decided; it stopped stating a false fact rather than started stating
# a new one.
_kbc_unfinished_write_note() {
    printf '%s' "the request did not complete, so this run CANNOT say whether it landed — a write the server already committed answers a timed-out or reset connection exactly as one that never arrived does. $1"
}

# _kbc_field_conversion_rerun_note <have-options> <restamp-dl> <landed-known> <from> <to>:
# the ONE sentence naming the re-run that resolves a conversion this run could not read
# the outcome of — the 000 transport arm and the 2xx whose body nothing could be read out
# of, which are the two arms that tell the operator to run the command again.
#
# WHY IT IS CONDITIONAL ON --options. CustomFieldMutator::typeGates calls
# assertOptionsMatchTarget BEFORE the `$from === $toType` no-op short-circuit, and that
# helper throws a plain ValidationException for same-type + non-null options ("This
# request does not change the type, so it is an options edit — send it to PATCH …"). So
# once the conversion has landed, the SAME command with --options still on it does not
# answer as a server-side no-op: it answers 422, and the arm reporting that 422 names
# only what the server said. "Re-running is safe" is true of the request WITHOUT them and
# false with them, which makes it a claim about the command, not about the route.
#
# WHY <landed-known> DECIDES THE SHAPE OF THE --options BRANCH, not just its wording.
# With options on the command there is no directive that is true on both sides of "did it
# land?": dropping them is right once it HAS landed and wrong while it has NOT (the
# conversion still has to happen, and the options are part of what is being asked), and
# keeping them is the exact mirror. An arm that KNOWS it landed can name one, and the 2xx
# arm does — the server does not answer 2xx for a refusal — so it prescribes the drop
# outright. The 000 arm cannot: it read no answer at all, which is the entire reason it
# exists. So it prescribes the READ first — 'field list', the same resolution the 412 arm
# already sends the operator to — and branches on what the read shows. That first step is
# correct whichever way the write went, so the sentence cannot be false on either branch;
# a single unconditional directive here can only be right by predicting which branch the
# operator is on, and three fix rounds on this sentence each picked one and were wrong on
# the other. The type names are what the branches are READ against, so they are handed in
# from the request rather than re-derived here (on a 000 there is no response to derive
# them from at all).
#
# ONE OWNER, BOTH SITES, and the predicates carried in rather than re-decided at each: the
# two sites spelling this claim separately is exactly how the 000 arm — whose whole job is
# to resolve "did the write land?" — came to prescribe a resolution the server refuses,
# while its sibling was corrected. _kbc_field_change_type_report cannot see the flag (it
# reports a response, not a request), so `have_options` is a parameter of that report, and
# every site calls this owner with the same argument shape for the same reason.
_kbc_field_conversion_rerun_note() {
    local note
    if [[ -n "$1" && -z "$3" ]]; then
        note="Re-read the definition FIRST ('field list'), because what to re-run depends on which way the write went: if it now reads '$5', the conversion LANDED, so re-run it WITHOUT --options — the server reads options on a request that changes no type as an OPTIONS EDIT and refuses it (422, sending it to the PATCH route, which is where an option-set change belongs); if it still reads '$4', it did NOT land, so re-run this exact command — the conversion has yet to happen and its options ride with it."
    elif [[ -n "$1" ]]; then
        note="Re-run it WITHOUT --options: a conversion that already landed answers as a server-side no-op, but only on a request carrying no options — the server reads options on a request that does not change the type as an OPTIONS EDIT and refuses it (422, sending it to the PATCH route), so this exact command re-run unchanged answers that refusal instead of resolving anything, and an option-set change goes through that route."
    else
        note="Re-run this exact command: a conversion that already landed answers as a server-side no-op, so re-running is safe."
    fi
    [[ -n "$2" ]] && note="$note That re-run RUNS the --restamp-dl pass this run skipped. Whether that pass FINISHES is its own outcome, which it reports — a stored value that is not a DL number is canonicalized by no run of it."
    printf '%s' "$note"
}

# _kbc_field_change_type_report <field-id> <http> <body> <key> <from> <to> <have-options>:
# one non-2xx outcome, in this tool's words AND the server's own. Both calls of the
# ref-impact handshake fail through here, so the refusal vocabulary cannot drift
# into two spellings.
#
# <have-options> is the REQUEST's predicate, not the response's, and it is here for one
# arm. 000 is NOT the only outcome this function reports that prescribes a re-run — 412,
# the zero-offender 422 and the offender-cap notice each name one too — but it is the
# only one whose re-run can meet the conversion ALREADY LANDED AS ASKED, i.e. a same-type
# request, which is the shape --options turns into a 422; so it is the only one where
# what a re-run does depends on whether --options rode along (see
# _kbc_field_conversion_rerun_note). The other three name a re-run of a conversion that
# demonstrably did not happen: the two 422s wrote nothing and left the type where it was,
# and 412 reports a type that MOVED and sends the operator back to 'field list' before
# re-running rather than promising a no-op. It is plumbed rather than re-derived from the
# body, which on a 000 does not exist.
#
# The status line + the raw body mirror what kb_api prints on a non-2xx under
# KB_API_ERRBODY=1, and the failure-log append mirrors its log line: kb_api_status is
# silent by design, and this is the one call in this file whose refusal IS the
# preflight — every offending card is named in that body, so dropping it would throw
# away the only report of what blocks the conversion.
_kbc_field_change_type_report() {
    local fid="$1" http="$2" resp="$3" fkey="$4" from="$5" to="$6" have_options="$7"
    local path="/custom_fields/$fid/change-type.json"
    echo "kbcard: HTTP $http on POST $path (field '$fkey': $from -> $to)" >&2
    echo "$resp" >&2
    [[ -n "${KB_LOG_FILE:-}" ]] && echo "$(date -u +%FT%TZ) POST $path HTTP-$http $resp" >> "$KB_LOG_FILE"
    # Empty unless the body is a JSON OBJECT, which is the shape every arm below
    # INDEXES — an "is it JSON" test hands a scalar or a list straight to `has(…)`,
    # where the read yields nothing and the arm it lands in makes claims about a
    # refusal nobody read. Every arm below states only what a body it actually read
    # supports.
    local readable; readable="$(kb_parse_resp "$resp" -r 'select(type == "object") | type')"
    case "$http" in
        412) echo "kbcard: the field's type CHANGED UNDER YOU — the board says '$(kb_parse_resp "$resp" -r '.actual // empty')' where this call was sent against '$(kb_parse_resp "$resp" -r '.expected // empty')'. NOTHING was written. Re-read the definition ('field list') and re-run: the conversion you asked for may no longer be the one you want." >&2 ;;
        # TWO rails answer 413, and they are not the same measurement: the board-scan
        # rail counts the BOARD's cards, the examined-carriers rail counts the cards
        # holding a value for THIS field. A client sentence naming either one is a false
        # claim on the other — a 6000-card board is nowhere near the board rail and can
        # still be over the carrier rail. Which rail it was is in the server's message,
        # which is echoed above, and that message is also the only place the
        # operator-supervised escape hatch exists; so this line frames the CLASS and
        # names nothing the server has not said.
        413) echo "kbcard: the conversion is over one of the server's RESOURCE rails for a type change — NOTHING was written. A rail bounds what one request may hold locks over; it is not a refusal of the conversion, and the server's message above names WHICH rail and the operator-supervised command to run instead." >&2 ;;
        # The mechanism is deliberately NOT named: implicit route-model binding answers
        # 404 before changeType is entered at all, and the mutator's own re-read under the
        # row lock throws the same 404 from inside the transaction. This run cannot tell
        # those apart, and it does not need to — neither writes anything.
        404) echo "kbcard: custom field id $fid is GONE — it was deleted since this run read the field index. Nothing was written." >&2 ;;
        # The re-run this arm names is NOT always the command that was run: with --options
        # on it, a conversion that landed refuses the identical request as an options edit,
        # and this arm is the one that cannot say whether it landed. So it hands the owner
        # an EMPTY <landed-known> and gets the read-then-branch sentence, against the types
        # this request was made with. The restamp pass is not named here on either branch —
        # this arm reports a response and holds no opinion about a pass only a 2xx reaches.
        000) echo "kbcard: the conversion request FAILED in transport (curl) — $(_kbc_unfinished_write_note "$(_kbc_field_conversion_rerun_note "$have_options" "" "" "$from" "$to")")" >&2 ;;
        422)
            # THREE 422 SHAPES, not two, and the third is why this is a three-way and not
            # the server's own two-way. The conversion's own refusals both carry `meta`
            # (the pair refusal and the offender refusal, told apart by the PRESENCE of
            # `meta.offenders` — the server's documented discriminator). The option RULES
            # throw a plain Laravel ValidationException, which renders `{message, errors}`
            # and NO `meta` at all — MEASURED on the sandbox: an omitted `--options` on a
            # `string -> enum` answered exactly that. Discriminating on `meta.offenders`
            # alone therefore reported the whole third class as a pair refusal, i.e. told
            # the operator that a conversion the server defines does not exist, and sent
            # them to fix the wrong thing. `meta` present is what says the refusal came
            # from the conversion at all.
            if [[ -z "$readable" ]]; then
                echo "kbcard: the conversion was REFUSED and no refusal could be read out of the body — nothing was written, and this run cannot say which rule or which cards refused it." >&2
            elif [[ "$(kb_parse_resp "$resp" -r 'has("meta")')" != "true" ]]; then
                # NO ENUMERATION OF THE RULES. This line used to list them, and the list
                # was a client-side copy of assertOptionsMatchTarget that had already gone
                # stale: it named three of four and omitted the one an operator most
                # plausibly reaches — same-type + options, "this is an options edit" —
                # which is precisely what a re-run of a landed --options conversion trips.
                # A copy of the server's rule set can only ever drift out of step with it;
                # the body echoed above names the rule that actually fired.
                echo "kbcard: the server REFUSED this request as invalid — nothing was written, and no card value was examined. The message above IS the rule that refused it: every rule about --options is the server's, and they all answer here." >&2
            elif [[ "$(kb_parse_resp "$resp" -r '.meta | has("offenders")')" != "true" ]]; then
                # The PAIR refusal: the conversion does not exist between these two types
                # at all, decided before a single task row was read — no card is at fault.
                echo "kbcard: the server defines NO conversion from '$from' to '$to' — this is refused on the TYPE PAIR, before any card value is read, so nothing on the board is at fault and nothing was written." >&2
            else
                local oc shown
                oc="$(kb_parse_resp "$resp" -r '.meta.offender_count // 0')"
                shown="$(kb_parse_resp "$resp" -r '.meta.offenders | length')"
                # ZERO offenders is a REAL body, not a degenerate one: the server sends
                # the scan's own offender list with every conversion refusal, and the
                # acknowledgement check refuses an acknowledged set against a scan that
                # derived NONE — reachable from --accept-ref-impact when the ref impact
                # disappears between this run's two calls. "0 card value(s) block this
                # conversion" then sends the operator looking for cards that do not
                # exist, on a run whose actual fault is the request.
                if [[ "$oc" == "0" ]]; then
                    echo "kbcard: the server REFUSED the conversion while naming NO offending card — NOTHING was written. The board WAS scanned and no card value blocks the conversion, so what was refused is the REQUEST: the server's message above is the rule that refused it. The shape this run can reach is an acknowledgement the scan no longer agrees with (the correlation move --accept-ref-impact acknowledged is gone from the set re-derived under the row lock) — re-run PLAIN, without the flag, and the conversion may simply carry." >&2
                else
                    echo "kbcard: $oc card value(s) block this conversion — NOTHING was written. The whole board is scanned BEFORE anything is written, so this refusal IS the preflight: there is no separate check mode over HTTP." >&2
                fi
                kb_parse_resp "$resp" -r '.meta.offenders[]? | "kbcard:   card \(.task_id) [\(.category)] \(.reason) — value: \(.value)"' >&2
                # Read BEFORE the truncation notice, because it is what the notice's advice
                # branches on — not merely what the line below prints.
                local ref_ids
                ref_ids="$(kb_parse_resp "$resp" -c '.meta.ref_impact_task_ids // empty')"
                if [[ "$(kb_parse_resp "$resp" -r '.meta.offenders_truncated // false')" == "true" ]]; then
                    # "Fix these and re-run to see the rest" is FALSE for the class this
                    # notice most often fires on. meta.ref_impact_task_ids is present only on
                    # a ref-impact refusal, and reaching one means every BLOCKING offender is
                    # a ref-impact one (assertOffendersClearOrAcknowledged throws the value
                    # refusal first whenever blocking > |ref_impact_ids|) — so there is
                    # nothing to fix, and the uncapped id set is printed below anyway. The
                    # one thing true of BOTH classes is the rule the --accept-ref-impact path
                    # already states: the cap applies to the refusal itself.
                    if [[ -n "$ref_ids" && "$ref_ids" != "[]" ]]; then
                        echo "kbcard:   ⚠ the server caps the list it names: $shown of $oc offender(s) are named above, and the cap applies to the refusal itself, so re-running does not widen it. There is nothing to FIX here — a ref-impact refusal is acknowledged, not repaired, and the full uncapped card-id set is named below." >&2
                    else
                        echo "kbcard:   ⚠ the server caps the list: $shown of $oc offender(s) are named above, and the cap applies to the refusal itself, so re-running unchanged does not widen it. Fix the named ones and re-run: the next refusal names the next batch." >&2
                    fi
                fi
                if [[ -n "$ref_ids" && "$ref_ids" != "[]" ]]; then
                    echo "kbcard:   the cards whose external-reference correlation this conversion would MOVE: $(jq -r 'map(tostring) | join(", ")' <<<"$ref_ids")" >&2
                fi
            fi ;;
        *) echo "kbcard: the conversion was refused (HTTP $http) — nothing was written." >&2 ;;
    esac
    return 0
}

# _kbc_field_census_scope_note <key> <server-scanned> <converted-count>: the ONE
# wording for what this pass's census IS, printed as the tail of every line that could
# otherwise be read as "the field is done".
#
# It exists because "nothing left to canonicalize" is a claim about a population this
# pass never reads. The conversion's population is CustomFieldMutator::candidateQuery —
# withTrashed()->where(board_id)->whereNotNull(payload->key), no archive filter and no
# soft-delete filter — while the census is GET /tasks/search.json, which applies the
# default SoftDeletes scope AND whereNull(archived_at). The count compare below can
# PROVE a remainder (n_conv > len) and can never rule one out, for two independent
# reasons: it compares COUNTS taken at two different moments, not sets, so live-side
# growth between the conversion and the census masks an archived carrier one-for-one;
# and on the server's no-op path nothing is scanned at all, so the count it reports is
# not a measurement of anything. Hence this note is UNCONDITIONAL on those lines.
#
# It is deliberately NOT folded into _kbc_unfinished_write_note. That owner says one
# specific thing — a WRITE whose transport never completed cannot be reported as landed
# or as not-landed — and its two call sites are transport failures. This says something
# about a POPULATION, on runs where every write this pass made completed and was
# verified. One owner per claim; sharing them would put census prose on the conversion's
# 000 arm, which never runs a census.
#
# The population fact ITSELF is _kbc_field_census_population_note's, embedded above: it
# is the same fact the census line prints on every run of both write verbs, and a second
# spelling of it here is how one of them would end up qualified and the other not. What
# is this note's own is the layer on top — the compare against the conversion's count,
# which is a statement only the restamp pass is in a position to make.
_kbc_field_census_scope_note() {
    local fkey="$1" scanned="$2" n_conv="$3" why
    if [[ -n "$scanned" ]]; then
        why="the server's own converted count ($n_conv) is not more than this census returned — a FLOOR, not a proof, because the two are counts taken at different moments rather than sets: a carrier entering the live set between the conversion and this read masks an archived one, one for one"
    else
        why="the server converted NOTHING on this run (it answered the same-type no-op, so no scan ran and its converted count measures no population at all) — this run had nothing to compare its census against"
    fi
    printf '%s' "⚠ SCOPE: this is a statement about the cards this pass can SEE, not about '$fkey'. $(_kbc_field_census_population_note "$fkey"), while the conversion's population is EVERY carrier of the key including archived and soft-deleted ones; those were never read here, and $why. A remainder can be PROVEN by this pass and never ruled out by it."
}

# _kbc_field_rerun_note <finishable-count> <notdl-count>: the ONE sentence about what
# re-running actually does, shared by the two arms that print one.
#
# "Re-running this exact command finishes the rest" was false in two directions at once.
# A value that is not a DL number is refused by kb_dl_canon IDENTICALLY on every pass —
# no re-run has ever written one, and none ever will; it needs the VALUE corrected, not
# another run — so "the rest" always over-promised whenever that bucket was non-empty.
# And when it is the ONLY bucket left (reachable: the clean arm above requires all four
# empty, so one non-empty notdl with nothing else lands here), the line was telling the
# operator to run a command that provably does nothing.
#
# THE CARVE-OUT IS CONDITIONAL, and deliberately not the unconditional treatment
# _kbc_field_census_scope_note gets two functions up. The difference is what kind of
# fact each one states: the census scope holds on EVERY run of this pass on every board
# (it never reads an archived carrier, ever), while a non-DL remainder is a property of
# THIS board measured on THIS run. Naming an exception that did not occur is the same
# defect one size down — it is exactly what made the offender-cap notice's "fix these
# and re-run" wrong for the class it fires on. Invariant facts unconditionally; measured
# ones only where measured. Do not "harmonize" the two.
_kbc_field_rerun_note() {
    local finishable="$1" n_notdl="$2" note
    if [[ "$finishable" -gt 0 ]]; then
        note="Re-running this exact command finishes the $finishable card(s) above that a re-run can finish: the conversion half is now a server-side no-op, and a card already holding the canonical form is left unwritten."
    else
        note="Re-running this exact command would change NOTHING: nothing reported above is something a re-run acts on."
    fi
    [[ "$n_notdl" -gt 0 ]] && note="$note The $n_notdl NOT-a-DL-number value(s) are not among them: kb_dl_canon refuses the same stored value identically on every pass, so those need the VALUE corrected, never another run."
    printf '%s' "$note"
}

# _kbc_field_restamp_dl <key> <converted-count> <server-scanned>: --restamp-dl's pass,
# AFTER a conversion the server has already committed. It is not part of the conversion
# and cannot be: the cast matrix's text rule for a `number` source is json_encode, so the
# stored number 1 converts to the string "1" — never "DL-0001". Correlation is not at risk
# (the server canonicalizes DL-028 / 28 / #28 to one key), but a custom-field DSL
# filter written as `DL-0001` string-MISSES a card storing "1", so a conversion
# alone leaves the DL migration half-done.
#
# Every value is rendered through kb_dl_canon — the ONE canonical DL renderer that
# next-dl and adopt-to-dl also stamp through. A second spelling of DL-%04d here is
# exactly the divergent implementation that makes two stored forms of one key, i.e.
# the defect this pass exists to repair.
#
# SEVEN OUTCOMES, reported as the seven different boards they are, because "verified"
# is a claim about a card that only some of them support:
#   canonicalized      — written, then RE-READ and confirmed on the authoritative GET.
#   already canonical  — the census (an authoritative board read) already shows the
#                        canonical form, so no write is issued at all. This is what
#                        makes re-running the whole command cost zero writes.
#   PATCH failed       — the write did not complete, so the card is NOT verifiable and
#                        is never counted as verified (the pass-1 defect this must never
#                        re-mint) — and equally not reportable as untouched: see
#                        _kbc_unfinished_write_note, whose transport this shares.
#   read back different— written, and the re-read disagrees: an observed state.
#   unverifiable read  — the verification GET failed, or 2xx'd with a body no value
#                        could be read out of. This run observed NOTHING about the
#                        card; "still holds its old value" would be a claim about a
#                        board nothing read.
#   not a DL number    — the stored value cannot be canonicalized at all. Skipped,
#                        never written, and never counted as done.
#   outside the census — the conversion converted MORE carriers than this pass can see.
#                        Never written, never seen, and PROVEN to exist. Its absence
#                        proves nothing in return: no run of this pass may claim
#                        completeness, whether or not it meets this outcome — see the
#                        population note below and _kbc_field_census_scope_note.
#
# <converted-count> is the server's OWN meta.converted_task_count from the conversion
# that just landed, and it is passed in for one reason: it is the only number in this
# run derived from the population the conversion actually touched.
#
# <server-scanned> is non-empty exactly when the server actually SCANNED — i.e. the
# conversion was a real one and not the same-type no-op. It is carried in EXPLICITLY
# rather than re-inferred from `n_conv == 0`, because "a real conversion that touched
# zero carriers" and "a no-op that scanned nothing" are two different boards and only
# the first makes converted_task_count a measurement. Without it, the no-op re-run this
# tool's own remediation lines tell the operator to make — the one run in the sequence
# that emits the clean line — computes a remainder of 0 by construction.
#
# EVERY "re-run this exact command" BELOW IS HONEST, and it is honest by reachability
# rather than by wording: this pass runs only after a 2xx, and --restamp-dl forces
# --to string, on which the server refuses --options twice over (prohibited on a scalar
# target; an options edit on a same-type request) — both 422, both before any 2xx. So no
# run reaching these lines carried --options, and the identical re-run cannot meet the
# options-edit refusal the CONVERSION's own arms have to name
# (_kbc_field_conversion_rerun_note). Change either half of that — the flag's --to
# string guard, or the server's option rules — and these lines need that owner too.
_kbc_field_restamp_dl() {
    local fkey="$1" n_conv="${2:-}" scanned="${3:-}" rows len i tid stored canon want body resp got unseen=0
    local -a done_ids=() already=() patch_failed=() mismatch=() unread=() notdl=()
    rows="$(_kbc_field_populated "$fkey")" || {
        echo "kbcard: ⚠ the conversion LANDED, but --restamp-dl did NOT run: the board read above did not return a complete card list, and a canonicalization pass over a partial board leaves an unknown remainder. No card was rewritten. Re-run this exact command once the board reads whole — the conversion half is then a server-side no-op." >&2
        return 1
    }
    len="$(jq 'length' <<<"$rows")"
    # THE TWO POPULATIONS ARE NOT THE SAME ONE, and only this compare can see it.
    # The conversion's population is CustomFieldMutator::candidateQuery —
    # withTrashed()->where(board_id)->whereNotNull(payload->key) — with no archive
    # filter and no soft-delete filter, so EVERY archived and EVERY trashed carrier was
    # converted. This census reads GET /tasks/search.json, which applies the default
    # SoftDeletes scope AND whereNull(archived_at) unless asked otherwise: those same
    # carriers are invisible to it. Without the compare the run reports "N of N
    # canonicalized and verified" over a denominator that is not the population, exits
    # 0, and an arbitrary number of cards permanently hold "1" instead of "DL-0001" —
    # un-archiving any one of them puts a non-canonical value back into the live set.
    # The remainder is REPORTED, never chased: extending the census to archived/trashed
    # cards would start PATCHing soft-deleted rows, which is a different decision than
    # this pass is entitled to make. Shape-guarded through kb_is_uint — the ASCII-digit
    # owner, never a bare bracket range, which is a COLLATION range under a UTF-8 locale
    # (card#5409) — because the value is echoed text off the wire, not a local integer.
    if kb_is_uint "$n_conv" && [[ "$n_conv" -gt "$len" ]]; then
        unseen=$(( n_conv - len ))
    fi
    if [[ "$len" -eq 0 ]]; then
        if [[ "$unseen" -gt 0 ]]; then
            echo "kbcard: ⚠ --restamp-dl canonicalized NOTHING and cannot say the field is done: no card this pass can SEE carries '$fkey', yet the conversion converted $n_conv card value(s). All $unseen of them are archived or soft-deleted carriers no board read this tool makes returns; each still holds what the conversion left it with, and un-archiving one puts a non-canonical value into the live set." >&2
            return 1
        fi
        # NOT "no card carries '$fkey'" — that is a statement about the board, and every
        # carrier of the key can be archived while this reads zero.
        echo "kbcard: --restamp-dl: no card this pass can SEE carries '$fkey' — nothing here to canonicalize. $(_kbc_field_census_scope_note "$fkey" "$scanned" "$n_conv")" >&2
        return 0
    fi
    for ((i = 0; i < len; i++)); do
        tid="$(jq -r --argjson i "$i" '.[$i].task_id' <<<"$rows")"
        # The stored value as TEXT — a non-string is rendered with tojson so a value
        # the conversion left as a container (or a number) reaches kb_dl_canon as
        # something it can refuse by name, rather than as an empty string.
        stored="$(jq -r --argjson i "$i" '.[$i].value | if type == "string" then . else tojson end' <<<"$rows")"
        # kb_dl_canon speaks for itself on a non-DL value (it names the value); this
        # collects the ids so the run's own summary can name every one of them at once.
        if ! canon="$(kb_dl_canon "$stored")"; then
            notdl+=("$tid ('$stored')")
            continue
        fi
        if [[ "$stored" == "$canon" ]]; then
            already+=("$tid")
            continue
        fi
        body="$(jq -nc --arg k "$fkey" --arg v "$canon" '{payload: {($k): $v}}')"
        # The v3 payload PATCH merges per-key, so writing this one key leaves every
        # other payload key on the card alone.
        kb_api PATCH "/tasks/$tid.json" "$body" >/dev/null || { patch_failed+=("$tid"); continue; }
        # VERIFY on the authoritative GET, never on the PATCH's own echo. Both sides
        # are jq -c ENCODINGS, so the JSON type rides in the compare.
        resp="$(kb_api GET "/tasks/$tid.json")" || { unread+=("$tid"); continue; }
        # shellcheck disable=SC2016  # $k is a jq --arg, not a shell variable
        got="$(kb_parse_resp "$resp" -c --arg k "$fkey" '.data.payload[$k]')"
        want="$(jq -nc --arg v "$canon" '$v')"
        if [[ -z "$got" ]]; then
            unread+=("$tid")
        elif [[ "$got" == "$want" ]]; then
            done_ids+=("$tid")
        else
            mismatch+=("$tid")
        fi
    done

    # NO ARM BELOW MAY CLAIM THE FIELD IS DONE — this one included. $unseen is a
    # one-directional instrument: it PROVES a remainder and can never rule one out.
    # (i) it is a difference of two COUNTS taken at two different moments, not of two
    # sets, so 2 converted live carriers + 3 archived ones, with 3 new live carriers
    # appearing before this census, reads len=5 / n_conv=5 / unseen=0 with the archived
    # remainder fully intact; and (ii) on the server's same-type no-op nothing is
    # scanned and converted_task_count is 0, so `n_conv > len` is structurally false no
    # matter what the board holds — which is precisely the run the remediation lines
    # below tell the operator to make. So the census-scope note rides this line
    # UNCONDITIONALLY, and the explicit `$unseen > 0` report below stays exactly what it
    # was: the stronger, counted statement, made only where the pass can prove it.
    if [[ ${#patch_failed[@]} -eq 0 && ${#mismatch[@]} -eq 0 && ${#unread[@]} -eq 0 && ${#notdl[@]} -eq 0 && "$unseen" -eq 0 ]]; then
        echo "kbcard: --restamp-dl: ${#done_ids[@]} of $len card value(s) canonicalized and verified, ${#already[@]} already canonical (left unwritten). $(_kbc_field_census_scope_note "$fkey" "$scanned" "$n_conv")" >&2
        return 0
    fi
    # The buckets a re-run ACTS on. notdl is deliberately not in it (kb_dl_canon refuses
    # the same value every pass) and neither is unseen (never read), which is what makes
    # the re-run sentence below able to be true.
    local finishable=$(( ${#patch_failed[@]} + ${#mismatch[@]} + ${#unread[@]} ))
    echo "kbcard: ⚠ the conversion LANDED, but --restamp-dl did not finish: ${#done_ids[@]} of $len card value(s) canonicalized and verified, ${#already[@]} already canonical." >&2
    if [[ ${#patch_failed[@]} -gt 0 ]]; then
        echo "kbcard:   the restamp PATCH FAILED on ${#patch_failed[@]} card(s): ${patch_failed[*]} — $(_kbc_unfinished_write_note "Re-run this exact command: a card already holding the canonical form is left unwritten, and one that does not is rewritten and re-read.")" >&2
    fi
    if [[ ${#mismatch[@]} -gt 0 ]]; then
        echo "kbcard:   read back a DIFFERENT value on ${#mismatch[@]} card(s): ${mismatch[*]} — they do not hold the canonical form (the write did not land, or something rewrote them between it and this read), so a DSL filter spelled DL-NNNN will silently skip each of them." >&2
    fi
    if [[ ${#unread[@]} -gt 0 ]]; then
        echo "kbcard:   the verification read could not observe ${#unread[@]} card(s): ${unread[*]} — their state is UNKNOWN (the GET failed, or returned a body no value could be read out of); the restamp may well have landed. Re-running is idempotent: re-run and re-read them." >&2
    fi
    if [[ ${#notdl[@]} -gt 0 ]]; then
        echo "kbcard:   NOT a DL number, so nothing was written: ${notdl[*]} — the conversion still landed on these cards; only their canonicalization was skipped, and a DSL filter spelled DL-NNNN will not match them." >&2
    fi
    if [[ "$unseen" -gt 0 ]]; then
        echo "kbcard:   OUTSIDE THIS PASS ENTIRELY: the conversion converted $n_conv card value(s), $unseen more than the $len this board read returns. The server converts every carrier keyed by '$fkey' INCLUDING archived and soft-deleted cards; this census reads neither, so those $unseen value(s) were never read and never written, and this run makes no claim about them. Each still holds what the conversion left it with, and un-archiving or restoring one puts a non-canonical value back into the live set — canonicalize it by making the card visible to a board read and re-running, or server-side." >&2
        echo "kbcard:   $(_kbc_field_rerun_note "$finishable" "${#notdl[@]}") And no re-run reaches the $unseen carrier(s) above at all." >&2
        return 1
    fi
    echo "kbcard:   $(_kbc_field_rerun_note "$finishable" "${#notdl[@]}")" >&2
    return 1
}

_kbc_field_retype() {
    local field="" to="" options="" have_options="" accept_ref="" restamp_dl=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --field)              kb_require_value "$1" "${2:-}" || return 2; field="$2"; shift 2 ;;
            --to)                 kb_require_value "$1" "${2:-}" || return 2; to="$2"; shift 2 ;;
            --options)            kb_require_value "$1" "${2:-}" || return 2; options="$2"; have_options=1; shift 2 ;;
            --accept-ref-impact)  accept_ref=1; shift ;;
            --restamp-dl)         restamp_dl=1; shift ;;
            *) echo "kbcard: unknown arg '$1'" >&2; return 2 ;;
        esac
    done
    [[ -z "$field" ]] && { echo "kbcard: field retype requires --field <name|id>" >&2; return 2; }
    [[ -z "$to" ]]    && { echo "kbcard: field retype requires --to <${_KBC_FIELD_TYPES[*]}>" >&2; return 2; }
    _kbc_field_require_type "$to" || return 2
    if [[ -n "$restamp_dl" && "$to" != "string" ]]; then
        echo "kbcard: --restamp-dl canonicalizes to the DL-NNNN string form, so it requires --to string (got '$to')" >&2
        return 2
    fi

    # Resolve the definition. This read is what makes the compare-and-swap FREE, so
    # it is not an optional cost: --field has to be resolved against the board's
    # field index anyway (there is no per-field GET), and the index carries the type.
    local fields fld fid fkey ftype
    fields="$(_kbc_fetch_fields)" || return 1
    fld="$(_kbc_field_resolve "$field" "$fields")" || return 2
    fid="$(jq -r '.id' <<<"$fld")"
    fkey="$(jq -r '.key' <<<"$fld")"
    ftype="$(jq -r '.type' <<<"$fld")"

    # --options is a PASSTHROUGH. Every rule about when options are required,
    # permitted or prohibited belongs to the server (they are required converting
    # INTO enum/multi_select from a non-option source and never inherited from the
    # stored column, optional between the two option types, prohibited otherwise) —
    # and it re-derives all of them under the row lock, against the definition it is
    # about to persist. A client-side copy of those rules could only ever be a
    # SECOND ruling to drift: it would refuse bodies the server accepts, or accept
    # ones it refuses, and either way the operator would be arguing with a rule this
    # tool invented. So the only thing done here is the shape: _kbc_field_option_values
    # is the shared CSV -> value-list owner. Two of its three refusals — an empty list,
    # an empty value — ARE the server's own (options => array|min:1, options.*.value =>
    # required), so they are not a second ruling at all.
    #
    # THE THIRD IS, and it is named rather than counted as one of them: a DUPLICATE value
    # is refused at rc 2 by this tool, and the server has no uniqueness rule on an option
    # set. That is the ONE exception to the passthrough claim above — carried over from
    # `set-options`, whose converge-to-set target genuinely must be distinct — and it is
    # documented as an exception in the usage header, README and the changelog. Dropping
    # it from this path would change what this verb ACCEPTS (rc 2 today, a request),
    # which is a decision this file's callers own; it is recorded as a recommendation.
    #
    # The server's wire shape is [{value, label?}], with an omitted label defaulting to
    # the value — the same choice `field create`'s --options makes, and the reason
    # sending --options at all is lossy between the two option types (the disclosure for
    # that rides the 2xx, below).
    local opts=""
    if [[ -n "$have_options" ]]; then
        opts="$(_kbc_field_option_values "$options")" || return 2
        opts="$(jq -c 'map({value: .})' <<<"$opts")"
    fi

    # from_type is ALWAYS sent. The read above already holds the current type, so the
    # optimistic-concurrency guard costs nothing — and without it a conversion racing
    # another one converts a definition this run never saw, silently. With it, that
    # race is a 412 that writes nothing.
    local body
    body="$(jq -nc --arg t "$to" --arg f "$ftype" '{type: $t, from_type: $f}')"
    [[ -n "$opts" ]] && body="$(jq -c --argjson o "$opts" '. + {options: $o}' <<<"$body")"

    local out http resp ref_ids=""
    out="$(_kbc_field_change_type_call "$fid" "$body")"
    http="${out%%$'\n'*}"; resp="${out#*$'\n'}"

    # Read on the FIRST response only: this is the set the handshake may acknowledge,
    # and the second call's own refusal (if any) reports its own, freshly derived set.
    if [[ "$http" == "422" ]]; then
        ref_ids="$(kb_parse_resp "$resp" -c '.meta.ref_impact_task_ids // empty')"
    fi

    # THE REF-IMPACT HANDSHAKE IS TWO CALLS, and the first one is never skipped —
    # not even with the flag. The set of cards whose external-reference correlation a
    # conversion moves is DERIVED BY THE SERVER under the row lock, and it refuses an
    # acknowledgement that no longer matches what it derived. Sending a set this
    # client guessed, or one carried over from an earlier run, would either be refused
    # or — worse, if it happened to match — would launder the one gate that makes a
    # correlation move a deliberate act into a flag somebody types out of habit. So
    # the flag acknowledges EXACTLY the ids THIS run was just shown, and nothing else.
    if [[ -n "$accept_ref" && -n "$ref_ids" && "$ref_ids" != "[]" ]]; then
        echo "kbcard: --accept-ref-impact: the server's refusal names $(jq 'length' <<<"$ref_ids") card(s) whose external-reference correlation this conversion MOVES — re-sending with exactly that set acknowledged." >&2
        kb_parse_resp "$resp" -r '.meta.offenders[]? | select(.category == "ref_impact") | "kbcard:   card \(.task_id): \((.refs_before // []) | join(" "))  ->  \((.refs_after // []) | join(" "))"' >&2
        # THE TWO META KEYS ARE CAPPED DIFFERENTLY: meta.offenders is truncated at the
        # server's MAX_REPORTED_OFFENDERS, meta.ref_impact_task_ids is not. This path
        # acknowledges the UNCAPPED set and prints from the CAPPED one, and it does not
        # go through _kbc_field_change_type_report, so the truncation notice that arm
        # prints is never reached from here — the operator would see 50 moves and
        # acknowledge 200, against the one property this flag claims (it acknowledges
        # exactly the moves it was shown). Derived from the two counts rather than from
        # meta.offenders_truncated: that flag is about the offender list as a whole,
        # while what matters here is the ref-impact rows against the set being sent.
        local shown_ref n_ref
        shown_ref="$(kb_parse_resp "$resp" -r '[.meta.offenders[]? | select(.category == "ref_impact")] | length')"
        n_ref="$(jq 'length' <<<"$ref_ids")"
        if kb_is_uint "$shown_ref" && [[ "$shown_ref" -lt "$n_ref" ]]; then
            echo "kbcard:   ⚠ the server CAPS the list it names: $shown_ref of the $n_ref moves being acknowledged are shown above, and the acknowledgement covers all $n_ref — including the ones no run has printed (the cap applies to the refusal itself, so re-running does not widen it)." >&2
        fi
        body="$(jq -c --argjson ids "$ref_ids" '. + {acknowledge_ref_impact: $ids}' <<<"$body")"
        out="$(_kbc_field_change_type_call "$fid" "$body")"
        http="${out%%$'\n'*}"; resp="${out#*$'\n'}"
    fi

    if [[ ! "$http" =~ ^2 ]]; then
        _kbc_field_change_type_report "$fid" "$http" "$resp" "$fkey" "$ftype" "$to" "$have_options"
        if [[ -z "$accept_ref" && -n "$ref_ids" && "$ref_ids" != "[]" ]]; then
            echo "kbcard:   To accept exactly those moves, re-run with --accept-ref-impact: it makes this same un-acknowledged call FIRST and acknowledges the set the server reports on THAT run — never a set carried over from this one." >&2
        fi
        return 1
    fi

    local row from_t to_t n_conv
    row="$(kb_parse_resp "$resp" ".data | $_KBC_FIELD_ROW")"
    from_t="$(kb_parse_resp "$resp" -r '.meta.from_type // empty')"
    to_t="$(kb_parse_resp "$resp" -r '.meta.to_type // empty')"
    n_conv="$(kb_parse_resp "$resp" -r '.meta.converted_task_count // empty')"
    # A 2xx nothing can be read out of. The conversion LANDED (the server does not
    # answer 2xx for a refusal), so this refuses the ECHO, not the write — and it
    # must not go on to restamp, because it has not read which conversion happened.
    if [[ -z "$row" || -z "$to_t" ]]; then
        # The re-run sentence is the shared owner's, fed all three predicates: it names
        # the restamp pass only where the flag was passed (without it there is no pass to
        # re-run, and naming one asserts a thing that did not happen — see the rule in
        # _kbc_field_rerun_note's header: invariant facts unconditionally, measured ones
        # only where measured), and it names a re-run WITHOUT --options where the command
        # carried them, because the identical command is refused once the conversion has
        # landed. Both are properties of the request this run made, so both are read off
        # the flags rather than spelled out here.
        #
        # THIS ARM PASSES <landed-known>, and that is what keeps its directive
        # unconditional. The 2xx IS the guarantee — the server does not answer 2xx for a
        # refusal — so the conversion landed as asked, and "drop --options" is simply the
        # right command; sending the operator to 'field list' first would offer to resolve
        # a question this arm has already answered. The 000 arm hands the same owner an
        # EMPTY one and gets the read-then-branch sentence instead, because it read no
        # answer at all. It also hands an EMPTY restamp predicate, so with --restamp-dl
        # this arm names the pass and that one does not — deliberately, since it reports a
        # response and holds no opinion about a pass only a 2xx reaches.
        _kbc_unverified "field retype" "'$fkey'" "The conversion returned HTTP $http and nothing could be read out of its body, so this run cannot say what the definition now is. $(_kbc_field_conversion_rerun_note "$have_options" "$restamp_dl" 1 "$ftype" "$to")"
        return $?
    fi

    # THE CONVERSION IS READ BACK OFF THE BOARD INDEX — the same surface `field delete` and
    # `field set-options` confirm on, and for the same reason: the index is the only read
    # surface a custom field has, and the echo is the write's own answer rather than the
    # board's. It matters more here than at either of them: a conversion that did not take
    # leaves every DSL filter on the key matching the OLD JSON type while `field list` is
    # never consulted, so the failure is invisible from every surface an operator looks at.
    # It runs BEFORE --restamp-dl: a canonicalization pass over a definition this run has not
    # confirmed converted would be rewriting card values against a type it guessed.
    local after fld_after now_t
    after="$(_kbc_fetch_fields)" || {
        _kbc_unverified "field retype" "'$fkey'" "The conversion answered HTTP $http and the board's field set could not be re-read, so the definition's type is UNMEASURED. Treat the conversion as LANDED — the server does not answer 2xx for a refusal — and re-read with 'field list' before running --restamp-dl."
        return $?
    }
    fld_after="$(jq -c --argjson id "$fid" 'first(.[]? | select(.id == $id)) // empty' <<<"$after")"
    if [[ -z "$fld_after" ]]; then
        echo "kbcard: field retype '$fkey': HARD FAILURE — the conversion answered HTTP $http and field id $fid is no longer defined on board $KB_BOARD_ID at all. The status is not the conversion; the read-back is." >&2
        return 1
    fi
    now_t="$(jq -r '.type // "null"' <<<"$fld_after")"
    if [[ "$now_t" != "$to" ]]; then
        echo "kbcard: field retype '$fkey': HARD FAILURE — the conversion answered HTTP $http and the board still declares '$fkey' as type '$now_t', not the '$to' this call asked for. Every DSL filter on that key is matching the OLD type. The status is not the conversion; the read-back is." >&2
        return 1
    fi
    # The server answers a target type equal to the current one as an explicit no-op:
    # 200, no scan, no write, no changelog row. Reporting it as a conversion would
    # claim a write that did not happen — and this is the shape a re-run takes.
    #
    # $scanned is that same fact, kept rather than thrown away: the restamp pass needs
    # to know whether ANY population was examined, and `converted_task_count: 0` cannot
    # tell it (the no-op factory hardcodes it, so it is indistinguishable from a real
    # conversion of zero carriers).
    local scanned=""
    if [[ "$from_t" == "$to_t" ]]; then
        echo "kbcard: field '$fkey' is already type '$to_t' on board $KB_BOARD_ID — the server converted nothing (no scan, no write)" >&2
    else
        scanned=1
        echo "kbcard: field '$fkey' (id $fid) converted $from_t -> $to_t on board $KB_BOARD_ID; the server converted $n_conv card value(s) in the SAME transaction, and rebuilt the search index for '$fkey'" >&2
    fi

    # --options REPLACES the whole options column ($locked->options = $options), and a
    # comma list carries no labels — so between the two option types, sending --options
    # destroys every explicit label the definition carried, behind a 2xx. The
    # definition this run already read is still in hand, so naming the lost labels
    # costs no request. Reported AFTER the 2xx and in the past tense on purpose: on a
    # refusal nothing was written and the labels are still there, and a warning about a
    # loss that did not happen is its own false claim.
    if [[ -n "$have_options" ]] && _kbc_field_type_takes_options "$from_t" && _kbc_field_type_takes_options "$to_t"; then
        local lost
        lost="$(jq -r '[(.options // [])[] | select(.label != null and .label != .value) | "\(.value)=\(.label)"] | join(", ")' <<<"$fld")"
        [[ -z "$lost" ]] || echo "kbcard: ⚠ --options REPLACES the whole option set and a comma list carries no labels, so the label(s) '$fkey' carried are GONE: $lost — every value now has label = value, the server's default for an omitted label. Between two option types, OMITTING --options carries the existing set over verbatim, labels included." >&2
    fi
    printf '%s\n' "$row"

    [[ -n "$restamp_dl" ]] || return 0
    _kbc_field_restamp_dl "$fkey" "$n_conv" "$scanned"
}

cmd_field() {
    local sub="${1:-}"
    [[ -z "$sub" ]] && { echo "kbcard: field requires a sub-verb: list | create | delete | retype | set-options" >&2; return 2; }
    shift
    case "$sub" in
        list)        _kbc_field_list "$@" ;;
        create)      _kbc_field_create "$@" ;;
        delete)      _kbc_field_delete "$@" ;;
        retype)      _kbc_field_retype "$@" ;;
        set-options) _kbc_field_set_options "$@" ;;
        *) echo "kbcard: unknown field sub-verb '$sub' (expected: list | create | delete | retype | set-options)" >&2; return 2 ;;
    esac
}

main() {
    # Optional global `--board NAME` before the subcommand selects the board env.
    local board_name=""
    if [[ "${1:-}" == "--board" ]]; then
        # The highest-stakes instance of the empty-value class: an empty --board falls
        # through to the DEFAULT board, so `--board "$KEY"` with KEY unset writes to a
        # different board than the caller named — a wrong-board write, not a no-op.
        kb_require_value "$1" "${2:-}" || exit 2
        board_name="$2"
        shift 2
    fi
    # Resolves board env + host env + token; sets KB_API / KB_BOARD_ID / KB_TOKEN.
    kb_load_config "$board_name" || exit 2

    # NO ARGUMENTS is a help request; an EMPTY first argument is a failed expansion. One
    # `-z "$cmd"` answered both with the usage block at rc 0, so `kbcard "$VERB" move --task N
    # --column in_progress` with VERB unset was a silent no-op a caller checking rc read as a
    # completed move. Same discriminator as the three positional sites card#5200 fixed — an
    # empty string is not an absent argument — reached here through the same owner, so kbcard's
    # verb refusal cannot drift from theirs. The help path keeps stdout + rc 0 (it is the
    # requested output); the refusal is diagnostic, so stderr + rc 2, matching this file's own
    # unknown-command arm below.
    if [[ $# -eq 0 ]]; then
        # `# \{0,1\}` and not `# `: a paragraph SEPARATOR in this header is a bare `#` with no
        # trailing space (trailing whitespace does not survive an editor or a linter), which a
        # space-requiring strip leaves in the rendered output as a literal `#` between paragraphs.
        sed -n '/^# Usage:/,/^$/p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
    fi
    local cmd="$1"
    kb_require_positional "" "$cmd" "<command>" || exit 2
    shift
    case "$cmd" in
        create-card) cmd_create_card "$@" ;;
        move)        cmd_move "$@" ;;
        reorder)     cmd_reorder "$@" ;;
        patch)       cmd_patch "$@" ;;
        list)        cmd_list "$@" ;;
        stages)      cmd_stages "$@" ;;
        link)        cmd_link "$@" ;;
        unlink)      cmd_unlink "$@" ;;
        show)        cmd_show "$@" ;;
        comment)     cmd_comment "$@" ;;
        comments)    cmd_comments "$@" ;;
        search)      cmd_search "$@" ;;
        archive)     cmd_archive "$@" ;;
        delete)      cmd_delete "$@" ;;
        field)       cmd_field "$@" ;;
        *) echo "kbcard: unknown command '$cmd'" >&2; exit 2 ;;
    esac
}

# run main only when executed directly, so tests/kbcard-selftest.sh can source the pure fns.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then main "$@"; fi
