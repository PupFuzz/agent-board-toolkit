#!/usr/bin/env bash
# next-dl — mint the next DL-NNN for a project's decision log.
#
# Two modes. BOTH prefer the server's authoritative counter; they differ only in
# whether the number is RESERVED.
#
#   DEFAULT (atomic claim, DL-157): when the board's kanban exposes the
#   `dl-sequence/claim` endpoint, next-dl ATOMICALLY claims the next number
#   server-side (race-free across concurrent allocators). A claim RESERVES the
#   number — an unused claim simply burns it (gaps are expected and fine). If the
#   endpoint is absent (older kanban / not deployed) or unreachable, it falls
#   back SILENTLY to the offline max+1 scan below — so behaviour is unchanged
#   until the endpoint ships.
#
#   --peek: return the next number WITHOUT reserving it — reads the board's
#   NON-CONSUMING `dl-sequence` inspect endpoint when reachable, and falls back to
#   the offline max+1 scan only when that endpoint is absent/unreachable, under the
#   same 404-absent vs present-but-errored discipline the claim path uses.
#
# WHY --peek PREFERS THE ENDPOINT (card#6232). --peek used to go straight to the
# offline scan. That scan maxes over DLs that reached a CARD, so a number that was
# CLAIMED but never STAMPED is invisible to it: it under-reports by one per burned
# claim. Measured — it returned DL-0220 on a board whose authoritative next was 222,
# handing back an already-allocated correlation key, which is the one thing an
# allocator must never do. Only the counter knows the claimed-but-unstamped numbers.
# Do not "simplify" this back to the scan: what makes --peek non-consuming is
# skipping the CLAIM, not skipping the read.
#
# The offline max+1 scan — the FALLBACK for both modes — takes the max over BOTH:
#   (1) `## DL-NNN` headers in CLAUDE_DECISIONS.md across every local checkout
#       (so an in-flight DL on a worktree / held PR can't be reused), AND
#   (2) the project's kanban board's stamped `dl_number`s, when reachable.
# (2) closes the collision gap that caused the DL-154 reuse (board card #2643).
# The board check is FAIL-SOFT — an unreachable board/token/API warns and falls
# back to the header scan, never blocking allocation offline. NOTE: the offline
# path is NOT atomic — safe for single-stream allocation; concurrent allocators
# on a shared board need the claim endpoint (the default) to avoid duplicates —
# and, per card#6232 above, it is a FLOOR rather than the truth: it cannot observe
# a claimed-but-unstamped number, so it can only ever under-report.
#
# Minting numbers in the wrong (far-too-high) range? The board's DL counter is
# stranded — recover it over the API: see docs/DL-COUNTER-RECOVERY.md.
#
# Usage: next-dl kanban|bridge|--board <name> [--peek]   (--board: an arbitrary PM-project board)
set -euo pipefail

# Shared toolkit lib (config resolution + whole-board pagination).
KB_LIB="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)/_kb-board-lib.sh"
[ -r "$KB_LIB" ] || { echo "$(basename "${BASH_SOURCE[0]}"): shared lib _kb-board-lib.sh not found next to this script — reinstall per INSTALL.md §3 (symlink all of bin/), or vendor _kb-board-lib.sh alongside this tool." >&2; exit 1; }
# shellcheck source=bin/_kb-board-lib.sh
source "$KB_LIB"
KB_PROG="next-dl"

USAGE='usage: next-dl kanban|bridge|--board <name> [--peek]'
peek=0
project=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --peek|--no-claim) peek=1 ;;
        --board)   # FR-2: an arbitrary PM-project board, not just kanban|bridge
            # TWO refusals, deliberately not one condition. This was a single
            # `[[ -n "${1:-}" && -z "$project" ]]` doing two unrelated jobs: the left
            # operand is the shared flag-value invariant (kb_require_value owns it and
            # names the flag), the right one is next-dl's OWN mutual exclusion — a
            # project named twice — which no value guard can express. Presence is still
            # tested first, so the order the `&&` short-circuited in is unchanged.
            kb_require_value "$1" "${2:-}" || exit 2
            shift
            [[ -z "$project" ]] || { echo "$USAGE" >&2; exit 2; }
            project="$1" ;;
        kanban|board|kanban-board|bridge|agent-bridge)
            [[ -z "$project" ]] || { echo "$USAGE" >&2; exit 2; }
            project="$1" ;;
        *) echo "$USAGE" >&2; exit 2 ;;
    esac
    shift
done
[[ -n "$project" ]] || { echo "$USAGE" >&2; exit 2; }

# Per-project defaults (back-compat). An arbitrary --board <name> resolves its
# board env by the `~/.kanban-<name>-board.env` convention and has no built-in
# offline checkout glob — supply it via KB_DL_CHECKOUT_GLOBS (see below).
case "$project" in
    kanban|board|kanban-board)
        default_patterns=("$HOME/kanbanboard" "$HOME/kanbanboard-*")
        board_env="${KBCARD_BOARD_ENV:-$HOME/.kanban-dev-board.env}" ;;
    bridge|agent-bridge)
        default_patterns=("$HOME/agent-webhook-bridge-*")
        board_env="${KBCARD_BOARD_ENV:-$HOME/.kanban-bridge-board.env}" ;;
    *)
        default_patterns=()
        board_env="${KBCARD_BOARD_ENV:-$HOME/.kanban-${project}-board.env}" ;;
esac

# Offline checkout globs (FR-2): the offline `max+1` header scan reads
# `## DL-NNN` from CLAUDE_DECISIONS.md across these checkouts. KB_DL_CHECKOUT_GLOBS
# (comma-separated patterns; leading `~` expanded) OVERRIDES the per-project
# default so a PM-project adopter's own repos are scanned. The primary atomic-claim
# path is board-config-driven and needs none of this.
patterns=("${default_patterns[@]}")
if [[ -n "${KB_DL_CHECKOUT_GLOBS:-}" ]]; then
    IFS=',' read -r -a patterns <<<"$KB_DL_CHECKOUT_GLOBS"
fi
globs=()
for pat in "${patterns[@]}"; do
    pat="${pat/#\~/$HOME}"
    # shellcheck disable=SC2206  # deliberate glob/word-split of a config-supplied pattern
    expanded=($pat)
    for d in "${expanded[@]}"; do [[ -e "$d" ]] && globs+=("$d"); done
done

# Highest integer in a stream of text on stdin (leading zeros stripped; empty ⇒ empty).
# The shared tail of BOTH max scans below — the DL-header scan and the dl_number scan.
max_int() { grep -oE '[0-9]+' | sed 's/^0*//;s/^$/0/' | sort -n | tail -1; }
# Highest DL number found in a stream of text on stdin (tolerates any DL-NNN form).
max_dl() { grep -oE 'DL-[0-9]+' | max_int; }

# Resolve api/board/token from config (in a subshell so env never leaks into this
# script). Echoes "<api>\t<board>\t<token_file>"; non-zero (with a reason on
# stderr) if curl/jq or any config is missing. kb_resolve_env (shared lib) does
# the board-env + host-env source and the api/token validation; next-dl keeps its
# own project-alias board_env (resolved above) and fail-soft posture.
resolve_board_cfg() (
    command -v curl >/dev/null && command -v jq >/dev/null \
        || { echo "next-dl: curl/jq missing — skipping board check" >&2; exit 1; }
    [[ -r "$board_env" ]] || { echo "next-dl: $board_env unreadable — skipping board check" >&2; exit 1; }
    # Only stdout is muted, NOT stderr: kb_resolve_env's rc-4 refusal (a board env that sets
    # the board-independent KBCARD_API) is its own loud, actionable message, and swallowing it
    # here left the operator with a bare "config incomplete" while next-dl silently lost BOTH
    # the atomic claim and the board's dl_number seed — minting from the local scan alone,
    # which is exactly how a DL gets re-minted on a shared board (the DL-154 collision class).
    local rc
    kb_resolve_env "$board_env" >/dev/null; rc=$?
    [[ $rc -eq 0 ]] && [[ -n "$KB_BOARD_ID" ]] \
        || { echo "next-dl: board config incomplete (rc=$rc) — skipping board check" >&2; exit 1; }
    printf '%s\t%s\t%s' "$KB_API" "$KB_BOARD_ID" "$KB_TOKEN_FILE"
)

# The exit code tells the caller HOW a call failed, so a real endpoint error is never
# masked as "absent" — the bug that made a downstream adopter misdiagnose a deployed
# endpoint as missing. The contract is stated ONCE, on dl_sequence_call below; it is not
# restated per wrapper, because the previous copy of it here had already drifted (it
# assigned "a 2xx with no positive value" to rc 3, while the code has always exited 1
# there — the benign-fallback arm).
# No -f on curl: we need the status to tell 404-absent from a present-but-errored call.
#
# ONE transport for BOTH DL-sequence routes. The claim (POST .../dl-sequence/claim.json,
# `.data.value`) and the peek (GET .../dl-sequence.json, `.data.next`) differ only in
# method, path and response field: everything that MATTERS — the status-case split, what
# counts as "absent", the fallback-vs-abort decision — is identical, and must stay
# identical. Written as two functions (card#6232) it was ~18 duplicated lines held in
# agreement by a comment asking the next editor to keep them in sync; a divergence there
# would not fail any test, it would just make one route quietly answer a 500 by falling
# back to the offline scan. The variable parts are arguments; the contract is code.
#
# dl_sequence_call <method> <path> <jq-field> <endpoint-label> <fallback-risk>
#   0 → the positive integer on stdout.
#   1 → endpoint ABSENT (HTTP 404) or unreachable / no config / a 2xx carrying no usable
#       value — benign; the caller falls back to the offline max+1 scan. A 2xx with no
#       value is deliberately here and not below: it is indistinguishable from an older
#       response shape, so aborting would break every board predating the route.
#   3 → endpoint PRESENT but the call FAILED (any non-2xx other than 404) — surfaced
#       loudly; the caller MUST abort rather than quietly answer from the offline scan.
#       A wrong-but-plausible DL is worse than no DL: it lands in a decision log and
#       becomes a duplicate correlation key nobody re-checks.
dl_sequence_call() (
    method="$1"; path="$2"; field="$3"; label="$4"; risk="$5"
    cfg="$(resolve_board_cfg 2>/dev/null)" || exit 1
    IFS=$'\t' read -r api board token_file <<<"$cfg"
    # Auth via stdin herestring (-H @- <<<) so the token never enters argv (#3569) + portable
    # (no /dev/fd process-sub dependency that breaks native mingw64 curl, #34).
    resp="$(curl -sS -w $'\n%{http_code}' -X "$method" \
        -H @- -H "Accept: application/json" \
        "$api/boards/$board/$path" 2>/dev/null <<<"$(kb_auth_header "$(cat "$token_file")")")" || exit 1   # connection failure → benign fallback
    http="${resp##*$'\n'}"; body="${resp%$'\n'*}"
    case "$http" in
        2[0-9][0-9])
            val="$(printf '%s' "$body" | jq -r "$field // empty" 2>/dev/null || true)"
            kb_is_uint "$val" && [[ "$val" -ge 1 ]] || exit 1   # 2xx but no positive value → benign fallback
            printf '%s' "$val" ;;
        404) exit 1 ;;   # endpoint not deployed — benign; fall back to the offline scan
        *)
            echo "next-dl: the $label is PRESENT but FAILED (HTTP $http) — NOT silently falling back to the offline scan, $risk. Fix the cause (token board-membership? board id? api_base?) and retry. Response: $(printf '%s' "$body" | tr '\n' ' ' | head -c 300)" >&2
            exit 3 ;;
    esac
)

# Atomic server-side claim (DL-157) — CONSUMES a number.
board_claim() {
    dl_sequence_call POST dl-sequence/claim.json .data.value \
        "atomic claim endpoint" \
        "which is not atomic and could re-mint on a shared board"
}

# Authoritative NON-CONSUMING read of the next DL (card#6232) — the whole point of the
# preference: the offline scan maxes over DLs that reached a CARD, so only this route
# knows a number that was claimed but never stamped.
board_peek() {
    dl_sequence_call GET dl-sequence.json .data.next \
        "DL-sequence inspect endpoint" \
        "which cannot see a claimed-but-unstamped DL and would under-report"
}

# DEFAULT: prefer the atomic claim. Fall back to the offline peek ONLY when the
# endpoint is genuinely absent/unreachable (exit 1, the rollout case). A claim that
# FAILED against a PRESENT endpoint (exit 3) is surfaced by board_claim and aborts
# here — silently degrading to the non-atomic scan is what masked AIMLA's real error.
if [[ $peek -eq 0 ]]; then
    if claimed="$(board_claim)"; then crc=0; else crc=$?; fi
    if [[ $crc -eq 0 ]] && kb_is_uint "$claimed"; then
        canon="$(kb_dl_canon "$claimed")" || { echo "next-dl: atomic claim returned '$claimed', not a canonical DL number" >&2; exit 1; }
        printf '%s\n' "$canon"
        exit 0
    fi
    [[ $crc -eq 3 ]] && exit 1   # endpoint present but errored → already surfaced; do NOT mint via the racy scan
fi

# --peek: prefer the authoritative NON-CONSUMING read, with the same fall-through
# shape as the claim above (absent/unreachable ⇒ offline scan; present-but-errored
# ⇒ abort, already surfaced). Kept as a sibling `if` rather than folded into an
# if/else with the claim block: both arms fall through to the SAME offline scan
# below, and an else-branch would have to re-state that.
if [[ $peek -eq 1 ]]; then
    if peeked="$(board_peek)"; then prc=0; else prc=$?; fi
    if [[ $prc -eq 0 ]] && kb_is_uint "$peeked"; then
        canon="$(kb_dl_canon "$peeked")" || { echo "next-dl: the DL-sequence inspect endpoint returned '$peeked', not a canonical DL number" >&2; exit 1; }
        printf '%s\n' "$canon"
        exit 0
    fi
    [[ $prc -eq 3 ]] && exit 1   # endpoint present but errored → already surfaced; do NOT answer from the scan
fi

# Offline fallback (either mode): max+1 over local headers + board-stamped dl_numbers.
max=0

# (1) local CLAUDE_DECISIONS.md headers across all checkouts.
for d in "${globs[@]}"; do
    f="$d/CLAUDE_DECISIONS.md"
    [[ -f "$f" ]] || continue
    n="$(grep -oE '^## DL-[0-9]+' "$f" 2>/dev/null | max_dl)"
    [[ -n "$n" && "$n" -gt "$max" ]] && max="$n"
done

# (2) board-stamped dl_numbers (fail-soft).
board_dl_max() (
    cfg="$(resolve_board_cfg)" || exit 1
    IFS=$'\t' read -r api board token_file <<<"$cfg"
    tok="$(cat "$token_file")"
    # PAGINATE the whole board so the fallback seed sees the TRUE max, not a
    # truncated page 1 — via the shared fetch_board_cards. Exit-code policy
    # (unchanged): a page-1-unreachable (rc 1) is fail-soft (skip the board check);
    # an incomplete read or an over-cap board (rc 2/3) REFUSES (exit 2) — an
    # undercount could re-mint a used DL. NB: even a complete scan is NON-ATOMIC;
    # the atomic claim endpoint is the real fix on a shared board (reached here
    # only when that endpoint is absent).
    cards="$(fetch_board_cards "$api" "$tok" "$board" "${NEXT_DL_PAGE_CAP:-50}")" || {
        rc=$?
        [[ "$rc" -eq 1 ]] && { echo "next-dl: board unreachable — skipping board check" >&2; exit 1; }
        echo "next-dl: board read incomplete or over NEXT_DL_PAGE_CAP — refusing to mint from a partial scan (could re-mint a used DL)" >&2
        exit 2
    }
    # dl_number is stamped in MIXED forms across boards/adopters: a string "DL-093" OR a
    # bare number 93. Extract bare digits so the scan is honest across heterogeneous boards
    # (this is the max over a STREAM — distinct from kb_dl_num's single-token canon, which
    # would reject a leaked >6-digit sentinel mid-stream).
    printf '%s' "$cards" | jq -r '.[]?.payload.dl_number // empty' | max_int
)
# Exit-code convention: 2 = incomplete read (a page fetch failed mid-pagination) ⇒ fail
# loud, do not stamp (undercount could re-mint). 1 = board unreachable on page 1 / no
# board configured ⇒ keep the original fail-soft posture (empty bmax ⇒ mint from the
# local sources below).
# The `if` form is set -e-safe (a non-zero command substitution in a bare
# assignment would otherwise exit before $? is captured).
if bmax="$(board_dl_max)"; then dlrc=0; else dlrc=$?; fi
[[ "$dlrc" -eq 2 ]] && exit 1
kb_is_uint "$bmax" && [[ "$bmax" -gt "$max" ]] && max="$bmax"

[[ "$max" -eq 0 ]] && { echo "next-dl: no DL headers found for '$project' — check the checkout paths" >&2; exit 1; }
canon="$(kb_dl_canon "$((max + 1))")" || { echo "next-dl: computed DL $((max + 1)) exceeds the canonical range" >&2; exit 1; }
printf '%s\n' "$canon"
