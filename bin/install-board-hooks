#!/usr/bin/env bash
# install-board-hooks — install agent-board-toolkit git hooks into a target repo.
#
#     install-board-hooks <repo-dir>
#
#     install-board-hooks --check <repo-dir>   # dry run: print the target dir, install nothing
#
#     install-board-hooks --allow-copies <repo-dir>   # a seat that cannot symlink: install
#                                                     # COPIES, reported AS copies (rc 3)
#
# EXIT STATUS: 0 installed as symlinks (or the dry run's target dir) · 1 refused · 2 usage ·
# 3 installed as COPIES (deliberate, degraded — NOT plain success) · 4 refused because symlink
# capability could not be DETERMINED (distinct from 1's "determined absent" — see below).
#
# INSTALLS BY SYMLINK, AND PROBES FIRST THAT IT CAN. The symlink is the whole upgrade contract:
# a `git pull` in this toolkit checkout updates every installed hook because each hook entry
# points at the source. A seat whose OS/filesystem cannot create symlinks does NOT report a
# failure — a POSIX-emulation layer (Windows/MSYS/Git-Bash with Developer Mode off and no
# elevation) answers `ln -s` with rc 0 after silently substituting a COPY. The install then
# reports plain success while the seat runs hook copies `git pull` never updates: a permanent
# pin that is indistinguishable from a healthy install in every log this tool writes. So
# capability is MEASURED before anything is installed (`_ibh_symlink_probe`), with three
# verdicts and three dispositions:
#   CAPABLE       install symlinks (the unchanged path — every existing caller on a capable
#                 seat sees byte-identical behaviour).
#   NOT_CAPABLE   REFUSE (rc 1), naming --allow-copies. The refusal follows the same shape as
#                 this tool's other refusals: a wrong install here is silent, so it fails closed.
#   INDETERMINATE REFUSE (rc 4) — reported SEPARATELY from NOT_CAPABLE, and that separation is
#                 the point: "we could not determine" collapsed into "we know you cannot" is a
#                 smaller copy of the very information loss this probe exists to end. It also
#                 fails closed THROUGH --allow-copies: that flag opts into a KNOWN degradation
#                 (and records it in the operator's own paper trail), never into an unknown
#                 state, and every INDETERMINATE reason is an actionable local fault. ANY OTHER
#                 probe status lands here too: only 0 selects the install and only 1 selects the
#                 not-capable refusal, so the default is the refusal, never the install.
# --allow-copies is not "force copies": on a CAPABLE seat it changes nothing and symlinks are
# installed. It permits the copies fallback on the seat that has no other option, and a run
# that actually installs copies says COPY per hook, prints a re-run obligation, and exits 3 —
# never 0. That is what makes the copies install legible to a script; there is deliberately no
# outcome that produces copies and reports what producing symlinks reports.
#
# Installs hooks/post-checkout (auto-move the correlated card to In Progress on a
# feature-branch checkout) and hooks/pre-push (a fail-soft advisory warning when a branch
# name references a card in a spelling the auto-move grammar won't recognize; card-4621).
# HONORS core.hooksPath: when a repo sets it (gitleaks, the
# pre-commit framework, Husky, many Windows setups), git dispatches hooks ONLY from there —
# installing into .git/hooks would be a SILENT no-op (the symlink is created, install reports
# success, the hook never fires; #4281). Non-destructive: refuses to clobber an existing
# NON-symlink hook (a repo's own hook is never lost). Refuses a hooksPath that resolves inside
# the tracked work tree (a machine-specific absolute symlink there would show as a work-tree
# change and break on other clones) — it guides the operator instead of polluting the tree.
# SEPARATED GIT TOPOLOGIES (the git COMMON dir is not <root>/.git): a --separate-git-dir checkout
# and a submodule INSTALL — into the hooks directory git actually dispatches from, outside their
# own work tree — and report where. A LINKED WORKTREE is REFUSED, naming the main checkout to run
# against instead (card#5226, card#5311). The split is by BLAST RADIUS, not by "is the git dir
# elsewhere": a worktree's hooks dir is shared with the main checkout and every sibling worktree,
# so installing from one silently rewires all of them, while the other two topologies have exactly
# one work tree each. The disposition lives in _ibh_install_dir_source, and no caller models it.
# It applies only while core.hooksPath is unset: a set hooksPath wins on every topology, which
# makes such a checkout perfectly installable.
#
# SCOPE: this installer handles GIT hooks only. The Claude Code agent-dispatch card-start hook
# (hooks/agent-dispatch-card-start) is a settings.json PreToolUse hook, NOT a git hook — it is
# registered by hand (operator-owned config; see docs/HOOKS.md), never written here.
set -euo pipefail

# ONE owner for the usage line: it was written out at each of the three refusal sites, and a
# flag added to the parser reaches an operator only through whichever copy they happened to hit.
_IBH_USAGE="usage: install-board-hooks [--check] [--allow-copies] <repo-dir>"

# _ibh_read_hooks_path <repo-dir>: the ONE reader of core.hooksPath. Echoes the value git will
# actually use and returns its PRESENCE as a status — the two facts a caller must not conflate.
#   0  SET (the value may be EMPTY — see below)   1  unset   2  set but git cannot expand it
# Two properties are load-bearing. Both were measured on git 2.43.0, and the selftest fixtures
# exercise this resolver's answers for both, so CI re-verifies them on its own git build — the
# second environment this file needs, after an ordering claim measured only here survived four
# review passes and failed on CI's first run:
#   * `--path` EXPANDS a leading `~` / `~user` (core.hooksPath is a path-type variable, and git
#     dispatches from the expanded dir). Reading the raw value makes `~/hooks` look relative.
#     A RELATIVE value is returned unchanged by `--path`, so the relative arm is unaffected.
#   * an EMPTY value is SET, and git does NOT fall back to <git-dir>/hooks — it dispatches NO
#     hooks at all (measured on git 2.43.0; the fixture pins this resolver's answer, not git's
#     dispatch, so a build that DID fall back would make our "disabled" state a false finding). `--get` distinguishes it from unset by EXIT STATUS ONLY (unset → 1, empty →
#     0 with empty output), so any caller testing the VALUE for emptiness silently reads
#     "hooks disabled" as "no hooksPath configured". That is why this returns a status.
# rc 2 is `~unknownuser` and friends: git fatals expanding it here AND at hook dispatch, so the
# repo's hooks are broken — never fold it into "unset", which would certify the repo healthy.
_ibh_read_hooks_path() {
    local out rc=0
    out="$(git -C "$1" config --path --get core.hooksPath 2>/dev/null)" || rc=$?
    case "$rc" in
        0) printf '%s' "$out"; return 0 ;;
        1) return 1 ;;
        *) return 2 ;;
    esac
}

# _ibh_common_dir <repo-dir>: echo this checkout's git COMMON dir as an ABSOLUTE path; rc 1 when
# git will not answer. It is <root>/.git for an ordinary checkout and something else for every
# separated topology (linked worktree, --separate-git-dir, submodule), which is exactly the
# condition under which a hooks dir derived from <root>/.git is a path git never reads.
# `rev-parse -C <path>` answers a RELATIVE common dir against the path the CALLER TYPED, not
# against the work-tree root (measured on git 2.43: from `<root>/subdir` it answers `../.git`),
# so it is absolutized against that same path — resolving it against the root would silently
# name a sibling of the repo.
_ibh_common_dir() {
    local cdir
    cdir="$(git -C "$1" rev-parse --git-common-dir 2>/dev/null)" || return 1
    [ -n "$cdir" ] || return 1
    case "$cdir" in /*) ;; *) cdir="$1/$cdir" ;; esac
    printf '%s' "$cdir"
}

# _ibh_main_checkout <repo-dir>: the OTHER checkout whose own `.git` directory is this repo's
# common dir — i.e. the MAIN checkout of a linked worktree, the one an operator must install
# against. rc 1 when no such checkout exists, which is the answer for BOTH other separated
# topologies and is what makes this the discriminator between them: a --separate-git-dir repo's
# common dir is an arbitrary path (not named `.git`) and a submodule's is
# <super>/.git/modules/<name>, so in neither case does a sibling work tree own it.
# Detection is by COMMON DIR, never by `.git`-is-a-FILE: all three topologies share that shape
# and they need three different answers.
_ibh_main_checkout() {
    local cdir parent root
    cdir="$(_ibh_common_dir "$1")" || return 1
    if [ "$(basename -- "$cdir")" != ".git" ] || [ ! -d "$cdir" ]; then return 1; fi
    parent="$(dirname -- "$cdir")"
    [ -d "$parent" ] || return 1
    root="$(git -C "$1" rev-parse --show-toplevel 2>/dev/null)" || return 1
    # Compared by INODE, not by spelling: the two paths come from different git queries — one
    # canonical (`--show-toplevel`), one relative to the typed path — so identical directories
    # routinely differ as strings (a trailing slash, a symlinked repo path, a sub-directory
    # argument), and a string compare would call an ordinary checkout its own main checkout.
    if [ -n "$root" ] && [ "$parent" -ef "$root" ]; then return 1; fi
    printf '%s' "$parent"
}

# _ibh_install_dir_source <repo-dir> <repo-root> <git-common-dir>: echo the directory whose
# `hooks/` this installer must write into — the <git-common-dir> argument _ibh_hooks_dir needs —
# and return whether installing here is serviceable at all.
#   0  install target echoed
#   1  REFUSED: a linked worktree. Echoes NOTHING — there is no directory this installer may
#      write; the caller words the refusal (and only it has the main checkout to name).
# THE DISPOSITION LIVES HERE, IN ONE PLACE. It used to be spelled out at the call site, and
# board-session-close then MODELLED that spelling to decide whether to offer the installer as a
# remedy — the second copy is the drift this toolkit's own dispatch check exists to catch, so
# that caller now asks this instead (canon #5).
#
# Only the linked worktree is refused, and the rationale is why: the refusal was decided on
# SURPRISING BLAST RADIUS — installing here silently rewires checkouts the operator never named.
# A linked worktree's common dir is shared by the main checkout AND every other worktree, so that
# is true of it. It is NOT true of the other two separated topologies: a --separate-git-dir
# checkout and a submodule each have exactly ONE work tree, so the blast radius is precisely the
# repo the operator is standing in and they install (card#5311). They were previously refused on
# a rationale that does not apply to them.
#
# The caller passes the root and common dir it has already resolved, so there is no second
# `rev-parse` here and no unreachable "cannot resolve" arm.
# The ordinary checkout echoes "$root/.git" — the CANONICAL spelling, not the passed common dir:
# git answers a relative common dir (`.git`, or `../.git` from a sub-directory) for that topology
# alone, and --check's stdout is a consumed contract. Both other topologies are answered ABSOLUTE
# even from a sub-directory (measured, git 2.43.0), so echoing the common dir needs no
# normalization there — and no `--path-format`, which would impose a git-version floor.
_ibh_install_dir_source() {
    local repo="$1" root="$2" cdir="$3"
    if [ "$cdir" -ef "$root/.git" ]; then printf '%s' "$root/.git"; return 0; fi
    # Discriminated by "does another checkout own this common dir?", never by `.git`-is-a-file:
    # all three separated topologies share that shape. rc 0 here means a linked worktree — the
    # other two have no sibling work tree owning their common dir (measured; the selftest pins it).
    if _ibh_main_checkout "$repo" >/dev/null 2>&1; then return 1; fi
    printf '%s' "$cdir"; return 0
}

# _ibh_hooks_dir <repo-root> <core.hooksPath-value> [git-common-dir] [hooksPath-is-set]: echo the
# directory the post-checkout hook must live in for git to dispatch it, and return a status
# telling the caller how to treat it. Pure (no filesystem writes) so
# tests/board-card-start-selftest.sh can assert on it — and so the session-close hook-dispatch
# check can REUSE it rather than re-derive the resolution (a second copy of it is the exact
# defect class that check exists to catch).
#   0  safe install target — the default <git-dir>/hooks, a hooksPath under .git/ (untracked), or
#      one OUTSIDE the work tree (an absolute/global dir): symlink into it.
#   3  hooksPath resolves INSIDE the tracked work tree (under repo root but NOT under .git/):
#      the caller must REFUSE. The directory is still echoed (for the diagnostic).
#   4  hooksPath is SET but EMPTY: git dispatches NO hooks for this repo. There is no directory
#      to echo and nothing to install — the caller must REFUSE (installing into <git-dir>/hooks
#      would report success on a path git never reads). Only reachable when the caller passes
#      <hooksPath-is-set>=1, which is why `_ibh_read_hooks_path` returns presence as a status.
# Git resolves a RELATIVE core.hooksPath against the work-tree top (verified), not the CWD.
# <git-common-dir> defaults to <repo-root>/.git, which is right for every ordinary checkout. A
# LINKED WORKTREE must pass its real common dir (`git rev-parse --git-common-dir`): there `.git`
# is a FILE and git dispatches hooks from the MAIN checkout's hooks dir, so <root>/.git/hooks is
# not a path git ever reads (verified against git 2.43).
# _ibh_norm <path>: LEXICAL path normalization — collapse `//`, `.` and `x/..` with NO
# filesystem access, so _ibh_hooks_dir stays pure. Used ONLY for the in-tree/out-of-tree prefix
# decision, never for the echoed path: a `..`-relative hooksPath such as `../shared-hooks`
# resolves OUTSIDE the work tree, but the raw string still begins with the repo root, so an
# un-normalized prefix test classifies it as in-tree and prints the wrong remediation. The
# echoed path is left as-is because the OS resolves it exactly as git does when it opens the
# hook — including through symlinked components, which a lexical collapse would not.
_ibh_norm() {
    local p="$1" seg out="" oldifs="$IFS"
    local -a segs=() st=()
    IFS='/'; read -r -a segs <<< "$p"; IFS="$oldifs"
    for seg in ${segs[@]+"${segs[@]}"}; do
        case "$seg" in
            ''|.) ;;
            ..)   if [ "${#st[@]}" -gt 0 ]; then st=("${st[@]:0:${#st[@]}-1}"); fi ;;
            *)    st+=("$seg") ;;
        esac
    done
    for seg in ${st[@]+"${st[@]}"}; do out="$out/$seg"; done
    case "$p" in
        /*) printf '%s' "${out:-/}" ;;
        *)  printf '%s' "${out#/}" ;;
    esac
}

_ibh_hooks_dir() {
    local root="$1" hp="${2:-}" gitdir="${3:-$1/.git}" hp_set="${4:-}"
    if [ -z "$hp" ]; then
        # SET-but-empty is "hooks disabled", NOT "no hooksPath" — distinguished by the caller's
        # presence flag, never by this empty value (that conflation is the defect itself).
        [ "$hp_set" = "1" ] && return 4
        printf '%s\n' "$gitdir/hooks"; return 0
    fi
    local dir
    case "$hp" in
        /*) dir="$hp" ;;     # absolute — as-is
        *)  dir="$root/$hp" ;;   # relative — against the work-tree top
    esac
    # Normalize the CLASSIFICATION inputs only (see _ibh_norm): '../x' must not read as in-tree.
    local nroot ndir
    nroot="$(_ibh_norm "${root%/}")"; ndir="$(_ibh_norm "${dir%/}")"
    # Under .git/ → untracked, safe to symlink (never shows as a work-tree change).
    case "$ndir/" in
        "$nroot"/.git/*|"$nroot"/.git/) printf '%s\n' "$dir"; return 0 ;;
    esac
    # Under the repo root but NOT under .git/ → a tracked work-tree dir → refuse.
    case "$ndir/" in
        "$nroot"/*) printf '%s\n' "$dir"; return 3 ;;
    esac
    # Outside the work tree entirely (absolute/global hooks dir) → safe to symlink.
    printf '%s\n' "$dir"; return 0
}

# _ibh_native_hash <path>: what the CONSUMER'S OWN BINARY sees at <path>. `git hash-object`
# opens the path (following a symlink) and hashes the bytes it reads, so two paths that hash
# equal deliver the same content to git — and git.exe is what dispatches hooks. rc 1 when git
# cannot read it at all (absent from PATH, a dangling entry, an unreadable repository context):
# a failed READ is never an answer about the seat, so the caller maps it to INDETERMINATE.
#   * `--no-filters` is load-bearing, not tidiness. Without it git applies the clean filter the
#     attributes mechanism selects FOR THAT PATH, and the probe's two paths differ in suffix
#     (`.ibhp<n>.s` / `.ibhp<n>.d`) — measured on git 2.43.0: a `*.d filter=…` attribute changes
#     one hash and not the other, which would report a capable seat as NOT_CAPABLE. Raw bytes
#     are also the right question: git dispatches a hook by EXEC'ing it, filters unapplied.
#   * No repository is required and none is assumed — but a repository CONTEXT is still resolved,
#     so the read is pinned to the probed entry's own directory with `-C`. Bare `git hash-object`
#     runs git's gentle repository setup from the CALLER's cwd, and a cwd whose context is BROKEN
#     (a `.git` gitfile naming a directory that does not exist is the measured case) is fatal
#     there — rc 128, mapped to `git-read-failed`, and the whole install refuses at rc 4 naming
#     four faults that are none of them the cause. Measured: outside a repo, inside a work tree,
#     and from within a `.git/hooks` directory all answered identically; a broken context was NOT
#     measured, and it is the one that answered differently. `-C <dirname>` makes the read answer
#     about the directory whose capability is being measured, so the answer no longer depends on
#     where the caller stands. It is NOT the cwd git dispatches the hook from: measured on git
#     2.43.0, a hook runs with cwd = the WORK-TREE ROOT (githooks(5): git changes to $GIT_DIR in a
#     bare repository, or the root of the working tree otherwise) — a different directory from the
#     hooks directory, and under a `core.hooksPath` pointing outside the repo not even the same
#     repository. The pin is right for the reason above, not for standing where the dispatcher does.
#     RESIDUAL, disclosed rather than left to be found: the pin MOVES the fatal repository context,
#     it does not remove one. A broken context at the CALLER's cwd is now harmless (measured: rc 0),
#     and the probed entry's OWN directory carrying a broken `.git` gitfile is now the fatal case
#     (measured: rc 1 → `git-read-failed` → INDETERMINATE → the install refuses at rc 4). That is
#     fail-closed, and the rc-4 text already names "a git that cannot read the probe's own entries".
#     Filters stay off, so the pinned directory's attributes change no answer either.
#   * It READS. There is no `-w`, so nothing reaches any object database and the probe's only
#     writes remain its two `.ibhp*` entries — which is what keeps `--check`'s disclosed write
#     set (see _ibh_main) exactly what it was.
_ibh_native_hash() {
    local h
    h="$(git -C "$(dirname -- "$1")" hash-object --no-filters -- "$1" 2>/dev/null)" || return 1
    [ -n "$h" ] || return 1
    printf '%s' "$h"
}

# _ibh_symlink_probe <dir>: measure whether THIS directory supports the only symlink property
# the install depends on — an entry that is a symlink AND that keeps tracking its source when
# the source is REPLACED (what a `git pull` does to a hook file: a new inode, not a truncate-
# and-rewrite). Prints exactly one line and returns the verdict as a status:
#     VERDICT=CAPABLE|NOT_CAPABLE|INDETERMINATE DIR=<probed dir> REASON=<token>
#   0  CAPABLE        · 1  NOT_CAPABLE        · 2  INDETERMINATE
# The token and the status are emitted from ONE tail below, so the line an operator reads and
# the branch the caller takes cannot disagree.
#
# THE REPLACED CONTENT IS READ TWICE, BY TWO DIFFERENT READERS, AND BOTH ANSWERS ARE KEPT.
# `cat` is the SHELL's reader — on a Windows/MSYS seat that is the emulation layer, and under
# `MSYS=winsymlinks:lnk` the layer creates a Windows `.lnk` shortcut which its own `cat` and
# `test -L` both resolve. Read only through it, this probe would answer CAPABLE while `git.exe`
# — a native binary, and the one that actually dispatches hooks — sees a shortcut FILE: a false
# CAPABLE minted inside the detector for the exact silent degrade the detector exists to stop.
# So the replaced content is read a second time by git's own binary (_ibh_native_hash), and the
# two answers are reported as a pair rather than collapsed:
#   git tracks | shell tracks | verdict       | REASON
#   ---------- | ------------ | ------------- | ------------------------------------------------
#   read failed (either path)  | INDETERMINATE | git-read-failed
#   yes        | yes          | CAPABLE       | ok
#   no         | no           | NOT_CAPABLE   | link-does-not-track-source-across-replacement
#   no         | yes          | NOT_CAPABLE   | readers-disagree-native-git-does-not-track
#   yes        | no           | NOT_CAPABLE   | readers-disagree-shell-does-not-track
# Both disagreements fail CLOSED, and the token records the DIRECTION so one run on a real seat
# identifies the mode instead of leaving a refusal nobody can attribute. The `lnk` signature is
# the `no|yes` row. The `yes|no` row is refused because hooks execute under that same shell.
# Dropping `cat` and keeping only git would refuse the `lnk` seat without ever saying why.
#
# NOT_CAPABLE vs INDETERMINATE is the whole design. NOT_CAPABLE is a MEASURED absence: the link
# was attempted and the result is not one (`ln` failed, or — the shape measured on a real
# Windows seat — `ln` succeeded and produced a regular file), or it is one and a reader does not
# see through it. INDETERMINATE is every state where the measurement itself did not happen: the
# probe could not write, could not read back, or could not get a clean name to probe with.
# Folding the second into the first would report a fact about the seat that was never
# established — which is why a git that fails to READ is `git-read-failed`, not "not capable".
#
# It writes two dot-prefixed entries into <dir> and removes them on every path. That is the one
# write the dry run also performs (see --check), because the alternative is certifying an
# install that would refuse.
_ibh_symlink_probe() {
    local dir="${1:-}" verdict=CAPABLE reason=ok n src="" dst="" got="" rc err
    local shell_tracks=no git_tracks=no h_src h_dst
    while :; do
        [ -n "$dir" ] || { verdict=INDETERMINATE reason=no-target-dir; break; }
        [ -d "$dir" ] || { verdict=INDETERMINATE reason=not-a-directory; break; }
        # CANONICALISE BEFORE PROBING. `ln -s "$src" "$dst"` stores $src VERBATIM as the link
        # target, and a relative one resolves against $dst's directory — so a relative <dir>
        # would make the tracking clause below fail on a perfectly capable seat. The probe owns
        # this; no caller is asked to pass a canonical path.
        dir="$(cd -- "$dir" 2>/dev/null && pwd -P)" \
            || { verdict=INDETERMINATE reason=target-dir-unreadable; dir="$1"; break; }
        # Short names: MAX_PATH is real on the seats this exists for, and the probe must not be
        # what overflows the path budget.
        n="$$-$RANDOM"; src="$dir/.ibhp$n.s"; dst="$dir/.ibhp$n.d"
        # Never clobber. Checked BEFORE the names are adopted for cleanup, so a refusal to
        # clobber cannot delete the very entry it refused to clobber.
        if [ -e "$src" ] || [ -e "$dst" ] || [ -L "$src" ] || [ -L "$dst" ]; then
            src=""; dst=""; verdict=INDETERMINATE reason=probe-name-collision; break
        fi
        # ARMED HERE, NOT EARLIER, and that placement is the whole care: the collision check
        # above has just established both names are ours to remove, and it deliberately clears
        # them before breaking so a refusal to clobber cannot delete what it refused to clobber.
        # A trap armed before it would do exactly that. Without a trap, a signal between the
        # write below and the tail's cleanup leaves `.ibhp*` behind while this function's header
        # claims removal on every path. The INT/TERM arms EXIT rather than let the shell resume:
        # an interrupted measurement is void, and 130/143 is the status the shell itself would
        # have reported for that signal — the caller reads exactly what it read before.
        trap 'rm -f -- "$dst" "$src" 2>/dev/null || :' EXIT
        trap 'rm -f -- "$dst" "$src" 2>/dev/null || :; exit 130' INT
        trap 'rm -f -- "$dst" "$src" 2>/dev/null || :; exit 143' TERM
        # The subshell is load-bearing: a FAILED REDIRECTION is reported by the shell, not by
        # printf, so `printf … 2>/dev/null` does not suppress its message.
        if ! ( printf 'A%s\n' "$n" > "$src" ) 2>/dev/null; then
            verdict=INDETERMINATE reason=target-dir-not-writable; break
        fi
        rc=0; err="$(ln -s -- "$src" "$dst" 2>&1)" || rc=$?
        if [ "$rc" != 0 ]; then
            # The reason token stays a token and `ln`'s own words go to STDERR verbatim: the
            # one-line stdout contract is what makes this parseable, and folding a message of
            # unknown shape into a token would need a sanitiser (a bracket range = a COLLATION
            # range under a UTF-8 locale) to protect it. Nothing is dropped; the channels differ.
            [ -z "$err" ] || printf 'install-board-hooks: symlink probe: %s\n' "$err" >&2
            verdict=NOT_CAPABLE reason="ln-failed-rc$rc"; break
        fi
        # THE CLAUSE THE MEASURED WINDOWS SHAPE FAILS: `ln -s` reported success and the result
        # is a regular file (the emulation layer substituted a copy).
        if [ ! -L "$dst" ]; then
            verdict=NOT_CAPABLE reason=ln-reported-success-but-result-is-not-a-symlink; break
        fi
        # Does it track the source ACROSS A REPLACEMENT? This is the direct test of the property
        # the upgrade contract needs. A hard link would also fail it; the clause above rejects a
        # hard link first, so this one is not carrying that case.
        rm -f -- "$src" 2>/dev/null || :
        [ ! -e "$src" ] || { verdict=INDETERMINATE reason=source-unlink-failed; break; }
        if ! ( printf 'B%s\n' "$n" > "$src" ) 2>/dev/null; then
            verdict=INDETERMINATE reason=source-replace-failed; break
        fi
        # READER 1 — the shell's. On the seat this whole tool exists for, that is the POSIX
        # emulation layer, and it resolves things a native binary does not.
        got="$(cat -- "$dst" 2>/dev/null || :)"
        if [ "$got" = "B$n" ]; then shell_tracks=yes; fi
        # READER 2 — the consumer's own binary. A read that FAILS is not an answer about the
        # seat: it is the measurement not happening, so it is INDETERMINATE and stops here
        # rather than being scored as "does not track".
        h_src="$(_ibh_native_hash "$src")" || { verdict=INDETERMINATE reason=git-read-failed; break; }
        h_dst="$(_ibh_native_hash "$dst")" || { verdict=INDETERMINATE reason=git-read-failed; break; }
        if [ "$h_dst" = "$h_src" ]; then git_tracks=yes; fi
        # ONE case over the PAIR — see the table in this function's header. There is no arm in
        # which one reader's answer is silently discarded, and the DEFAULT is a refusal rather
        # than the CAPABLE initialiser: an unmapped pair would otherwise keep `verdict=CAPABLE
        # reason=ok` and install on a pair nobody classified — the same fail-open shape the
        # caller's probe-status dispatch just inverted. UNREACHABLE as written (both variables are
        # assigned only `no` above and only `yes` below their reads), so this closes no live hole;
        # it makes the enumeration's default match its intent, which is what the next arm added
        # here inherits.
        case "$git_tracks:$shell_tracks" in
            yes:yes) ;;
            no:no)   verdict=NOT_CAPABLE reason=link-does-not-track-source-across-replacement ;;
            no:yes)  verdict=NOT_CAPABLE reason=readers-disagree-native-git-does-not-track ;;
            yes:no)  verdict=NOT_CAPABLE reason=readers-disagree-shell-does-not-track ;;
            *)       verdict=INDETERMINATE reason=unmapped-reader-pair ;;
        esac
        break
    done
    if [ -n "$src" ]; then rm -f -- "$dst" "$src" 2>/dev/null || :; fi
    # Disarmed on the normal path: the trap is this function's, not the caller's, and both
    # shipped callers invoke the probe inside a command substitution (whose subshell would run
    # an EXIT trap that outlived the function).
    trap - EXIT INT TERM
    printf 'VERDICT=%s DIR=%s REASON=%s\n' "$verdict" "$dir" "$reason"
    # ONE mapping, at ONE place: a second spelling of it is how a caller's branch and the
    # operator's line come to say different things.
    case "$verdict" in
        CAPABLE)     return 0 ;;
        NOT_CAPABLE) return 1 ;;
        *)           return 2 ;;
    esac
}

# _ibh_require_positional <slot> <arg> <name> [suffix]: mirrors kb_require_positional in
# _kb-board-lib.sh — this script is vendored standalone and MUST NOT source that lib; keep the
# two in sync, and read the rationale there. tests/kb-positional-guard-selftest.sh runs one
# assertion matrix against BOTH copies rather than trusting this comment.
_ibh_require_positional() {
    if [ -z "$2" ]; then
        echo "install-board-hooks: $3 is empty (an unexpanded variable?)${4:-}" >&2
        return 1
    fi
    if [ -n "$1" ]; then
        echo "install-board-hooks: unexpected extra argument: $2${4:-}" >&2
        return 1
    fi
    return 0
}

_ibh_main() {
    # --check <repo-dir>: DRY RUN. Evaluate every precondition a real run evaluates — except the
    # toolkit-side `chmod +x` on the hook SOURCES, which is itself a write and which a dry run
    # must not perform (it can EPERM on sources you do not own even when the mode is already
    # right; no root-owned install topology is documented, so this is claim precision, not a
    # live path) — in the same order, in this same function, then stop before the first write. On success it prints the
    # directory the install WOULD target (stdout, nothing else) and exits 0; on refusal it
    # prints the same diagnostic a real run would and exits non-zero, with empty stdout.
    #
    # ONE PRECONDITION CANNOT BE EVALUATED WITHOUT WRITING, and it is evaluated anyway: symlink
    # capability is measurable only by creating a symlink. The dry run therefore performs the
    # probe's create-and-remove pair (two dot-prefixed `.ibhp*` entries, removed on every path)
    # and installs nothing else. The alternative was worse in the direction that matters: a
    # --check that skipped the probe would answer "this install would succeed" on exactly the
    # seat where the real run refuses, and its consumer (board-session-close's remedy line)
    # would print that refusal as the fix.
    #
    # It exists so a caller never has to MODEL these preconditions. board-session-close used to
    # re-derive them to decide whether to print `install-board-hooks <repo>` as a remedy, and a
    # partial copy — 2 of the 9 — produced a wrong answer in two consecutive reviews: the copy,
    # not the missing predicates, was the defect (canon #5). A caller now asks instead of
    # guessing, and gains any precondition added here without being changed.
    local check="" copies="" repo="" arg
    # Parse in a LOOP and reject anything unrecognised. Accepting --check only in position 1
    # meant `install-board-hooks <repo> --check` silently discarded it and performed a REAL
    # install — a flag whose entire contract is "install nothing" doing the install, on its most
    # natural mis-spelling. Silently ignoring an extra positional is the same hazard one step
    # further out, so both are rc 2 with the usage line.
    for arg in "$@"; do
        case "$arg" in
            --check)        check=1 ;;
            --allow-copies) copies=1 ;;
            -*)      echo "install-board-hooks: unknown option: $arg" >&2
                     echo "$_IBH_USAGE" >&2; exit 2 ;;
            *)       _ibh_require_positional "$repo" "$arg" "<repo-dir>" || {
                         echo "$_IBH_USAGE" >&2; exit 2
                     }
                     repo="$arg" ;;
        esac
    done
    if [ -z "$repo" ]; then
        echo "$_IBH_USAGE" >&2; exit 2
    fi
    # Print git's OWN refusal rather than asserting "not a git repo": `dubious ownership`
    # (safe.directory) and a core.hooksPath git cannot expand also land here, and each needs a
    # different fix than "this isn't a repository".
    local probe_err
    if ! probe_err="$(git -C "$repo" rev-parse --git-dir 2>&1 >/dev/null)"; then
        echo "install-board-hooks: git refuses this checkout ($repo): ${probe_err:-unknown error}" >&2
        exit 1
    fi
    local root
    root="$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null || true)"
    [ -n "$root" ] || { echo "install-board-hooks: cannot resolve the work-tree root for: $repo" >&2; exit 1; }

    local toolkit
    toolkit="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
    # The full hook set the toolkit installs. post-checkout: auto-move the card to In
    # Progress on branch checkout. pre-push: the fail-soft branch-name advisory (card-4621).
    local hooks=(post-checkout pre-push)
    local hook
    for hook in "${hooks[@]}"; do
        [ -f "$toolkit/hooks/$hook" ] || { echo "install-board-hooks: hook source missing: $toolkit/hooks/$hook" >&2; exit 1; }
        [ -n "$check" ] || chmod +x "$toolkit/hooks/$hook"
    done

    local hp dir rc hp_rc hp_set=""
    # Read PRESENCE and value together: `|| true` on a bare `--get` would erase the one bit that
    # separates "no hooksPath" from "hooksPath disabled", and installing on the latter is a
    # silent no-op — the #4281 shape this installer exists to avoid.
    hp_rc=0; hp="$(_ibh_read_hooks_path "$repo")" || hp_rc=$?
    # REACHABLE, and which of this and the `rev-parse` probe above fires is git-version-
    # dependent: on git 2.43.0 an unexpandable path-type value fatals every command in the repo
    # (so the probe reports it first), while on git 2.54.0 `rev-parse` succeeds and only this
    # explicit `--path` read fatals. Measured in both environments after four review passes on
    # ONE host agreed this arm was dead; the boundary version is unknown, so no ordering is
    # claimed. It stays because folding an unknown read status into "unset" is the guess this
    # tool exists to avoid.
    if [ "$hp_rc" = 2 ]; then
        {
            echo "install-board-hooks: core.hooksPath is set to a value git cannot expand (e.g. '~unknownuser/...')."
            echo "  Refusing: git fails the same way when it dispatches hooks, so this repo runs NO hooks."
            echo "  Fix the value (git -C '$repo' config core.hooksPath <dir>) or remove it (--unset), then re-run."
        } >&2
        exit 1
    fi
    [ "$hp_rc" = 0 ] && hp_set=1

    # The common dir this tool passes to _ibh_hooks_dir is resolved by _ibh_install_dir_source,
    # which owns the per-topology disposition: <root>/.git for an ordinary checkout (the canonical
    # spelling — see that function on why the passed value is not reused), the real common dir for
    # the two separated topologies that install, and a refusal for the linked worktree. It is
    # consulted ONLY while core.hooksPath is unset, because only then is the hooks dir derived
    # from the common dir at all.
    local cdir
    cdir="$(_ibh_common_dir "$repo")" || cdir=""
    if [ -z "$cdir" ]; then
        echo "install-board-hooks: cannot resolve the git common directory for: $repo" >&2
        exit 1
    fi
    # The gate is on hooksPath being UNSET, not on the topology alone: a set core.hooksPath wins
    # on every topology, so a linked worktree that configures one is perfectly installable and
    # refusing it here would be a false refusal. Only when the hooks dir is DERIVED from the
    # common dir does the topology decide anything.
    local hooks_src="$root/.git" super
    if [ -z "$hp_set" ]; then
        if ! hooks_src="$(_ibh_install_dir_source "$repo" "$root" "$cdir")"; then
            # The ONE refused topology. `main` is non-empty by construction here (that is the
            # predicate the primitive refused on), but it is read rather than assumed — the
            # message is worthless if it names an empty path.
            local main
            main="$(_ibh_main_checkout "$repo")" || main=""
            {
                echo "install-board-hooks: $root is a LINKED WORKTREE — git dispatches its hooks from the main checkout."
                echo "  Refusing: $cdir/hooks is shared by the main checkout AND EVERY worktree of this repository,"
                echo "  so installing from here would change hook behavior for all of them, not just this one."
                echo "  Run it against the main checkout instead — that wires this worktree too:"
                echo "      install-board-hooks ${main:-<the main checkout>}"
            } >&2
            exit 1
        fi
        # A separated topology that DOES install: say where, because the hooks land outside the
        # work tree the operator named and a silent success there is surprising. On stderr in BOTH
        # modes — `--check`'s only stdout is the target directory, a contract other tools consume.
        if [ "$hooks_src" != "$root/.git" ]; then
            super="$(git -C "$repo" rev-parse --show-superproject-working-tree 2>/dev/null)" || super=""
            {
                if [ -n "$super" ]; then
                    echo "install-board-hooks: $root is a SUBMODULE of $super — its hooks live outside its own work tree,"
                    echo "  at $hooks_src/hooks. That is where git dispatches them from, and it is the install target."
                    echo "  This wires THIS submodule only; the superproject's own hooks are a different repository's and are untouched."
                else
                    # Deliberately does NOT assert "`.git` is a file pointing at it": that is true
                    # of a --separate-git-dir checkout, which is what reaches this arm in practice,
                    # but this is also the fall-through for any state where the common dir is
                    # simply elsewhere (an exported GIT_DIR, say), and a wrong-but-specific cause
                    # is worse than an honest generic one. What IS known is stated: where git
                    # dispatches from. This checkout is that git directory's only work tree, which
                    # is what makes installing here safe.
                    echo "install-board-hooks: $root has a SEPARATE git directory, at $hooks_src."
                    echo "  git dispatches this repository's hooks from $hooks_src/hooks, and that is the install target."
                fi
            } >&2
        fi
    fi
    # Capture rc in an || context: a bare `dir="$(cmd)"; rc=$?` would trip `set -e` on the
    # command-substitution's non-zero exit (rc=3, the in-tree refuse signal) and quit at the
    # assignment BEFORE rc is read — killing the guidance block below (impl-review HIGH).
    rc=0; dir="$(_ibh_hooks_dir "$root" "$hp" "$hooks_src" "$hp_set")" || rc=$?
    if [ "$rc" = 4 ]; then
        {
            echo "install-board-hooks: core.hooksPath is set to an EMPTY value — git dispatches NO hooks for this repo."
            echo "  Refusing: an empty value does not fall back to .git/hooks, so installing there would report"
            echo "  success on a directory git never reads (the silent no-op this installer exists to prevent)."
            echo "  Fix: git -C '$repo' config --unset core.hooksPath   (or point it at a hooks directory), then re-run."
        } >&2
        exit 1
    fi
    if [ "$rc" = 3 ]; then
        {
            echo "install-board-hooks: core.hooksPath='$hp' resolves inside the tracked work tree ($dir)."
            echo "  Refusing: a machine-specific absolute symlink there would show as a work-tree change and break on other clones."
            echo "  Instead, add a line to each committed hook that runs the toolkit hook — e.g.:"
            echo "      exec \"$toolkit/hooks/post-checkout\" \"\$@\"   # and likewise for pre-push"
            echo "  or point core.hooksPath at an out-of-tree directory."
        } >&2
        exit 1
    fi

    # Creatability + writability: what `mkdir -p` and `ln -sf` need. A real run learns this by
    # failing; --check must learn it without writing, so the same two facts are tested here for
    # both modes — a check that skipped them would answer a different question than it is asked.
    local probe_dir="$dir"
    if [ ! -d "$dir" ]; then
        local anc="$dir" prev=""
        if [ -e "$dir" ] || [ -L "$dir" ]; then
            echo "install-board-hooks: the hooks path exists but is not a directory: $dir" >&2
            exit 1
        fi
        while [ -n "$anc" ] && [ "$anc" != "/" ] && [ "$anc" != "$prev" ]; do
            prev="$anc"; anc="$(dirname -- "$anc")"
            if [ -e "$anc" ] || [ -L "$anc" ]; then break; fi
        done
        if [ ! -d "$anc" ] || [ ! -w "$anc" ]; then
            echo "install-board-hooks: cannot create the hooks directory $dir (nearest existing parent: $anc)" >&2
            exit 1
        fi
        # The hooks dir does not exist yet, so the probe runs in the nearest existing ancestor —
        # the directory `mkdir -p` is about to create it under, hence on the same filesystem and
        # under the same process privilege, which is what symlink capability is a property of.
        # ONE rule for both modes: the dry run must not create the directory, and a real run
        # that probed a directory the dry run could not would answer a different question.
        probe_dir="$anc"
    elif [ ! -w "$dir" ]; then
        echo "install-board-hooks: the hooks directory is not writable: $dir" >&2
        exit 1
    fi

    # SYMLINK CAPABILITY — measured before anything is installed, in BOTH modes (see --check).
    local probe_out probe_rc=0
    probe_out="$(_ibh_symlink_probe "$probe_dir")" || probe_rc=$?
    # THE DEFAULT IS THE REFUSAL, not the install. Only 0 means CAPABLE and only 1 means
    # NOT_CAPABLE; every other status is a measurement this dispatch cannot read, so it lands on
    # the INDETERMINATE arm below — the existing one, with no message and no exit status of its
    # own. Enumerating 2 here and letting the rest fall through installed symlinks on the
    # strength of a status nobody mapped, and those statuses exist: the probe's INT/TERM traps
    # exit 130/143, and a signal they do not catch reads back off the command substitution as
    # 129/137. Fail-open is the exact class of silent success this whole tool exists to close.
    if [ "$probe_rc" != 0 ] && [ "$probe_rc" != 1 ]; then
        {
            # A KILLED probe prints NOTHING, and that is a live state on this arm: the probe's own
            # INT/TERM traps exit 130/143 before its one-line report, and an uncaught signal reads
            # back off the command substitution as 129/137. An empty `$probe_out` rendered as
            # "(…)" — a refusal quoting nothing, followed by a fault list none of whose entries is
            # the cause. So the empty case says what actually happened and skips that list.
            echo "install-board-hooks: could not DETERMINE whether $probe_dir supports tracking symlinks (${probe_out:-the probe exited $probe_rc without reporting: it was terminated before it could measure})."
            echo "  Refusing: an undetermined probe is not evidence of capability, and installing on one is how a"
            echo "  silently-copied hook set gets reported as a healthy install. This is NOT a finding that symlinks"
            echo "  are unavailable here — that is a different verdict, with a different exit status (1, not 4)."
            echo "  --allow-copies does not apply: it opts into a KNOWN degradation, never into an unknown state."
            if [ -n "$probe_out" ]; then
                echo "  Fix the reason named above (it is a local fault: permissions, a stray probe file, an unreadable"
                echo "  directory, or a git that cannot read the probe's own entries), then re-run. Where the fault is"
                echo "  the unlink itself, the probe could not remove its own entries either — any '.ibhp*' left in"
                echo "  that directory is disposable."
            else
                echo "  There is no reason token to act on: the measurement was interrupted, not completed, so nothing"
                echo "  here is a finding about this seat. Re-run it — and if it keeps being killed, find what is"
                echo "  signalling it (a job-control or timeout wrapper around this command is the usual cause). Any"
                echo "  '.ibhp*' left in that directory belongs to the interrupted probe and is disposable."
            fi
        } >&2
        exit 4
    fi
    if [ "$probe_rc" = 1 ] && [ -z "$copies" ]; then
        {
            echo "install-board-hooks: $probe_dir cannot create tracking symlinks ($probe_out)."
            echo "  Refusing: the hooks are installed as symlinks so that a 'git pull' in $toolkit updates them."
            echo "  Where 'ln -s' silently yields a COPY, the install reports success and the seat then runs hooks"
            echo "  that never update again — a pin that is invisible in every log this tool writes."
            echo "  Fix: enable symlink creation, then re-run. On Windows that is Developer Mode, or a shell with"
            echo "  SeCreateSymbolicLinkPrivilege (an elevated one), plus MSYS/Git-Bash 'export MSYS=winsymlinks:nativestrict'."
            echo "  Or install copies deliberately: install-board-hooks --allow-copies $repo"
            echo "    — copies are reported AS copies and exit 3, and MUST be re-installed after every toolkit upgrade."
        } >&2
        exit 1
    fi
    # A copies install happens only where symlinks were MEASURED absent. On a capable seat the
    # flag changes nothing: it permits the fallback, it does not select it — so an operator who
    # carries the flag in a shared script does not silently pin a capable seat to stale copies.
    # An `if`, never a trailing `[ … ] && x=1`: that form leaks its own false status and, under
    # `set -e`, quits the script on the common (capable) path.
    local install_copies=""
    if [ "$probe_rc" = 1 ]; then install_copies=1; fi
    # PRE-PASS: every per-entry refusal is decided over the WHOLE hook set BEFORE the first
    # write, so a run that refuses installs nothing at all. These guards used to run inside the
    # install loop, which made the refusal PARTIAL: a set whose second hook was a hook the
    # operator wrote exited 1 with the first hook already on disk. On the copies branch that is
    # consequential — the rc-3 summary carrying the `rm` recipe and the re-run-after-every-
    # upgrade obligation never prints, so a script gating on the status reads a clean refusal
    # while a copy that never tracks the toolkit is installed and live.
    local dst
    for hook in "${hooks[@]}"; do
        dst="$dir/$hook"
        if [ -e "$dst" ] && [ ! -L "$dst" ]; then
            echo "install-board-hooks: refusing to overwrite an existing non-symlink hook: $dst" >&2
            echo "  (merge the agent-board-toolkit hook into it by hand, or remove it first)" >&2
            exit 1
        fi
        # `ln -sf` DEREFERENCES a symlink-to-directory: the hook would be created INSIDE that
        # directory, this tool would report success, and git would never see a hook at $dst —
        # the #4281 "success on a path git never reads" shape in a new place.
        if [ -L "$dst" ] && [ -d "$dst" ]; then
            echo "install-board-hooks: refusing: $dst is a symlink to a directory ($(readlink -- "$dst"))." >&2
            echo "  Installing would put the hook INSIDE that directory, where git never looks." >&2
            echo "  Remove it first: rm -- '$dst'" >&2
            exit 1
        fi
    done
    # THE DRY RUN STOPS HERE — one place, immediately before the first write, now that every
    # per-entry refusal is decided above. Its ONLY stdout is the target directory: empty stdout
    # means "do not act", the same fail-closed contract the rest of the toolkit uses. Its STATUS
    # still carries the verdict — a would-be copies install answers 3 here exactly as the real
    # one does, so a consumer gating on `--check` succeeding never reads a degraded install as a
    # clean one.
    if [ -n "$check" ]; then
        printf '%s\n' "$dir"
        if [ -n "$install_copies" ]; then
            echo "install-board-hooks: this seat cannot symlink ($probe_out) — a real run with --allow-copies would install COPIES here." >&2
            exit 3
        fi
        return 0
    fi
    mkdir -p "$dir"
    local src
    for hook in "${hooks[@]}"; do
        src="$toolkit/hooks/$hook"; dst="$dir/$hook"
        if [ -n "$install_copies" ]; then
            # `rm` FIRST, then `cp`: `cp src dst` where dst is an existing symlink writes THROUGH
            # the link — on a re-install over a previous symlink install that means writing into
            # whatever it pointed at, i.e. this toolkit's own hook source.
            rm -f -- "$dst"
            cp -- "$src" "$dst"
            # git silently ignores a non-executable hook (an `advice.ignoredHook` hint at most),
            # and `cp` applies the umask to a new file — so the bit is set explicitly.
            chmod +x "$dst"
            echo "install-board-hooks: COPY $dst <= $src   (a copy — it does NOT track the toolkit)"
        else
            ln -sf "$src" "$dst"
            # The probe said this directory can do it; this asserts that THIS entry actually is
            # one. It is not a guard against an impossible state — it is the reported defect
            # itself (an emulation layer answering `ln -s` with rc 0 and a copy), measured on the
            # entry that will really be dispatched rather than on the probe's stand-in.
            if [ ! -L "$dst" ]; then
                {
                    echo "install-board-hooks: 'ln -s' reported success but $dst is not a symlink."
                    echo "  The capability probe passed on $probe_dir and this entry contradicts it, so the two"
                    echo "  disagree and the install is NOT trustworthy. The entry is left in place (removing it"
                    echo "  would leave the repo with no hook at all); it will run, but never track $src."
                    echo "  Re-run with --allow-copies to install copies deliberately and have them reported as copies."
                } >&2
                exit 1
            fi
            echo "install-board-hooks: $dst -> $src"
        fi
    done
    # NB: an `[ -n "$hp" ] && echo …` trailing statement would return 1 (→ script exit 1) on a
    # successful install with no core.hooksPath; use an if so success always exits 0.
    if [ -n "$hp" ]; then echo "install-board-hooks: (honored core.hooksPath=$hp)"; fi
    if [ -n "$install_copies" ]; then
        {
            echo "install-board-hooks: installed ${#hooks[@]} hook(s) as COPIES, not symlinks ($probe_out)."
            echo "  They do NOT track $toolkit: a 'git pull' there will not reach them."
            echo "  RE-RUN THIS COMMAND AFTER EVERY TOOLKIT UPGRADE — and delete the stale copies first, because"
            echo "  the installer refuses to overwrite a non-symlink hook (it cannot tell a stale copy of ours"
            echo "  from a hook you wrote):"
            for hook in "${hooks[@]}"; do echo "      rm -f -- '$dir/$hook'"; done
            echo "      install-board-hooks --allow-copies $repo"
            echo "  Exit status 3 — a deliberate degraded install, deliberately not 0."
        } >&2
        exit 3
    fi
}

# run main only when executed directly, so the selftest can source _ibh_hooks_dir.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then _ibh_main "$@"; fi
