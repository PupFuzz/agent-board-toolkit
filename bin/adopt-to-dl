#!/usr/bin/env bash
# adopt-to-dl — the PM-invoked "pull-into-build" adoption seam (roundtable #14 B).
#
# Stamps an EXISTING plain product card with a DL number + a source-qualified
# placeholder pr_url, in ONE atomic operation, so the card crosses from PM-manual
# ownership into the bridge writeback's PR-lifecycle authority. It is a PATCH on
# the card that is already there — NOT a create (see dl-onramp for the create-a-new-
# card flow; re-using that here would leave the plain card AND a new card = two
# cards per item).
#
# What it does, in order:
#   1. readiness gate      — <card-id> numeric, --repo an <owner>/<name>, --board resolves.
#   2. already-adopted guard (roundtable #14 MUST-FIX-3) — refuse to re-mint over a card that
#      already carries a dl_number (that would orphan the old DL and strand any branch/PR
#      named for it). Only --dl <same N> re-stamps idempotently, for a crash-retry.
#   3. mint                — next-dl claims the next DL atomically, and the claimed N is ECHOED
#      to the caller BEFORE the write, so a crash mid-seam is retried with `--dl N` (no orphan,
#      no double-mint).
#   4. atomic write        — REUSE `kbcard patch --dl … --pr-url …`: one request stamping
#      payload.dl_number AND a placeholder pr_url (`…/pull/0`, source = <repo>), relying on the
#      kanban per-key payload merge (#2180). Both keys land together or not at all: two writes
#      with a crash between would leave a dl_number-without-source card the writeback can't
#      correlate and the reconcile can't see — the exact silent-no-move footgun this avoids.
#      (swimlane_id alone does NOT yield a source; the pr_url does.)
#   5. fail-loud verify     — GET by-ref?system=dl&ref=N&source=<repo> must now return the card,
#      exercising the SAME repo-qualified correlation the bridge writeback + the coord.kanban_common
#      reconcile use (roundtable #14, DL-SOURCE-CORRELATION.md). A miss aborts LOUD at adoption
#      time, not silently at the next bridge:check.
#
# Usage:
#   adopt-to-dl <card-id> --repo <owner/name> --board <name> [--dl <N>] [--issue <N>]
#     --board <name> resolves ~/.kanban-<name>-board.env (the toolkit convention); REQUIRED so a
#       deliberate adoption can never land on the wrong board by defaulting.
#     --dl <N>       skip the mint and use N — the crash-retry / explicit path (idempotent).
#     --issue <N>    ALSO correlate the card with GitHub issue #N: co-stamp payload.issue_number +
#       a source-qualified issue_url in the SAME atomic write, and fail-loud-verify the issue by-ref
#       (system=github_issue) parallel to the DL one. Optional + independent of the dl/pr lifecycle
#       keys (a card can carry both) — omit it and adoption is byte-identical to the DL-only path.
set -euo pipefail

# This script's real directory — resolve the shared lib AND the sibling bins (next-dl, kbcard)
# from here rather than via $PATH, so a minimal-PATH invocation still finds them (they live
# beside this script in every install, symlinked or vendored — the same guarantee KB_LIB relies on).
_ATA_BINDIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# Shared toolkit lib (config resolution + kanban-API curl wrapper + DL canonicalization).
KB_LIB="$_ATA_BINDIR/_kb-board-lib.sh"
[ -r "$KB_LIB" ] || { echo "adopt-to-dl: shared lib _kb-board-lib.sh not found next to this script — reinstall per INSTALL.md §3 (symlink all of bin/), or vendor _kb-board-lib.sh alongside this tool." >&2; exit 1; }
# shellcheck source=bin/_kb-board-lib.sh
source "$KB_LIB"
KB_PROG="adopt-to-dl"

# ── pure decision logic (network-free; unit-tested by tests/adopt-to-dl-selftest.sh) ──

# THE `--repo` PREDICATE LIVES IN THE LIB, as `kb_is_repo_slug` (bin/_kb-board-lib.sh), which
# owns the reasoning: the value is spent TWICE, on both sides of ONE comparison — the placeholder
# `pr_url` this tool STAMPS, and the `source=` of the step-5 by-ref VERIFY — so a shape-only test
# lets a garbage spelling derive the SAME garbage on both sides and the verify passes VACUOUSLY.
# It is called directly at the readiness gate below; there is no wrapper here, because a second
# name for one predicate is how a second predicate starts.

# _ata_pr_url <repo>: the pre-PR placeholder pr_url whose repo segment yields the card's
# by-ref `source`. The reconciler/writeback overwrite the URL when the real PR opens; only the
# `<owner>/<name>` segment is load-bearing here.
_ata_pr_url() { printf 'https://github.com/%s/pull/0' "$1"; }

# _ata_issue_url <repo> <issue-n>: the issue_url whose repo segment yields the card's by-ref
# `source` for the issue→card correlation (system=github_issue). Mirror of _ata_pr_url; unlike
# the pre-PR placeholder the issue number is known at adoption, so the real #N rides the URL —
# but as with pr_url only the `<owner>/<name>` segment is load-bearing for `source`.
_ata_issue_url() { printf 'https://github.com/%s/issues/%s' "$1" "$2"; }

# _ata_canon_source <repo>: the server's `canonicalizeSource` — lowercase (GitHub owner/repo is
# ASCII + case-insensitive). The card's stored `source` is the lowercased repo, so the verify
# query must lowercase too rather than rely on the server canonicalizing the query param.
#
# ⚠ MIRRORS OF `canonicalizeSource`, ALL OF THEM — keep in sync (card#8421), and the list is
# CHECKED rather than trusted: tests/promote-source-qualify-selftest.sh § 3d reds when a copy
# named here is renamed, moved or dropped, and § 3e drives all three over one corpus so a
# DIVERGENCE between them reds however it was spelled. ⛔ CATCHING AN UNNAMED FIFTH COPY IS
# BEST-EFFORT, and § 3d — not this comment — OWNS that scope: which lines its predicate admits,
# every admission it makes and what it still cannot see are stated there, once. Do not restate
# them here; a scope restated in two places is what went stale last time. The server
# class is the SoT; the copies are this one — `_ata_canon_source` — plus TWO in
# `bin/promote-released-cards`, which is a vendored standalone that must not source this lib and
# cannot call this function:
#   * `src_canon`, its ONE shell spelling (sed trim, cap 255, tr), through which BOTH sides of
#     its own comparison pass — the operator's `.promote.source` and the $GITHUB_REPOSITORY that
#     value is checked against;
#   * its jq copy `canon_source`, canonicalizing the CARD side of the same comparison.
# Trim and the 255 cap are omitted HERE deliberately, not forgotten: `kb_is_repo_slug` — the
# `--repo` gate at the readiness check below — has already refused every value that either
# would change (whitespace is outside the charset, and a >255-byte `<owner>/<repo>` is not one
# GitHub issues), so adding them would be a second rule with no input to act on. The `tr` runs
# under the caller's locale, which is safe for the same reason: only ASCII reaches it.
#
# ⛔ AND THAT PARTIALNESS IS WHY THIS COPY STAYS HERE RATHER THAN MOVING INTO THE LIB THIS FILE
# ALREADY SOURCES. The reason is NOT "a vendored standalone cannot reach the lib" — that is true
# of `bin/promote-released-cards` and FALSE of this file, which sources `_kb-board-lib.sh` at the
# top of this file. It is that this function is a deliberately PARTIAL canonicalizer whose omissions
# are safe only because `kb_is_repo_slug` ran first: published in the shared lib under a general
# name it would offer a partial rule to callers that have no such gate, which is how a second
# divergent implementation starts (canon #5). The hoist would not shrink the mirror set either —
# `promote-released-cards` still cannot reach the lib — so it buys nothing and costs a name that
# would misdescribe what it does.
_ata_canon_source() { printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]'; }

# _ata_adopt_decision <existing-dl-int|""> <requested-dl-int|"">: the MUST-FIX-3 guard, as a
# pure decision over the card's current dl_number and an optional --dl. Prints one of:
#   mint            no dl_number, no --dl        → claim a fresh DL
#   use-requested   no dl_number, --dl N         → crash-retry after a mint that didn't stamp; use N
#   retry           dl_number == --dl            → idempotent re-stamp/verify (crash after the stamp)
#   refuse-adopted  dl_number set, no --dl        → already adopted; re-minting would orphan it
#   refuse-conflict dl_number set, --dl ≠ it      → stamp conflict
_ata_adopt_decision() {
    local existing="${1:-}" requested="${2:-}"
    if [[ -z "$existing" ]]; then
        [[ -z "$requested" ]] && { printf 'mint'; return 0; }
        printf 'use-requested'; return 0
    fi
    [[ -z "$requested" ]] && { printf 'refuse-adopted'; return 0; }
    [[ "$existing" == "$requested" ]] && { printf 'retry'; return 0; }
    printf 'refuse-conflict'; return 0
}

# Prints on STDOUT; the error arms redirect. The channel is the CALLER's to choose because the
# two uses differ: an explicitly-requested `--help` is the requested OUTPUT (rc 0, pipeable,
# pageable), while usage-after-a-bad-argument is diagnostic. Baking `>&2` in here made
# `adopt-to-dl --help > f` yield an EMPTY file at rc 0 — a false success that reads as "this
# tool has no help" to any caller redirecting stdout.
usage() { echo "usage: adopt-to-dl <card-id> --repo <owner/name> --board <name> [--dl <N>] [--issue <N>]"; }

main() {
    local card_id="" repo="" board_name="" req_dl="" req_issue=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            # Every value-taking flag is gated on the flag being SEEN with a value, via the
            # shared kb_require_value (already in scope) — the same guard kbcard applies at all
            # 37 of its arms. Without it `--dl ""` (an unexpanded variable) read as "no --dl"
            # and took the MINT path, so a crash-retry that meant "re-stamp DL-N" minted a
            # SECOND DL instead — orphaning DL-N and stranding any branch or PR named for it,
            # the exact outcome _ata_adopt_decision's refuse-adopted arm exists to prevent.
            # `--issue ""` silently dropped the co-stamp while still reporting "verified via
            # by-ref". It also turns a trailing flag with no argument from a bare `shift`
            # failure (rc 1, no output) into a named diagnostic.
            --repo)  kb_require_value "$1" "${2:-}" || exit 2; shift; repo="$1" ;;
            --board) kb_require_value "$1" "${2:-}" || exit 2; shift; board_name="$1" ;;
            --dl)    kb_require_value "$1" "${2:-}" || exit 2; shift; req_dl="$1" ;;
            --issue) kb_require_value "$1" "${2:-}" || exit 2; shift; req_issue="$1" ;;
            -h|--help) usage; exit 0 ;;
            --) ;;
            -*) echo "adopt-to-dl: unknown flag '$1'" >&2; usage >&2; exit 2 ;;
            *)  kb_require_positional "$card_id" "$1" "<card-id>" || { usage >&2; exit 2; }
                card_id="$1" ;;
        esac
        shift
    done

    # 1. readiness gate
    [[ -n "$card_id" ]] || { echo "adopt-to-dl: <card-id> is required" >&2; usage >&2; exit 2; }
    kb_is_uint "$card_id" || { echo "adopt-to-dl: <card-id> must be numeric (got '$card_id')" >&2; exit 2; }
    # The refusal names the usual cause, because the accept set is narrower than it looks and
    # the value is one an operator often pastes from a git remote: `git@github.com:acme/widget`
    # and `acme/widget.git` are both git-remote spellings of a repo and neither is the
    # `<owner>/<name>` a card's by-ref source resolves to.
    kb_is_repo_slug "$repo" \
        || { echo "adopt-to-dl: --repo must be a bare <owner>/<name> — exactly one '/', and only letters, digits, '.', '_', '-' either side of it, with no '.git' suffix (got '$repo'). An scp-style 'git@github.com:owner/name', a URL, a '.git' suffix or a glob is the usual cause: this value becomes the card's stamped pr_url AND the by-ref verify query, so a spelling that is not a real repo correlates to nothing." >&2; exit 2; }
    [[ -n "$board_name" ]] || { echo "adopt-to-dl: --board <name> is required (a deliberate adoption must name its board)" >&2; exit 2; }

    local req_int=""
    if [[ -n "$req_dl" ]]; then
        req_int="$(kb_dl_num "$req_dl")" || { echo "adopt-to-dl: --dl '$req_dl' is not a DL number" >&2; exit 2; }
    fi
    # --issue is a bare positive integer (the GitHub issue number). Stricter than kbcard's own
    # `--issue` rule on purpose, and still worth having after it: kbcard refuses a value that is
    # not ONE POSITIVE decorated integer, which still leaves a DECORATED spelling ("#7", "issue-7")
    # accepted there and then refused on the wire by the number-typed field, and a padded "007"
    # silently renumbered to 7 by the payload merge's tonumber. This adoption path names the
    # issue number itself, so it refuses both — one clear cause, before anything is stamped.
    if [[ -n "$req_issue" ]] && ! kb_is_uint "$req_issue"; then
        echo "adopt-to-dl: --issue must be a positive integer (the GitHub issue number); got '$req_issue'" >&2
        exit 2
    fi

    kb_load_config "$board_name" || exit 2   # prints its own cause

    # fetch the card: confirm the board, read the existing dl_number
    local card cur_board existing_int
    card="$(kb_api GET "/tasks/$card_id.json")" || { echo "adopt-to-dl: card #$card_id not readable on the configured board" >&2; exit 1; }
    # kb_api decides success on the HTTP STATUS CLASS alone, so a 2xx carrying a proxy's HTML
    # page or a truncated read arrives here as a success — where an unguarded jq exits 5 under
    # `set -e`, with jq's parse error as this tool's whole diagnostic. kb_parse_resp (shared lib)
    # hands that back as an EMPTY value instead, and an empty board id is refused on its own
    # line: the board-mismatch message below would otherwise report the card as being "on board
    # " — a specific claim about a card this read never got an answer about.
    cur_board="$(kb_parse_resp "$card" -r '.data.board_id // empty')"
    [[ -n "$cur_board" ]] || { echo "adopt-to-dl: card #$card_id returned success but no board id could be read out of its body — nothing was read, so this card's board is UNCONFIRMED; refusing to adopt" >&2; exit 1; }
    [[ "$cur_board" == "$KB_BOARD_ID" ]] || { echo "adopt-to-dl: card #$card_id is on board $cur_board, not the --board '$board_name' board ($KB_BOARD_ID) — refusing to adopt on the wrong board" >&2; exit 1; }
    # Reached only once the body above WAS readable, so an empty dl_number here means the card
    # carries none — the mint path, exactly as before.
    existing_int="$(kb_dl_int_lenient "$(kb_parse_resp "$card" -r '.data.payload.dl_number // empty')")"

    # 2. already-adopted guard
    local decision; decision="$(_ata_adopt_decision "$existing_int" "$req_int")"
    case "$decision" in
        refuse-adopted)
            echo "adopt-to-dl: card #$card_id is ALREADY adopted as $(kb_dl_canon "$existing_int"). Refusing to re-mint — that would orphan DL-$existing_int and strand any branch/PR named for it. To re-stamp idempotently (crash-retry), pass: --dl $existing_int" >&2
            exit 1 ;;
        refuse-conflict)
            echo "adopt-to-dl: card #$card_id already carries $(kb_dl_canon "$existing_int") but --dl names $req_int — refusing (stamp conflict). Settle the intended DL first." >&2
            exit 1 ;;
    esac

    # 3. mint (echo the claimed N BEFORE the write, for crash-retry) — or use the requested N
    local dl_int
    case "$decision" in
        mint)
            local minted
            minted="$("$_ATA_BINDIR/next-dl" --board "$board_name")" \
                || { echo "adopt-to-dl: mint failed (next-dl) — aborting before any stamp" >&2; exit 1; }
            dl_int="$(kb_dl_int_lenient "$minted")"
            [[ -n "$dl_int" ]] || { echo "adopt-to-dl: next-dl returned no DL number ('$minted') — aborting" >&2; exit 1; }
            echo "adopt-to-dl: claimed $(kb_dl_canon "$dl_int") for card #$card_id (repo $repo) — stamping now. If this crashes before it completes, re-run idempotently: adopt-to-dl $card_id --repo $repo --board $board_name --dl $dl_int" >&2 ;;
        *) dl_int="${req_int:-$existing_int}" ;;   # use-requested / retry
    esac

    # 4. atomic write — reuse kbcard's single-request dl_number+pr_url PATCH (#2180 per-key merge).
    # When --issue is given, the SAME request co-stamps issue_number + issue_url (independent
    # lifecycle keys) so the DL and issue correlation land together or not at all.
    local dl_canon pr_url issue_url=""
    dl_canon="$(kb_dl_canon "$dl_int")" || { echo "adopt-to-dl: could not canonicalize DL $dl_int" >&2; exit 1; }
    pr_url="$(_ata_pr_url "$repo")"
    local stamp_args=(patch --task "$card_id" --dl "$dl_canon" --pr-url "$pr_url")
    if [[ -n "$req_issue" ]]; then
        issue_url="$(_ata_issue_url "$repo" "$req_issue")"
        stamp_args+=(--issue "$req_issue" --issue-url "$issue_url")
    fi
    "$_ATA_BINDIR/kbcard" --board "$board_name" "${stamp_args[@]}" >/dev/null \
        || { echo "adopt-to-dl: the atomic stamp (kbcard patch) FAILED for card #$card_id (DL-$dl_int${req_issue:+, issue #$req_issue}) — card not adopted" >&2; exit 1; }

    # 5. fail-loud verify — the same repo-qualified by-ref correlation the writeback/reconcile use.
    # The card's stored source is the LOWERCASED repo (server canonicalizeSource), so lowercase the
    # query to match without relying on the server also canonicalizing the query param.
    local source_enc by_ref
    source_enc="$(_ata_canon_source "$repo")"; source_enc="${source_enc//\//%2F}"
    by_ref="$(kb_api GET "/boards/$KB_BOARD_ID/tasks/by-ref.json?system=dl&ref=$dl_int&source=$source_enc")" \
        || { echo "adopt-to-dl: VERIFY read failed after stamping card #$card_id (DL-$dl_int) — investigate before relying on the card" >&2; exit 1; }
    if ! kb_by_ref_hit "$by_ref" "$card_id"; then
        echo "adopt-to-dl: VERIFY FAILED — by-ref(system=dl, ref=$dl_int, source=$repo) did NOT return card #$card_id after stamping. The dl_number/pr_url may not have persisted, or the source did not resolve. Fix before the next bridge:check (do NOT assume the card is adopted)." >&2
        exit 1
    fi

    # When --issue was co-stamped, verify the issue correlation the SAME way — exercising the
    # github_issue by-ref the bridge/kanban use — so a source that resolves for DL but not for the
    # issue is caught at adoption, not silently at the next bridge:check.
    if [[ -n "$req_issue" ]]; then
        local issue_ref
        issue_ref="$(kb_api GET "/boards/$KB_BOARD_ID/tasks/by-ref.json?system=github_issue&ref=$req_issue&source=$source_enc")" \
            || { echo "adopt-to-dl: ISSUE VERIFY read failed after stamping card #$card_id (issue #$req_issue) — investigate before relying on the card" >&2; exit 1; }
        if ! kb_by_ref_hit "$issue_ref" "$card_id"; then
            echo "adopt-to-dl: ISSUE VERIFY FAILED — by-ref(system=github_issue, ref=$req_issue, source=$repo) did NOT return card #$card_id after stamping. The issue_number/issue_url may not have persisted, or the source did not resolve. Fix before the next bridge:check." >&2
            exit 1
        fi
    fi

    echo "adopt-to-dl: card #$card_id adopted as $dl_canon, source=$repo${req_issue:+, issue #$req_issue} — verified via by-ref."
    exit 0
}

# run main only when executed directly, so tests/adopt-to-dl-selftest.sh can source the pure fns.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then main "$@"; fi
