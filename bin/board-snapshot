#!/usr/bin/env bash
# board-snapshot — compact in-flight summary of the dev tracking boards, so the
# BOARD (not memory) is the source of truth surfaced at SessionStart. Read-only,
# fail-soft: a slow/down API prints a notice and exits 0, never blocking startup.
#
# Boards: 5 = kanban-board ("Kanban Product Backlog"), 8 = agent-webhook-bridge.
set -uo pipefail

# API base read from ~/.kanban-host.env (board-independent; not baked in) via
# kb_load_host_env, which also publishes KB_HOST_TOKEN_FILE — the host-level token
# default. The TOKEN IS NOT READ HERE: each board may point KBCARD_TOKEN_FILE at its
# own token, so it is read per-board inside board_report() below. Reading one
# token up-front and exiting when it was missing meant a host that uses only
# per-board tokens rendered NOTHING at SessionStart. Since card#7245 a board whose
# token file NOBODY declared is reported per-board rather than falling through to a
# shared default, and the api base is preflighted against $KANBAN_EXPECTED_HOST
# before any board is read.
# Fail-soft throughout — a missing config never blocks SessionStart. See INSTALL.md.
KB_LIB="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)/_kb-board-lib.sh"
[ -r "$KB_LIB" ] || { echo "$(basename "${BASH_SOURCE[0]}"): shared lib _kb-board-lib.sh not found next to this script — reinstall per INSTALL.md §3 (symlink all of bin/), or vendor _kb-board-lib.sh alongside this tool." >&2; exit 1; }
# shellcheck source=bin/_kb-board-lib.sh
source "$KB_LIB"
kb_load_host_env   # cannot fail (reads no token)
API="${KB_API:-https://YOUR-KANBAN-HOST/api/v3}"
# Cap EACH request at 5s against a slow/down API. Honored by both fetchers THIS
# script uses — fetch_board_cards (paginated read) and kb_api (the preload
# stage-name read). The lib has three; kb_api_status honors it too.
#
# This bounds a REQUEST, not this script, and the gap is much wider than one cap:
# the per-board fetch_board_cards PAGINATES, each page a separate capped curl, up
# to SNAPSHOT_PAGE_CAP (25). So per board the ceiling is 25*5 (cards) + 5 (preload)
# = 130s, not 5s — and the roster multiplies that. The harness's SessionStart
# timeout, NOT this cap, is what actually bounds the hook, and a kill there
# truncates the snapshot rather than degrading it — the one outcome worse than a
# slow one. Typical run is ~4.9s of a 10s budget (a healthy board is one page):
# card-4447 folded the snapshot + untriaged renders onto ONE fetch per board (was
# two), returning ~2.4s of the old ~7.2s.
KB_CURL_MAX_TIME=5

# The whole-board paginated read is the shared fetch_board_cards (lib): reading
# only the server's default page silently shortened the in-flight + untriaged
# lists once a board grew past it. A page-cap hit (rc 3) or a short read (rc 4)
# still yields the partial array, so this fail-soft SessionStart display shows
# what it has rather than going dark — and, since card#6365, says ON STDOUT that
# that is what it is showing. See board_report's own note at the rc guard.
#
# WHICH OF THE TWO PARTIAL RCS IS ACTUALLY REACHABLE HERE — a claim about the
# world, so it is stated as a DERIVATION plus the measurement that fed it, not as
# a board size that rots the week after it is written (an earlier version of this
# comment asserted "board 5 is already ~98 cards"; it was 242 when re-measured):
#   rc 3 (page cap) needs SNAPSHOT_PAGE_CAP (25) x the paginator's fixed limit=200
#     = MORE THAN 5,000 cards on ONE board. No board here is near that, so rc 3 is
#     a fixture-only rc for this tool today — but it is the cap that decides it, so
#     lowering SNAPSHOT_PAGE_CAP is all it takes to reach it.
#   rc 4 (short read) needs the read to span MORE THAN ONE PAGE, and then any row
#     to leave the match set between the page-1 and page-2 requests: the census
#     compares the pages' summed rows against the meta.total captured on PAGE 1
#     ONLY, so one archive (board-session-close does exactly this) or one card
#     moving out of the board mid-scan makes sum_n < total. It is REACHABLE, and it
#     is reachable BENIGNLY — an ordinary concurrent write, not a broken server.
# Re-derive it, do not quote it: ask the API how many pages a board is
#   GET $API/tasks/search.json?q=board_id=<id>&limit=200&page=1 -> .meta.last_page
# and compare against ceil(cards / 200) > SNAPSHOT_PAGE_CAP for rc 3. Measured
# 2026-08-21: boards 5 and 8 answered last_page=2 (total 242 and 271), board 12
# last_page=1 (189) — i.e. two of the three configured boards are already
# multi-page reads, which is exactly the precondition rc 4 needs.

# Clean slate before sourcing a board env: board envs EXPORT their keys, so an
# operator shell that sourced board A's env carries A's KB_BOARD_ID / KB_STAGE_* /
# token into board B here. Without this scrub, a B env that OMITS any of them
# silently inherits A's value — the WRONG board under a label (KB_BOARD_ID), or a
# stage id that means something else on B (card-4448). Unsetting EVERY KB_STAGE_*
# by GLOB rather than an enumerated list is what makes it drift-proof: a function
# that later reads a new KB_STAGE_* is covered for free — the enumerated list
# drifting out of sync between the two former per-board passes WAS the defect. KBCARD_TOKEN_FILE
# is scrubbed for the same reason plus one more: the host env's value is in this shell
# (kb_load_host_env sourced it), and must not read back as this board's own override —
# the per-function token ladder places it a tier lower.
board_env_scrub() {
    # shellcheck disable=SC2086  # intentional word-split: each name is a separate unset arg
    unset KBCARD_TOKEN_FILE KB_BOARD_ID ${!KB_STAGE_@}
}

# board_unread <label> <reason> — the ONE exit for a board this pass could not read.
# It writes the SAME reason to both of board_report's channels because both sections
# make a claim and neither can borrow the other's disclaimer: they are rendered under
# separate headers, with every other board's output between them.
#
# Distinct from the rc-3/rc-4 notes further down, and deliberately so — those mark a
# read that HAPPENED and came back short (rows are rendered, the counts are floors),
# this one marks a board whose rows were never read at all (nothing is rendered, and
# there is no count to floor). Same channel, different claim.
#
# The reason string is the CALLER's, unchanged from what it printed before, so the
# rule the paginator's contract puts on caller messages (an arm reached by more than
# one rc names the rc and names no cause) stays where it was — at the arm. This
# function adds no cause of its own.
board_unread() {  # $1 = label   $2 = reason ; reports on stdout AND fd 3
    echo "• ${1}: (${2})"
    echo "⚠ ${1}: (${2}) — this board's cards were NOT read, so NO untriaged card from it appears below" >&3
}

# board_report — ONE per-board pass: set up + fetch the board's cards ONCE, then
# render both the in-flight snapshot (→ stdout) and the untriaged list (→ fd 3).
# snap() and untriaged() were independent subshells that each sourced the env and
# called fetch_board_cards for the SAME board — two full ~215KB pulls per board per
# SessionStart (card-4447). Each curl spawn is a fresh TLS handshake, so the cost is
# per-REQUEST; one fetch halves the API time. The parent streams stdout under the
# snapshot header and buffers fd 3 for the untriaged header, so the two-section
# output order is unchanged.
#
# EVERY arm that ends a board's pass without a card list reports on BOTH channels,
# through board_unread ABOVE. It used to report ONCE, on stdout, and write nothing to
# fd 3 — inherited from the era when snap() and untriaged() were separate passes and
# untriaged could stay quiet because snap had already spoken. That is a historical
# shape, not a decision, and once the two sections were printed under DIFFERENT
# headers it became a false claim: the untriaged header asserts "none may be silently
# missed", and an EMPTY section under it, for a board whose rows were never read at
# all, is a stronger version of the very claim card#6365's rc-3/rc-4 note exists to
# forbid one line above. A section that read nothing must SAY it read nothing; the
# alternative is silence that looks exactly like "there is nothing to triage".
#
# Which is why it is ONE function and not a convention repeated per arm: the sites that
# can end a pass without a card list have grown before (the env file, the board id, the
# token, the read guard, and the two renders) and the next one would otherwise inherit
# the silence for free. board-snapshot-selftest.sh derives that population from this
# file rather than listing it, so a new arm reds instead of going quiet.
board_report() {  # $1 = board env file   $2 = label ;  snapshot → stdout, untriaged → fd 3
  local envf="$1" label="$2"
  [[ -r "$envf" ]] || { board_unread "$label" "env $envf missing"; return 0; }
  (
    board_env_scrub
    # shellcheck disable=SC1090
    source "$envf"
    [[ -n "${KB_BOARD_ID:-}" ]] || { board_unread "$label" "env $envf sets no KB_BOARD_ID"; return 0; }
    # Explicit token ladder: this board's > the host's. There is NO third, defaulted tier —
    # card#7245 removed the baked ~/.kanban-dev-token, because a board falling through to it
    # was using a credential nobody chose for it and shared with every other board. Per-board
    # fail-soft — one board's undeclared or unreadable token must not blank the others.
    # Resolved once so the read and its failure message can't drift to different files.
    local tokfile
    tokfile="$(kb_declared_token_file "$envf" "${KBCARD_TOKEN_FILE:-}" "${KB_HOST_TOKEN_FILE:-}")" \
        || { board_unread "$label" "no KBCARD_TOKEN_FILE declared in $envf or ~/.kanban-host.env"; return 0; }
    kb_read_token "$tokfile" \
        || { board_unread "$label" "token file unreadable: $tokfile"; return 0; }
    local data rc
    data="$(fetch_board_cards "$API" "$KB_TOKEN" "$KB_BOARD_ID" "${SNAPSHOT_PAGE_CAP:-25}")"; rc=$?
    [[ $rc -eq 0 || $rc -eq 3 || $rc -eq 4 ]] \
        || { board_unread "$label" "board read failed — fetch rc=$rc"; return 0; }
    # A PARTIAL read is rendered — and now SAYS SO ON THE CHANNEL THE READER SEES.
    # The two rcs admitted above besides 0 emit their partial array precisely so a
    # fail-soft display can show what it has, and the paginator flags both
    # INCOMPLETE on STDERR — which this script's consumer discards (the same
    # channel trap the "2>&1 IS LOAD-BEARING" note at the bottom of this file
    # describes for the staleness guard). So the count an operator acts on was
    # rendered from a partial row set with the only contradicting signal on a
    # stream nobody reads: `in-flight 12` off a board that holds more. card#6365.
    #
    # The state is derived ONCE, here, and HANDED to the render path rather than
    # re-derived at each render from $rc — there are two renders, on two channels,
    # and a third would inherit it for free. Two carriers, because they answer
    # different questions:
    #   $floor prefixes every count this pass prints ("in-flight ≥12"), so the
    #     NUMBER cannot be read as a total even quoted out of its line. EVERY is a
    #     claim with a denominator: this pass prints exactly THREE counts — the
    #     in-flight count, the untriaged count, and the untriaged list's overflow
    #     tail ("… +N more"). The tail was the one that shipped bare, because it is
    #     a count of what the SIX-line cap hid rather than a count of the board, and
    #     it is a floor for the same reason the other two are. Adding a fourth count
    #     to either jq without $floor is the way this claim goes false; the selftest
    #     asserts no bare count survives on a partial read, over the whole render;
    #   the notes SAY it, once per section, because the two sections are printed
    #     under different headers (fd 3 is buffered and rendered far below), so a
    #     bare ≥ arriving there would have no explanation beside it. The fd-3 note
    #     also covers the silent shape: a truncated read whose surviving cards are
    #     all triaged prints NO untriaged block at all, and "nothing to triage" is
    #     exactly the claim a partial read may not make.
    # Predicate is `-ne 0`, not `3|4`: it is derived from the guard above — anything
    # that reaches here non-zero is a read this tool renders WITHOUT it being whole —
    # so widening that guard cannot leave a new rc rendering as complete.
    local floor=""
    if [[ $rc -ne 0 ]]; then
        floor="≥"
        echo "• ${label}: card list INCOMPLETE (fetch rc=$rc) — the in-flight count below is a FLOOR, not a total"
        echo "⚠ ${label}: card list INCOMPLETE (fetch rc=$rc) — untriaged cards may be MISSING from the list below" >&3
    fi
    # in-flight = the board's In Progress + In Review + Held stages, selected by the
    # env stage ids (the env is the contract for WHICH stages are in-flight; a board
    # omitting one simply drops it from the map).
    #
    # Display names are BOARD-SOURCED. They were hardcoded literals ("In Progress" /
    # "In Review" / "Held"), i.e. a private second copy of what the board calls its
    # columns — so a rename left the snapshot asserting a name the board no longer
    # used, and it printed [Held] for a column named Blocked/Gated on all three
    # boards. The two invisible siblings were the same defect: "In Progress" and
    # "In Review" only ever looked right because they happened to match.
    #
    # preload.json is the cheap stages read (~2.5KB, vs ~220KB for boards/{id}.json,
    # which inlines every task AND its description); there is no GET index for
    # workflow_stages, and tasks/search returns workflow_stage_id but no name.
    #
    # Fail-soft (SessionStart must never block): an unreachable preload, or an env
    # stage id the board doesn't define, degrades to "stage <id>" — the shape the
    # untriaged block below already prints. An unnamed stage is honest; a guessed
    # one is how this bug read as working.
    local names pre
    KB_API="$API"   # kb_api reads this global; board_report()'s body is a subshell, so it is contained
    pre="$(kb_api GET "/boards/$KB_BOARD_ID/preload.json" 2>/dev/null)" || pre=""
    # The preload body is UNTRUSTED and the name map must be TOTAL over it: a bad
    # preload costs the labels and nothing else. Anything less cascades — an empty
    # $names reaches --argjson below and takes the whole board to "(parse error)",
    # losing cards that fetched perfectly.
    #
    # Two distinct hazards, one expression:
    #   - not JSON at all. kb_api returns the body on any 2xx, and a proxy, captive
    #     portal, or truncated read can answer 200 with HTML. `fromjson?` yields
    #     nothing on a parse failure, so `// null` catches it.
    #   - JSON, but not this shape. Syntax-validating the body (jq -e .) is NOT
    #     enough and was the first fix's mistake: {"data":[]}, [] and {"data":"x"}
    #     are all valid JSON that then THROW on the .data walk (`?` suppresses
    #     iteration errors, not indexing an array/string with "workflows"). `try`
    #     covers the whole walk, so every shape lands on {} instead of an abort.
    # A stage whose name is null/absent is simply not mapped, and falls through to
    # the same "stage <id>" default — an unnamed stage is honest; a guessed one is
    # how the hardcoded labels read as working for so long.
    # Body enters jq VIA STDIN, never argv (-R -s slurps it as a raw string): an
    # untrusted body over MAX_ARG_STRLEN (~128KB) makes execve fail with "Argument
    # list too long" BEFORE jq parses anything, so $names comes back empty and
    # cascades into the card-listing jq exactly as a bad shape would. A >128KB 2xx
    # interstitial is ordinary for the proxy/portal case this guard exists for. The
    # lib states this rule for the same reason (see fetch_board_cards' header, the
    # #3091/#3362 class) — the argv form was measured failing at 131111 bytes.
    names="$(printf '%s' "$pre" | jq -R -s \
        --arg ip "${KB_STAGE_IN_PROGRESS:-}" \
        --arg ir "${KB_STAGE_IN_REVIEW:-}" \
        --arg hl "${KB_STAGE_HELD:-}" \
        '(fromjson? // null) as $p
         | (try ($p
                 | [ .data.workflows[]?.stages[]?
                     | select(.name != null)
                     | {(.id|tostring): ((.name | tostring | gsub("\\s+"; " "))[0:32])} ]
                 | add // {})
            catch {}) as $bn
         | [$ip,$ir,$hl]
         | map(select(. != ""))
         | map({(.): ($bn[.] // ("stage " + .))})
         | add // {}')"
    printf '%s' "$data" | jq -r --arg label "$label" --arg floor "$floor" --argjson names "$names" '
        (. // []) as $t
        | ($names | keys | map(tonumber)) as $infl
        | "• \($label): in-flight \($floor)\([$t[]|select(.workflow_stage_id as $s|$infl|index($s))]|length)",
          ([$t[] | select(.workflow_stage_id as $s | $infl | index($s))
            | "    #\(.id) [\($names[(.workflow_stage_id|tostring)])] \(.name[0:68])"] | .[])
      ' 2>/dev/null || echo "• ${label}: (parse error)"

    # ── untriaged section (→ fd 3): cards NOT in a terminal column (Shipped/
    # Released/Won't-Do) and lacking the `triaged` tag. New cards land untagged →
    # surface so triage is never silently missed ("triaged is a separate signal
    # from the DL number"). A Won't-Do card is processed-to-completion (terminal),
    # so it is terminal here too. Reuses the SAME $data as the snapshot above —
    # that reuse IS the card-4447 dedup. The parent buffers fd 3 and prints it under
    # the untriaged header, after every board's snapshot. /triage-cards clears them.
    printf '%s' "$data" | jq -r --arg label "$label" --arg floor "$floor" \
        --arg shipped "${KB_STAGE_SHIPPED_TO_DEV:-}" \
        --arg released "${KB_STAGE_RELEASED_TO_MAIN:-}" \
        --arg wontdo "${KB_STAGE_WONT_DO:-}" '
        ([$shipped, $released, $wontdo] | map(select(. != "") | tonumber)) as $term
        | ((. // [])
           | map(select(((.workflow_stage_id as $s | $term | index($s)) | not)
                        and (((.tags // []) | index("triaged")) | not)))
           | sort_by(.id) | reverse) as $u
        | if ($u | length) > 0 then
            "⚠ \($label): \($floor)\($u | length) UNTRIAGED — run the /triage-cards skill (newest first):",
            ($u[0:6][] | "    #\(.id) [stage \(.workflow_stage_id)] \(.name[0:60])"),
            (if ($u | length) > 6 then "    … +\($floor)\(($u | length) - 6) more" else empty end)
          else empty end
      ' 2>/dev/null >&3 \
        || echo "⚠ ${label}: (untriaged list could not be rendered — parse error)" >&3
  )
}

# Run the snapshot only when executed directly, so tests/board-snapshot-selftest.sh
# can source this file for its pure functions (board_env_scrub / board_report)
# without rendering a live snapshot. Mirrors the main-guard every other bin uses.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then

# PREFLIGHT, before any board is read: the api base must name a host somebody declared
# (card#7245). Fail-SOFT like everything else here — a SessionStart hook must never block —
# but the notice goes out under no board's header, because it is not one board's problem:
# every board on this box would send its bearer to the same unrecognised host. The guard has
# already said which value and which file on stderr.
if ! kb_require_known_api_host "$API"; then
    echo "── Dev board snapshot — SKIPPED: the resolved kanban api host is not a declared one (see stderr) ──"
    exit 0
fi

# Board roster is config-driven (BR-1), mirroring kbcard's `--board <name>` model
# so a PM-project adopter drives its OWN boards (not kanban-dev's hardcoded two).
# `~/.kanban-snapshot-boards` (override via KANBAN_SNAPSHOT_BOARDS): one
# `<name>:<label>` per line (`#` comments / blanks skipped); `<name>` resolves to
# `~/.kanban-<name>-board.env`, `<label>` is the display string (defaults to the
# name if no `:`). Absent/empty ⇒ the kanban-dev default below — back-compatible.
SNAPSHOT_BOARDS="${KANBAN_SNAPSHOT_BOARDS:-$HOME/.kanban-snapshot-boards}"
roster=()   # each entry: "<envfile>\t<label>"
if [[ -r "$SNAPSHOT_BOARDS" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line#"${line%%[![:space:]]*}"}"   # ltrim
        [[ -z "$line" || "$line" == \#* ]] && continue
        name="${line%%:*}"
        label="${line#*:}"
        [[ "$label" == "$line" ]] && label="$name"   # no colon ⇒ label = name
        name="${name//[[:space:]]/}"
        [[ -z "$name" ]] && continue
        roster+=("$HOME/.kanban-${name}-board.env"$'\t'"$label")
    done < "$SNAPSHOT_BOARDS"
fi
if [[ ${#roster[@]} -eq 0 ]]; then
    roster=(
        "$HOME/.kanban-dev-board.env"$'\t'"Board 5 (kanban-board)"
        "$HOME/.kanban-bridge-board.env"$'\t'"Board 8 (bridge)"
    )
fi

# One fetch per board (card-4447): board_report renders the in-flight snapshot to
# stdout and the untriaged list to fd 3. Buffer fd 3 to a temp file so the two
# sections keep their order (all snapshots, then all untriaged) off a SINGLE fetch.
untri_buf="$(mktemp 2>/dev/null || true)"
[[ -n "$untri_buf" ]] && trap 'rm -f "$untri_buf" 2>/dev/null' EXIT
echo "── Dev board snapshot — boards are the source of truth (memory is a cache) ──"
for entry in "${roster[@]}"; do
    if [[ -n "$untri_buf" ]]; then
        board_report "${entry%%$'\t'*}" "${entry#*$'\t'}" 3>>"$untri_buf"
    else
        # mktemp failed (should never happen on a writable TMPDIR): interleave the
        # untriaged lines into the snapshot section rather than lose them — still
        # ONE fetch per board; only the two-section split degrades.
        board_report "${entry%%$'\t'*}" "${entry#*$'\t'}" 3>&1
    fi
done
echo "── Untriaged cards — triage is my responsibility; none may be silently missed ──"
[[ -n "$untri_buf" ]] && cat "$untri_buf"

# Runtime staleness (cards #4351/#4361/#4393): the pin/copies topology fails silently in
# the worse direction — tools keep working, just older. --quiet prints nothing when
# current, so a healthy host stays silent.
#
# 2>&1 IS LOAD-BEARING: the guard writes warnings/failures to stderr, and this script's
# consumer is a SessionStart hook that surfaces STDOUT — a stderr-only warning is
# discarded and the guard silently never reaches anyone (the same channel trap
# board-card-start already ate: "the installed hook wrapper discards stderr, so the log
# is the durable record"). A staleness warning nobody reads is the exposure, not the fix.
# Folding to stdout puts it in the same stream as the board snapshot itself.
#
# Never blocks the snapshot (SessionStart is fail-soft): `|| true` swallows the guard's
# non-zero exit — the MESSAGE is the signal here, not the status.
command -v agent-board-toolkit-runtime-check >/dev/null 2>&1 \
    && agent-board-toolkit-runtime-check --quiet 2>&1 || true
exit 0
fi
