#!/usr/bin/env bash
# board-stats — a per-board STOCK + FLOW report, read from the two surfaces that can
# actually answer those two questions. Read-only: every call it makes is a GET.
#
# TWO SECTIONS, TWO SOURCES, ON PURPOSE.
#
#   STOCK is a STATE question — "what is on the board right now". The card snapshot
#   (tasks/search.json, via the shared fetch_board_cards) is the surface that answers it:
#   per board x column card counts, plus the oldest card's age in the PULLABLE columns
#   (backlog / prioritized), which is the one stock number that says whether the queue is
#   being worked or just growing.
#
#   FLOW is a RATE question — "what happened in the last 24h". Only the board changelog, an
#   append-only event log, answers that, and NOT deriving it from a card's `last_stage_move`
#   is the whole reason this tool exists. That field is a SNAPSHOT of the card's last hop, so
#   a census over it answers a rate question with a state value and is wrong in three
#   directions at once:
#     - a card that moved twice inside the window contributes ONE transition, not two, and
#       the intermediate stage is simply gone;
#     - a card that shipped and then bounced back reads only as the bounce — the resolution
#       it also had that day is invisible, so a wash silently deletes a real event;
#     - a release batch that re-moves already-shipped cards reads as N fresh resolutions.
#   The changelog carries every `task.moved` event separately, so a multi-hop card is
#   multi-hop here, a wash is a WASH ROW rather than a netted-away zero, and resolutions are
#   reported PER DESTINATION STAGE rather than collapsed into one number that reads the same
#   whether work was shipped or declined.
#
# TERMINAL vs NON-TERMINAL is read from the board env's KB_STAGE_* map (shipped-to-dev /
# released-to-main / won't-do), never from a baked-in stage id: board consumers key on
# NUMERIC stage ids, and those ids differ per board. Column NAMES come from the board itself
# (preload.json), falling back to the name the changelog event recorded and then to
# "stage <id>" — an unnamed column is honest, a guessed one is how a hardcoded label reads as
# working for years.
#
# FAIL-SOFT PER BOARD, and never silently. One unreachable board does not kill the report: its
# failure is named on its own line, the sections it could not fill are marked UNAVAILABLE
# rather than omitted, and the report ends with a PARTIAL line. A number that is a floor
# rather than a total (a capped card read, a truncated changelog window) says so where it is
# printed.
#
# Usage: board-stats [--board <name> | --all] [--since 24h|7d|<ISO-8601>] [--format text|json]
#
#   --board <name>   report on one board: the roster entry called <name>, else
#                    ~/.kanban-<name>-board.env directly. Mutually exclusive with --all.
#   --all            report on every board in the roster (~/.kanban-snapshot-boards, or every
#                    ~/.kanban-*-board.env on the box when there is no roster). THE DEFAULT.
#   --since <window> the FLOW window: <N>h, <N>d, or an ISO-8601 instant. Default 24h. The
#                    STOCK section is a snapshot and is not affected by it.
#   --format <fmt>   text (human, the default) or json. Both are rendered from ONE derivation,
#                    so the JSON carries exactly what the text prints — per-board stock,
#                    per-transition counts with their human/service split, the created count,
#                    the washes, and every per-board failure.
#
# Knobs: BOARD_STATS_MAX_TIME (per-request seconds, default 15), BOARD_STATS_PAGE_CAP
# (changelog pages per board, default 25 x 200 rows), BOARD_STATS_CARD_PAGE_CAP (default 25).
#
# Exit: 0 the report ran — INCLUDING a partial one, because a named unreadable board is a
# finding in the report, not a broken instrument; 1 no board could be read at all, so there is
# no report to believe; 2 usage error.
set -uo pipefail

KB_LIB="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)/_kb-board-lib.sh"
[ -r "$KB_LIB" ] || { echo "$(basename "${BASH_SOURCE[0]}"): shared lib _kb-board-lib.sh not found next to this script — reinstall per INSTALL.md §3 (symlink all of bin/), or vendor _kb-board-lib.sh alongside this tool." >&2; exit 1; }
# shellcheck source=bin/_kb-board-lib.sh
source "$KB_LIB"
KB_PROG="board-stats"

USAGE="Usage: board-stats [--board <name> | --all] [--since 24h|7d|<ISO-8601>] [--format text|json]"

# Cap EACH request. This bounds a REQUEST and not the run: a 7d window pages, so the ceiling
# is per-board (pages + 1 preload + the card read) x the cap, times the roster.
KB_CURL_MAX_TIME="${BOARD_STATS_MAX_TIME:-15}"
_BS_CL_LIMIT=200                                        # the changelog endpoint's own maximum
_BS_PAGE_CAP="${BOARD_STATS_PAGE_CAP:-25}"
_BS_CARD_PAGE_CAP="${BOARD_STATS_CARD_PAGE_CAP:-25}"

# ---------------------------------------------------------------------------
# jq programs. Each is a single-quoted constant so the shell never rewrites one, and every
# document larger than a stage map reaches jq through a FILE or stdin — never argv, which a
# whole-board card array or a 7d changelog window passes long before MAX_ARG_STRLEN (the
# lib's fetch_board_cards header documents that class).
# ---------------------------------------------------------------------------

# Shared timestamp reader: the API renders UTC as "+00:00", which fromdateiso8601 does not
# accept, and a value it cannot read becomes null rather than an abort — one unparseable
# timestamp must cost its own row, not the board.
_BS_JQ_EP='def ep($s): (if ($s|type) != "string" then null
                        else ($s | if test("Z$") then . else sub("\\+00:00$"; "Z") end
                                 | (try fromdateiso8601 catch null)) end);'

# One changelog page → {n, last_id, oldest, rows}. `rows` is already filtered to the window
# and projected to what the aggregation reads plus the event's own identity, so a page's bulk
# is dropped here rather than accumulated. `n`/`last_id`/`oldest` are what the pagination loop
# stops on. A row also carries `source` (ui|api|system), deliberately NOT projected: nothing
# splits on it, and a field carried for a future reader is one nobody notices is stale.
_BS_PAGE_JQ="$_BS_JQ_EP"'
def pget($k): ((.payload // {}) | if type == "object" then (.[$k] // null) else null end);
(.data // []) as $d
| { n: ($d | length),
    last_id: ($d[-1].id // null),
    oldest: ep($d[-1].created_at),
    rows: [ $d[]
            | select(.action == "task.created" or .action == "task.moved")
            | select(ep(.created_at) != null and ep(.created_at) >= $cut)
            | { action: .action, at: .created_at, card: .subject_id,
                actor: (.actor_type // "unknown"),
                from_id: pget("from_stage_id"), to_id: pget("to_stage_id"),
                from_name: pget("from_stage_name"), to_name: pget("to_stage_name") } ] }'

# The board's columns + names, out of an UNTRUSTED preload body. Total over anything: a body
# that is not JSON, or is JSON of another shape, costs the LABELS and nothing else — anything
# less cascades and takes cards that fetched perfectly with it. The body arrives as a raw
# string on stdin (-R -s) for the argv reason above.
_BS_STAGEMAP_JQ='
(fromjson? // null) as $p
| (try ($p | [ .data.workflows[]?.stages[]?
               | select(.id != null)
               | {id: (.id|tostring), name: (.name // null), pos: (.position // 0)} ])
   catch []) as $s
| { names: ([ $s[] | select(.name != null) | {(.id): (.name|tostring|gsub("\\s+"; " "))} ] | add // {}),
    order: ([ $s[] | {id: .id, pos: .pos} ] | sort_by(.pos) | map(.id)) }'

# The whole per-board derivation — stock and flow both, from the card file, the row file and
# the board's meta. ONE derivation feeds both output formats, so the JSON cannot drift from
# the text: the text renderer below reads this object and computes nothing of its own.
_BS_BOARD_JQ="$_BS_JQ_EP"'
def sid($v): (if $v == null then null else ($v|tostring) end);
def stagelabel($v; $ev): (sid($v) as $k
                     | if $k == null then "(none)"
                       else ($meta.names[$k] // $ev // ("stage " + $k)) end);
def isterm($v): (sid($v) as $k | $k != null and (($meta.term | index($k)) != null));
def ispull($v): (sid($v) as $k | $k != null and (($meta.pull | index($k)) != null));
def actorsplit: { human:   ([ .[] | select(.actor == "human") ]   | length),
                  service: ([ .[] | select(.actor == "service") ] | length),
                  other:   ([ .[] | select(.actor != "human" and .actor != "service") ] | length) };
def round1: ((. * 10) | round) / 10;

($cards[0] // []) as $all
| [ $all[] | select(.deleted_at == null) ] as $live
| (($rowpages | add) // []) as $rows
| [ $rows[] | select(.action == "task.moved") ] as $moved
| [ $rows[] | select(.action == "task.created") ] as $created
| ([ $live[] | (.workflow_stage_id | tostring) ] | unique) as $seen
| ($meta.order + (($seen - $meta.order) | sort_by(tonumber? // 0))) as $cols
| [ $moved
    | group_by([.from_id, .to_id])[]
    | { from_stage_id: .[0].from_id, to_stage_id: .[0].to_id,
        from_stage: stagelabel(.[0].from_id; .[0].from_name),
        to_stage:   stagelabel(.[0].to_id;   .[0].to_name),
        count: length,
        actors: actorsplit,
        resolution: isterm(.[0].to_id),
        wash: (isterm(.[0].from_id) and (isterm(.[0].to_id) | not)) } ]
  | sort_by([(0 - .count), .from_stage, .to_stage]) as $trans
| { board: $meta.name, label: $meta.label, board_id: $meta.board_id,
    stock: (if $meta.stock_ok | not then null else
      { columns: [ $cols[] as $k
          | [ $live[] | select((.workflow_stage_id|tostring) == $k) ] as $in
          | { stage_id: ($k | tonumber? // $k),
              stage: ($meta.names[$k] // ("stage " + $k)),
              cards: ($in | length),
              pullable: (($meta.pull | index($k)) != null),
              terminal: (($meta.term | index($k)) != null),
              oldest_card:
                (if (($meta.pull | index($k)) != null) and ($in | length) > 0
                 then ([ $in[] | {id: .id, created_at: .created_at, e: ep(.created_at)}
                         | select(.e != null) ] | sort_by(.e) | .[0]) as $o
                      | (if $o == null then null
                         else { id: $o.id, created_at: $o.created_at,
                                age_days: ((($meta.now - $o.e) / 86400) | round1) } end)
                 else null end) } ],
        total: ($live | length) } end),
    flow: (if $meta.flow_ok | not then null else
      { created: ($created | length),
        moved: ($moved | length),
        actors: ($moved | actorsplit),
        transitions: $trans,
        resolutions: ([ $moved
                        | map(select(isterm(.to_id)))
                        | group_by(.to_id)[]
                        | { stage_id: .[0].to_id,
                            stage: stagelabel(.[0].to_id; .[0].to_name),
                            count: length, actors: actorsplit } ]
                      | sort_by([(0 - .count), .stage])),
        washes: [ $trans[] | select(.wash) ],
        events_read: ($rows | length),
        pages: $meta.flow.pages,
        truncated: $meta.flow.truncated } end),
    failures: $meta.failures }'

# The text rendering — a pure function of the document above.
_BS_TEXT_JQ='
def pad($n): tostring | . as $s | ($n - ($s|length)) as $k
             | $s + (if $k > 0 then (" " * $k) else "" end);
def lpad($n): tostring | . as $s | ($n - ($s|length)) as $k
              | (if $k > 0 then (" " * $k) else "" end) + $s;
def split_note: (if .actors.other > 0 then "   human \(.actors.human) · service \(.actors.service) · unattributed \(.actors.other)"
                 else "   human \(.actors.human) · service \(.actors.service)" end);
"── Board stats ── stock from the card snapshot · flow from the changelog ──",
"window: \(.since.spec) — flow counts events at or after \(.since.cutoff) · generated \(.generated_at)",
( .boards[]
  | "",
    "▸ \(.label)  [\(.board)\(if .board_id != null then " · board \(.board_id)" else "" end)]",
    ( .failures[] | "  ⚠ \(.)" ),
    ( if .stock == null then "  stock: UNAVAILABLE — see the ⚠ line(s) above"
      else "  stock — a state question, read from the card snapshot",
           ( .stock.columns[]
             | "    \(.stage | pad(24))\(.cards | lpad(6))"
               + (if .oldest_card != null then "   oldest \(.oldest_card.age_days)d (#\(.oldest_card.id))" else "" end)
               + (if .terminal then "   [terminal]" elif .pullable then "   [pullable]" else "" end) ),
           "    \("total" | pad(24))\(.stock.total | lpad(6))"
      end ),
    ( if .flow == null then "  flow: UNAVAILABLE — see the ⚠ line(s) above"
      else "  flow — a rate question, read from the changelog\(if .flow.truncated then " (WINDOW TRUNCATED)" else "" end)",
           "    \("created" | pad(24))\(.flow.created | lpad(6))",
           "    \("moved" | pad(24))\(.flow.moved | lpad(6))\(. | .flow | split_note)",
           ( if (.flow.transitions | length) == 0 then "    transitions: none in window"
             else "    transitions:",
                  ( .flow.transitions[]
                    | "      \("\(.from_stage) -> \(.to_stage)" | pad(46))\(.count | lpad(5))"
                      + split_note
                      + (if .wash then "   [WASH]" elif .resolution then "   [resolution]" else "" end) )
             end ),
           ( if (.flow.resolutions | length) == 0 then "    resolutions: none in window"
             else "    resolutions, per destination stage (never collapsed into one number):",
                  ( .flow.resolutions[] | "      \(.stage | pad(46))\(.count | lpad(5))" + split_note )
             end ),
           ( if (.flow.washes | length) == 0 then empty
             else "    washes (terminal -> non-terminal; reported, NOT netted against the resolutions above):",
                  ( .flow.washes[] | "      \("\(.from_stage) -> \(.to_stage)" | pad(46))\(.count | lpad(5))" )
             end )
      end ) ),
( if .partial then
    "",
    "⚠ PARTIAL REPORT — \(.failed_boards) of \(.boards | length) board(s) could not be read in full; each is named above with its ⚠. Nothing was omitted silently."
  else empty end )'

# ---------------------------------------------------------------------------
# functions
# ---------------------------------------------------------------------------

# _bs_since_epoch <spec> <now-epoch>: the window's cutoff in epoch seconds, on stdout; rc 2
# with a diagnostic on an unreadable spec.
#
# `<N>h` / `<N>d` are computed ARITHMETICALLY and never handed to date(1) — GNU date reads
# "24h" as a FUTURE instant (now + 24 hours), so the relative form, which is the default and
# the one every caller types, would silently produce an empty window that looks like a quiet
# day. date(1) is reached only for an ISO-8601 spec, so a box whose date cannot parse one
# still gets every relative window.
_bs_since_epoch() {
    local spec="$1" now="$2" n e
    # An empty or whitespace-only spec is refused HERE and not left to date(1), which answers
    # `date -d ""` with TODAY'S MIDNIGHT at rc 0 — a plausible window nobody asked for, and
    # the shape an unexpanded shell variable arrives in. The caller's kb_require_value already
    # refuses `--since ""` at the flag, so this is the same invariant re-asserted where the
    # value is USED rather than trusted from one call site.
    if [[ -z "${spec//[[:space:]]/}" ]]; then
        echo "$KB_PROG: --since needs a window (an unexpanded variable?) — <N>h, <N>d, or an ISO-8601 instant" >&2
        return 2
    fi
    if kb_ere_match "$spec" '^([0-9]{1,6})([hd])$'; then
        n="$((10#${BASH_REMATCH[1]}))"
        [[ "$n" -ge 1 ]] || { echo "$KB_PROG: --since $spec is a zero-length window" >&2; return 2; }
        case "${BASH_REMATCH[2]}" in
            h) printf '%s' "$((now - n * 3600))" ;;
            d) printf '%s' "$((now - n * 86400))" ;;
        esac
        return 0
    fi
    e="$(date -u -d "$spec" +%s 2>/dev/null)"
    if kb_is_uint "${e:-}"; then printf '%s' "$e"; return 0; fi
    echo "$KB_PROG: --since '$spec' is neither a <N>h / <N>d window nor an ISO-8601 instant this box's date(1) can read" >&2
    return 2
}

# _bs_stage_map <preload-body>: {names, order} for the board, or the empty map on any
# unusable body (see _BS_STAGEMAP_JQ).
_bs_stage_map() {
    printf '%s' "${1:-}" | jq -c -R -s "$_BS_STAGEMAP_JQ" 2>/dev/null || printf '{"names":{},"order":[]}'
}

# _bs_window_rows <board-id> <cutoff-epoch> <rows-file>: page the board changelog BACKWARDS,
# appending one JSON array of in-window rows per page to <rows-file>; prints
# {pages, truncated, error} on stdout. The rows never pass through a shell variable or argv.
#
# WHY THE LOOP STOPS WHERE IT DOES. The endpoint has NO date filter — it is a cursor log,
# newest-first under order=desc, paged by `before=<row id>` — so a window is read by paging
# until the rows precede the cutoff. A page whose OLDEST row (its last, under desc) already
# precedes the cutoff has therefore delivered every in-window row that exists, and every later
# page is older still: that is the stop, and it is why the cutoff test reads the page's LAST
# row rather than each row (each row is filtered too, but that is what to KEEP, not when to
# stop). A short page — fewer rows than the endpoint's own limit — means the log itself is
# exhausted. The page cap is the third stop and the ONLY one that can truncate a window: it
# says so, and the board is reported partial rather than presenting a short read as a whole
# one.
_bs_window_rows() {
    local board_id="$1" cut="$2" out="$3"
    local cursor="" pages=0 truncated=false err="" url resp page n oldest last
    while :; do
        url="/boards/$board_id/changelog.json?limit=${_BS_CL_LIMIT}&order=desc"
        [[ -n "$cursor" ]] && url+="&before=$cursor"
        resp="$(KB_API_QUIET=1 kb_api GET "$url")" || {
            err="changelog read failed (HTTP ${KB_HTTP:-000}) after $pages page(s)"; break; }
        pages=$((pages + 1))
        page="$(printf '%s' "$resp" | jq -c --argjson cut "$cut" "$_BS_PAGE_JQ" 2>/dev/null)"
        [[ -n "$page" ]] || { err="changelog page $pages is not the shape this tool reads"; break; }
        printf '%s' "$page" | jq -c '.rows' >> "$out"
        n="$(printf '%s' "$page" | jq -r '.n')"
        oldest="$(printf '%s' "$page" | jq -r 'if .oldest == null then "none" else (.oldest|tostring) end')"
        last="$(printf '%s' "$page" | jq -r 'if .last_id == null then "none" else (.last_id|tostring) end')"
        [[ "$n" -lt "$_BS_CL_LIMIT" ]] && break
        [[ "$oldest" != none && "$oldest" -lt "$cut" ]] && break
        [[ "$last" != none ]] || { err="changelog page $pages carries no cursor id — cannot page further"; break; }
        if [[ "$pages" -ge "$_BS_PAGE_CAP" ]]; then
            truncated=true
            err="stopped at the ${_BS_PAGE_CAP}-page cap — this window is INCOMPLETE (raise BOARD_STATS_PAGE_CAP)"
            break
        fi
        cursor="$last"
    done
    jq -n --argjson pages "$pages" --argjson truncated "$truncated" --arg err "$err" \
        '{pages: $pages, truncated: $truncated, error: (if $err == "" then null else $err end)}'
}

# _bs_board_json <card-file> <rows-file> <meta-json>: the per-board object. Both bulk inputs
# are read as FILES (--slurpfile), never argv.
_bs_board_json() {
    jq -n --slurpfile cards "$1" --slurpfile rowpages "$2" --argjson meta "$3" "$_BS_BOARD_JQ"
}

# _bs_render_text <doc-file>: the human rendering of the assembled document.
_bs_render_text() { jq -r "$_BS_TEXT_JQ" "$1"; }

# _bs_one_board <name> <label> <cutoff> <now> <tmpdir>: one board's object on stdout. Every
# failure is collected into the object's own `failures` array rather than printed, so the
# renderer decides where it lands and no board can be dropped without a line saying so.
_bs_one_board() {
    local name="$1" label="$2" cut="$3" now="$4" tmp="$5"
    local envf="$HOME/.kanban-${name}-board.env"
    local -a fails=() vals=()
    local board_id="" tokfile="" bl="" pr="" sh="" rl="" wd=""
    local stock_ok=false flow_ok=false rc pre map err
    local cardfile="$tmp/cards.json" rowsfile="$tmp/rows.jsonl"
    local flowmeta='{"pages":0,"truncated":false,"error":null}'
    map='{"names":{},"order":[]}'
    : > "$cardfile"; : > "$rowsfile"

    if [[ ! -r "$envf" ]]; then
        fails+=("board env not readable: $envf — this board contributes nothing to the report")
    else
        # kb_board_env_get, not a source: it unsets each requested key before reading the file
        # in a subshell, so a board that omits an optional stage id cannot inherit the value a
        # sibling board's env left in this shell (the card-4448 class).
        mapfile -t vals < <(kb_board_env_get "$envf" KB_BOARD_ID KBCARD_TOKEN_FILE \
            KB_STAGE_BACKLOG KB_STAGE_PRIORITIZED \
            KB_STAGE_SHIPPED_TO_DEV KB_STAGE_RELEASED_TO_MAIN KB_STAGE_WONT_DO)
        board_id="${vals[0]:-}"; tokfile="${vals[1]:-}"
        bl="${vals[2]:-}"; pr="${vals[3]:-}"
        sh="${vals[4]:-}"; rl="${vals[5]:-}"; wd="${vals[6]:-}"

        if [[ -z "$board_id" ]]; then
            fails+=("env $envf sets no KB_BOARD_ID — this board contributes nothing to the report")
        else
            # This board's token > the host's > the default, resolved once so the read and any
            # failure message cannot name different files.
            tokfile="${tokfile:-${KB_HOST_TOKEN_FILE:-$HOME/.kanban-dev-token}}"
            if ! kb_read_token "$tokfile"; then
                fails+=("token file unreadable: $tokfile — this board contributes nothing to the report")
            else
                KB_API="$API"   # the lib's kb_api reads this global
                fetch_board_cards "$API" "$KB_TOKEN" "$board_id" "$_BS_CARD_PAGE_CAP" \
                    > "$cardfile" 2>/dev/null
                rc=$?
                case "$rc" in
                    0) stock_ok=true ;;
                    3|4) stock_ok=true
                         fails+=("card snapshot INCOMPLETE (fetch rc=$rc) — every stock count below is a floor, not a total") ;;
                    *) : > "$cardfile"
                       fails+=("card snapshot unavailable (fetch rc=$rc) — this board's stock section is missing") ;;
                esac

                pre="$(KB_API_QUIET=1 kb_api GET "/boards/$board_id/preload.json" 2>/dev/null)" || pre=""
                map="$(_bs_stage_map "$pre")"
                [[ "$map" == '{"names":{},"order":[]}' ]] \
                    && fails+=("board column names unavailable (preload read failed or was unusable) — columns are labelled by stage id")

                flowmeta="$(_bs_window_rows "$board_id" "$cut" "$rowsfile")"
                err="$(printf '%s' "$flowmeta" | jq -r '.error // ""')"
                if [[ -z "$err" ]]; then
                    flow_ok=true
                elif [[ "$(printf '%s' "$flowmeta" | jq -r '.pages')" -gt 0 ]]; then
                    # Some of the window was read: report what there is, flagged, rather than
                    # dropping a section whose rows are in hand.
                    flow_ok=true
                    fails+=("changelog window INCOMPLETE: $err — the flow counts below are a floor, not a total")
                else
                    fails+=("changelog unavailable: $err — this board's flow section is missing")
                fi
            fi
        fi
    fi

    local failures_json='[]'
    [[ ${#fails[@]} -gt 0 ]] && failures_json="$(printf '%s\n' "${fails[@]}" \
        | jq -R -s 'split("\n") | map(select(length > 0))')"

    local meta
    meta="$(jq -n --arg name "$name" --arg label "$label" --arg bid "$board_id" \
        --argjson map "$map" --argjson flow "$flowmeta" --argjson failures "$failures_json" \
        --argjson now "$now" --argjson stock_ok "$stock_ok" --argjson flow_ok "$flow_ok" \
        --arg bl "$bl" --arg pr "$pr" --arg sh "$sh" --arg rl "$rl" --arg wd "$wd" '
        { name: $name, label: $label,
          board_id: (if $bid == "" then null else ($bid | tonumber? // $bid) end),
          names: $map.names, order: $map.order,
          term: ([$sh, $rl, $wd] | map(select(. != ""))),
          pull: ([$bl, $pr] | map(select(. != ""))),
          now: $now, flow: $flow, failures: $failures,
          stock_ok: $stock_ok, flow_ok: $flow_ok }')"

    # The aggregation itself is the last thing that can drop a board out of the report
    # entirely, which is the one failure mode this tool must not have: a board that produced
    # no line is indistinguishable from a board nobody asked about. So its output is captured
    # and, if it did not produce one, replaced by a stub object carrying the board's identity,
    # its own failures, and this one.
    local obj
    obj="$(_bs_board_json "$cardfile" "$rowsfile" "$meta" 2>/dev/null)"
    if [[ -n "$obj" ]]; then
        printf '%s\n' "$obj"
    else
        jq -c -n --argjson meta "$meta" \
            '{ board: $meta.name, label: $meta.label, board_id: $meta.board_id,
               stock: null, flow: null,
               failures: ($meta.failures + ["this board could not be summarized — the report aggregation failed on its data"]) }'
    fi
}

# Run only when executed directly, so tests/board-stats-selftest.sh can source this file for
# its pure functions without issuing a single request. Mirrors board-snapshot's main guard.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then

board="" all=0 since="24h" format="text"
while [[ $# -gt 0 ]]; do
    case "$1" in
        # Contiguous leading comment block, not a fixed range — see the release movers.
        -h|--help) awk 'NR>1 { if (substr($0,1,1) == "#") print; else exit }' "$0"; exit 0 ;;
        --all) all=1 ;;
        --board)
            kb_require_value "$1" "${2:-}" || exit 2
            shift
            [[ -z "$board" ]] || { echo "$KB_PROG: --board given twice" >&2; echo "$USAGE" >&2; exit 2; }
            board="$1" ;;
        --since)
            kb_require_value "$1" "${2:-}" || exit 2
            shift; since="$1" ;;
        --format)
            kb_require_value "$1" "${2:-}" || exit 2
            shift; format="$1" ;;
        *) echo "$KB_PROG: unknown argument: $1" >&2; echo "$USAGE" >&2; exit 2 ;;
    esac
    shift
done

[[ "$all" -eq 1 && -n "$board" ]] && { echo "$KB_PROG: --all and --board are mutually exclusive" >&2; echo "$USAGE" >&2; exit 2; }
case "$format" in
    text|json) ;;
    *) echo "$KB_PROG: --format '$format' is not one of: text, json" >&2; exit 2 ;;
esac

now="$(date -u +%s)"
cut="$(_bs_since_epoch "$since" "$now")" || exit 2

kb_load_host_env   # cannot fail (reads no token)
API="${KB_API:-}"
[[ -n "$API" ]] || { echo "$KB_PROG: KBCARD_API not set — create ~/.kanban-host.env (see agent-board-toolkit docs/INSTALL.md)" >&2; exit 1; }

# The roster is the lib's (the ~/.kanban-snapshot-boards file board-snapshot reads, else every
# board env on the box). --board addresses a board whether or not the roster names it, taking
# the roster's display label when it does.
declare -a roster=()
mapfile -t roster < <(kb_board_roster)
if [[ -n "$board" ]]; then
    sel=""
    for entry in "${roster[@]}"; do
        [[ "${entry%%$'\t'*}" == "$board" ]] && sel="$entry"
    done
    [[ -n "$sel" ]] || sel="$board"$'\t'"$board"
    roster=("$sel")
fi
if [[ ${#roster[@]} -eq 0 ]]; then
    echo "$KB_PROG: no board found — this box has no ~/.kanban-snapshot-boards roster and no ~/.kanban-*-board.env (see agent-board-toolkit docs/INSTALL.md §3)" >&2
    exit 1
fi

TMP="$(mktemp -d)" || { echo "$KB_PROG: could not create a temp dir" >&2; exit 1; }
trap 'rm -rf "$TMP"' EXIT
boardsfile="$TMP/boards.jsonl"
: > "$boardsfile"
for entry in "${roster[@]}"; do
    name="${entry%%$'\t'*}"
    label="${entry#*$'\t'}"
    bdir="$TMP/b.$$.${name//[^A-Za-z0-9_-]/_}"
    mkdir -p "$bdir"
    _bs_one_board "$name" "$label" "$cut" "$now" "$bdir" >> "$boardsfile"
done

docfile="$TMP/doc.json"
jq -s --argjson now "$now" --arg spec "$since" --argjson cutep "$cut" '
    { generated_at: ($now | todate),
      since: { spec: $spec, cutoff: ($cutep | todate), epoch: $cutep },
      partial: any(.[]; (.failures | length) > 0),
      failed_boards: ([ .[] | select((.failures | length) > 0) ] | length),
      readable_boards: ([ .[] | select(.stock != null or .flow != null) ] | length),
      boards: . }' "$boardsfile" > "$docfile" \
    || { echo "$KB_PROG: could not assemble the report" >&2; exit 1; }

case "$format" in
    json) jq '.' "$docfile" ;;
    text) _bs_render_text "$docfile" ;;
esac

# A report over zero readable boards is not a quiet board — it is no measurement at all, and
# the ⚠ lines just rendered say which read failed.
if [[ "$(jq -r '.readable_boards' "$docfile")" -eq 0 ]]; then
    echo "$KB_PROG: no board could be read — nothing above is a measurement" >&2
    exit 1
fi
exit 0
fi
