#!/usr/bin/env bash
# board-session-close — session-close reconciliation ritual. RUN ON DEMAND when
# the user says they're closing / wrapping up the session. Puts board in-flight
# state next to local branch/PR reality so any drift (a card that no longer
# matches what git/PRs show) gets fixed BEFORE the session ends. Read-only — it
# surfaces what to reconcile; the actual kbcard writes are the agent's call.
#
# The inverse-drift leg (In-Review cards tracking no open PR) is DELEGATED to the
# shipped, framework-maintained `kanban-reconcile.py --detect` — the sanctioned
# conforming implementation of the inverse-drift CONTRACT (the framework coord
# plugin's BOARD-SYNC.md § "The detect backstop contract (inverse-drift)"). It
# reads the same boards from the coord config (kanban.boards[]) and is READ-ONLY
# by construction, plus adds a forward un-carded-open-PR leg the retired bash
# check never had.
#
# A READ-ONLY "Git hook dispatch" leg reports, per local checkout, whether the
# post-checkout hook git ACTUALLY dispatches reaches `board-card-start`. A repo can
# lose that wiring and every routine check stays green: `board-card-start` is
# fail-soft by contract (it must never block a checkout), so from the operator's
# seat a missing hook and a working hook are indistinguishable, and the inverse-drift
# leg below sees only the SYMPTOM (a card that never left its backlog column) and
# reconciles it as ordinary drift — masking the cause. This leg reports the cause. It
# is REPORT-ONLY: it never installs, repairs or mutates anything, and it never changes
# this ritual's exit code (the inverse-drift leg owns that).
#
# A third READ-ONLY leg — "Archive-eligible done cards" — is DELEGATED to the
# sibling `_kbc-archive-eligible.py`: for each configured board it reports how many
# terminal (done-lane) cards are not yet archived, and runs the framework's shipped
# `may_archive` gate over a BOUNDED SAMPLE of them to show a concrete "safe to
# archive now" starting point (the gate is per-card in `kbcard archive` at archive
# time; gating the whole done backlog here would be a slow network storm). It only
# surfaces (never archives); a missing sibling is a warning, not a hard failure.
set -uo pipefail

# resolve_reconcile_hook — locate the shipped kanban-reconcile.py detect hook
# WITHOUT a version-pinned path (a future plugin bump must not break this). Prints
# the resolved path on stdout (rc 0), or rc 1 if none of the sources have it — the
# caller then fails LOUD rather than silently skipping the drift check. Order:
#   1. $KANBAN_RECONCILE_HOOK explicit operator override.
#   2. The coord plugin version THIS session loaded (its dir is named on $PATH) —
#      runs the exact version the rest of the session's coord tooling uses.
#   3. The git-maintained marketplace clone (stable, version-less path).
#   4. The newest cached plugin version carrying the hook (sort -V).
resolve_reconcile_hook() {
  local rel="hooks/bin/kanban-reconcile.py" c pdir
  if [[ -n "${KANBAN_RECONCILE_HOOK:-}" ]]; then
    [[ -f "$KANBAN_RECONCILE_HOOK" ]] && { printf '%s' "$KANBAN_RECONCILE_HOOK"; return 0; }
    return 1
  fi
  pdir="$(printf '%s\n' "${PATH//:/$'\n'}" | grep -m1 '/agent-board-framework/coord/[^/]*/bin$' 2>/dev/null || true)"
  if [[ -n "$pdir" ]]; then
    c="${pdir%/bin}/$rel"
    [[ -f "$c" ]] && { printf '%s' "$c"; return 0; }
  fi
  c="$HOME/.claude/plugins/marketplaces/agent-board-framework/plugins/coord/$rel"
  [[ -f "$c" ]] && { printf '%s' "$c"; return 0; }
  # A non-matching glob stays literal (no nullglob) → the trailing -f guard rejects it.
  c="$(printf '%s\n' "$HOME"/.claude/plugins/cache/agent-board-framework/coord/*/"$rel" | sort -V | tail -1)"
  [[ -n "$c" && -f "$c" ]] && { printf '%s' "$c"; return 0; }
  return 1
}

# The local checkouts this ritual inspects — ONE list, read by BOTH the branch-reality
# leg and the hook-dispatch leg (a second hardcoded copy is how two legs silently come
# to disagree about which repos are covered). Host-local by nature: board-session-close
# is the agent host's own session tool, not a vendored per-repo tool.
BSC_WORKTREES=(
  "$HOME/agent-webhook-bridge-dev"
  "$HOME/agent-webhook-bridge-prod"
  "$HOME/kanbanboard"
  "$HOME/agent-board-toolkit"
  "$HOME/agent-board-toolkit-prod"
)
# The hooks install-board-hooks installs. post-checkout is load-bearing (it is what moves
# the card to In Progress); pre-push is the fail-soft branch-name advisory.
BSC_HOOKS=(post-checkout pre-push)

# _bsc_hooks_dir <repo-dir> — echo the directory git ACTUALLY dispatches this repo's hooks
# from.  rc 0 = resolved · 1 = git REFUSES this checkout, and stdout carries git's own
# diagnostic instead of a directory · 2 = no checkout there · 7 = a bare repository · 8 = a
# directory inside someone else's work tree, not a checkout root (stdout explains, for both) ·
# 3 = resolved, but core.hooksPath is inside the tracked work tree (install-board-hooks
# refuses that target; git still dispatches from it) · 4 = core.hooksPath is SET but EMPTY, so
# git dispatches NO hooks at all (there is no directory to echo) · 5 = the resolver could not
# be loaded · 6 = core.hooksPath is set to a value git cannot expand (git fatals at dispatch).
#
# NEITHER the core.hooksPath READ nor its resolution is re-derived here: both are primitives
# bin/install-board-hooks already owns and deliberately exposes (`_ibh_read_hooks_path`,
# `_ibh_hooks_dir`; that bin is main-guarded, so sourcing it defines them and installs
# nothing). A checker that looked in .git/hooks alone — or that read the value without its
# presence status — would report a repo healthy on the strength of a hook git never dispatches:
# the precise silent no-op the installer was fixed for (#4281). A second copy of either is what
# lets the two drift apart again. They are sourced in a SUBSHELL because install-board-hooks
# sets -euo pipefail at top level and this ritual deliberately runs without -e.
# With a second argument of `installer`, it answers a different question: which directory
# `install-board-hooks` would TARGET for this repo (it passes <root>/.git, never the real common
# dir). Same code path, one substituted input — so "can the installer service this checkout?" is
# answered by comparing the two views, not by pattern-matching path shapes that miss topologies.
_bsc_hooks_dir() {
  local repo="$1" view="${2:-}" ibh root cdir err
  [[ -e "$repo" ]] || return 2
  # Report git's OWN words when it refuses the checkout, never a guessed cause. Several real
  # states land here and each has a different fix: not a repository, `dubious ownership`
  # (safe.directory), and — verified — a core.hooksPath git cannot expand, which fatals EVERY
  # command in the repo, this probe included. "Not a git work tree" would be a confident wrong
  # diagnosis for the last two, and a wrong-but-specific cause is worse than an honest one.
  if ! err="$(git -C "$repo" rev-parse --git-dir 2>&1 >/dev/null)"; then
    printf '%s' "${err:-git refused this checkout}"; return 1
  fi
  root="$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null)"
  if [[ -z "$root" ]]; then
    # git did NOT refuse — it answered, and the answer is "there is no work tree". Saying "git
    # refuses this checkout" here would be the guessed cause this function exists to avoid.
    printf 'a bare repository — no work tree, so no branch is ever checked out here'; return 7
  fi
  # A path that is merely INSIDE a work tree is not that checkout: reporting the enclosing
  # repo's hooks under this path's name is a false statement about a repo the operator asked
  # about, and the fix-line would name a path that is not the checkout being described.
  if ! _bsc_same_dir "$root" "$repo"; then
    printf 'not a checkout root — it is a directory inside the work tree at %s' "$root"; return 8
  fi
  # A LINKED WORKTREE (.git is a FILE) dispatches hooks from the main checkout's common dir,
  # not <worktree>/.git/hooks. `rev-parse -C <repo>` may answer relative to <repo>.
  cdir="$(git -C "$repo" rev-parse --git-common-dir 2>/dev/null)"
  [[ -n "$cdir" ]] || cdir="$root/.git"
  [[ "$cdir" == /* ]] || cdir="$repo/$cdir"
  [[ "$view" == "installer" ]] && cdir="$root/.git"   # mirrors _ibh_main's own argument
  ibh="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/install-board-hooks"
  [[ -r "$ibh" ]] || return 5
  # shellcheck source=/dev/null
  (
    . "$ibh" >/dev/null 2>&1
    # `-e` is live in here (the sourced bin sets it), so every status is captured in an ||
    # context and every branch is an `if` — a bare `[ x ] && exit N` would exit 1 on the
    # false branch and silently become "not a work tree" at the caller.
    local hp hp_rc=0 hp_set=""
    hp="$(_ibh_read_hooks_path "$repo")" || hp_rc=$?
    if [ "$hp_rc" = 2 ]; then exit 6; fi
    if [ "$hp_rc" = 0 ]; then hp_set=1; fi
    _ibh_hooks_dir "$root" "$hp" "$cdir" "$hp_set"
  )
}

# _bsc_active_toolkit — the toolkit checkout that owns the on-PATH `board-card-start`: the copy
# that actually runs when a hook fires, and the reference for "is this hook wired to the same
# checkout?".  rc 0 = echoed · 1 = board-card-start is NOT on PATH · 2 = it is on PATH but its
# toolkit root is not derivable. The root is confirmed by LAYOUT (a `hooks/post-checkout`
# beside the tool's parent), never by a `bin` path literal: a copy install under any other
# directory name would otherwise yield a confident wrong root — and a wrong root makes every
# correctly-wired repo report CLONE-DRIFT.
_bsc_active_toolkit() {
  local p root
  p="$(command -v board-card-start 2>/dev/null)" || return 1
  [[ -n "$p" ]] || return 1
  p="$(readlink -f "$p" 2>/dev/null || printf '%s' "$p")"
  root="$(dirname "$(dirname "$p")")"
  [[ -n "$root" && -f "$root/hooks/post-checkout" ]] || return 2
  printf '%s' "$root"
}

# _bsc_runnable <file> — THE predicate for "could git actually exec this hook?". rc 0 silent
# when it could; rc 1 printing the reason when it could not. Every caller that needs this
# property calls this and does nothing else to decide it.
#
# It exists because that property kept being computed in more than one place, and each round of
# review found a NEW fact that had to be added to every place at once: the executable bit was
# added to the chain path after the direct path already had it; exec-ability was then added to
# both; and then three more one-predicate gaps turned up in the same family (a tab-separated
# shebang, an interpreter that is a directory, a first line with no trailing newline). Applying
# each new fact twice, correctly, still left the next one to be applied twice. The split was the
# defect — so this is the only site that knows the rule, and anything added here lands on every
# caller for free. PURE READ: stat plus the first line, never an execution.
#
# What the kernel actually does, and therefore what this owns:
#   * the file must be executable AND a regular file — `-x` is true for a DIRECTORY, which
#     cannot be exec'd;
#   * a `#!` line is read (the read must survive a first line with NO trailing newline, which
#     makes `read` return non-zero while still assigning);
#   * a trailing CR makes the interpreter name carry the stray \r — git then fails "cannot
#     exec". This is the native hazard of the Windows/MSYS COPY install topology this toolkit
#     supports (docs/INSTALL.md §2);
#   * leading WHITESPACE after `#!` is skipped and the interpreter ends at the next one —
#     SPACES AND TABS both, so `#!<TAB>/bin/sh` and `#!/bin/sh<TAB>` run fine (verified) and
#     must not be called dead;
#   * the interpreter itself must exist, be a regular file, and be executable.
# A file with no `#!` is not judged: it may be a binary, or be run by the shell.
# `/usr/bin/env foo` is judged on `env` alone — resolving `foo` needs the PATH git will have at
# dispatch time, not this one, and guessing it would invent findings.
_bsc_runnable() {
  local f="$1" first="" interp
  if [[ -d "$f" ]]; then printf 'is a directory, not a hook'; return 1; fi
  if [[ ! -f "$f" ]]; then printf 'is not a regular file'; return 1; fi
  if [[ ! -x "$f" ]]; then
    printf 'is not executable — git ignores it, saying so only through a suppressible advice.ignoredHook hint'
    return 1
  fi
  IFS= read -r first < "$f" 2>/dev/null || true
  [[ -n "$first" ]] || return 0
  case "$first" in '#!'*) ;; *) return 0 ;; esac
  case "$first" in
    *$'\r') printf 'has a CRLF shebang line — the OS looks for an interpreter whose name carries the stray \\r, and git fails with "cannot exec"'
             return 1 ;;
  esac
  interp="${first#\#!}"; interp="${interp#"${interp%%[![:space:]]*}"}"; interp="${interp%%[[:space:]]*}"
  [[ -n "$interp" ]] || return 0
  if [[ -d "$interp" || ! -f "$interp" || ! -x "$interp" ]]; then
    printf 'names a shebang interpreter (%s) that is missing, not a regular file, or not executable — git fails with "cannot exec"' "$interp"
    return 1
  fi
  return 0
}

# _bsc_hook_reaches <hook-file> <hook-name> — rc 0 when the dispatched hook actually reaches
# board-card-start; rc 2 (printing the target) when it chains to a hook the OS could not run.
# Reads the file with symlinks followed, so a symlinked hook and a copied one (Windows/MSYS
# `ln -s` yields copies) both match, and follows ONE level of chaining — a committed hook that
# execs the toolkit hook, the remedy install-board-hooks prints for an in-tree core.hooksPath.
#
# It matches TEXT, so the answer is an approximation whose bounds run in BOTH directions. They
# are stated here and in docs/HOOKS.md, because a check whose limits are undisclosed gets
# trusted past them — and this one's whole purpose is to stop a dead hook reading as healthy.
#
# Bounds that err toward a false FINDING (safe):
#   * `#` comments are stripped before matching, so a hook that only MENTIONS the tool in a
#     comment reads as not reaching it — and the strip also blanks the tail of a line whose
#     earlier text quotes a `#` (`echo "#"; board-card-start`).
#   * only ABSOLUTE, literal chain targets are followed. A chain written with a variable
#     (`exec "$TOOLKIT/hooks/post-checkout"`) or relative to the work tree
#     (`exec ../toolkit/hooks/post-checkout`) reads as a finding even though it works. Neither
#     is unresolvable in principle — githooks(5) fixes the hook CWD at the work-tree root, so a
#     relative target could be resolved against it (ambiguously for a shared/global hooks dir
#     serving several repos), and a variable assigned inside the hook could be read — they are
#     simply NOT IMPLEMENTED, and both err toward a false finding. The guidance this chain
#     support exists for prints an absolute literal path, so the population these tools
#     generate is covered; a hand-written variant may not be.
#   * a chain through a wrapper that is not itself a `hooks/<name>` path reads as a finding.
#
# Bounds that can produce a false OK — ACCEPTED, and NOT IMPLEMENTED rather than impossible:
#   * a mention inside a string literal (`echo "run board-card-start yourself"`) reads as a
#     reach. Separating a string from code needs real shell parsing, not a match.
#   * an invocation UNREACHABLE at runtime reads as a reach — most realistically a call after an
#     early `exit 0`, which is how a hook gets "temporarily" disabled. The simplest form (an
#     unconditional top-level `exit 0` before the call) IS catchable by a pure read; the general
#     case — conditionals, functions, traps — is not, and only executing the hook decides it.
# Both were reproduced against this implementation. The general case of the second, and the
# first, are why these stay open; anything a pure READ can decide is fixed instead of disclosed
# (see _bsc_runnable), so that rationale is never stretched to cover what reading can catch.
_bsc_hook_reaches() {
  local f="$1" hook="$2" p refs code broken=""
  code="$(sed 's/#.*//' "$f" 2>/dev/null)" || return 1
  grep -q 'board-card-start' <<< "$code" && return 0
  refs="$(grep -o "/[^\"'[:space:]]*/hooks/$hook" <<< "$code" | sort -u)"
  [[ -n "$refs" ]] || return 1
  while IFS= read -r p; do
    [[ -n "$p" && -r "$p" ]] || continue
    if sed 's/#.*//' "$p" 2>/dev/null | grep -q 'board-card-start'; then
      # The chained hook must be runnable too — the SAME question, so the same owner. This
      # call is why a fact added to _bsc_runnable can no longer land on one path only.
      if _bsc_runnable "$p" >/dev/null; then return 0; fi
      broken="$p"
    fi
  done <<< "$refs"
  if [[ -n "$broken" ]]; then printf '%s' "$broken"; return 2; fi
  return 1
}

# _bsc_hook_state <dispatch-dir> <hook> <toolkit-root> — echo ONE status token:
#   OK · MISSING · DANGLING · NOT-RUNNABLE · NO-REACH · CHAIN-BROKEN · CLONE-DRIFT
_bsc_hook_state() {
  local dir="$1" hook="$2" tk="${3:-}" f="$1/$2" real
  if [[ -L "$f" && ! -e "$f" ]]; then echo "DANGLING"; return 0; fi
  [[ -e "$f" ]] || { echo "MISSING"; return 0; }
  # Runnability — the bit, the file type, the shebang, all of it — is ONE question with ONE
  # owner (_bsc_runnable). Nothing here re-decides any part of it.
  _bsc_runnable "$f" >/dev/null || { echo "NOT-RUNNABLE"; return 0; }
  local reach_rc=0
  _bsc_hook_reaches "$f" "$hook" >/dev/null || reach_rc=$?
  if [[ "$reach_rc" == 2 ]]; then echo "CHAIN-BROKEN"; return 0; fi
  if [[ "$reach_rc" != 0 ]]; then echo "NO-REACH"; return 0; fi
  # A symlink into a DIFFERENT toolkit checkout still fires today, but the wiring has
  # drifted: that clone can be mid-edit, on another branch, or removed. A copy is not a
  # symlink and is not flagged (that is the supported Windows topology).
  if [[ -n "$tk" && -L "$f" ]]; then
    real="$(readlink -f "$f" 2>/dev/null || true)"
    # Prefix test by string strip, not a `case` glob: a toolkit path containing a glob
    # metacharacter would otherwise decide a finding by pattern-matching accident.
    if [[ "${real#"$tk"/}" == "$real" ]]; then echo "CLONE-DRIFT"; return 0; fi
  fi
  echo "OK"
}

# _bsc_state_reason <status> <hook-file> [hook-name] — the one-line human reason for a status.
_bsc_state_reason() {
  local tgt
  case "$1" in
    NOT-RUNNABLE)   printf 'git cannot run it — it %s' "$(_bsc_runnable "$2" || true)" ;;
    CHAIN-BROKEN)   tgt="$(_bsc_hook_reaches "$2" "${3:-post-checkout}" 2>/dev/null || true)"
                    printf 'chains to a hook git cannot run (%s: it %s)' "${tgt:-?}" \
                           "$(_bsc_runnable "${tgt:-/nonexistent}" || true)" ;;
    MISSING)        printf 'no hook file in the dispatch dir' ;;
    DANGLING)       printf 'symlink target is gone (%s)' "$(readlink "$2" 2>/dev/null || echo '?')" ;;
    NO-REACH)       printf 'does not reach board-card-start' ;;   # comments stripped first
    CLONE-DRIFT)    printf 'symlinked into another toolkit checkout (%s)' "$(readlink -f "$2" 2>/dev/null || echo '?')" ;;
    *)              printf '%s' "$1" ;;
  esac
}

# _bsc_main_checkout <repo-dir> — the checkout whose OWN .git directory is this repo's common
# dir (a linked worktree's main checkout). Empty + rc 1 when there is none: a --separate-git-dir
# repo and a submodule also have a `.git` FILE, but their common dir is an external path or
# <super>/.git/modules/<name>, so no sibling checkout owns it.
_bsc_main_checkout() {
  local cdir parent
  cdir="$(git -C "$1" rev-parse --git-common-dir 2>/dev/null)" || return 1
  [[ -n "$cdir" ]] || return 1
  [[ "$cdir" == /* ]] || cdir="$1/$cdir"
  [[ "$(basename "$cdir")" == ".git" && -d "$cdir" ]] || return 1
  parent="$(dirname "$cdir")"
  [[ -d "$parent" && "$parent" != "$1" ]] || return 1
  printf '%s' "$parent"
}

# _bsc_fix_line <repo> <dispatch-dir> <hook> — the remediation, verified against the topology
# rather than assumed. `install-board-hooks <repo>` is named ONLY when the directory it would
# target is provably the one git dispatches from; where a sibling checkout owns that directory,
# that path is named instead (and likewise proven); and where NO invocation can service the
# checkout, it says so and names the manual wiring. Printing a command that exits 1 is worse
# than printing none, and the topologies where it does are not rare (a linked worktree, a
# --separate-git-dir clone and a submodule all have a `.git` FILE, so the installer's
# <repo>/.git/hooks target is un-creatable).
# _bsc_same_dir <a> <b> — do two path SPELLINGS name the same directory? Compared canonically,
# never as strings: `--git-common-dir` is answered relative to the path the caller typed while
# the classification uses `--show-toplevel`, which is always canonical, so a symlinked repo
# path, a trailing slash, or a sub-directory of the work tree all make identical directories
# compare unequal. That difference used to fall through to the "your .git is a file" arm, which
# then asserted a falsehood about an ordinary checkout AND withheld the command that works.
_bsc_same_dir() {
  [[ -n "$1" && -n "$2" ]] || return 1
  [[ "$(readlink -m -- "$1" 2>/dev/null || printf '%s' "$1")" \
     == "$(readlink -m -- "$2" 2>/dev/null || printf '%s' "$2")" ]]
}

# _bsc_fix_line <repo> <dispatch-dir> <hook> — the remediation line.
#
# It does NOT model install-board-hooks' preconditions; it ASKS, via that tool's own `--check`
# dry run, and gates on the verdict. Modelling them is what produced a wrong answer in two
# consecutive reviews: a partial copy proved 2 of the 9 preconditions, so the modal finding — a
# repo carrying its own committed hook, which the installer refuses to clobber — was told to run
# a command that exits 1. Adding the two missing predicates would have made it 4 of 9 and left
# the shape intact (canon #5: fix the primitive, do not re-derive it at the call site).
#
# What stays here is the question `--check` cannot answer: whether the directory the installer
# would target is the one git DISPATCHES from. The installer can succeed while installing where
# git never looks (a linked worktree), so "the command works" and "the command fixes what I am
# reporting" are two different facts and both are required.
_bsc_fix_line() {
  local repo="$1" dir="$2" hook="$3" ibh itgt main err
  ibh="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/install-board-hooks"
  if [[ ! -x "$ibh" ]]; then
    printf 'install-board-hooks is not beside this tool, so no remedy could be verified; wire it by hand: ln -s <toolkit>/hooks/%s %s/' "$hook" "$dir"
    return 0
  fi
  # TWO questions, in this order, because each has its own right words and the wrong order
  # answers with the other one's. (1) WHERE would the installer put the hook? A resolution —
  # it goes through the same _ibh_hooks_dir the installer uses, with the installer's own
  # argument. (2) WOULD it succeed? Nine preconditions — asked of the installer itself via
  # --check, never re-derived here. Asking (2) first made a topology that no invocation can
  # service report as "resolve that, then re-run", which is not true of it.
  itgt="$(_bsc_hooks_dir "$repo" installer 2>/dev/null)" || itgt=""
  if _bsc_same_dir "$itgt" "$dir"; then
    if "$ibh" --check "$repo" >/dev/null 2>&1; then
      printf 'fix: install-board-hooks %s' "$repo"; return 0
    fi
    # Right directory, but it refuses. Quote its own words; invent no remedy — in particular no
    # `ln -s`, which for the commonest refusal (a repo carrying its own committed hook) would
    # tell the operator to destroy that hook.
    err="$("$ibh" --check "$repo" 2>&1 >/dev/null | head -1)" || true
    printf 'install-board-hooks refuses this checkout, so it is not the fix: %s — resolve that, then re-run it' \
           "${err##*install-board-hooks: }"
    return 0
  fi
  # A sibling checkout may own the dispatch dir (a linked worktree): the same two questions.
  main="$(_bsc_main_checkout "$repo" 2>/dev/null)" || main=""
  if [[ -n "$main" ]] && _bsc_same_dir "$(_bsc_hooks_dir "$main" installer 2>/dev/null)" "$dir" \
     && "$ibh" --check "$main" >/dev/null 2>&1; then
    printf 'fix: install-board-hooks %s   (this checkout dispatches from that one'"'"'s hook dir)' "$main"
    return 0
  fi
  # No invocation can service this checkout: the installer would write where git does not
  # dispatch from. Name both directories, assert no cause, and only offer the manual symlink if
  # the dispatch dir could actually take one.
  if [[ -d "$dir" && -w "$dir" ]]; then
    printf 'install-board-hooks would target %s, but git dispatches from %s, so it cannot fix this. Wire it by hand: ln -s <toolkit>/hooks/%s %s/' \
           "${itgt:-<unresolvable>}" "$dir" "$hook" "$dir"
  else
    printf 'install-board-hooks would target %s, but git dispatches from %s, which is not a writable directory — no remedy applies until that is resolved' \
           "${itgt:-<unresolvable>}" "$dir"
  fi
}

# _bsc_hook_dispatch_report <repo-dir>… — print one line per checkout plus a findings summary;
# mutate nothing. Returns the finding COUNT so a caller can assert on it; main deliberately does
# NOT fold it into the ritual's exit code. It resolves the active toolkit ITSELF rather than
# taking it as an argument, so the one function owns both the off-PATH warning and the count —
# a warning printed by the caller could not be counted, and an all-clear verdict printed
# underneath it asserted the exact thing the warning denied.
_bsc_hook_dispatch_report() {
  local repo name dir rc hook st findings=0 lines tk tk_rc=0 inspected=0 skipped=0
  tk="$(_bsc_active_toolkit)" || tk_rc=$?
  if [[ "$tk_rc" == 1 ]]; then
    # The single most consequential host-wide failure: every post-checkout below is a trampoline
    # into a tool that does not exist. It is a finding, not a footnote.
    echo "• (host): ✗ board-card-start is NOT on PATH — every post-checkout hook below is a no-op on this host, however it is wired"
    echo "      fix: put the toolkit's bin/ on PATH (see docs/INSTALL.md)"
    findings=$((findings + 1)); tk=""
  elif [[ "$tk_rc" == 2 ]]; then
    echo "• (host): ⚠ board-card-start is on PATH but its toolkit checkout is not derivable — hooks are still checked, minus the wrong-checkout comparison"
    tk=""
  fi
  for repo in "$@"; do
    name="$(basename "$repo")"
    rc=0; dir="$(_bsc_hooks_dir "$repo")" || rc=$?
    case "$rc" in
      2) echo "• ${name}: — no checkout at ${repo} (skipped)"; skipped=$((skipped + 1)); continue ;;
      1) echo "• ${name}: ✗ git refuses this checkout, so no hook can dispatch: ${dir}"
         echo "      (${repo} — fix what git reports above, then re-run this ritual)"
         findings=$((findings + 1)); skipped=$((skipped + 1)); continue ;;
      4) echo "• ${name}: ✗ core.hooksPath is set to an EMPTY value — git dispatches NO hooks for this repo, so the card auto-move is DEAD"
         echo "      (an empty value does NOT fall back to .git/hooks; a hook file sitting there is never read)"
         echo "      fix: git -C ${repo} config --unset core.hooksPath   then: install-board-hooks ${repo}"
         findings=$((findings + 1)); inspected=$((inspected + 1)); continue ;;
      # In practice the rc-1 arm ALWAYS reports this first: every value git cannot expand also
      # fatals `rev-parse` (verified). The arm stays so an unknown read status is never silently
      # folded into "unset" — that guess is the defect class this check exists for.
      6) echo "• ${name}: ✗ core.hooksPath is set to a value git cannot expand — git fatals when it dispatches, so NO hook runs"
         echo "      fix: git -C ${repo} config core.hooksPath <dir>   (or --unset), then: install-board-hooks ${repo}"
         findings=$((findings + 1)); inspected=$((inspected + 1)); continue ;;
      7|8) echo "• ${name}: — skipped: ${dir}"
         skipped=$((skipped + 1)); continue ;;
      5) echo "• ${name}: ⚠ CHECK DID NOT RUN — install-board-hooks (which owns the core.hooksPath resolver) is not beside this tool"
         findings=$((findings + 1)); skipped=$((skipped + 1)); continue ;;
    esac
    # An empty dir would silently degrade every hook below to a false MISSING — the one
    # answer this check must never invent. (Reachable: an unreadable/corrupt resolver.)
    if [[ -z "$dir" ]]; then
      echo "• ${name}: ⚠ CHECK DID NOT RUN — could not resolve the hook dispatch dir (resolver rc ${rc})"
      findings=$((findings + 1)); skipped=$((skipped + 1)); continue
    fi
    inspected=$((inspected + 1))
    lines=""
    for hook in "${BSC_HOOKS[@]}"; do
      st="$(_bsc_hook_state "$dir" "$hook" "$tk")"
      [[ "$st" == "OK" ]] && continue
      findings=$((findings + 1))
      # Severity follows the STATUS, not the hook: CLONE-DRIFT still fires today (it is wiring
      # drift, not a dead hook), so labelling it DEAD would contradict both this file and the
      # docs. Only post-checkout can be "the auto-move is dead" — pre-push is advisory.
      if [[ "$st" == "CLONE-DRIFT" ]]; then
        lines+="    ⚠ ${hook}: $(_bsc_state_reason "$st" "$dir/$hook" "$hook") — it still fires, but from a checkout other than the on-PATH tools'"$'\n'
      elif [[ "$hook" == "post-checkout" ]]; then
        lines+="    ✗ post-checkout: $(_bsc_state_reason "$st" "$dir/$hook" "$hook") — the card auto-move is DEAD for this repo"$'\n'
      else
        lines+="    ⚠ ${hook}: $(_bsc_state_reason "$st" "$dir/$hook" "$hook") — the branch-name advisory is off"$'\n'
      fi
    done
    if [[ -z "$lines" ]]; then
      echo "• ${name}: ✓ ${BSC_HOOKS[*]} dispatch from ${dir}"
      continue
    fi
    echo "• ${name}: dispatch dir ${dir}"
    printf '%s' "$lines"
    if [[ "$rc" == 3 ]]; then
      echo "      core.hooksPath is inside the tracked work tree: install-board-hooks refuses that target — chain the toolkit hook into the committed hook by hand (see docs/HOOKS.md)"
    else
      echo "      $(_bsc_fix_line "$repo" "$dir" "post-checkout")"
    fi
  done
  # Canon #9: an empty result is a measurement that never happened. Never print an all-clear
  # over zero inspected checkouts — say what was and was not measured.
  if [[ "$inspected" -eq 0 ]]; then
    echo "  (0 checkout(s) inspected, ${skipped} skipped, ${findings} finding(s) — NOTHING was verified here; point this at your checkouts before reading it as clean)"
  elif [[ "$findings" -eq 0 ]]; then
    echo "  (${inspected} inspected / ${skipped} skipped — no findings: every INSPECTED checkout has a runnable post-checkout that textually calls board-card-start; that is what ✓ asserts, not that a card will move — see docs/HOOKS.md)"
  else
    echo "  (${inspected} inspected / ${skipped} skipped — ${findings} finding(s) — REPORT-ONLY: nothing was installed, repaired or changed here)"
  fi
  return "$findings"
}

main() {
  local d wt b dirty hook rc out line cur_key ae_helper ae_out ae_rc
  echo "═══ SESSION-CLOSE RECONCILIATION ═══"
  echo "Fix any board card below that doesn't match the git/PR reality, then close."
  echo
  "$HOME/.local/bin/board-snapshot" 2>/dev/null || echo "(board-snapshot unavailable)"
  echo
  echo "── Local branch reality (cross-check against the cards above) ──"
  for wt in "${BSC_WORKTREES[@]}"; do
    d="$(basename "$wt")"
    [[ -e "$wt/.git" ]] || continue
    b="$(git -C "$wt" branch --show-current 2>/dev/null || true)"
    dirty=""; [[ -n "$(git -C "$wt" status --porcelain 2>/dev/null)" ]] && dirty=" (uncommitted changes)"
    echo "• ${d}: branch=${b:-?}${dirty}"
  done
  echo
  echo "── Git hook dispatch — does each checkout's post-checkout still reach board-card-start? ──"
  echo "   (report-only; remediation is yours: install-board-hooks <repo-dir>)"
  # board-card-start is fail-soft by contract, so a dead hook looks exactly like a working
  # one from here — this leg is the only thing on the host that reads the wiring itself.
  # Report-only by design: the finding count is deliberately NOT folded into the ritual's
  # exit code (which stays owned by the inverse-drift leg) — a lost hook is an operator fix,
  # not a reason to fail a session close.
  _bsc_hook_dispatch_report "${BSC_WORKTREES[@]}" || true
  echo
  echo "── Open PRs (each should have a card in In Review / Held) ──"
  # A SECOND, independently maintained literal list — one entry per unique GitHub repo, since
  # a second checkout of the same repo (a -prod deploy clone) would list the same open PRs.
  # It is NOT derived from BSC_WORKTREES: keeping the two in step is manual today, and
  # deriving it (dedupe by remote URL) is carded separately rather than done here.
  for d in agent-webhook-bridge-dev kanbanboard agent-board-toolkit; do
    wt="$HOME/$d"
    [[ -e "$wt/.git" ]] || continue
    ( cd "$wt" 2>/dev/null && gh pr list --state open --limit 10 2>/dev/null \
        | sed "s#^#  ${d}: #" ) || true
  done
  echo
  echo "── Inverse-drift check — In-Review cards with NO open PR (#3651), plus un-carded open PRs ──"
  echo "   (delegated to the shipped kanban-reconcile.py --detect; read-only)"
  if ! hook="$(resolve_reconcile_hook)"; then
    {
      echo "  ⚠ board-session-close: could NOT locate the shipped kanban-reconcile.py --detect hook."
      echo "    The inverse-drift check DID NOT RUN — do not close on an un-run drift check."
      echo "    Searched: \$KANBAN_RECONCILE_HOOK, the coord plugin dir on \$PATH, the marketplace"
      echo "    clone (~/.claude/plugins/marketplaces/agent-board-framework/plugins/coord/hooks/bin/),"
      echo "    and the plugin cache (~/.claude/plugins/cache/agent-board-framework/coord/*/hooks/bin/)."
      echo "    Fix: run /coord:update (or reinstall the coord plugin), or set KANBAN_RECONCILE_HOOK."
    } >&2
    return 1
  fi
  out="$(python3 "$hook" --detect 2>&1)"; rc=$?
  printf '%s\n' "$out" | sed 's/^/  /'
  # The hook's inverse leg is config-gated: a board without inverse_check_columns
  # runs the FORWARD leg only and reports 'inverse check OFF' at rc 0 — a PASS that
  # silently drops the In-Review-without-open-PR check the retired bash always ran.
  # A board absent/mis-declared in kanban.boards[] is 'skipped' at rc 0 the same way.
  # Re-surface both as a LOUD ⚠ on stderr, OUTSIDE the per-board '(no drift detected)'
  # framing, so the degraded coverage is never read as a clean pass (canon #9).
  cur_key=""
  while IFS= read -r line; do
    case "$line" in
      *"[DETECT] board"*"skipped"*)
        cur_key="${line%%):*}"; cur_key="${cur_key##*(}"
        echo "  ⚠ board ${cur_key:-?} was SKIPPED by kanban-reconcile.py --detect (${line#*"): "}) — it got NO inverse-drift check this run; declare its board_id + a single-repo kanban.boards[].repo to cover it" >&2
        ;;
      *"[DETECT] board"*"):"*)
        cur_key="${line%%):*}"; cur_key="${cur_key##*(}"
        ;;
      *"inverse check OFF"*)
        echo "  ⚠ inverse-drift check is OFF for board ${cur_key:-?} — arm inverse_check_columns in kanban.boards[] (coordination.config.json) or this ritual silently skips the In-Review-without-open-PR check" >&2
        ;;
    esac
  done <<< "$out"
  if [[ "$rc" -ne 0 ]]; then
    echo "  ⚠ kanban-reconcile.py --detect exited $rc — the inverse-drift check may be INCOMPLETE" >&2
    echo "    (config/API error above); investigate before treating the board as reconciled." >&2
  fi

  echo
  echo "── Archive-eligible done cards (consider: kbcard archive #N) ──"
  echo "   (read-only surfacing via _kbc-archive-eligible.py over the shipped may_archive gate)"
  ae_helper="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_kbc-archive-eligible.py"
  if [[ ! -f "$ae_helper" ]]; then
    echo "  ⚠ board-session-close: _kbc-archive-eligible.py sibling not found ($ae_helper) — the" >&2
    echo "    archive-eligible surfacing DID NOT RUN. It is advisory (the drift check above still" >&2
    echo "    ran), so this does not block close; reinstall the toolkit bin/ to restore it." >&2
  else
    ae_out="$(python3 "$ae_helper" 2>&1)"; ae_rc=$?
    printf '%s\n' "$ae_out" | sed 's/^/  /'
    if [[ "$ae_rc" -ne 0 ]]; then
      echo "  ⚠ _kbc-archive-eligible.py exited $ae_rc — the archive-eligible surfacing may be" >&2
      echo "    INCOMPLETE (config/API error above); it is advisory and does not block close." >&2
    fi
  fi

  return "$rc"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
