#!/usr/bin/env bash
# pr-base-snapshot — print THE BASE SNAPSHOT a `pull_request` workflow step must pair its work
# tree with: the FIRST PARENT of the merge commit `actions/checkout` leaves at HEAD. Nothing else
# is printed on stdout, so callers use it as `BASE=$(pr-base-snapshot --head "$HEAD_SHA")`.
#
# Hoisted from agent-webhook-bridge's `bin/pr-base-snapshot.sh` (card#8527, card#12338).
#
# WHY NOT `github.event.pull_request.base.sha`. GitHub does not refresh that field on every
# `synchronize`, so it can LAG the base tip the merge commit was actually computed against.
# Measured 2026-09-02 on the bridge's PR #640, run 33598959720: the event carried `base.sha`
# 549c894 while the merge commit 642decf the SAME event checked out has first parent 7a11085.
# The bridge's DL collision gate paired those two, read the base branch's own DL-335 as a number
# the PR had minted, and refused an innocent PR.
#
# NOR `git merge-base "$BASE" HEAD`. That RE-DERIVES a base from whatever head it is handed, so the
# first caller whose head is not the PR merge silently gets the FORK POINT — and every entry the
# base branch gained after the fork then reads as this PR's. This tool derives nothing: HEAD^1 is
# the base commit the merge RECORDS. Where that recorded shape is absent it refuses, not guesses.
#
# THE CONTRACT IT CHECKS, rather than assumes:
#   * HEAD is a commit with exactly TWO parents, and
#   * HEAD^2 is the PR head sha the event carried (`--head`),
# which together say "this work tree IS the merge of THIS PR's head into its base". The second leg
# is what makes the first non-vacuous. Either leg failing exits non-zero with the reason on stderr
# and prints no sha.
#
# THE PRECONDITION IS MEASURED: GitHub NEVER FAST-FORWARDS `refs/pull/<n>/merge`. Checked
# 2026-09-02 on two bridge PRs whose branches had already merged their base (#635 merge 570d1dc,
# #630 merge 6286dc9): both were TWO-parent merges. A plain `git merge` in a fixture DOES
# fast-forward there, which is why test harnesses pass `--no-ff`.
#
# Usage:
#   pr-base-snapshot --head <pr-head-sha>
#   pr-base-snapshot --tool-version
#
#   --head          the PR head sha (github.event.pull_request.head.sha); run in the checkout
#   --tool-version  print the toolkit release this FILE was stamped at, and exit 0, before any
#                   repo is read (VERSIONING.md rule 1).
#
# Exit status (every non-zero one means "no sha was printed"):
#   0  the base sha was printed
#   2  usage: no (or an empty) --head, or an unknown argument
#   3  HEAD could not be read as a commit
#   4  HEAD is not a two-parent merge commit
#   5  HEAD's second parent is not the PR head sha
set -euo pipefail
# SIGPIPE ignored and every write tolerated, so the status survives a reader that goes away
# (card#6911).
trap '' PIPE

ABTK_TOOL_VERSION='0.50.0'

_put()     { printf '%s\n' "$1" 2>/dev/null || true; }
_put_err() { printf '%s\n' "$1" >&2 2>/dev/null || true; }
die() { _put_err "pr-base-snapshot: $*"; exit 2; }

# Mirrors kb_require_value in _kb-board-lib.sh; held level by tests/mirror-pair-parity-selftest.sh.
require_value() { [ -n "${2:-}" ] || die "$1 requires a non-empty value"; }

expected_head=""; TOOL_VERSION_ONLY=0
while [ $# -gt 0 ]; do
  case "$1" in
    --head) require_value "$1" "${2:-}"; expected_head="$2"; shift 2;;
    --tool-version) TOOL_VERSION_ONLY=1; shift;;
    -h|--help) _put "$(awk 'NR>1 { if (substr($0,1,1) == "#") print; else exit }' "$0")"; exit 0;;
    *) die "unknown arg '$1'";;
  esac
done

if [ "$TOOL_VERSION_ONLY" = 1 ]; then
  _put "$ABTK_TOOL_VERSION"
  exit 0
fi

if [ -z "$expected_head" ]; then
  _put_err "::error::pr-base-snapshot needs the PR head sha (github.event.pull_request.head.sha) as --head."
  _put_err "Without it the merge at HEAD cannot be shown to be a merge OF THIS PR."
  exit 2
fi

if ! parents="$(git rev-list --parents -n 1 HEAD 2>&1)"; then
  _put_err "::error::pr-base-snapshot could not read HEAD as a commit: ${parents}"
  exit 3
fi

# `rev-list --parents -n 1` prints "<commit> <parent>..." — a two-parent merge is 3 fields.
read -r -a fields <<<"$parents"
if [ "${#fields[@]}" -ne 3 ]; then
  _put_err "::error::HEAD (${fields[0]:-?}) is not a two-parent merge commit, so this run is not on the merge GitHub built for a pull_request event."
  _put_err "This step reads its base snapshot from HEAD^1 and has no other source: github.event.pull_request.base.sha can lag, and a merge-base would re-derive the FORK POINT and refuse innocent PRs."
  _put_err "Fix: run this step on a pull_request event with the default actions/checkout ref (the refs/pull/N/merge commit), or re-run the job so GitHub recomputes that merge."
  exit 4
fi

base_parent="${fields[1]}"
head_parent="${fields[2]}"

if [ "$head_parent" != "$expected_head" ]; then
  _put_err "::error::HEAD's second parent (${head_parent}) is not this PR's head sha (${expected_head}), so the checked-out merge is not a merge of this PR's current head."
  _put_err "GitHub recomputes refs/pull/N/merge per event; a mismatch means this job is running against a stale or foreign merge."
  _put_err "Fix: if GitHub had not yet rebuilt refs/pull/N/merge for this push, re-run the job. If a NEWER push has already superseded this run, read that run instead — a re-run replays THIS event's head sha. If the PR has merge conflicts, GitHub cannot build the merge commit at all until they are resolved."
  exit 5
fi

_put "$base_parent"
